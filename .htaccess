# 3. Defensive SEO: Send HTTP 410 Gone only for non-existent legacy spam doorway pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^training-pelatihan-dan-sertifikasi-.*-di-.*\.html$ - [G,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^pdf/ - [G,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^training/.*\.html$ - [G,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^page/ - [G,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^tag/ - [G,L]

</IfModule>

# Custom Error Pages
ErrorDocument 410 /410.html
ErrorDocument 404 /404.html

# Canonical Header & Caching for Legacy Image Backlinks (Consolidate Image PageRank)
<Files "Rambu-Rambu-K3-Beserta-Penjelasannya.png">
    <IfModule mod_headers.c>
        Header set Link '<https://konsultank3.com/alat-pelindung-diri/>; rel="canonical"'
        Header set Cache-Control "public, max-age=31536000, immutable"
    </IfModule>
</Files>
