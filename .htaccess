<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Force HTTPS and non-www (one hop)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://konsultank3.com%{REQUEST_URI} [L,R=301]

RewriteRule ^(_legacy_backup|docs|src|scripts|public|node_modules|\.git|\.astro)(/|$) - [R=404,L]
RewriteRule ^(server\.js|package\.json|package-lock\.json|astro\.config\.mjs|README\.md|_redirects)$ - [R=404,L]

# 2. Reclaim Cited Backlink & Legacy URLs (1:1 301 Mapping)

# --- High-Priority Verified External Backlinks (Direct 1-Hop 301 Reclaim) ---
RewriteRule ^training/dokumen-amdal-pabrik-kayu\.html(/.*)?$ https://konsultank3.com/contoh-lembar-checklist-amdal-gedung-862.html [R=301,L]
RewriteRule ^training/contoh-pembuatan-jsa-penggalian-dengan-cangkul\.html(/.*)?$ https://konsultank3.com/contoh-job-safety-analysis-pengelasan-815.html [R=301,L]
RewriteRule ^training/pengenalan-peralatan-basic-trauma-life-support-for-jpam\.html(/.*)?$ https://konsultank3.com/bclsbasic-cardiac-life-support-for-paramedic-111.html [R=301,L]
RewriteRule ^pdf/faktor-penyebab-akibat-kerja\.html(/.*)?$ https://konsultank3.com/penyakit-akibat-kerja/ [R=301,L]
RewriteRule ^category/konsultan-industri-perusahaan(/.*)?$ https://konsultank3.com/ [R=301,L]
RewriteRule ^category/industri(/.*)?$ https://konsultank3.com/ [R=301,L]
