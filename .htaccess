<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1. Force HTTPS and non-www (one hop)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://konsultank3.com%{REQUEST_URI} [L,R=301]

RewriteRule ^(_legacy_backup|docs|src|scripts|node_modules|\.git|\.astro)(/|$) - [R=404,L]
RewriteRule ^(server\.js|package\.json|package-lock\.json|astro\.config\.mjs|README\.md|_redirects)$ - [R=404,L]

# 2. Reclaim Cited Backlink & Legacy URLs (1:1 301 Mapping)
RewriteRule ^program-pengendalian-kebisingan-331\.html$ /program-pengendalian-kebisingan/ [R=301,L]
RewriteRule ^privacy-policy/?$ /kebijakan-privasi/ [R=301,L]
RewriteRule ^hubungi-kami/?$ /kontak/ [R=301,L]
RewriteRule ^arsip/?$ / [R=301,L]

# 3. Defensive SEO: Send HTTP 410 Gone only for non-existent legacy spam doorway pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule -[0-9]{3,4}\.html$ - [G,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^pdf/ - [G,L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^training/.*\.html$ - [G,L]

</IfModule>

# Custom Error Pages
ErrorDocument 410 /410.html
ErrorDocument 404 /404.html
