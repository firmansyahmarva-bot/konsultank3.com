---
import { waLink } from '../data/contact.js';

interface Props {
  presetMessage?: string;
}

const {
  presetMessage = 'Halo Kak, saya mau tanya-tanya soal pelatihan & sertifikasi K3. Boleh dibantu? 🙏'
} = Astro.props;

const mainWaUrl = waLink(presetMessage);

const quickIntents = [
  {
    icon: '📅',
    label: 'Tanya jadwal terdekat',
    sub: 'Cek tanggal & kota pelaksanaan',
    href: waLink('Halo Kak, boleh minta info jadwal pelatihan K3 terdekat yang tersedia? 🙏')
  },
  {
    icon: '💰',
    label: 'Minta info biaya',
    sub: 'Rincian investasi & fasilitas peserta',
    href: waLink('Halo Kak, saya mau tanya rincian biaya investasi & fasilitas pelatihannya 🙏')
  },
  {
    icon: '📄',
    label: 'Cek syarat peserta',
    sub: 'Verifikasi ijazah & dokumen pendaftaran',
    href: waLink('Halo Kak, boleh bantu cek persyaratan berkas peserta sertifikasi K3? 🙏')
  },
  {
    icon: '🏢',
    label: 'In-house untuk perusahaan',
    sub: 'Proposal korporat & penyesuaian lokasi',
    href: waLink('Halo Kak, kami mau konsultasi pengadaan In-House Training K3 untuk perusahaan 🙏')
  }
];
---

<!-- Quick-Intent Popover Panel (Desktop & Mobile) -->
<div
  id="wa-intent-panel"
  popover="auto"
  role="dialog"
  aria-label="Pilih topik konsultasi WhatsApp"
  data-lenis-prevent
  class="wa-popover-panel w-[calc(100vw-2rem)] max-w-sm rounded-3xl bg-white/95 backdrop-blur-xl border border-slate-200/90 shadow-2xl text-slate-800 p-0 overflow-hidden"
>
  <div class="bg-gradient-to-br from-slate-950 via-slate-900 to-emerald-950 text-white px-5 py-4 flex items-start justify-between gap-3">
    <div>
      <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-emerald-400">
        <span class="w-2 h-2 rounded-full bg-emerald-400 inline-block"></span>
        <span>Konsultasi WhatsApp</span>
      </div>
      <p class="font-serif font-bold text-base text-white mt-0.5 leading-snug">
        Mau tanya soal apa, Kak?
      </p>
    </div>
    <button
      type="button"
      id="wa-panel-close"
      aria-label="Tutup panel konsultasi"
      class="w-8 h-8 rounded-full bg-white/10 hover:bg-white/20 text-slate-200 flex items-center justify-center transition-colors shrink-0"
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <div class="p-4 space-y-2.5">
    <!-- Primary Context CTA -->
    <a
      href={mainWaUrl}
      target="_blank"
      rel="noopener"
      class="btn-shine group flex items-center justify-between gap-3 p-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white shadow-lg shadow-emerald-600/25 transition-all"
    >
      <div class="flex items-center gap-3 min-w-0">
        <span class="w-9 h-9 rounded-xl bg-white/15 flex items-center justify-center text-lg shrink-0" aria-hidden="true">💬</span>
        <div class="min-w-0">
          <div class="font-bold text-sm leading-tight">Chat Langsung Konsultan</div>
          <div class="text-[11px] text-emerald-100 truncate">Konsultasi sesuai topik halaman ini</div>
        </div>
      </div>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="shrink-0 group-hover:translate-x-0.5 transition-transform" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>

    <div class="pt-1">
      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 px-1 mb-1.5">
        Atau pilih topik cepat
      </div>
      <div class="grid grid-cols-1 gap-1.5">
        {quickIntents.map((item) => (
          <a
            href={item.href}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-3 p-2.5 rounded-xl border border-slate-200/80 bg-slate-50/70 hover:bg-emerald-50/80 hover:border-emerald-300 transition-all"
          >
            <span class="w-8 h-8 rounded-lg bg-white border border-slate-200/80 flex items-center justify-center text-sm shrink-0 shadow-xs" aria-hidden="true">
              {item.icon}
            </span>
            <div class="min-w-0 flex-1">
              <div class="text-xs font-bold text-slate-900 group-hover:text-emerald-800 leading-tight">{item.label}</div>
              <div class="text-[11px] text-slate-500 truncate">{item.sub}</div>
            </div>
            <span class="text-slate-400 group-hover:text-emerald-600 text-xs transition-transform group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</div>

<!-- Desktop Floating Launcher + Single Soft Nudge -->
<div class="hidden md:flex fixed bottom-6 right-6 z-50 items-end gap-3">
  <!-- Soft 8s Nudge Bubble (once per session) -->
  <div
    id="wa-nudge"
    hidden
    class="wa-nudge-bubble flex items-center gap-2.5 pl-3.5 pr-2 py-2.5 rounded-2xl bg-slate-950/95 backdrop-blur-md text-white text-xs font-medium shadow-2xl border border-white/15"
  >
    <button
      type="button"
      id="wa-nudge-open"
      class="text-left hover:text-emerald-300 transition-colors flex items-center gap-2"
    >
      <span class="w-2 h-2 rounded-full bg-emerald-400 shrink-0" aria-hidden="true"></span>
      <span>Halo Kak 👋 Ada yang bisa kami bantu?</span>
    </button>
    <button
      type="button"
      id="wa-nudge-close"
      aria-label="Tutup pesan sapaan"
      class="w-6 h-6 rounded-full hover:bg-white/10 text-slate-400 hover:text-white flex items-center justify-center transition-colors shrink-0"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
        <path d="M18 6L6 18M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <!-- Floating Toggle Button -->
  <button
    type="button"
    id="wa-fab-btn"
    popovertarget="wa-intent-panel"
    aria-haspopup="dialog"
    aria-controls="wa-intent-panel"
    aria-label="Buka menu konsultasi WhatsApp"
    data-magnetic
    class="relative flex items-center justify-center w-14 h-14 rounded-full bg-gradient-to-br from-emerald-500 to-emerald-700 hover:from-emerald-400 hover:to-emerald-600 text-white shadow-2xl shadow-emerald-600/35 ring-4 ring-white/80 transition-transform duration-300 hover:scale-105 active:scale-95 cursor-pointer"
  >
    <span class="absolute top-0.5 right-0.5 w-3.5 h-3.5 rounded-full bg-emerald-300 border-2 border-white" aria-hidden="true"></span>
    <svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
    </svg>
  </button>
</div>

<!-- Mobile floating WhatsApp link -->
<a
  id="wa-mobile-button"
  href={mainWaUrl}
  target="_blank"
  rel="noopener"
  aria-label="Chat WhatsApp"
  class="wa-mobile-button-hidden md:hidden fixed right-4 bottom-[calc(1rem+env(safe-area-inset-bottom))] z-50 grid size-14 place-items-center rounded-full bg-emerald-700 text-white shadow-xl ring-2 ring-white/80 hover:bg-emerald-600 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-600"
>
  <svg width="25" height="25" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
      </svg>
</a>

<script>
  let supportsDisplayTransition: boolean | undefined;
  function canTransitionDisplay(): boolean {
    if (supportsDisplayTransition !== undefined) return supportsDisplayTransition;
    if (!window.CSS?.supports?.('transition-behavior', 'allow-discrete') || !document.body) {
      return false;
    }
    const probe = document.createElement('div');
    probe.style.cssText = 'transition: display 1s allow-discrete !important; display: block;';
    document.body.appendChild(probe);
    getComputedStyle(probe).display;
    probe.style.display = 'none';
    supportsDisplayTransition = getComputedStyle(probe).display === 'block';
    probe.remove();
    return supportsDisplayTransition;
  }

  function supportsTopLayerExit(): boolean {
    return Boolean(window.CSS?.supports?.('overlay', 'auto') && canTransitionDisplay());
  }

  async function closePopoverAnimated(panel: HTMLElement) {
    if (!Object.hasOwn(HTMLElement.prototype, 'popover')) {
      panel.removeAttribute('data-fallback-open');
      return;
    }
    if (!panel.matches(':popover-open')) return;
    if (!supportsTopLayerExit()) {
      panel.setAttribute('data-closing', '');
      const animations = panel.getAnimations({ subtree: true });
      if (animations.length > 0) {
        await Promise.race([
          Promise.allSettled(animations.map((a) => a.finished)),
          new Promise((r) => setTimeout(r, 400))
        ]);
      }
      if (!panel.hasAttribute('data-closing')) return;
      panel.removeAttribute('data-closing');
    }
    panel.hidePopover();
  }

  let nudgeTimer: number | undefined;

  function setupWhatsAppCTA() {
    window.clearTimeout(nudgeTimer);

    const panel = document.getElementById('wa-intent-panel');
    const closeBtn = document.getElementById('wa-panel-close');
    const fabBtn = document.getElementById('wa-fab-btn');
    const nudge = document.getElementById('wa-nudge');
    const nudgeOpen = document.getElementById('wa-nudge-open');
    const nudgeClose = document.getElementById('wa-nudge-close');

    const hasPopoverApi = Object.hasOwn(HTMLElement.prototype, 'popover');

    const openPanel = () => {
      if (!panel) return;
      if (hasPopoverApi) {
        if (!panel.matches(':popover-open')) panel.showPopover();
      } else {
        panel.toggleAttribute('data-fallback-open');
      }
    };

    if (panel && !hasPopoverApi && fabBtn && !fabBtn.dataset.waBound) {
      fabBtn.dataset.waBound = '1';
      fabBtn.addEventListener('click', openPanel);
    }

    if (panel && closeBtn && !closeBtn.dataset.waBound) {
      closeBtn.dataset.waBound = '1';
      closeBtn.addEventListener('click', () => closePopoverAnimated(panel));
    }

    // Dismiss nudge cleanly and store once per session
    const dismissNudge = () => {
      if (!nudge) return;
      nudge.hidden = true;
      try {
        sessionStorage.setItem('k3_wa_nudge_dismissed', '1');
      } catch {}
    };

    if (nudge && nudgeClose && !nudgeClose.dataset.waBound) {
      nudgeClose.dataset.waBound = '1';
      nudgeClose.addEventListener('click', dismissNudge);
    }

    if (nudge && nudgeOpen && !nudgeOpen.dataset.waBound) {
      nudgeOpen.dataset.waBound = '1';
      nudgeOpen.addEventListener('click', () => {
        dismissNudge();
        openPanel();
      });
    }

    // Show gentle nudge 8s after load once per session (unless panel already opened)
    let dismissed = false;
    try {
      dismissed = sessionStorage.getItem('k3_wa_nudge_dismissed') === '1';
    } catch {}
    if (nudge && !dismissed) {
      nudgeTimer = window.setTimeout(() => {
        if (panel && hasPopoverApi && panel.matches(':popover-open')) return;
        nudge.hidden = false;
      }, 8000);
    }

    // Mobile WhatsApp button visibility based on scroll (> 260px) & keyboard state
    const updateMobileButton = () => {
      const button = document.getElementById('wa-mobile-button');
      if (!button) return;
      const active = document.activeElement;
      const inputFocused = active instanceof HTMLElement && /^(INPUT|TEXTAREA|SELECT)$/.test(active.tagName);
      const show = window.scrollY > 260 && !inputFocused;
      button.classList.toggle('wa-mobile-button-hidden', !show);
    };

    updateMobileButton();
    const win = window as Window & { __k3WaScrollBound?: boolean };
    if (!win.__k3WaScrollBound) {
      win.__k3WaScrollBound = true;
      window.addEventListener('scroll', updateMobileButton, { passive: true });
      document.addEventListener('focusin', updateMobileButton);
      document.addEventListener('focusout', () => setTimeout(updateMobileButton, 50));
    }
  }

  document.addEventListener('astro:page-load', setupWhatsAppCTA);
</script>
