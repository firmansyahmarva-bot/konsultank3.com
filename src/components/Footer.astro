---
const currentYear = new Date().getFullYear();

const kemnakerLinks = [
  { label: 'Ahli K3 Umum', href: '/pelatihan-ahli-k3-umum/' },
  { label: 'Auditor SMK3', href: '/pelatihan-auditor-smk3-kemnaker/' },
  { label: 'K3 Kebakaran (A–D)', href: '/pelatihan-k3-kebakaran/' },
  { label: 'Teknisi & Ahli K3 Listrik', href: '/pelatihan-k3-listrik/' },
  { label: 'K3 Ruang Terbatas', href: '/pelatihan-k3-ruang-terbatas/' },
  { label: 'Petugas P3K Kerja', href: '/pelatihan-petugas-p3k-kemnaker-bnsp/' },
  { label: 'LPK K3 Kota Tangerang', href: '/lpk-k3-tangerang/' },
  { label: 'Semua Jadwal Pelatihan', href: '/pelatihan/' },
];

const bnspLinks = [
  { label: 'POP Pertambangan', href: '/pelatihan-pop-pertambangan-bnsp/' },
  { label: 'Ahli K3 Konstruksi', href: '/pelatihan-ahli-k3-konstruksi-muda-madya/' },
  { label: 'Higiene Industri (HIMU)', href: '/pelatihan-higiene-industri-muda-himu-bnsp/' },
  { label: 'Petugas Gas Beracun H2S', href: '/pelatihan-petugas-gas-beracun-h2s-bnsp/' },
  { label: 'K3 Rumah Sakit & Faskes', href: '/pelatihan-k3-rumah-sakit-faskes-bnsp/' },
  { label: 'K3 Laboratorium', href: '/pelatihan-k3-laboratorium-bnsp/' },
  { label: 'Spill Response B3 & Drill', href: '/pelatihan-spill-response-b3-oil-spill-drill/' },
  { label: 'Investigasi RCA & SCAT', href: '/pelatihan-investigasi-kecelakaan-kerja-rca-scat/' },
];

const konsultasiLinks = [
  { label: 'Audit SMK3 PP 50/2012', href: '/panduan-penerapan-smk3/' },
  { label: 'Pengesahan P2K3 & P3K', href: '/jasa-pengesahan-p2k3-lisensi-p3k/' },
  { label: 'Konsultasi IMS & ISO', href: '/konsultasi-integrated-management-system/' },
  { label: 'CSMS Kontraktor K3', href: '/contractor-safety-management-system-csms/' },
  { label: 'Safety Leadership Direksi', href: '/executive-safety-leadership/' },
  { label: 'Audit Risiko Ergonomi', href: '/penilaian-risiko-ergonomi/' },
  { label: 'Pengendalian Kebisingan', href: '/program-pengendalian-kebisingan/' },
  { label: 'Standar Pemilihan APD', href: '/alat-pelindung-diri/' },
  { label: 'Penyakit Akibat Kerja', href: '/penyakit-akibat-kerja/' },
  { label: 'Materi Safety Talk', href: '/materi-safety-talk-harian/' },
  { label: 'Management of Change', href: '/management-of-change-k3/' },
];

const downloadLinks = [
  { label: 'Checklist SMK3 166 Kriteria', href: '/downloads/Checklist-Audit-SMK3-166-Kriteria.html' },
  { label: 'Formulir JSA Kerja Aman', href: '/downloads/Formulir-JSA-Job-Safety-Analysis.html' },
  { label: 'Tabel NAB Kebisingan K3', href: '/downloads/Tabel-Nilai-Ambang-Batas-Kebisingan-K3.html' },
];
const linkGroups = [
  { title: 'Konsultasi & Audit', links: [
    { label: 'Audit Kepatuhan Regulasi K3', href: '/audit-kepatuhan-regulasi-k3/' },
    { label: 'Pendampingan SMKP Minerba', href: '/pendampingan-smkp-minerba/' },
    { label: 'Konsultasi HAZOP', href: '/jasa-konsultasi-hazop/' },
    ...konsultasiLinks.slice(0, 7),
    ...konsultasiLinks.slice(10),
  ] },
  { title: 'Pelatihan Kemnaker', links: kemnakerLinks },
  { title: 'Pelatihan BNSP & In-House', links: [
    { label: 'Pelatihan In-House', href: '/in-house-training-k3-jakarta-surabaya-balikpapan/' },
    ...bnspLinks,
  ] },
  { title: 'Panduan & Unduhan', links: [
    { label: 'Artikel K3', href: '/artikel/' },
    ...konsultasiLinks.slice(7, 10),
    ...downloadLinks,
  ] },
];
---

<div class="footer-scene">
  <figure class="footer-photos">
    <img src="/assets/images/footer-consulting.webp" width="1752" height="897" loading="lazy" decoding="async" alt="Ilustrasi rapat konsultasi, peninjauan lapangan, dan pembahasan hasil" />
    <img src="/assets/images/footer-training.webp" width="1672" height="941" loading="lazy" decoding="async" alt="Ilustrasi kelompok berseragam, pelatihan di kelas, dan praktik lapangan" />
    <figcaption>Ilustrasi kegiatan</figcaption>
  </figure>

  <footer class="glass-footer">
    <div class="footer-inner">
      <div class="footer-intro">
        <div>
          <a class="footer-brand" href="/">KonsultanK3.com</a>
          <h2>Dari asesmen hingga penerapan.</h2>
        </div>
        <a class="footer-contact btn-shine" href="/kontak/">Hubungi Kami <span aria-hidden="true">↗</span></a>
      </div>

      <nav class="footer-links" aria-label="Layanan dan sumber daya">
        {linkGroups.map(({ title, links }) => (
          <section>
            <h3>{title}</h3>
            <ul>
              {links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
            </ul>
          </section>
        ))}
      </nav>

      <div class="footer-legal">
        <p>© 2011–{currentYear} KonsultanK3.com</p>
        <nav aria-label="Perusahaan dan kebijakan">
          <a href="/tentang-kami/">Tentang Kami</a>
          <a href="/kebijakan-privasi/">Kebijakan Privasi</a>
          <a href="/syarat-ketentuan/">Syarat &amp; Ketentuan</a>
        </nav>
      </div>
    </div>
  </footer>
</div>

<style>
  .footer-scene {
    display: flow-root;
    position: relative;
    isolation: isolate;
    background: #0a1522;
  }

  .footer-photos {
    position: sticky;
    top: 0;
    height: 100svh;
    margin: 0 0 -100svh;
    z-index: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-content: center;
    align-items: center;
    gap: 5px;
  }

  .footer-photos img { display: block; width: 100%; height: auto; }
  .footer-photos figcaption {
    grid-column: 1 / -1;
    padding: .5rem 1rem;
    color: #b6cbe1;
    font-size: .75rem;
  }

  .glass-footer {
    position: relative;
    z-index: 1;
    margin-top: 88svh;
    min-height: 76svh;
    padding: clamp(2rem, 5vw, 5rem) clamp(1.25rem, 5vw, 5rem) 2rem;
    color: #fff;
    background: linear-gradient(180deg, rgb(10 28 53 / .64), rgb(10 23 39 / .96) 72%);
    border-top: 1px solid rgb(207 230 255 / .35);
    box-shadow: 0 -12px 50px rgb(7 19 33 / .25);
    -webkit-backdrop-filter: blur(12px) saturate(85%);
    backdrop-filter: blur(12px) saturate(85%);
  }

  .footer-inner { max-width: 84rem; margin-inline: auto; }
  .footer-intro, .footer-legal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .footer-brand { color: #d8e6f1; font-size: .875rem; font-weight: 700; }
  .footer-intro h2 {
    max-width: 18ch;
    margin: .625rem 0 0;
    font-size: clamp(2rem, 4.2vw, 4.375rem);
    font-weight: 650;
    line-height: 1.06;
    letter-spacing: -.045em;
  }

  .footer-contact {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    padding: .875rem 1.25rem;
    border: 1px solid rgb(214 234 255 / .6);
    border-radius: 2rem;
    background: rgb(224 238 255 / .12);
    font-weight: 700;
  }
  .footer-contact:hover { background: rgb(224 238 255 / .22); }

  .footer-links {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.75rem;
    margin-top: clamp(2rem, 5vw, 4rem);
    padding: 2rem 0;
    border-block: 1px solid rgb(218 234 255 / .24);
  }

  .footer-links section {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    align-items: baseline;
    gap: .5rem 1.25rem;
  }

  .footer-links h3 { margin: 0; font-size: .95rem; font-weight: 700; }
  .footer-links ul { display: flex; flex-wrap: wrap; gap: .5rem; margin: 0; padding: 0; list-style: none; }
  .footer-links a, .footer-legal { color: #d5e2ef; font-size: .875rem; }
  .footer-links a, .footer-legal nav a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: .45rem .8rem;
    border: 1px solid rgb(171 207 245 / .28);
    border-radius: .6rem;
    background: rgb(138 184 234 / .10);
    color: #e9f3ff;
  }
  .footer-links a:is(:hover, :focus-visible), .footer-legal nav a:is(:hover, :focus-visible) {
    border-color: rgb(171 207 245 / .6);
    background: rgb(138 184 234 / .22);
    color: #fff;
  }
  .footer-brand:hover {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: .25em;
  }

  .footer-legal { padding-top: 1.25rem; }
  .footer-legal p { margin: 0; }
  .footer-legal nav { display: flex; flex-wrap: wrap; gap: .625rem 1.25rem; }

  @media (max-width: 767px) {
    .footer-photos { grid-template-columns: 1fr; }
    .footer-links section { grid-template-columns: minmax(0, 1fr); }
    .glass-footer { padding-bottom: calc(6rem + env(safe-area-inset-bottom)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-photos { position: relative; height: auto; margin-bottom: 0; }
    .glass-footer { min-height: auto; margin-top: 0; }
  }
</style>
