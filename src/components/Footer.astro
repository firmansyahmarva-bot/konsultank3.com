---
const currentYear = new Date().getFullYear();
---

<footer class="bg-slate-950 text-slate-400 border-t border-white/10 pt-16 pb-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Grid: 4 Columns -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-white/10">
      
      <!-- Brand & Corporate Backing -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3 text-white">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-slate-950 shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
          </div>
          <div>
            <span class="font-extrabold text-xl text-white">Konsultan<span class="text-amber-400">K3</span>.com</span>
            <div class="text-[10px] tracking-wider text-slate-400 uppercase">A Wahana Totalita Knowledge Partner</div>
          </div>
        </a>
        <p class="text-sm text-slate-400 leading-relaxed max-w-sm">
          Portal referensi ilmiah kepatuhan Keselamatan dan Kesehatan Kerja (K3) industri terpercaya di Indonesia sejak 2011. Didukung oleh konsultan senior dan PJK3 berlisensi resmi Kemnaker RI & BNSP.
        </p>

        <!-- Wahana Totalita Official Badge -->
        <div class="inline-flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10 text-xs text-slate-300">
          <div class="w-8 h-8 rounded-lg bg-emerald-500/20 text-emerald-400 flex items-center justify-center shrink-0 font-bold">
            WT
          </div>
          <div>
            <div class="font-semibold text-white">PT Wahana Totalita Konsultan</div>
            <div class="text-slate-400 text-[11px]">Mitra PJK3 Resmi Kemnaker RI</div>
          </div>
          <a href="https://wahanatotalita.com" target="_blank" rel="noopener" class="text-emerald-400 hover:text-emerald-300 text-xs font-bold underline ml-auto">
            Kunjungi &rarr;
          </a>
        </div>
      </div>

      <!-- Column 1: Pelatihan K3 Kemnaker -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Pelatihan K3</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/pelatihan-ahli-k3-umum/" class="hover:text-amber-400 transition-colors">Ahli K3 Umum (Kemnaker)</a></li>
          <li><a href="/pelatihan-k3-kebakaran/" class="hover:text-amber-400 transition-colors">K3 Penanggulangan Kebakaran</a></li>
          <li><a href="/pelatihan-k3-listrik/" class="hover:text-amber-400 transition-colors">Teknisi & Ahli K3 Listrik</a></li>
          <li><a href="/pelatihan-k3-ruang-terbatas/" class="hover:text-amber-400 transition-colors">K3 Ruang Terbatas (Confined Space)</a></li>
          <li><a href="/pelatihan/" class="text-emerald-400 font-semibold hover:underline">Semua Jadwal Pelatihan &rarr;</a></li>
        </ul>
      </div>

      <!-- Column 2: Konsultasi & Audit -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Konsultasi & Audit</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/panduan-penerapan-smk3/" class="hover:text-amber-400 transition-colors">Audit SMK3 PP 50/2012</a></li>
          <li><a href="/program-pengendalian-kebisingan/" class="hover:text-amber-400 transition-colors">Pengendalian Kebisingan Industri</a></li>
          <li><a href="/alat-pelindung-diri/" class="hover:text-amber-400 transition-colors">Standar Pemilihan APD SNI/ANSI</a></li>
          <li><a href="/penyakit-akibat-kerja/" class="hover:text-amber-400 transition-colors">Pencegahan Penyakit Akibat Kerja</a></li>
        </ul>
      </div>

      <!-- Column 3: Download & Regulasi -->
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">Pusat Unduhan & Legal</h3>
        <ul class="space-y-2 text-sm">
          <li><a href="/downloads/Checklist-Audit-SMK3-166-Kriteria.html" class="hover:text-amber-400 transition-colors">Checklist SMK3 166 Kriteria</a></li>
          <li><a href="/downloads/Formulir-JSA-Job-Safety-Analysis.html" class="hover:text-amber-400 transition-colors">Template Formulir JSA Excel</a></li>
          <li><a href="/downloads/Tabel-Nilai-Ambang-Batas-Kebisingan-K3.html" class="hover:text-amber-400 transition-colors">Tabel NAB Kebisingan K3</a></li>
          <li><a href="/kebijakan-privasi/" class="hover:text-amber-400 transition-colors">Kebijakan Privasi</a></li>
          <li><a href="/syarat-ketentuan/" class="hover:text-amber-400 transition-colors">Syarat & Ketentuan</a></li>
          <li><a href="/kontak/" class="text-amber-400 font-semibold hover:underline">Hubungi Konsultan &rarr;</a></li>
        </ul>
      </div>

    </div>

    <!-- Bottom Strip -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500">
      <div>
        &copy; 2011–{currentYear} <strong>KonsultanK3.com</strong>. Hak cipta dilindungi undang-undang.
      </div>
      <div class="flex items-center gap-4 text-slate-400">
        <span class="inline-flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          Standar Kepatuhan Zero Accident
        </span>
        <span>•</span>
        <span>UU No. 1 Tahun 1970 & PP No. 50 Tahun 2012</span>
      </div>
    </div>

  </div>
</footer>
