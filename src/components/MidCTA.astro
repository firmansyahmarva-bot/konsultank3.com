---
import { waLink } from '../data/contact.js';

interface Props {
  presetMessage?: string;
}

const {
  presetMessage = 'Halo Kak, saya mau konsultasi kebutuhan pelatihan & sertifikasi K3. Boleh dibantu? 🙏'
} = Astro.props;

const waUrl = waLink(presetMessage);
---

<template id="mid-cta-template">
  <aside
    data-mid-cta
    aria-label="Konsultasi Kebutuhan K3"
    class="not-prose relative pt-4"
  >
    <!-- Tilted corner sticker badge -->
    <div class="cta-sticker-badge inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-amber-400 text-slate-950 font-extrabold text-[11px] sm:text-xs tracking-wide shadow-lg shadow-amber-500/25 border-2 border-white absolute top-0 left-5 sm:left-7 z-20 -rotate-2 select-none">
      <span aria-hidden="true">💬</span>
      <span>Gratis Konsultasi</span>
    </div>

    <!-- Emerald gradient border frame -->
    <div class="p-[1.5px] rounded-3xl bg-gradient-to-br from-emerald-400 via-teal-500/60 to-amber-400/80 shadow-xl shadow-slate-900/8">
      <div class="relative overflow-hidden rounded-[22px] bg-white px-6 py-7 sm:px-8 sm:py-7 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <!-- Subtle ambient radial tint -->
        <div class="pointer-events-none absolute -right-12 -top-12 w-48 h-48 rounded-full bg-emerald-400/10 blur-2xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -left-10 -bottom-10 w-40 h-40 rounded-full bg-amber-400/10 blur-2xl" aria-hidden="true"></div>

        <div class="relative z-10 space-y-1.5 max-w-xl pt-1">
          <h3 class="font-serif text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight leading-snug">
            Konsultasikan kebutuhan K3 Anda dengan kami
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed font-sans">
            Ceritakan kebutuhan Anda atau tim. Kami bantu carikan program, jadwal &amp; biaya yang pas. Tanya dulu juga boleh, Kak.
          </p>
        </div>

        <div class="relative z-10 shrink-0">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener"
            class="btn-shine group inline-flex items-center justify-center gap-2.5 w-full md:w-auto px-6 py-3.5 rounded-2xl bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-500 hover:to-emerald-600 text-white font-bold text-sm shadow-lg shadow-emerald-600/25 transition-all duration-300 hover:-translate-y-0.5 active:translate-y-0"
          >
            <span>Chat Kami Sekarang</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-hover:translate-x-1" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </aside>
</template>
