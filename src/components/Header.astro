<script is:inline>
  (() => {
    const h = document.getElementById('site-header');
    const i = h && h.querySelector('.header-inner');
    if (h && i) {
      h.classList.add('is-wide');
      if (i.scrollWidth > i.clientWidth) h.classList.remove('is-wide');
    }
  })();
</script>

<script>
  let navResizeObserver: ResizeObserver | null = null;
  let lastCollapsedWidth = 0;

  function positionFallbackPopover(trigger: HTMLElement, panel: HTMLElement) {
    if (typeof CSS !== 'undefined' && CSS.supports?.('position-area', 'block-end')) return;
    const tr = trigger.getBoundingClientRect();
    const pr = panel.getBoundingClientRect();
    const pad = 16;
    let top = tr.bottom + 8;
    if (top + pr.height > window.innerHeight - pad && tr.top - pr.height - 8 > pad) {
      top = tr.top - pr.height - 8;
    }
    const left = Math.max(pad, Math.min(tr.left, window.innerWidth - pr.width - pad));
    panel.style.top = `${Math.round(top)}px`;
    panel.style.left = `${Math.round(left)}px`;
  }

  function setupResponsiveNav() {
    if (navResizeObserver) {
      navResizeObserver.disconnect();
      navResizeObserver = null;
    }

    const header = document.getElementById('site-header');
    const inner = header?.querySelector('.header-inner') as HTMLElement | null;
    const siteMenu = document.getElementById('site-menu');
    if (!header || !inner || !siteMenu) return;

    const hasPopoverApi = Object.hasOwn(HTMLElement.prototype, 'popover');
    const dropdownItems = Array.from(header.querySelectorAll('.nav-dropdown')) as HTMLLIElement[];

    const syncLayout = (forceMeasure = false) => {
      const currentlyWide = header.classList.contains('is-wide');
      const currentWidth = header.clientWidth;

      // Avoid layout thrash while collapsed unless header grew wider
      if (!forceMeasure && !currentlyWide && currentWidth <= lastCollapsedWidth) {
        return;
      }

      const menuWasOpen = hasPopoverApi && !currentlyWide && siteMenu.matches(':popover-open');

      header.classList.add('is-measuring');
      header.classList.add('is-wide');
      const fitsInline = inner.scrollWidth <= inner.clientWidth;

      if (fitsInline) {
        lastCollapsedWidth = 0;
        if (hasPopoverApi) siteMenu.removeAttribute('popover');
        siteMenu.removeAttribute('data-fallback-open');

        dropdownItems.forEach((li) => {
          const trigger = li.querySelector('.dropdown-trigger') as HTMLButtonElement | null;
          const panel = li.querySelector('.dropdown-panel') as HTMLElement | null;
          if (!trigger || !panel) return;
          if (hasPopoverApi) {
            panel.setAttribute('popover', 'auto');
            panel.hidden = false;
          } else {
            panel.hidden = true;
          }
          trigger.setAttribute('aria-expanded', 'false');
        });
      } else {
        header.classList.remove('is-wide');
        lastCollapsedWidth = currentWidth;
        if (hasPopoverApi) {
          siteMenu.setAttribute('popover', 'auto');
          if (menuWasOpen && !siteMenu.matches(':popover-open')) {
            try { siteMenu.showPopover(); } catch {}
          }
        }

        dropdownItems.forEach((li) => {
          const trigger = li.querySelector('.dropdown-trigger') as HTMLButtonElement | null;
          const panel = li.querySelector('.dropdown-panel') as HTMLElement | null;
          if (!trigger || !panel) return;
          if (hasPopoverApi) panel.removeAttribute('popover');
          panel.style.top = '';
          panel.style.left = '';
          panel.hidden = true;
          trigger.setAttribute('aria-expanded', 'false');
        });
      }

      requestAnimationFrame(() => header.classList.remove('is-measuring'));
    };

    // Fallback toggle if browser lacks native Popover API
    const menuBtn = document.getElementById('mobile-menu-btn');
    if (menuBtn && !hasPopoverApi && !menuBtn.dataset.navBound) {
      menuBtn.dataset.navBound = '1';
      menuBtn.addEventListener('click', () => {
        if (!header.classList.contains('is-wide')) {
          siteMenu.toggleAttribute('data-fallback-open');
        }
      });
    }

    // Bind dropdown triggers, hover previews & toggle positioning
    dropdownItems.forEach((li) => {
      if (li.dataset.navBound) return;
      li.dataset.navBound = '1';

      const trigger = li.querySelector('.dropdown-trigger') as HTMLButtonElement | null;
      const panel = li.querySelector('.dropdown-panel') as HTMLElement | null;
      if (!trigger || !panel) return;

      let hoverPreview = false;

      if (hasPopoverApi) {
        panel.addEventListener('toggle', (e: Event) => {
          const toggleEvent = e as ToggleEvent;
          const isOpen = toggleEvent.newState === 'open';
          trigger.setAttribute('aria-expanded', String(isOpen));
          if (isOpen && header.classList.contains('is-wide')) {
            requestAnimationFrame(() => positionFallbackPopover(trigger, panel));
          } else {
            hoverPreview = false;
          }
        });
      }

      li.addEventListener('pointerenter', (e: PointerEvent) => {
        if (!hasPopoverApi || !header.classList.contains('is-wide')) return;
        if (!window.matchMedia('(hover: hover)').matches || e.pointerType === 'touch') return;
        if (!panel.matches(':popover-open')) {
          hoverPreview = true;
          try {
            (panel as any).showPopover({ source: trigger });
          } catch {
            try { panel.showPopover(); } catch {}
          }
        }
      });

      li.addEventListener('pointerleave', (e: PointerEvent) => {
        if (!hasPopoverApi || !header.classList.contains('is-wide')) return;
        if (e.pointerType === 'touch' || !hoverPreview) return;
        if (panel.matches(':popover-open')) {
          try { panel.hidePopover(); } catch {}
        }
        hoverPreview = false;
      });

      trigger.addEventListener('click', (e: MouseEvent) => {
        if (header.classList.contains('is-wide') && hasPopoverApi) {
          if (hoverPreview && panel.matches(':popover-open')) {
            e.preventDefault();
            hoverPreview = false;
          }
        } else {
          e.preventDefault();
          const willOpen = panel.hidden;
          panel.hidden = !willOpen;
          trigger.setAttribute('aria-expanded', String(willOpen));
        }
      });

      li.addEventListener('focusout', (e: FocusEvent) => {
        if (!hasPopoverApi || !header.classList.contains('is-wide')) return;
        const related = e.relatedTarget as Node | null;
        if (related && !li.contains(related) && panel.matches(':popover-open')) {
          try { panel.hidePopover(); } catch {}
        }
      });
    });

    // Close popovers cleanly when clicking any nav link
    if (!siteMenu.dataset.linkCloseBound) {
      siteMenu.dataset.linkCloseBound = '1';
      siteMenu.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => {
          if (hasPopoverApi) {
            if (siteMenu.matches(':popover-open')) {
              try { siteMenu.hidePopover(); } catch {}
            }
            dropdownItems.forEach((li) => {
              const p = li.querySelector('.dropdown-panel') as HTMLElement | null;
              if (p?.matches(':popover-open')) {
                try { p.hidePopover(); } catch {}
              }
            });
          } else {
            siteMenu.removeAttribute('data-fallback-open');
          }
        });
      });
    }

    syncLayout(true);

    if ('ResizeObserver' in window) {
      navResizeObserver = new ResizeObserver(() => syncLayout(false));
      navResizeObserver.observe(header);
      navResizeObserver.observe(siteMenu);
    }
  }

  document.addEventListener('astro:page-load', setupResponsiveNav);
</script>
