---
import { WA_DISPLAY, waLink } from '../data/contact.js';

const currentPath = Astro.url.pathname;

const isPelatihanActive =
  currentPath.startsWith('/pelatihan') || currentPath.startsWith('/lpk-k3') || currentPath.startsWith('/in-house');
const isKonsultasiActive =
  currentPath.startsWith('/panduan-penerapan-smk3') ||
  currentPath.startsWith('/konsultasi-') ||
  currentPath.startsWith('/jasa-') ||
  currentPath.startsWith('/contractor-') ||
  currentPath.startsWith('/executive-') ||
  currentPath.startsWith('/safety-culture') ||
  currentPath.startsWith('/audit-kepatuhan') ||
  currentPath.startsWith('/fire-risk') ||
  currentPath.startsWith('/management-of-change') ||
  currentPath.startsWith('/penilaian-risiko') ||
  currentPath.startsWith('/program-pengendalian') ||
  currentPath.startsWith('/alat-pelindung') ||
  currentPath.startsWith('/materi-safety');
const isRegulasiActive =
  currentPath.startsWith('/downloads/') ||
  currentPath.startsWith('/penyakit-akibat-kerja') ||
  currentPath.startsWith('/artikel');

const kemnakerPrograms = [
  { name: 'Ahli K3 Umum', tag: 'SKP Kemnaker', href: '/pelatihan-ahli-k3-umum/' },
  { name: 'Ahli K3 Umum Semarang', tag: 'Jateng', href: '/pelatihan-ahli-k3-umum-semarang/' },
  { name: 'Auditor SMK3', tag: 'PP 50/2012', href: '/pelatihan-auditor-smk3-kemnaker/' },
  { name: 'K3 Kebakaran (Kelas A–D)', tag: 'Kep.186/1999', href: '/pelatihan-k3-kebakaran/' },
  { name: 'Teknisi & Ahli K3 Listrik', tag: 'Permen 12/2015', href: '/pelatihan-k3-listrik/' },
  { name: 'K3 Ruang Terbatas', tag: 'Confined Space', href: '/pelatihan-k3-ruang-terbatas/' },
  { name: 'Petugas P3K Tempat Kerja', tag: 'Kemnaker & BNSP', href: '/pelatihan-petugas-p3k-kemnaker-bnsp/' },
];

const bnspPrograms = [
  { name: 'POP Pertambangan', tag: 'Minerba', href: '/pelatihan-pop-pertambangan-bnsp/' },
  { name: 'Ahli K3 Konstruksi', tag: 'Muda & Madya', href: '/pelatihan-ahli-k3-konstruksi-muda-madya/' },
  { name: 'Higiene Industri (HIMU)', tag: 'BNSP', href: '/pelatihan-higiene-industri-muda-himu-bnsp/' },
  { name: 'Petugas Gas Beracun H2S', tag: 'Migas', href: '/pelatihan-petugas-gas-beracun-h2s-bnsp/' },
  { name: 'K3 Rumah Sakit & Faskes', tag: 'K3RS', href: '/pelatihan-k3-rumah-sakit-faskes-bnsp/' },
  { name: 'K3 Laboratorium', tag: 'Biosafety', href: '/pelatihan-k3-laboratorium-bnsp/' },
  { name: 'PPPA & POPAL Air Limbah', tag: 'Lingkungan', href: '/pelatihan-pppa-popal/' },
  { name: 'PPPU & POIPPU Emisi', tag: 'Udara', href: '/pelatihan-pppu-poippu/' },
];

const corporatePrograms = [
  { name: 'In-House Training Multi-Kota', desc: 'Jakarta, Surabaya & Balikpapan', href: '/in-house-training-k3-jakarta-surabaya-balikpapan/' },
  { name: 'Spill Response B3 & Drill', desc: 'Tanggap darurat tumpahan kimia & minyak', href: '/pelatihan-spill-response-b3-oil-spill-drill/' },
  { name: 'Investigasi Insiden RCA & SCAT', desc: 'Analisis akar penyebab kecelakaan kerja', href: '/pelatihan-investigasi-kecelakaan-kerja-rca-scat/' },
  { name: 'LPK K3 Kota Tangerang', desc: 'Pusat pembinaan kawasan Jabodetabek', href: '/lpk-k3-tangerang/' },
];

const konsultasiSystem = [
  { name: 'Audit SMK3 PP 50/2012', desc: 'Pendampingan 64–166 kriteria', href: '/panduan-penerapan-smk3/' },
  { name: 'Konsultasi IMS (ISO & SMK3)', desc: 'Integrasi ISO 45001, 9001 & 14001', href: '/konsultasi-integrated-management-system/' },
  { name: 'Audit Kepatuhan Regulasi K3', desc: 'Legal register & verifikasi izin', href: '/audit-kepatuhan-regulasi-k3/' },
  { name: 'Pengesahan P2K3 & Lisensi P3K', desc: 'Pengurusan kelembagaan Disnaker', href: '/jasa-pengesahan-p2k3-lisensi-p3k/' },
  { name: 'CSMS Kontraktor K3', desc: 'Prakualifikasi & sistem vendor', href: '/contractor-safety-management-system-csms/' },
  { name: 'Executive Safety Leadership', desc: 'Workshop tata kelola direksi & GM', href: '/executive-safety-leadership/' },
  { name: 'Safety Culture Assessment', desc: 'Maturity score & roadmap budaya K3', href: '/safety-culture-assessment/' },
];

const konsultasiEngineering = [
  { name: 'Studi HAZOP / HAZID', desc: 'Identifikasi bahaya proses pabrik', href: '/jasa-konsultasi-hazop/' },
  { name: 'Fire Risk Assessment', desc: 'Audit proteksi & risiko kebakaran', href: '/fire-risk-assessment/' },
  { name: 'Management of Change (MOC)', desc: 'Kendali perubahan & PSSR fasilitas', href: '/management-of-change-k3/' },
  { name: 'Audit Risiko Ergonomi', desc: 'Asesmen Permenaker 5/2018 & stasiun kerja', href: '/penilaian-risiko-ergonomi/' },
  { name: 'Pengendalian Kebisingan', desc: 'Pemetaan dBA & program konversi', href: '/program-pengendalian-kebisingan/' },
  { name: 'Standar Pemilihan APD', desc: 'Kelayakan SNI/ANSI Permenakertrans 08/2010', href: '/alat-pelindung-diri/' },
  { name: 'Materi Safety Talk Harian', desc: 'Topik P5M siap pakai tim lapangan', href: '/materi-safety-talk-harian/' },
];

const regulasiLinks = [
  { name: 'Checklist Audit SMK3 166 Kriteria', desc: 'Instrumen evaluasi PP 50/2012', href: '/downloads/Checklist-Audit-SMK3-166-Kriteria.html' },
  { name: 'Template Formulir JSA Excel', desc: 'Format identifikasi bahaya kerja', href: '/downloads/Formulir-JSA-Job-Safety-Analysis.html' },
  { name: 'Tabel NAB Kebisingan K3', desc: 'Referensi batas pajanan aman', href: '/downloads/Tabel-Nilai-Ambang-Batas-Kebisingan-K3.html' },
  { name: 'Pencegahan Penyakit Akibat Kerja', desc: 'Panduan medis & higiene industri', href: '/penyakit-akibat-kerja/' },
  { name: 'Artikel & Pustaka K3', desc: 'Arsip referensi teknis sejak 2011', href: '/artikel/' },
];
---

<!-- Top Executive Authority Strip -->
<div class="bg-slate-950 text-slate-200 text-xs py-2 px-4 border-b border-slate-800 relative z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <div class="flex items-center gap-2 min-w-0">
      <span class="inline-flex items-center gap-2 font-semibold text-white truncate">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse-glow shrink-0" aria-hidden="true"></span>
        <span>PJK3 Resmi Berlisensi Kemnaker RI &amp; BNSP</span>
      </span>
      <span class="hidden lg:inline text-slate-400 shrink-0">&bull;</span>
      <span class="hidden lg:inline text-slate-300 truncate">Melayani Pelatihan &amp; Audit Seluruh Indonesia</span>
    </div>
    <div class="hidden sm:flex items-center gap-4 shrink-0">
      <a href="mailto:info@konsultank3.com" class="text-slate-300 hover:text-white transition-colors hidden md:inline">
        info@konsultank3.com
      </a>
      <a
        href={waLink('Halo Kak, saya mau konsultasi program pelatihan dan sertifikasi K3 🙏')}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 hover:bg-emerald-500/25 font-bold transition-colors"
      >
        <span>WhatsApp: {WA_DISPLAY}</span>
      </a>
    </div>
  </div>
</div>

<!-- Sticky Bright Frost Executive Navigation -->
<header id="site-header" class="site-header sticky top-0 z-40">
  <div class="header-inner max-w-7xl mx-auto px-3 min-[400px]:px-4 sm:px-6 lg:px-8 h-[4.25rem] flex items-center justify-between gap-2 min-[400px]:gap-4">

    <!-- Corporate Wordmark -->
    <a href="/" class="site-logo flex items-center gap-3 group shrink-0">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-500 flex items-center justify-center text-slate-950 shadow-md shadow-amber-500/25 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div>
        <div class="font-extrabold text-lg sm:text-xl tracking-tight leading-none text-slate-950">
          Konsultan<span class="text-amber-600">K3</span><span class="text-xs text-slate-500 font-semibold">.com</span>
        </div>
        <div class="text-[9px] tracking-[0.14em] text-slate-500 uppercase font-bold mt-1">
          Safety &amp; Compliance Partner
        </div>
      </div>
    </a>

    <!-- Single Semantic Navigation Landmark -->
    <nav class="site-nav flex items-center" aria-label="Navigasi Utama">
      <button
        id="mobile-menu-btn"
        type="button"
        popovertarget="site-menu"
        popovertargetaction="toggle"
        aria-controls="site-menu" aria-label="Menu"
        class="menu-button inline-flex items-center gap-2 px-3 py-2 rounded-xl border border-slate-200 bg-slate-50 hover:bg-slate-100 text-slate-800 text-xs font-bold transition-colors cursor-pointer"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <span class="hidden min-[400px]:inline">Menu</span>
      </button>

      <ul id="site-menu" class="site-menu" popover="auto" data-lenis-prevent>
        <li>
          <a
            href="/"
            aria-current={currentPath === '/' ? 'page' : undefined}
            class={`block px-3.5 py-2 rounded-xl text-sm font-semibold transition-all whitespace-nowrap ${
              currentPath === '/'
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200/80'
                : 'text-slate-700 hover:text-slate-950 hover:bg-slate-100/80'
            }`}
          >
            Beranda
          </a>
        </li>

        <!-- Dropdown 1: Pelatihan K3 Mega-Menu -->
        <li class="nav-dropdown">
          <button
            type="button"
            aria-expanded="false"
            aria-controls="dd-pelatihan"
            popovertarget="dd-pelatihan"
            aria-current={isPelatihanActive ? 'page' : undefined}
            class={`dropdown-trigger w-full flex items-center justify-between lg:justify-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold transition-all whitespace-nowrap cursor-pointer ${
              isPelatihanActive
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200/80'
                : 'text-slate-700 hover:text-slate-950 hover:bg-slate-100/80'
            }`}
          >
            <span>Pelatihan K3</span>
            <svg class="nav-chevron w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>

          <div id="dd-pelatihan" class="dropdown-panel w-full lg:w-[46rem]" data-lenis-prevent>
            <div class="mega-scroll p-3 lg:p-5">
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">
                <div>
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-700 px-2 pb-2 border-b border-slate-100 mb-2">
                    Sertifikasi Kemnaker RI
                  </div>
                  <ul class="space-y-0.5">
                    {kemnakerPrograms.map((item) => (
                      <li>
                        <a href={item.href} class="flex items-center justify-between gap-2 px-2 py-1.5 rounded-lg text-xs font-medium text-slate-700 hover:text-emerald-800 hover:bg-emerald-50/70 transition-colors">
                          <span>{item.name}</span>
                          <span class="text-[10px] font-semibold text-slate-400 shrink-0">{item.tag}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div>
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 px-2 pb-2 border-b border-slate-100 mb-2">
                    Sertifikasi BNSP &amp; Sektor
                  </div>
                  <ul class="space-y-0.5">
                    {bnspPrograms.map((item) => (
                      <li>
                        <a href={item.href} class="flex items-center justify-between gap-2 px-2 py-1.5 rounded-lg text-xs font-medium text-slate-700 hover:text-emerald-800 hover:bg-emerald-50/70 transition-colors">
                          <span>{item.name}</span>
                          <span class="text-[10px] font-semibold text-slate-400 shrink-0">{item.tag}</span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div>
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-700 px-2 pb-2 border-b border-slate-100 mb-2">
                    Program Korporat &amp; Wilayah
                  </div>
                  <ul class="space-y-1.5">
                    {corporatePrograms.map((item) => (
                      <li>
                        <a href={item.href} class="block px-2.5 py-2 rounded-xl bg-slate-50/80 hover:bg-emerald-50/70 border border-slate-200/60 hover:border-emerald-200 transition-colors">
                          <div class="text-xs font-bold text-slate-900">{item.name}</div>
                          <div class="text-[11px] text-slate-500 mt-0.5">{item.desc}</div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="mt-4 pt-3 border-t border-slate-100 flex flex-wrap items-center justify-between gap-2 px-1">
                <span class="text-[11px] font-semibold text-slate-500">SKP &amp; Sertifikat Resmi Kemnaker RI / BNSP</span>
                <a href="/pelatihan/" class="text-xs font-bold text-emerald-700 hover:text-emerald-800 inline-flex items-center gap-1">
                  <span>Lihat Semua Katalog Pelatihan</span>
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        </li>

        <!-- Dropdown 2: Konsultasi & Audit Mega-Menu -->
        <li class="nav-dropdown">
          <button
            type="button"
            aria-expanded="false"
            aria-controls="dd-konsultasi"
            popovertarget="dd-konsultasi"
            aria-current={isKonsultasiActive ? 'page' : undefined}
            class={`dropdown-trigger w-full flex items-center justify-between lg:justify-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold transition-all whitespace-nowrap cursor-pointer ${
              isKonsultasiActive
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200/80'
                : 'text-slate-700 hover:text-slate-950 hover:bg-slate-100/80'
            }`}
          >
            <span>Konsultasi &amp; Audit</span>
            <svg class="nav-chevron w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>

          <div id="dd-konsultasi" class="dropdown-panel w-full lg:w-[36rem]" data-lenis-prevent>
            <div class="mega-scroll p-3 lg:p-5">
              <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
                <div>
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-emerald-700 px-2 pb-2 border-b border-slate-100 mb-2">
                    Sistem Manajemen &amp; Kepatuhan
                  </div>
                  <ul class="space-y-1">
                    {konsultasiSystem.map((item) => (
                      <li>
                        <a href={item.href} class="block px-2.5 py-1.5 rounded-lg hover:bg-emerald-50/70 transition-colors">
                          <div class="text-xs font-bold text-slate-900">{item.name}</div>
                          <div class="text-[11px] text-slate-500">{item.desc}</div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>

                <div>
                  <div class="text-[11px] font-extrabold uppercase tracking-wider text-amber-700 px-2 pb-2 border-b border-slate-100 mb-2">
                    Engineering &amp; Kajian Teknis
                  </div>
                  <ul class="space-y-1">
                    {konsultasiEngineering.map((item) => (
                      <li>
                        <a href={item.href} class="block px-2.5 py-1.5 rounded-lg hover:bg-emerald-50/70 transition-colors">
                          <div class="text-xs font-bold text-slate-900">{item.name}</div>
                          <div class="text-[11px] text-slate-500">{item.desc}</div>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </li>

        <!-- Dropdown 3: Regulasi & Unduhan -->
        <li class="nav-dropdown">
          <button
            type="button"
            aria-expanded="false"
            aria-controls="dd-regulasi"
            popovertarget="dd-regulasi"
            aria-current={isRegulasiActive ? 'page' : undefined}
            class={`dropdown-trigger w-full flex items-center justify-between lg:justify-center gap-1.5 px-3.5 py-2 rounded-xl text-sm font-semibold transition-all whitespace-nowrap cursor-pointer ${
              isRegulasiActive
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200/80'
                : 'text-slate-700 hover:text-slate-950 hover:bg-slate-100/80'
            }`}
          >
            <span>Regulasi &amp; Unduhan</span>
            <svg class="nav-chevron w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M6 9l6 6 6-6"/>
            </svg>
          </button>

          <div id="dd-regulasi" class="dropdown-panel w-full lg:w-[21rem]" data-lenis-prevent>
            <div class="mega-scroll p-3 lg:p-4">
              <div class="text-[11px] font-extrabold uppercase tracking-wider text-slate-600 px-2 pb-2 border-b border-slate-100 mb-2">
                Dokumen &amp; Pustaka K3
              </div>
              <ul class="space-y-1">
                {regulasiLinks.map((item) => (
                  <li>
                    <a href={item.href} class="block px-2.5 py-2 rounded-lg hover:bg-emerald-50/70 transition-colors">
                      <div class="text-xs font-bold text-slate-900">{item.name}</div>
                      <div class="text-[11px] text-slate-500">{item.desc}</div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </li>

        <li>
          <a
            href="/tentang-kami/"
            aria-current={currentPath.startsWith('/tentang-kami') ? 'page' : undefined}
            class={`block px-3.5 py-2 rounded-xl text-sm font-semibold transition-all whitespace-nowrap ${
              currentPath.startsWith('/tentang-kami')
                ? 'bg-emerald-50 text-emerald-800 border border-emerald-200/80'
                : 'text-slate-700 hover:text-slate-950 hover:bg-slate-100/80'
            }`}
          >
            Tentang Kami
          </a>
        </li>

        <!-- Narrow-only Contact & CTA Footer inside Mobile Drawer -->
        <li class="menu-mobile-cta pt-3 mt-2 border-t border-slate-200 space-y-2">
          <a
            href="/kontak/"
            class="block text-center px-4 py-2.5 rounded-xl border border-slate-200 bg-slate-50 text-slate-800 font-bold text-sm"
          >
            Kontak &amp; Lokasi Kantor
          </a>
          <a
            href={waLink('Halo Kak, saya mau konsultasi sertifikasi K3 🙏')}
            target="_blank"
            rel="noopener"
            class="btn-shine flex items-center justify-center gap-2 w-full py-3 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-emerald-600 to-emerald-700 shadow-lg shadow-emerald-600/25"
          >
            <span>Konsultasi Gratis via WhatsApp</span>
          </a>
        </li>
      </ul>
    </nav>

    <!-- Right Action Buttons -->
    <div class="header-actions hidden sm:flex items-center gap-2.5 shrink-0">
      <a
        href="/kontak/"
        aria-current={currentPath.startsWith('/kontak') ? 'page' : undefined}
        class={`hidden xl:inline-flex items-center px-3 py-2 rounded-xl text-sm font-semibold transition-colors ${
          currentPath.startsWith('/kontak')
            ? 'text-emerald-800 bg-emerald-50'
            : 'text-slate-700 hover:text-slate-950 hover:bg-slate-100'
        }`}
      >
        Kontak
      </a>
      <a
        href={waLink('Halo Kak, saya mau konsultasi sertifikasi K3 🙏')}
        target="_blank"
        rel="noopener"
        class="btn-shine hidden sm:inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-bold text-white bg-gradient-to-r from-emerald-600 to-emerald-700 hover:from-emerald-500 hover:to-emerald-600 shadow-md shadow-emerald-600/25 transition-all hover:-translate-y-0.5 active:translate-y-0"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
