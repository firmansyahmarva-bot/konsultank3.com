---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Katalog Pelatihan', href: '/pelatihan/' },
  { name: 'Ahli K3 Umum', href: '/pelatihan-ahli-k3-umum/' },
  { name: 'K3 Kebakaran', href: '/pelatihan-k3-kebakaran/' },
  { name: 'K3 Listrik', href: '/pelatihan-k3-listrik/' },
  { name: 'Ruang Terbatas', href: '/pelatihan-k3-ruang-terbatas/' },
  { name: 'Audit SMK3', href: '/panduan-penerapan-smk3/' },
  { name: 'Tentang Kami', href: '/tentang-kami/' },
];
---

<!-- Top Announcement Bar -->
<div class="bg-slate-950 text-slate-300 text-xs py-2 px-4 border-b border-white/5 relative z-50">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
    <div class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap">
      <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping inline-block"></span>
        Batch Kemnaker
      </span>
      <span class="text-slate-300 text-[11px] sm:text-xs">
        Konsultasi sertifikasi dan pelatihan K3 - hubungi kami via WhatsApp
      </span>
    </div>
    <div class="hidden sm:flex items-center gap-3 text-xs shrink-0">
      <span class="text-slate-400">Hotline Kepatuhan K3:</span>
      <a href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20konsultasi%20program%20K3" 
         target="_blank" 
         rel="noopener" 
         class="text-emerald-400 font-bold hover:text-emerald-300 transition-colors flex items-center gap-1">
        <span>0813-9294-3146</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Blurred Navigation Header -->
<header class="sticky top-0 z-40 bg-slate-950/90 backdrop-blur-md border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-18 flex items-center justify-between gap-4">
    
    <!-- Logo with Sunburst Emblem -->
    <a href="/" class="flex items-center gap-3 text-white transition-opacity hover:opacity-90 group shrink-0">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 flex items-center justify-center text-slate-950 shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          <path d="m9 12 2 2 4-4"/>
        </svg>
      </div>
      <div>
        <div class="font-extrabold text-lg sm:text-xl tracking-tight leading-none text-white">
          Konsultan<span class="text-amber-400">K3</span><span class="text-xs text-slate-400 font-normal">.com</span>
        </div>
        <div class="text-[9px] tracking-widest text-slate-400 uppercase font-medium mt-1">
          Safety & Compliance Partner
        </div>
      </div>
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden xl:flex items-center gap-1">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`px-3 py-1.5 rounded-lg text-sm font-medium transition-all ${
              isActive
                ? 'text-amber-400 bg-white/5 font-semibold'
                : 'text-slate-300 hover:text-white hover:bg-white/5'
            }`}
          >
            {link.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Action Button & Mobile Hamburger -->
    <div class="flex items-center gap-3">
      <a
        href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20konsultasi%20sertifikasi%20K3"
        target="_blank"
        rel="noopener"
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-md shadow-emerald-600/20 transition-all hover:scale-[1.02] active:scale-[0.98]"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Konsultasi Gratis</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="xl:hidden p-2 rounded-lg text-slate-300 hover:text-white hover:bg-white/10 transition-colors"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden xl:hidden bg-slate-950/98 border-b border-white/10 px-4 pt-2 pb-6 space-y-1">
    {navLinks.map((link) => (
      <a
        href={link.href}
        class="block px-3 py-2.5 rounded-lg text-base font-medium text-slate-300 hover:text-white hover:bg-white/5"
      >
        {link.name}
      </a>
    ))}
    <div class="pt-4 border-t border-white/10">
      <a
        href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20konsultasi%20sertifikasi%20K3"
        target="_blank"
        rel="noopener"
        class="flex items-center justify-center gap-2 w-full py-3 rounded-xl text-base font-bold text-white bg-emerald-600 hover:bg-emerald-500 shadow-lg shadow-emerald-600/20"
      >
        <span>Hubungi via WhatsApp (24/7)</span>
      </a>
    </div>
  </div>
</header>

<script>
  function setupMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const hamIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');

    if (btn && menu) {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!isExpanded));
        menu.classList.toggle('hidden');
        hamIcon?.classList.toggle('hidden');
        closeIcon?.classList.toggle('hidden');
      });
    }
  }

  // Support Astro View Transitions page changes
  document.addEventListener('astro:page-load', setupMenu);
</script>
