---
import BaseLayout from './BaseLayout.astro';
import { getPillarForArticle, getRelatedArticles, getPillarById, normalizePath } from '../data/topics.js';
import { waLink } from '../data/contact.js';

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  canonical?: string;
  publishDate?: string;
  updatedDate?: string;
  updated?: string;
  summary?: string;
  category?: string;
  readTime?: string;
  pillarId?: string;
}

const {
  title,
  metaTitle,
  description,
  canonical = Astro.url.pathname,
  publishDate = '2026-10-29',
  updatedDate,
  updated,
  summary,
  category = 'Panduan & Kepatuhan K3',
  readTime = '5 menit baca',
  pillarId
} = Astro.props;

const cleanPath = normalizePath(canonical);
const fullCanonical = canonical.startsWith('http') ? canonical : `https://konsultank3.com${cleanPath.endsWith('/') ? cleanPath : cleanPath}`;

// Determine pillar association
const pillarFromProp = pillarId ? getPillarById(pillarId) : null;
const detectedPillar = getPillarForArticle(cleanPath);
const pathSlug = cleanPath.replace(/^\/|\/$/g, '');
const isPillarPage = Boolean(getPillarById(pathSlug));
const activePillar = pillarFromProp || detectedPillar || (isPillarPage ? getPillarById(pathSlug) : null);

// Effective updated date: only when updated prop is explicitly passed or for pillar pages
const effectiveUpdated = updated || (isPillarPage ? 'November 2026' : null);

// Related articles for spokes
const relatedArticles = (!isPillarPage && activePillar) ? getRelatedArticles(cleanPath, 3) : [];

// Determine final page title (must not exceed 60 chars)
const computedTitle = metaTitle || (
  title.includes('Konsultan K3')
    ? title
    : (title.length + 24 <= 60 ? `${title} » Konsultan K3 Indonesia` : title)
);

const breadcrumbElements = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Beranda",
    "item": "https://konsultank3.com/"
  }
];

if (isPillarPage) {
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": 2,
    "name": title,
    "item": fullCanonical
  });
} else if (activePillar) {
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": 2,
    "name": activePillar.shortName,
    "item": `https://konsultank3.com${activePillar.path}`
  });
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": 3,
    "name": title,
    "item": fullCanonical
  });
} else {
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": 2,
    "name": category,
    "item": "https://konsultank3.com/pelatihan/"
  });
  breadcrumbElements.push({
    "@type": "ListItem",
    "position": 3,
    "name": title,
    "item": fullCanonical
  });
}

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": breadcrumbElements
    },
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "mainEntityOfPage": fullCanonical,
      ...(publishDate ? { "datePublished": publishDate } : {}),
      ...(effectiveUpdated ? { "dateModified": "2026-11-10" } : {}),
      "author": {
        "@type": "Organization",
        "name": "Tim Redaksi KonsultanK3.com",
        "url": "https://konsultank3.com/tentang-kami/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "logo": {
          "@type": "ImageObject",
          "url": "https://konsultank3.com/assets/images/logo.png"
        }
      }
    }
  ]
};
---

<BaseLayout
  title={computedTitle}
  description={description}
  canonical={canonical}
  type="article"
  schema={articleSchema}
  presetMessage={`Halo KonsultanK3, saya sedang membaca artikel "${title}" dan ingin konsultasi lebih lanjut.`}
>
  <!-- Hero Article Header Banner -->
  <section class="bg-slate-950 text-white pt-12 pb-16 border-b border-white/10 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-30"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        {isPillarPage ? (
          <span class="text-amber-400 font-semibold">{title}</span>
        ) : activePillar ? (
          <>
            <a href={activePillar.path} class="hover:text-amber-400 transition-colors font-medium">{activePillar.shortName}</a>
            <span>/</span>
            <span class="text-slate-300 truncate max-w-[200px] sm:max-w-xs">{title}</span>
          </>
        ) : (
          <>
            <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">{category}</a>
            <span>/</span>
            <span class="text-slate-300 truncate max-w-[200px] sm:max-w-xs">{title}</span>
          </>
        )}
      </nav>

      <!-- Badge strip -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          {activePillar ? activePillar.shortName : category}
        </span>
        <span class="text-xs text-slate-400 flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          {readTime}
        </span>
        {effectiveUpdated && (
          <span class="text-xs text-emerald-400 font-medium flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Terakhir diperbarui: {effectiveUpdated}
          </span>
        )}
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight font-serif">
        {title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl font-sans">
        {description}
      </p>

      <!-- Author / Reviewer Meta Card -->
      <div class="mt-8 pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-slate-800 border border-white/15 flex items-center justify-center text-amber-400 font-bold text-sm">
            K3
          </div>
          <div>
            <div class="text-sm font-semibold text-white">Tim Redaksi KonsultanK3.com</div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Article Body & Conversion Sidebar Grid -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Key Executive Takeaways Card (optional summary) -->
      {summary && (
        <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200/80 mb-10 shadow-sm not-prose">
          <div class="flex items-center gap-2 text-amber-900 font-bold text-sm uppercase tracking-wider mb-2">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
            Ringkasan Eksekutif
          </div>
          <p class="text-sm text-amber-950 leading-relaxed">
            {summary}
          </p>
        </div>
      )}

      {/* Up-link to pillar guide */}
      {!isPillarPage && activePillar && (
        <div class="mb-8 p-4 rounded-2xl bg-emerald-50 border border-emerald-200/90 text-emerald-950 text-sm flex flex-col sm:flex-row sm:items-center justify-between gap-4 not-prose shadow-sm">
          <div class="space-y-0.5">
            <span class="text-[11px] uppercase tracking-wider font-bold text-emerald-700 block">Panduan Induk K3</span>
            <p class="text-xs sm:text-sm text-slate-700">
              Artikel ini merupakan bagian dari rujukan pilar <strong class="text-slate-900">{activePillar.title}</strong>.
            </p>
          </div>
          <a
            href={activePillar.path}
            class="px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-sm hover:scale-105 shrink-0 text-center"
          >
            {activePillar.anchorText} &rarr;
          </a>
        </div>
      )}

      <!-- Main Prose Content -->
      <article class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:text-slate-900 prose-headings:tracking-tight prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-p:text-slate-700 prose-p:leading-relaxed prose-p:text-base prose-li:text-slate-700 prose-strong:text-slate-900 prose-img:rounded-2xl">
        <slot />
      </article>

      <!-- Up-Link to Pillar Guide at bottom of content -->
      {!isPillarPage && activePillar && (
        <div class="mt-10 p-5 rounded-2xl bg-gradient-to-r from-emerald-900 to-slate-900 text-white shadow-md not-prose flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <span class="text-[11px] uppercase tracking-wider text-emerald-400 font-bold block mb-1">Rujukan Komprehensif</span>
            <h4 class="font-serif font-bold text-base text-white">{activePillar.title}</h4>
            <p class="text-xs text-slate-300 mt-0.5">Pelajari pedoman regulasi resmi, instrumen penilaian, dan prosedur implementasi teknis.</p>
          </div>
          <a
            href={activePillar.path}
            class="px-5 py-2.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider transition-all shrink-0 shadow"
          >
            Buka Panduan Lengkap &rarr;
          </a>
        </div>
      )}

      <!-- Related Articles (3 links, same pillar) -->
      {!isPillarPage && relatedArticles.length > 0 && activePillar && (
        <section class="mt-12 pt-8 border-t border-slate-200 not-prose">
          <div class="flex items-center justify-between mb-6">
            <div>
              <span class="text-[11px] uppercase tracking-wider text-amber-600 font-bold block mb-1">Eksplorasi Topik</span>
              <h3 class="font-serif text-xl sm:text-2xl font-bold text-slate-900">
                Artikel Terkait dalam {activePillar.shortName}
              </h3>
            </div>
            <a href={activePillar.path} class="text-xs font-bold text-emerald-600 hover:text-emerald-700">
              Lihat Semua &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {relatedArticles.map((rel) => (
              <a
                href={rel.path}
                class="group p-5 rounded-2xl bg-white border border-slate-200/80 hover:border-amber-400 hover:shadow-lg transition-all flex flex-col justify-between"
              >
                <div>
                  <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block mb-1.5">
                    {activePillar.shortName}
                  </span>
                  <h4 class="font-serif font-bold text-sm text-slate-900 group-hover:text-amber-600 transition-colors leading-snug line-clamp-2 mb-2">
                    {rel.title}
                  </h4>
                  <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
                    {rel.desc}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-slate-100 flex items-center text-xs font-bold text-emerald-600 group-hover:text-emerald-700">
                  <span>Baca ulasan</span> &rarr;
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      <!-- In-Article Consultation Box -->
      <div class="mt-12 p-8 rounded-3xl bg-gradient-to-br from-slate-900 to-slate-950 text-white shadow-xl border border-white/10 relative overflow-hidden not-prose">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-2 max-w-lg">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              Konsultasi & Sertifikasi Terakreditasi
            </span>
            <h3 class="text-2xl font-bold font-serif text-white">Butuh Bimbingan Teknis atau Sertifikasi Tim Anda?</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Konsultasikan kebutuhan pelatihan personil, implementasi SMK3, atau in-house training perusahaan Anda langsung bersama tim ahli K3.
            </p>
          </div>
          <a
            href={waLink(`Halo KonsultanK3, saya ingin konsultasi teknis terkait topik: ${title}`)}
            target="_blank"
            rel="noopener"
            class="px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-lg shadow-emerald-600/30 transition-all hover:scale-105 shrink-0 flex items-center gap-2"
          >
            <span>Hubungi via WhatsApp</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Back to Library Navigation -->
      <div class="mt-10 pt-6 border-t border-slate-200 flex items-center justify-between not-prose">
        <a href="/" class="text-sm font-semibold text-slate-600 hover:text-slate-900 flex items-center gap-2">
          &larr; Kembali ke Beranda
        </a>
        <a href="/pelatihan/" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 flex items-center gap-1">
          <span>Lihat Semua Pelatihan K3</span> &rarr;
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
