---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  publishDate?: string;
  category?: string;
  readTime?: string;
}

const {
  title,
  description,
  canonical = Astro.url.pathname,
  publishDate = '2026-10-29',
  category = 'Panduan & Kepatuhan K3',
  readTime = '5 menit baca'
} = Astro.props;

const fullCanonical = canonical.startsWith('http') ? canonical : `https://konsultank3.com${canonical}`;

const articleSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Beranda",
          "item": "https://konsultank3.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Katalog Edukasi K3",
          "item": "https://konsultank3.com/pelatihan/"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": title,
          "item": fullCanonical
        }
      ]
    },
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "mainEntityOfPage": fullCanonical,
      "datePublished": publishDate,
      "dateModified": "2026-11-05",
      "author": {
        "@type": "Organization",
        "name": "Tim Ahli K3 PT Wahana Totalita Konsultan",
        "url": "https://wahanatotalita.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "logo": {
          "@type": "ImageObject",
          "url": "https://konsultank3.com/assets/images/logo.png"
        }
      }
    }
  ]
};
---

<BaseLayout
  title={`${title} » Konsultan K3 Indonesia`}
  description={description}
  canonical={canonical}
  type="article"
  schema={articleSchema}
  presetMessage={`Halo KonsultanK3, saya sedang membaca artikel "${title}" dan ingin konsultasi lebih lanjut.`}
>
  <!-- Hero Article Header Banner -->
  <section class="bg-slate-950 text-white pt-12 pb-16 border-b border-white/10 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-30"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
      
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">{category}</a>
        <span>/</span>
        <span class="text-slate-300 truncate max-w-[200px] sm:max-w-xs">{title}</span>
      </nav>

      <!-- Badge strip -->
      <div class="flex flex-wrap items-center gap-3 mb-4">
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          {category}
        </span>
        <span class="text-xs text-slate-400 flex items-center gap-1.5">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
          {readTime}
        </span>
        <span class="text-xs text-slate-400 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
          Terverifikasi Tim K3 Senior
        </span>
      </div>

      <!-- Main Headline -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight font-serif">
        {title}
      </h1>

      <p class="mt-4 text-base sm:text-lg text-slate-300 leading-relaxed max-w-3xl font-sans">
        {description}
      </p>

      <!-- Author / Reviewer Meta Card -->
      <div class="mt-8 pt-6 border-t border-white/10 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-full bg-slate-800 border border-white/15 flex items-center justify-center text-amber-400 font-bold text-sm">
            K3
          </div>
          <div>
            <div class="text-sm font-semibold text-white">Dewan Redaksi K3 & Kepatuhan Regulasi</div>
            <div class="text-xs text-slate-400">Ditinjau bersama Instruktur PJK3 PT Wahana Totalita</div>
          </div>
        </div>
        <div class="text-xs text-slate-400">
          Standar: <strong class="text-slate-300">Kemnaker RI & Standar SNI</strong>
        </div>
      </div>

    </div>
  </section>

  <!-- Article Body & Conversion Sidebar Grid -->
  <section class="py-12 bg-slate-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      
      <!-- Key Executive Takeaways Card -->
      <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200/80 mb-10 shadow-sm">
        <div class="flex items-center gap-2 text-amber-900 font-bold text-sm uppercase tracking-wider mb-2">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
          Ringkasan Eksekutif & Kepatuhan
        </div>
        <p class="text-sm text-amber-950 leading-relaxed">
          Penerapan standar keselamatan kerja ini merupakan bagian integral dari pemenuhan audit SMK3 (PP 50/2012) dan UU No. 1 Tahun 1970 untuk mencegah kecelakaan fatalitas serta kerugian operasional perusahaan.
        </p>
      </div>

      <!-- Main Prose Content -->
      <article class="prose prose-slate max-w-none prose-headings:font-serif prose-headings:text-slate-900 prose-headings:tracking-tight prose-h2:text-2xl prose-h2:sm:text-3xl prose-h2:mt-10 prose-h2:mb-4 prose-h3:text-xl prose-p:text-slate-700 prose-p:leading-relaxed prose-p:text-base prose-li:text-slate-700 prose-strong:text-slate-900 prose-img:rounded-2xl">
        <slot />
      </article>

      <!-- In-Article Consultation & Lead Funnel Box -->
      <div class="mt-14 p-8 rounded-3xl bg-gradient-to-br from-slate-900 to-slate-950 text-white shadow-xl border border-white/10 relative overflow-hidden">
        <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
          <div class="space-y-2 max-w-lg">
            <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
              Konsultasi & Sertifikasi Terakreditasi
            </span>
            <h3 class="text-2xl font-bold font-serif text-white">Butuh Bimbingan Teknis atau Sertifikasi Tim Anda?</h3>
            <p class="text-sm text-slate-300 leading-relaxed">
              Konsultasikan kebutuhan pelatihan personil, implementasi SMK3, atau in-house training perusahaan Anda langsung bersama tim PJK3 resmi Kemnaker RI.
            </p>
          </div>
          <a
            href={`https://wa.me/6281392943146?text=${encodeURIComponent(`Halo KonsultanK3, saya ingin konsultasi teknis terkait topik: ${title}`)}`}
            target="_blank"
            rel="noopener"
            class="px-6 py-3.5 rounded-2xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-lg shadow-emerald-600/30 transition-all hover:scale-105 shrink-0 flex items-center gap-2"
          >
            <span>Hubungi via WhatsApp</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <!-- Back to Library Navigation -->
      <div class="mt-10 pt-6 border-t border-slate-200 flex items-center justify-between">
        <a href="/" class="text-sm font-semibold text-slate-600 hover:text-slate-900 flex items-center gap-2">
          &larr; Kembali ke Beranda
        </a>
        <a href="/pelatihan/" class="text-sm font-semibold text-emerald-600 hover:text-emerald-700 flex items-center gap-1">
          <span>Lihat Semua Pelatihan K3</span> &rarr;
        </a>
      </div>

    </div>
  </section>
</BaseLayout>
