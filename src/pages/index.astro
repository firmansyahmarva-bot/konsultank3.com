  <!-- Interactive script for Hero Quick Quote -->
  <script>
    import { WA_NUMBER } from '../data/contact.js';

    function setupQuoteForm() {
      const form = document.getElementById('hero-quote-form');
      if (form) {
        form.addEventListener('submit', (e) => {
          e.preventDefault();
          const prog = (document.getElementById('hero-prog') as HTMLSelectElement)?.value;
          const qty = (document.getElementById('hero-qty') as HTMLSelectElement)?.value;
          const msg = `Halo KonsultanK3, saya ingin konsultasi pendaftaran program: ${prog} untuk ${qty}. Mohon info jadwal terdekat, silabus lengkap, dan penawaran biayanya.`;
          window.open(`https://wa.me/${WA_NUMBER}?text=${encodeURIComponent(msg)}`, '_blank');
        });
      }
    }
    document.addEventListener('astro:page-load', setupQuoteForm);
  </script>
