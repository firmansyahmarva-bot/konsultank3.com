---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { waLink } from '../../data/contact.js';

const units = [
  { code: 'E.370000.001.01', title: 'Mengidentifikasi Sumber Pencemaran Air Limbah', desc: 'Pemetaan neraca air industri, titik buang (outfall), debit influen-efluen, dan karakteristik air limbah.' },
  { code: 'E.370000.002.01', title: 'Menentukan Karakteristik Sumber Pencemaran Air Limbah', desc: 'Analisis parameter kunci COD, BOD, TSS, minyak lemak, pH, dan logam berat sesuai baku mutu Permen LHK.' },
  { code: 'E.370000.003.01', title: 'Menilai Tingkat Pencemaran Air Limbah', desc: 'Kalkulasi beban pencemaran air limbah harian dan kepatuhan baku mutu terhadap izin pembuangan air limbah (IPLC).' },
  { code: 'E.370000.004.01', title: 'Melakukan Pengolahan Air Limbah (Fisika, Kimia & Biologi)', desc: 'Pengendalian unit operasi koagulasi-flokulasi, sedimentasi, aerasi lumpur aktif (activated sludge), dan filtrasi.' },
  { code: 'E.370000.007.01', title: 'Melakukan Perawatan Instalasi Pengolahan Air Limbah (IPAL)', desc: 'Pembersihan bar screen, kalibrasi sensor pH/DO meter online, perawatan pompa submersible, dan blower aerasi.' },
  { code: 'E.370000.009.01', title: 'Mengidentifikasi Bahaya & Tanggap Darurat di IPAL', desc: 'Mitigasi gas H2S beracun di bak ekualisasi, tumpahan bahan kimia PAC/polimer, dan prosedur keselamatan ruang terbatas.' }
];

const faqs = [
  {
    q: 'Apa perbedaan skema PPPA dan POPAL dalam sertifikasi BNSP?',
    a: 'PPPA (Penanggung Jawab Pengendalian Pencemaran Air) ditujukan bagi level manajerial, supervisor lingkungan, atau kepala departemen HSE yang bertanggung jawab atas perencanaan, perizinan, dan kepatuhan regulasi lingkungan. Sedangkan POPAL (Penanggung Jawab Operasional Pengolahan Air Limbah) ditujukan bagi operator teknis yang mengoperasikan unit IPAL sehari-hari di lapangan.'
  },
  {
    q: 'Apakah sertifikat yang diterbitkan resmi berlogo Garuda BNSP?',
    a: 'Ya, seluruh asesmen kompetensi diselenggarakan oleh Lembaga Sertifikasi Profesi (LSP) terakreditasi Badan Nasional Sertifikasi Profesi (BNSP) dengan sertifikat kompetensi berlogo Garuda Emas yang diakui secara nasional di Indonesia.'
  },
  {
    q: 'Apa saja berkas persyaratan portofolio yang perlu disiapkan peserta?',
    a: 'Peserta perlu menyiapkan salinan ijazah, KTP, CV/riwayat kerja, surat rekomendasi/penugasan perusahaan, foto operasional di unit IPAL, SOP pengolahan air limbah, dan hasil uji laboratorium efluen berkala (LHU).'
  }
];

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Sertifikasi BNSP PPPA & POPAL", "item": "https://konsultank3.com/pelatihan-pppa-popal/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan dan Sertifikasi BNSP PPPA & POPAL Air Limbah Industri",
      "description": "Sertifikasi kompetensi resmi BNSP untuk Penanggung Jawab Pengendalian Pencemaran Air (PPPA) dan Operasional IPAL (POPAL) sesuai SKKNI No. 187 Tahun 2016.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout
  title="Sertifikasi BNSP PPPA & POPAL Air Limbah"
  description="Pelatihan & sertifikasi resmi BNSP PPPA dan POPAL (Operasional IPAL) sesuai SKKNI 187/2016. Pembekalan intensif & bimbingan pra-uji."
  canonical="/pelatihan-pppa-popal/"
  schema={courseSchema}
  presetMessage="Halo KonsultanK3, saya ingin konsultasi pendaftaran sertifikasi BNSP PPPA / POPAL air limbah."
>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">BNSP PPPA &amp; POPAL</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold border border-blue-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
            Standar Kompetensi Kerja Nasional Indonesia &bull; SKKNI No. 187/2016
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Sertifikasi BNSP <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">PPPA &amp; POPAL</span> Air Limbah Industri
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Raih sertifikat kompetensi resmi <strong>Badan Nasional Sertifikasi Profesi (BNSP)</strong> untuk Penanggung Jawab Pengendalian Pencemaran Air (PPPA) dan Penanggung Jawab Operasional IPAL (POPAL). Penuhi PROPER KLHK dan regulasi baku mutu air limbah industri.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin info jadwal dan biaya sertifikasi BNSP PPPA POPAL")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Daftar Batch Terdekat &rarr;
            </a>
            <a
              href="#unit-kompetensi"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Unit Kompetensi
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi</span>
              <p class="text-white font-bold text-sm">3 Hari (Bimtek + Uji)</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Metode</span>
              <p class="text-white font-bold text-sm">Online / Hybrid</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Sertifikat</span>
              <p class="text-white font-bold text-sm">Garuda Emas BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Masa Berlaku</span>
              <p class="text-emerald-400 font-bold text-sm">3 Tahun Nasional</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pembekalan Asesmen Portofolio Sertifikasi BNSP PPPA Air Limbah"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-cyan-500 text-slate-950 mb-2">
                PROPER &amp; Baku Mutu KLHK
              </span>
              <div class="text-lg font-bold">Kepatuhan Lingkungan Industri</div>
              <p class="text-xs text-slate-300 mt-1">Bimbingan penyusunan dokumen portofolio teknis dan simulasi wawancara bersama Asesor BNSP resmi.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500 text-white flex items-center justify-center font-bold text-lg">
              📜
            </div>
            <div>
              <div class="text-xs font-bold text-white">LSP Lingkungan Terakreditasi</div>
              <div class="text-[10px] text-slate-400">Lisensi Resmi BNSP RI</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">💧</div>
            <div>
              <div class="text-xs font-bold text-white">Skema PPPA &amp; POPAL</div>
              <div class="text-[10px] text-slate-400">Pengendali &amp; Operator IPAL</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <div class="lg:col-span-8 space-y-12">
        
        <!-- Overview Card -->
        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900">
            Mengapa Personel IPAL Wajib Bersertifikat BNSP?
          </h2>
          <p class="text-base text-slate-700 leading-relaxed font-sans">
            Berdasarkan Peraturan Menteri Lingkungan Hidup dan Kehutanan (Permen LHK) dan ketentuan penilaian PROPER, industri manufaktur, tekstil, makanan-minuman, farmasi, rumah sakit, dan kelapa sawit diwajibkan memiliki personel yang kompeten dan tersertifikasi dalam mengoperasikan unit pengolahan air limbah (IPAL). Sertifikasi BNSP menjamin personel memiliki keterampilan teruji dalam menjaga air efluen tidak mencemari badan air umum.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-700 block mb-1">Skema PPPA (Manajerial)</span>
              <p class="text-xs text-slate-600 leading-relaxed">Fokus pada perencanaan strategis pengolahan air limbah, pemantauan debit &amp; beban pencemaran, koordinasi laboratorium eksternal, dan pelaporan perizinan lingkungan.</p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 block mb-1">Skema POPAL (Operasional)</span>
              <p class="text-xs text-slate-600 leading-relaxed">Fokus pada pengoperasian pompa, bak sedimentasi, aerator, dosing kimia koagulan (PAC/tawas/polimer), pengecekan sludge volume (SV30), dan pemeliharaan alat.</p>
            </div>
          </div>
        </div>

        <!-- Unit Kompetensi SKKNI -->
        <div id="unit-kompetensi" class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6 scroll-mt-24">
          <h3 class="text-2xl font-bold font-serif text-slate-900">
            Daftar Unit Kompetensi SKKNI No. 187 Tahun 2016
          </h3>
          
          <div class="space-y-4">
            {units.map((u, idx) => (
              <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono font-bold text-blue-700 bg-blue-100 px-2 py-0.5 rounded-md">{u.code}</span>
                    <span class="text-xs font-bold text-slate-500">Unit {idx + 1}</span>
                  </div>
                  <h4 class="font-bold text-slate-900 text-base">{u.title}</h4>
                  <p class="text-xs text-slate-600 leading-relaxed">{u.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- FAQs -->
        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
          <h3 class="text-2xl font-bold font-serif text-slate-900">
            Pertanyaan Umum Seputar Uji BNSP
          </h3>
          
          <div class="space-y-3">
            {faqs.map(f => (
              <details class="group p-4 rounded-2xl bg-slate-50 border border-slate-200 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-sm">
                  <span>{f.q}</span>
                  <span class="ml-2 text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="mt-3 text-xs text-slate-600 leading-relaxed pt-2 border-t border-slate-200">
                  {f.a}
                </p>
              </details>
            ))}
          </div>
        </div>

      </div>

      <!-- Sticky Sidebar -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        
        <div class="p-6 rounded-3xl bg-slate-900 text-white space-y-4 shadow-xl">
          <div class="text-xs font-bold uppercase tracking-wider text-amber-400">Pendaftaran Batch</div>
          <h4 class="text-lg font-bold font-serif">Jadwal Sertifikasi BNSP Terdekat</h4>
          <div class="space-y-2 text-xs text-slate-300">
            <div class="flex justify-between border-b border-white/10 pb-1.5">
              <span>Metode:</span>
              <strong class="text-white">Online Pra-Uji + Uji Asesor</strong>
            </div>
            <div class="flex justify-between border-b border-white/10 pb-1.5">
              <span>Output:</span>
              <strong class="text-emerald-400">Sertifikat Garuda BNSP</strong>
            </div>
            <div class="flex justify-between">
              <span>Status:</span>
              <strong class="text-cyan-400">Buka Kuota Peserta</strong>
            </div>
          </div>

          <a
            href={waLink("Halo KonsultanK3, saya ingin mendaftar sertifikasi BNSP PPPA POPAL")}
            target="_blank"
            rel="noopener"
            class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg transition-all"
          >
            <span>Daftar via WhatsApp</span> &rarr;
          </a>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Sertifikasi Lingkungan Terkait</div>
          <div class="space-y-2 text-sm font-semibold text-slate-800">
            <a href="/pelatihan-pppu-poippu/" class="block hover:text-emerald-600">💨 Sertifikasi BNSP PPPU &amp; POIPPU (Udara)</a>
            <a href="/panduan-penerapan-smk3/" class="block hover:text-emerald-600">📋 Audit SMK3 &amp; ISO 14001</a>
            <a href="/pelatihan-ahli-k3-umum/" class="block hover:text-emerald-600">🎓 Pembinaan Ahli K3 Umum</a>
          </div>
        </div>

      </aside>

    </div>
  </main>
</BaseLayout>
