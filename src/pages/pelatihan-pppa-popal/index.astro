---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { batches } from '../../data/batches.js';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const batch = batches.pppa;

const title = "Sertifikasi BNSP PPPA & POPAL Air Limbah";
const description = "Pelatihan & sertifikasi resmi BNSP PPPA dan POPAL Operasional IPAL sesuai SKKNI 187/2016. Pembekalan intensif, bimbingan portofolio, dan uji kompetensi.";
const canonical = "/pelatihan-pppa-popal/";

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Sertifikasi BNSP PPPA & POPAL", "item": "https://konsultank3.com/pelatihan-pppa-popal/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan dan Sertifikasi BNSP PPPA & POPAL Air Limbah Industri",
      "description": "Sertifikasi kompetensi resmi BNSP untuk Penanggung Jawab Pengendalian Pencemaran Air (PPPA) dan Penanggung Jawab Operasional IPAL (POPAL) sesuai SKKNI No. 187 Tahun 2016.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={courseSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">BNSP PPPA &amp; POPAL</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold border border-blue-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
            Standar Kompetensi Kerja Nasional Indonesia &bull; SKKNI No. 187/2016
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Sertifikasi BNSP <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">PPPA &amp; POPAL</span> Air Limbah Industri
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Raih sertifikat kompetensi resmi <strong>Badan Nasional Sertifikasi Profesi (BNSP)</strong> untuk Penanggung Jawab Pengendalian Pencemaran Air (PPPA) dan Penanggung Jawab Operasional IPAL (POPAL). Penuhi PROPER KLHK dan regulasi baku mutu air limbah industri.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi Sertifikasi BNSP PPPA dan POPAL Air Limbah")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi WhatsApp Resmi &rarr;
            </a>
            <a
              href="#jenjang-pelatihan"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Skema PPPA &amp; POPAL
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Skema</span>
              <p class="text-white font-bold text-sm">PPPA &amp; POPAL</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Standar</span>
              <p class="text-white font-bold text-sm">SKKNI 187/2016</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen</span>
              <p class="text-white font-bold text-sm">Garuda Emas BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kualifikasi</span>
              <p class="text-emerald-400 font-bold text-sm">LSP Lingkungan</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pembekalan Asesmen Portofolio Sertifikasi BNSP PPPA Air Limbah"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-cyan-500 text-slate-950 mb-2">
                PROPER &amp; Baku Mutu KLHK
              </span>
              <div class="text-lg font-bold">Kepatuhan Lingkungan Industri</div>
              <p class="text-xs text-slate-300 mt-1">Bimbingan penyusunan dokumen portofolio teknis dan simulasi wawancara bersama Asesor BNSP resmi.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500 text-white flex items-center justify-center font-bold text-lg">
              📜
            </div>
            <div>
              <div class="text-xs font-bold text-white">LSP Lingkungan Terakreditasi</div>
              <div class="text-[10px] text-slate-400">Lisensi Resmi BNSP RI</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">💧</div>
            <div>
              <div class="text-xs font-bold text-white">Skema PPPA &amp; POPAL</div>
              <div class="text-[10px] text-slate-400">Pengendali &amp; Operator IPAL</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Article Content Column -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section 1: Apa itu Sertifikasi BNSP PPPA & POPAL -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Pengenalan Program</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Apa itu Sertifikasi BNSP PPPA &amp; POPAL</h2>
          </div>
          <p class="text-base sm:text-lg text-slate-700 font-light leading-relaxed">
            Sertifikasi BNSP PPPA dan POPAL adalah program sertifikasi kompetensi profesi resmi berskala nasional yang diselenggarakan melalui Lembaga Sertifikasi Profesi (LSP) terlisensi Badan Nasional Sertifikasi Profesi (BNSP) guna memberikan pengakuan formal atas keterampilan, pengetahuan, serta sikap kerja personel penanggung jawab pengendalian pencemaran air dan operator Instalasi Pengolahan Air Limbah (IPAL) di fasilitas industri. Sertifikat kompetensi yang diterbitkan berlambang Garuda Emas dan diakui secara legal di seluruh wilayah Negara Kesatuan Republik Indonesia.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Pengelolaan air limbah industri merupakan instrumen penting dalam menjaga kelestarian ekosistem perairan dan mematuhi baku mutu lingkungan hidup. Buangan air limbah cair yang tidak memenuhi standar baku mutu dapat menyebabkan pencemaran sungai, penurunan kualitas air tanah, sanksi administratif penghentian operasional pabrik, hingga tuntutan pidana lingkungan. Keberadaan personel pengelola air limbah yang kompeten menjamin unit operasi fisik, kimia, dan biologi di IPAL berjalan stabil dan efisien dalam mendegradasi polutan berbahaya.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kewajiban kepemilikan personel bersertifikat kompetensi pengelolaan air limbah dipersyaratkan oleh regulasi Kementerian Lingkungan Hidup dan Kehutanan (KLHK) serta menjadi indikator penilaian mutlak dalam Program Penilaian Peringkat Kinerja Perusahaan dalam Pengelolaan Lingkungan Hidup (PROPER). Skema ini mengacu pada Standar Kompetensi Kerja Nasional Indonesia (SKKNI) No. 187 Tahun 2016 bidang Pengelolaan Limbah Industri, memastikan industri memiliki penanggung jawab manajerial dan operator teknis yang andal.
          </p>
          <div class="p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20 space-y-3">
            <h3 class="text-base font-bold text-amber-900">Siapa Saja yang Membutuhkan Sertifikasi Ini?</h3>
            <p class="text-sm text-slate-700 font-light leading-relaxed">
              Sertifikasi profesi air limbah ini ditujukan bagi industri penghasil air buangan proses dan limbah domestik terpadu, antara lain:
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-700 font-light">
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Manajer Lingkungan &amp; HSE:</strong> Penanggung jawab penyusunan dokumen persetujuan teknis (Pertek), neraca air, dan pemenuhan baku mutu IPLC.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Operator &amp; Teknisi IPAL Lapangan:</strong> Bertugas mengoperasikan bak ekualisasi, aerator lumpur aktif, dosing bahan kimia, dan filtrasi.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pabrik Tekstil, Makanan-Minuman &amp; Sawit:</strong> Industri dengan beban pencemaran organik BOD, COD, dan minyak lemak tinggi.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Industri Farmasi &amp; Kimia:</strong> Fasilitas dengan karakteristik limbah bahan kimia kompleks dan logam berat berbahaya.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Rumah Sakit &amp; Fasilitas Pelayanan Medis:</strong> Pengelolaan air buangan medis infeksius dan instalasi desinfeksi efluen.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pengelola Kawasan Industri:</strong> Operator Centralized Effluent Treatment Plant (CETP) kawasan industri terpadu.</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Jenjang / Jenis Pelatihan -->
        <section id="jenjang-pelatihan" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Klasifikasi &amp; Tingkatan</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Jenjang / Jenis Pelatihan</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Sertifikasi BNSP bidang air limbah industri diklasifikasikan ke dalam dua skema kompetensi utama yang membedakan jenjang manajerial perencanaan dengan jenjang operasional lapangan:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white text-xs uppercase font-semibold">
                <tr>
                  <th class="py-4 px-4 sm:px-6">Jenjang / Skema</th>
                  <th class="py-4 px-4 sm:px-6">Peran</th>
                  <th class="py-4 px-4 sm:px-6">Tugas utama</th>
                  <th class="py-4 px-4 sm:px-6">Materi kunci</th>
                  <th class="py-4 px-4 sm:px-6">Persyaratan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">PPPA</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Penanggung Jawab Pengendalian Pencemaran Air (Tingkat Manajerial)</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Perencanaan strategis pengolahan air limbah, pemantauan debit &amp; beban pencemaran, perizinan lingkungan, koordinasi uji laboratorium eksternal, dan pelaporan PROPER KLHK</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Identifikasi sumber dan karakteristik air limbah, penilaian tingkat pencemaran, kalkulasi beban pencemaran harian terhadap baku mutu, evaluasi efisiensi IPAL, pelaporan lingkungan</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Pendidikan relevan atau pengalaman kerja terbukti di bidang pengelolaan lingkungan air limbah</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">POPAL</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Penanggung Jawab Operasional Pengolahan Air Limbah (Tingkat Operasional)</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Pengoperasian peralatan fisik, kimia, dan biologi di unit IPAL, dosing bahan kimia koagulan/flokulan, pemantauan lumpur aktif SV30, dan pemeliharaan mesin</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Pengendalian proses koagulasi-flokulasi, sedimentasi, lumpur aktif (activated sludge), pembersihan bar screen, kalibrasi sensor pH/DO meter, mitigasi bahaya H2S &amp; tanggap darurat IPAL</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Pendidikan relevan atau pengalaman operasional unit IPAL di fasilitas industri</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-sm text-slate-600 font-light leading-relaxed">
            Kedua skema ini menjamin tata kelola instalasi pengolahan air limbah terpadu. Pemegang sertifikasi PPPA memimpin perumusan strategi, memantau ketaatan baku mutu efluen sebelum dibuang ke badan air penerima, dan menyusun laporan perizinan. Sementara itu, pemegang sertifikasi POPAL memastikan bahwa pompa submersible, blower aerasi, dan takaran bahan kimia koagulan di lapangan beroperasi dengan optimal tanpa henti.
          </p>
        </section>

        <!-- Section 3: Dasar Hukum -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Landasan Regulasi</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Dasar Hukum</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Penyelenggaraan sertifikasi profesi kompetensi air limbah berpijak pada landasan hukum ketenagakerjaan dan ketentuan lingkungan hidup yang berlaku secara nasional:
          </p>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">UU No. 1 Tahun 1970 tentang Keselamatan Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Undang-Undang Keselamatan Kerja merupakan payung hukum utama yang mewajibkan pencegahan dan pengendalian faktor bahaya lingkungan di tempat kerja. Pada Pasal 3 ayat (1) huruf k diamanatkan kewajiban memelihara kebersihan, kesehatan, dan ketertiban di lingkungan kerja, termasuk pengendalian pembuangan air kotor dan limbah cair agar tidak menimbulkan bahaya kesehatan bagi tenaga kerja dan masyarakat sekitar.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">SKKNI No. 187 Tahun 2016 tentang Pengelolaan Limbah Industri</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Standar Kompetensi Kerja Nasional Indonesia yang ditetapkan oleh Menteri Ketenagakerjaan RI sebagai rujukan baku kompetensi profesi di bidang pengelolaan limbah industri. Standar ini memuat unit-unit kompetensi inti yang harus dikuasai personel air limbah mulai dari identifikasi sumber buangan, karakterisasi polutan, pengendalian unit operasi IPAL, pemeliharaan alat, hingga prosedur tanggap darurat tumpahan kimia dan gas beracun.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Ketentuan Baku Mutu Permen LHK dan Penilaian PROPER KLHK</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Regulasi teknis Kementerian Lingkungan Hidup dan Kehutanan yang menetapkan batas kadar maksimum polutan air limbah yang boleh dialirkan ke badan air permukaan untuk masing-masing sektor industri. Peraturan ini diintegrasikan ke dalam mekanisme penilaian PROPER yang mewajibkan kepemilikan personel bersertifikat kompetensi resmi sebagai bukti pemenuhan ketaatan hukum lingkungan hidup.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 4: Silabus Pembelajaran -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Materi Kurikulum</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Silabus Pembelajaran</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kurikulum pembekalan disusun secara sistematis mengacu pada daftar unit kompetensi SKKNI No. 187 Tahun 2016, mempersiapkan peserta dalam penguasaan teknis operasional dan kelengkapan portofolio uji:
          </p>

          <div class="space-y-5">
            <!-- Topic 1 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">01</span>
                Mengidentifikasi Sumber Pencemaran Air Limbah (Unit E.370000.001.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Unit kompetensi ini membekali peserta dengan keterampilan melakukan pemetaan neraca air industri secara menyeluruh dari titik penggunaan hingga saluran buang. Peserta mempelajari penentuan titik buang (outfall), pengukuran debit influen dan efluen, serta identifikasi proses produksi yang menghasilkan beban cemaran cair. Pemahaman ini krusial dalam menyusun strategi reduksi air limbah langsung dari sumber proses.
              </p>
            </div>

            <!-- Topic 2 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">02</span>
                Menentukan Karakteristik Sumber Pencemaran Air Limbah (Unit E.370000.002.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini mendalami analisis parameter kunci kualitas air buangan industri sesuai baku mutu Permen LHK. Peserta mempelajari parameter organik seperti Chemical Oxygen Demand (COD) dan Biochemical Oxygen Demand (BOD), padatan tersuspensi (Total Suspended Solids / TSS), kandungan minyak dan lemak, derajat keasaman (pH), serta cemaran logam berat. Penguasaan karakterisasi ini menentukan pemilihan teknologi pengolahan limbah yang tepat sasaran.
              </p>
            </div>

            <!-- Topic 3 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">03</span>
                Menilai Tingkat Pencemaran Air Limbah (Unit E.370000.003.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini membahas kalkulasi beban pencemaran air limbah harian, bulanan, dan tahunan berdasarkan volume debit dan konsentrasi polutan. Peserta mengevaluasi kepatuhan beban buangan terhadap dokumen izin pembuangan air limbah (IPLC) atau Persetujuan Teknis (Pertek). Pembahasan mencakup perbandingan kinerja efluen terhadap standar lingkungan hidup guna mencegah terjadinya pelanggaran baku mutu.
              </p>
            </div>

            <!-- Topic 4 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">04</span>
                Melakukan Pengolahan Air Limbah Fisika, Kimia &amp; Biologi (Unit E.370000.004.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peserta mempelajari operasional pengolahan limbah secara terpadu melalui tahapan pengolahan fisik (screening dan sedimentasi), kimiawi (koagulasi dan flokulasi dengan PAC/tawas dan polimer), serta biologi menggunakan proses lumpur aktif (activated sludge). Dilatih pula pengendalian parameter operasional lumpur aktif seperti dissolved oxygen (DO), rasio nutrisi F/M, dan pengendapan lumpur Sludge Volume 30 menit (SV30).
              </p>
            </div>

            <!-- Topic 5 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">05</span>
                Melakukan Perawatan Instalasi Pengolahan Air Limbah / IPAL (Unit E.370000.007.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini menitikberatkan pada prosedur pemeliharaan preventif sarana mekanikal dan elektrikal IPAL. Peserta dibekali teknik pembersihan saringan kasar (bar screen), kalibrasi sensor pH meter dan DO meter online secara berkala, pemeriksaan getaran pompa celup (submersible pump), serta sistem pelumasan mesin blower aerasi. Perawatan berkala menjamin kontinuitas operasi pengolahan air limbah tanpa hambatan teknis.
              </p>
            </div>

            <!-- Topic 6 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">06</span>
                Mengidentifikasi Bahaya &amp; Tanggap Darurat di IPAL (Unit E.370000.009.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini berfokus pada mitigasi bahaya K3 di lingkungan fasilitas IPAL, seperti bahaya gas beracun hidrogen sulfida (H2S) yang terbentuk di bak ekualisasi dan bak pengendap lumpur anaerobik. Peserta dilatih menangani insiden tumpahan bahan kimia koagulan berbahaya, prosedur kerja selamat di ruang terbatas (confined space), serta penggunaan alat pelindung diri pernapasan dan pelampung penyelamat air.
              </p>
            </div>

            <!-- Topic 7 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">07</span>
                Bimbingan Teknis Portofolio Asesmen BNSP
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Sesi pendampingan intensif bagi peserta dalam menginventarisasi dan menyusun dokumen bukti kerja (portofolio) sesuai skema uji BNSP. Peserta dibimbing melengkapi dokumen SOP operasional IPAL, logbook pencatatan debit harian, foto kegiatan operasional di lapangan, serta Laporan Hasil Uji (LHU) laboratorium lingkungan. Bimbingan ini memastikan seluruh bukti kompetensi memenuhi prinsip Valid, Asli, Terkini, dan Memadai (VATM).
              </p>
            </div>

            <!-- Topic 8 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-emerald-500/10 text-emerald-700 font-mono text-xs flex items-center justify-center font-bold">08</span>
                Pelaksanaan Uji Kompetensi Asesor LSP BNSP
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Tahap asesmen kompetensi yang dilaksanakan secara objektif oleh Asesor Kompetensi berlisensi resmi BNSP dari Lembaga Sertifikasi Profesi (LSP) terakreditasi. Uji kompetensi meliputi verifikasi portofolio dokumen kerja, ujian tulis pemahaman unit kompetensi, serta wawancara teknis mendalam. Peserta yang dinyatakan kompeten berhak direkomendasikan untuk menerima sertifikat profesi berlogo Garuda Emas.
              </p>
            </div>
          </div>
        </section>

