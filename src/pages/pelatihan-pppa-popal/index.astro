          <a
            href={waLink("Halo KonsultanK3, saya ingin mendaftar sertifikasi BNSP PPPA POPAL Air Limbah")}
            target="_blank"
            rel="noopener"
            class="w-full inline-flex items-center justify-center gap-2 p-4 rounded-full bg-white text-zinc-900 font-semibold text-xs font-mono uppercase tracking-wider hover:bg-zinc-200 transition-colors shadow-lg"
