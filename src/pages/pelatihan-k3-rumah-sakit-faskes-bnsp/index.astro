---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Pelatihan & Sertifikasi K3 Rumah Sakit & Faskes (K3RS) BNSP";
const description = "Sertifikasi resmi K3 Rumah Sakit & Fasilitas Pelayanan Kesehatan (K3RS) BNSP. Kuasai Permenkes 66/2016, standar akreditasi KARS Pokja MFK, PCRA, ICRA, dan B3 medis.";
const canonical = "/pelatihan-k3-rumah-sakit-faskes-bnsp/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pelatihan K3", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "K3 Rumah Sakit & Faskes", "item": "https://konsultank3.com/pelatihan-k3-rumah-sakit-faskes-bnsp/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan & Uji Kompetensi K3 Rumah Sakit & Fasyankes (K3RS) Sertifikasi BNSP",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "educationalCredentialAwarded": "Sertifikat Kompetensi BNSP - K3 Rumah Sakit (Garuda Emas)",
      "occupationalCategory": "Hospital Safety Officer / K3RS Specialist",
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "Blended / Online / In-House Rumah Sakit",
        "courseWorkload": "PT32H"
      }
    },
    {
      "@type": "Service",
      "name": "Layanan Asistensi Akreditasi Pokja MFK & In-House Training K3RS",
      "serviceType": "Healthcare Safety & Facility Management Certification",
      "description": "Layanan in-house pelatihan dan pendampingan implementasi keselamatan fasilitas rumah sakit dan pemenuhan Pokja MFK akreditasi KARS/Starkes untuk RSUD, RS Swasta, dan Klinik di Jakarta, Surabaya, Semarang, dan kota lainnya.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa itu sertifikasi K3 Rumah Sakit (K3RS) BNSP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sertifikasi K3 Rumah Sakit BNSP adalah pengakuan kompetensi formal berskala nasional bagi praktisi keselamatan rumah sakit. Sertifikasi ini membuktikan kemampuan dalam mengelola risiko unik lingkungan medis, termasuk pengelolaan limbah B3 medis, keselamatan pasien dan tenaga kesehatan, pencegahan kebakaran di ruang rawat inap, penilaian risiko pra-konstruksi (PCRA), serta kesiapsiagaan bencana (Hospital Disaster Plan)."
          }
        },
        {
          "@type": "Question",
          "name": "Apa regulasi wajib yang mendasari penerapan K3 di Rumah Sakit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dasar hukum utamanya adalah Peraturan Menteri Kesehatan (Permenkes) No. 66 Tahun 2016 tentang Keselamatan dan Kesehatan Kerja Rumah Sakit, UU No. 17 Tahun 2023 tentang Kesehatan, dan Standar Akreditasi Rumah Sakit Kemenkes (Starkes/KARS) khususnya Bab Manajemen Fasilitas dan Keselamatan (MFK)."
          }
        },
        {
          "@type": "Question",
          "name": "Apa perbedaan antara PCRA dan ICRA di rumah sakit?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "PCRA (Pre-Construction Risk Assessment) berfokus pada mitigasi bahaya fisik keselamatan selama renovasi atau konstruksi di area rumah sakit (kebisingan, getaran, debu puing, keselamatan jalur evakuasi, dan kontinuitas sistem utilitas). Sedangkan ICRA (Infection Control Risk Assessment) berfokus pada pengendalian transmisi agen infeksi biologis (mikroba/jamur) yang dapat membahayakan pasien rentan selama aktivitas renovasi berlangsung."
          }
        },
        {
          "@type": "Question",
          "name": "Siapa saja yang direkomendasikan mengikuti pelatihan K3RS BNSP ini?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Anggota Komite K3RS, staf Instalasi Pemeliharaan Sarana Rumah Sakit (IPSRS), penanggung jawab Kesling/Sanitasi RS, perawat pengendali infeksi (IPCN), dokter penanggung jawab K3, manajer operasional klinik, serta kepala tata usaha Puskesmas."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah pelatihan ini bisa diselenggarakan secara in-house di rumah sakit kami?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sangat bisa. Kami menyediakan paket In-House Training K3RS yang dirancang khusus untuk rumah sakit Anda di Jakarta, Surabaya, Bandung, Semarang, Medan, Makassar, atau Denpasar, lengkap dengan simulasi walkthrough audit MFK di ruang rawat, IGD, dan IPAL medis."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Header -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Pelatihan K3</a>
        <span>/</span>
        <span class="text-slate-300">K3 Rumah Sakit (K3RS)</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
            Permenkes No. 66/2016 &bull; Akreditasi KARS Pokja MFK
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">K3 Rumah Sakit &amp; Faskes (K3RS)</span> BNSP
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Tingkatkan mutu keselamatan pasien, tenaga medis, dan pengunjung fasyankes. Kuasai instrumen audit Pokja MFK, penilaian risiko pra-konstruksi (PCRA), pengelolaan limbah B3 medis, dan simulasi tanggap darurat bencana rumah sakit.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi pendaftaran Pelatihan & Uji Kompetensi K3RS BNSP. Mohon informasi jadwal, silabus MFK, dan paket in-house rumah sakit.")}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-slate-950 font-bold text-sm shadow-lg shadow-emerald-500/20 transition-all transform hover:-translate-y-0.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Konsultasi Program K3RS
            </a>
            <a
              href="#pokja-mfk"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/10 transition-colors"
            >
              Cek Checklist Pokja MFK
            </a>
          </div>
        </div>

        <!-- Right Column: Overview Card -->
        <div class="lg:col-span-5">
          <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-white/10 backdrop-blur-sm shadow-2xl space-y-6">
            <h3 class="font-serif text-lg font-bold text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              Profil Kualifikasi Sertifikasi K3RS
            </h3>
            
            <dl class="space-y-4 text-xs sm:text-sm">
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Lembaga Sertifikasi</dt>
                <dd class="text-white font-semibold text-right">BNSP via LSP Terakreditasi</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Regulasi Acuan</dt>
                <dd class="text-emerald-300 font-semibold text-right">Permenkes 66/2016 &amp; Starkes</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Instrumen Akreditasi</dt>
                <dd class="text-white font-semibold text-right">Pokja MFK (Manajemen Fasilitas)</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Masa Berlaku Lisensi</dt>
                <dd class="text-white font-semibold text-right">3 Tahun (Berlogo Garuda Emas)</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Format Pelatihan</dt>
                <dd class="text-teal-400 font-semibold text-right">Online / In-House Hospital Walkthrough</dd>
              </div>
            </dl>

            <div class="pt-2">
              <div class="p-3.5 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-200 leading-relaxed">
                <strong>Nilai Akreditasi Rumah Sakit:</strong> Kelengkapan dokumen K3RS, pembentukan Tim K3RS yang bersertifikat kompetensi resmi, serta bukti drill darurat merupakan indikator penilaian primer kelulusan akreditasi Paripurna.
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Navigation Anchor Strip -->
  <div class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm text-xs sm:text-sm font-medium">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto gap-6 py-3 scrollbar-none text-slate-600">
      <a href="#urgensi" class="hover:text-emerald-600 whitespace-nowrap">Urgensi K3RS</a>
      <a href="#pokja-mfk" class="hover:text-emerald-600 whitespace-nowrap text-emerald-700 font-bold">6 Elemen Pokja MFK</a>
      <a href="#pcra-icra" class="hover:text-emerald-600 whitespace-nowrap">PCRA &amp; B3 Medis</a>
      <a href="#unit-kompetensi" class="hover:text-emerald-600 whitespace-nowrap">Unit Uji BNSP</a>
      <a href="#faskes-kota" class="hover:text-emerald-600 whitespace-nowrap">In-House Rumah Sakit</a>
      <a href="#faq" class="hover:text-emerald-600 whitespace-nowrap">FAQ</a>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Urgensi K3RS -->
    <section id="urgensi" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-8 space-y-6 text-slate-700 leading-relaxed text-base">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block">Kepatuhan Hukum &amp; Keselamatan Pasien</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Tantangan Risiko Ekstrem di Fasilitas Pelayanan Kesehatan
        </h2>
        <p>
          Berbeda dari pabrik atau gedung perkantoran biasa, rumah sakit beroperasi 24 jam nonstop dengan populasi rentan: pasien yang tidak dapat bergerak mandiri, bayi di ruang inkubator, peralatan bertegangan tinggi di ruang operasi, serta paparan agen infeksius menular.
        </p>
        <p>
          Berdasarkan <strong>Permenkes No. 66 Tahun 2016</strong>, setiap fasyankes wajib menyelenggarakan keselamatan dan kesehatan kerja secara sistematis. Sertifikasi <strong>Petugas K3RS BNSP</strong> memberikan kompetensi teknis bagi pengelola faskes dalam memastikan bahwa seluruh sarana fisik dan operasional medis memenuhi standar proteksi terbaik.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold text-sm">01</div>
            <h4 class="font-bold text-slate-900 text-sm">Proteksi Tenaga Medis dari PAK &amp; Tertusuk Jarum</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Mencegah insiden tertusuk jarum suntik (*needle stick injury*), penularan infeksi airborne/bloodborne, dan paparan radiasi pengion di ruang radiologi.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-teal-500/10 text-teal-600 flex items-center justify-center font-bold text-sm">02</div>
            <h4 class="font-bold text-slate-900 text-sm">Kesiapan Evakuasi Pasien (Hospital Disaster Plan)</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Merancang sistem tanggap darurat Code Red (kebakaran) dan Code Blue (henti jantung) dengan prosedur evakuasi pasien kritis dari ruang ICU.
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4 p-6 rounded-3xl bg-slate-900 text-white space-y-5 border border-slate-800 shadow-xl">
        <h3 class="font-serif text-lg font-bold text-emerald-400">Target Peserta Fasyankes</h3>
        <ul class="space-y-3 text-xs leading-relaxed text-slate-300">
          <li class="pb-2 border-b border-white/10">
            <strong class="text-white block">Ketua &amp; Anggota Komite K3RS:</strong> Bertanggung jawab atas regulasi dan pelaporan insiden internal.
          </li>
          <li class="pb-2 border-b border-white/10">
            <strong class="text-white block">IPSRS &amp; Teknisi Elektromedis:</strong> Mengelola pemeliharaan genset, tabung oksigen medis, dan instalasi mekanikal.
          </li>
          <li class="pb-2 border-b border-white/10">
            <strong class="text-white block">Sanitarian &amp; Penanggung Jawab Limbah B3:</strong> Mengawasi IPAL, TPS B3 medis, dan insinerator.
          </li>
          <li>
            <strong class="text-white block">Manajer Klinik &amp; Puskesmas:</strong> Memenuhi standar survei akreditasi faskes tingkat pertama (FKTP).
          </li>
        </ul>
      </div>
    </section>

    <!-- Section 2: 6 Elemen Pokja MFK -->
    <section id="pokja-mfk" class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block">Integrasi Akreditasi KARS / Starkes</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          6 Elemen Wajib Pokja MFK yang Dipelajari &amp; Diujikan
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Kurikulum sertifikasi disinkronkan langsung dengan instrumen audit Bab Manajemen Fasilitas dan Keselamatan (MFK):
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs">MFK 1</div>
          <h3 class="font-bold text-slate-900 text-base">Kepemimpinan &amp; Perencanaan</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Penyusunan Program Kerja K3RS tahunan, pembentukan organisasi komite K3RS resmi SK Direktur, dan alokasi anggaran keselamatan.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs">MFK 2</div>
          <h3 class="font-bold text-slate-900 text-base">Keselamatan &amp; Keamanan Fisik</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Inspeksi area berisiko tinggi, kontrol akses kamar bayi/ruang obat, identifikasi badge staf, dan pemasangan CCTV keselamatan.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs">MFK 3</div>
          <h3 class="font-bold text-slate-900 text-base">Bahan Berbahaya &amp; Beracun (B3)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Pengelolaan rantai pasok B3 medis (formalin, etilen oksida, reagen), ketersediaan spill kit tumpahan medis, TPS B3 berizin, dan manifest limbah medis.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs">MFK 4</div>
          <h3 class="font-bold text-slate-900 text-base">Kesiapsiagaan Bencana (Disaster)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Penyusunan Hospital Disaster Plan (HDP), simulasi bencana gempa/banjir/kebakaran massal, dan penetapan triase gawat darurat.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs">MFK 5</div>
          <h3 class="font-bold text-slate-900 text-base">Proteksi Kebakaran (Fire Safety)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Inspeksi rutin APAR, hydrant, detektor asap, sprinkler, pemeliharaan pintu darurat bebas rintangan, dan pelatihan Code Red untuk seluruh perawat.</p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-700 font-bold flex items-center justify-center text-xs">MFK 6</div>
          <h3 class="font-bold text-slate-900 text-base">Sistem Utilitas &amp; Alat Medis</h3>
          <p class="text-xs text-slate-600 leading-relaxed">Uji berkala kontinuitas pasokan listrik darurat (genset &lt; 10 detik), distribusi gas medis sentral (Oksigen), kualitas air bersih, dan kalibrasi alat medis.</p>
        </div>
      </div>
    </section>

    <!-- Section 3: PCRA & B3 Medis -->
    <section id="pcra-icra" class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white border border-white/10 shadow-2xl space-y-6">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-400 block">Studi Kasus Teknis</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Penilaian Risiko Pra-Konstruksi (PCRA) &amp; ICRA Renovasi
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Salah satu poin audit tersering yang menjadi catatan surveyor akreditasi adalah pelaksanaan renovasi gedung rumah sakit di dekat area rawat inap:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-slate-300">
        <div class="p-5 rounded-2xl bg-white/5 border border-white/10 space-y-2">
          <h4 class="font-bold text-white text-sm">Metodologi PCRA Rumah Sakit</h4>
          <p class="leading-relaxed">Menilai dampak debu puing terhadap sistem sirkulasi udara (HVAC), isolasi partisi kedap udara dengan tekanan negatif (*negative pressure containment*), mitigasi getaran terhadap alat laboratorium sensitif, dan pengalihan jalur evakuasi kebakaran pasien.</p>
        </div>
        <div class="p-5 rounded-2xl bg-white/5 border border-white/10 space-y-2">
          <h4 class="font-bold text-white text-sm">SOP Tumpahan B3 &amp; Sitotoksik</h4>
          <p class="leading-relaxed">Teknik pemakaian spill kit sitotoksik di ruang kemoterapi, penanganan tumpahan darah atau cairan tubuh infeksius, dekontaminasi permukaan, dan penampungan dalam kantong kuning berlogo biohazard.</p>
        </div>
      </div>
    </section>

    <!-- Section 4: In-House Faskes Coverage -->
    <section id="faskes-kota" class="space-y-6">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block">Jangkauan Wilayah Rumah Sakit</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Layanan Pelatihan K3RS untuk RSUD &amp; Jaringan Swasta
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Konsultan K3 Indonesia melayani pelatihan daring (Public Class) serta <strong>In-House Training tatap muka langsung di fasyankes Anda</strong>:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h4 class="font-bold text-slate-900 text-base">Jabodetabek &amp; Jawa Barat</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
