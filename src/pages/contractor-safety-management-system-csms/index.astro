---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Jasa CSMS Contractor Safety Management System K3";
const description = "Konsultasi & audit CSMS (Contractor Safety Management System): panduan 6 tahap, prakualifikasi vendor tender migas/tambang, dan pengawasan kontraktor.";
const canonical = "/contractor-safety-management-system-csms/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Layanan Konsultasi", "item": "https://konsultank3.com/panduan-penerapan-smk3/" },
        { "@type": "ListItem", "position": 3, "name": "CSMS K3 Kontraktor", "item": "https://konsultank3.com/contractor-safety-management-system-csms/" }
      ]
    },
    {
      "@type": "Service",
      "name": "Jasa Konsultasi & Audit Contractor Safety Management System (CSMS) K3",
      "serviceType": "Contractor Safety Management & Pre-Qualification Consulting",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa itu Contractor Safety Management System (CSMS)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "CSMS adalah sistem komprehensif yang digunakan oleh perusahaan pemilik proyek (Owner) untuk mengelola dan memitigasi risiko K3 dari kontraktor, mitra kerja, dan subkontraktor di setiap fase—mulai dari prakualifikasi tender, seleksi, aktivitas pra-kerja, eksekusi lapangan, hingga evaluasi akhir performa."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah sertifikat atau kelulusan CSMS wajib untuk mengikuti tender migas dan BUMN?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya. Di sektor minyak dan gas (SKK Migas), pertambangan mineral dan batubara, energi, konstruksi EPC, serta manufaktur multinasional, sertifikat kelulusan prakualifikasi CSMS dengan skor minimum tertentu (umumnya kategori risiko tinggi/High Risk) menjadi syarat mutlak administrasi tender."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana KonsultanK3.com membantu kontraktor agar lolos prakualifikasi CSMS?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kami mendampingi kontraktor menyusun dokumen HSE Plan proyek yang spesifik, bridging document, manual kebijakan K3, matriks kompetensi personel, riwayat jam kerja selamat (LTI stats), serta bukti implementasi audit lapangan sehingga memenuhi skor evaluasi owner tender."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/panduan-penerapan-smk3/" class="hover:text-amber-400 transition-colors">Konsultasi Sistem</a>
        <span>/</span>
        <span class="text-slate-300">Contractor Safety Management System (CSMS)</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse-glow"></span>
            Standar Pengawasan Kontraktor &bull; Migas, Tambang &amp; EPC
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Jasa Konsultasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">CSMS (Contractor Safety Management System)</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Sistem tata kelola keselamatan kontraktor terpadu: perancangan sistem CSMS bagi Project Owner dan pendampingan kelulusan prakualifikasi tender bagi vendor di sektor migas, tambang, energi, dan konstruksi.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, kami mau berdiskusi mengenai konsultasi CSMS (Contractor Safety Management System)")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi CSMS via WhatsApp &rarr;
            </a>
            <a
              href="#tahapan-csms"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Alur 6 Tahap CSMS
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Ruang Lingkup</span>
              <p class="text-white font-bold text-sm">6 Tahapan Penuh</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Sektor Industri</span>
              <p class="text-white font-bold text-sm">Migas, EPC &amp; Mining</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Target Nilai</span>
              <p class="text-white font-bold text-sm">Prakualifikasi High Risk</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Hasil Akhir</span>
              <p class="text-emerald-400 font-bold text-sm">Mitigasi Zero Incident</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pengawasan K3 Kontraktor di Lokasi Proyek Industri CSMS"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Kontrol Vendor Proyek
              </span>
              <div class="text-lg font-bold">Lindungi Aset Pemilik Fasilitas</div>
              <p class="text-xs text-slate-300 mt-1">Mengendalikan potensi bahaya dari subkontraktor dan pekerja alih daya sebelum insiden terjadi di tapak proyek.</p>
            </div>
          </div>

          <!-- Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">Lolos Tender BUMN &amp; KKKS</div>
              <div class="text-[10px] text-slate-400">Verifikasi Dokumen Prakualifikasi</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🛡️</div>
            <div>
              <div class="text-xs font-bold text-white">Bridging Document</div>
              <div class="text-[10px] text-slate-400">Harmonisasi HSE Plan Kontraktor</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Rich Technical Guide (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section: Mengapa CSMS Kritis -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Manajemen Risiko Pihak Ketiga</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Mengapa Sistem Pengawasan Kontraktor (CSMS) Menjadi Syarat Wajib Industri?
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            Statistik ketenagakerjaan global dan nasional menunjukkan bahwa lebih dari <strong>70% hingga 80% insiden kecelakaan fatal (fatality) di area industri</strong> melibatkan pekerja kontraktor, subkontraktor, atau vendor alih daya. Perbedaan budaya keselamatan kerja, ketidakpahaman atas bahaya lokal fasilitas, peralatan kerja yang aus, serta fluktuasi kompetensi pekerja musiman menjadi akar penyebab utama kerugian aset dan terhentinya operasional pemilik proyek.
          </p>

          <p class="text-slate-700 leading-relaxed">
            <strong>Contractor Safety Management System (CSMS)</strong> adalah mekanisme penyaringan dan pengawasan sistematis yang memastikan setiap kontraktor yang menginjakkan kaki di fasilitas Anda memiliki sistem manajemen keselamatan yang setara dengan standar perusahaan Anda.
          </p>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
            <div class="flex items-center gap-2 text-slate-900 font-bold text-sm">
              <span class="text-lg">⚖️</span>
              Kewajiban Pengawasan Kontraktor pada SMK3 PP 50/2012
            </div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              Berdasarkan klausul <strong>Pembelian dan Pengendalian Kontraktor dalam SMK3 PP No. 50 Tahun 2012 dan ISO 45001:2018 Klausul 8.1.4.2</strong>, pengusaha pemberi kerja bertanggung jawab secara hukum memastikan barang dan jasa yang dipasok oleh kontraktor tidak menurunkan tingkat keselamatan kerja di lokasi proyek.
            </p>
          </div>
        </section>

        <!-- Section: Alur 6 Tahap CSMS -->
        <section id="tahapan-csms" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Standard Operating Procedure</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Alur 6 Tahap Siklus Contractor Safety Management System (CSMS)
            </h2>
          </div>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                01
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 1: Penilaian Risiko Pekerjaan (Risk Assessment)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Pemilik proyek mengidentifikasi ruang lingkup pekerjaan vendor dan menetapkan tingkat risiko K3: <strong>Rendah (Low), Sedang (Medium), atau Tinggi (High Risk)</strong>. Penentuan ini menentukan level ketatnya persyaratan kualifikasi yang harus dipenuhi vendor saat tender.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                02
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 2: Prakualifikasi K3 Kontraktor (Pre-Qualification / PQ)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Evaluasi dokumentasi rekam jejak K3 kontraktor: kebijakan HSE, sertifikat personel pengawas K3, statistik jam kerja selamat (Lost Time Injury / LTI), kepatuhan APD, sertifikasi alat berat, dan asuransi ketenagakerjaan. Vendor yang memenuhi passing score dinyatakan lolos ke tahap penawaran teknis.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                03
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 3: Seleksi &amp; Penandatanganan Kontrak (Selection &amp; Award)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Penyusunan pasal-pasal klausul keselamatan khusus ke dalam kontrak kerja (HSE Exhibit), alokasi anggaran keselamatan yang memadai (safety budget), serta kesepakatan sanksi dan denda pelanggaran K3 di lapangan.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                04
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 4: Aktivitas Pra-Kerja (Pre-Job Activity)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Penyelenggaraan Kick-Off Meeting HSE, peninjauan <em>Bridging Document</em> (penyelarasan prosedur darurat vendor dengan sistem owner), verifikasi Job Safety Analysis (JSA), penerbitan izin kerja (Work Permit), dan induksi keselamatan bagi seluruh pekerja kontraktor sebelum pekerjaan dimulai.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                05
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 5: Pengawasan Saat Pelaksanaan (Work in Progress)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Inspeksi lapangan rutin, pemantauan safety briefing harian (toolbox talk), audit berkala kepatuhan prosedur, inspeksi keabsahan lisensi operator alat berat (SIO), dan rapat koordinasi K3 mingguan.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                06
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 6: Evaluasi Akhir Performa K3 (Final Evaluation)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Penilaian kinerja keselamatan pasca-proyek: rasio insiden, kepatuhan laporan near-miss, kedisiplinan izin kerja, dan kebersihan housekeeping. Skor akhir menentukan apakah kontraktor tersebut dimasukkan ke dalam Approved Vendor List (AVL) untuk proyek berikutnya atau dimasukkan ke daftar evaluasi.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section: Dua Jalur Layanan Konsultasi -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Solusi Klien</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Dukungan Konsultasi CSMS untuk Dua Sisi Kebutuhan
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl bg-slate-900 text-white space-y-4">
              <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-xl">
                🏢
              </div>
              <h3 class="text-lg font-bold text-white">Bagi Project Owner &amp; Manajemen Fasilitas</h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                Kami merancang manual CSMS korporat, menyusun kuesioner prakualifikasi terstandarisasi, melatih tim assessor internal pengadaan, dan menyediakan jasa auditor pihak ketiga independen untuk menilai kualifikasi ribuan vendor Anda.
              </p>
              <ul class="text-xs text-slate-300 space-y-2 pt-2 border-t border-white/10">
                <li>✓ Standarisasi scoring matrix prakualifikasi vendor</li>
                <li>✓ Penyusunan template HSE Exhibit &amp; kontrak kerja</li>
                <li>✓ Audit kepatuhan lapangan independen (third-party audit)</li>
              </ul>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xl">
                👷
              </div>
              <h3 class="text-lg font-bold text-slate-900">Bagi Kontraktor Peserta Tender (Vendor)</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Kami mendampingi perusahaan kontraktor menyusun seluruh portofolio dokumen K3 yang disyaratkan oleh panitia tender SKK Migas, BUMN Karya, Pertamina, PLN, maupun perusahaan tambang agar lolos passing grade prakualifikasi.
              </p>
              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-100">
                <li>✓ Pembuatan dokumen Project HSE Plan &amp; Bridging Document</li>
                <li>✓ Penyusunan dokumen Prosedur Kerja Kritis &amp; JSA</li>
                <li>✓ Simulasi wawancara dan persiapan audit verifikasi lapangan</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Section: FAQ -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">FAQ</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Pertanyaan yang Sering Diajukan Seputar CSMS
            </h2>
          </div>

          <div class="space-y-3">
            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Berapa lama proses penyusunan dokumen CSMS untuk kontraktor tender?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Penyusunan dokumen pendampingan tender CSMS tipikal memakan waktu 2 hingga 4 minggu kerja tergantung pada kelengkapan histori jam kerja, bukti sertifikat personel K3, dan dokumen kebijakan dasar yang dimiliki perusahaan vendor.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apa perbedaan antara CSMS dan SMK3 PP 50/2012?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                SMK3 PP 50/2012 adalah sistem manajemen keselamatan komprehensif internal untuk seluruh organisasi perusahaan. Sedangkan CSMS adalah salah satu sub-sistem khusus yang berfokus mengatur hubungan kontraktual keselamatan kerja antara pemberi kerja (Owner) dan pihak ketiga (kontraktor pelaksana).
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apakah sertifikat CSMS berlaku nasional di semua perusahaan pemberi kerja?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Secara umum, sertifikat kelulusan prakualifikasi CSMS diterbitkan oleh masing-masing pemilik proyek atau holding korporasi (misalnya sistem CIVD SKK Migas yang diakui bersama oleh seluruh Kontraktor Kontrak Kerja Sama migas). Namun, dokumen portofolio HSE Plan yang disusun dapat digunakan sebagai basis yang kuat untuk tender di perusahaan multinasional lainnya.
              </p>
            </details>
          </div>
        </section>

      </article>

      <!-- Right Sidebar: Inquiries (4 cols) -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        
        <!-- B2B Proposal Box -->
        <div class="p-6 rounded-2xl bg-slate-900 text-white border border-white/10 shadow-xl space-y-4">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-amber-500/20 text-amber-400 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Layanan CSMS Terpadu
          </div>

          <h3 class="text-lg font-bold text-white">Butuh Lolos Tender atau Susun Sistem CSMS?</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
