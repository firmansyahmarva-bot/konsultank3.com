---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Management of Change (MOC) K3: Prosedur & Formulir";
const description = "Panduan lengkap Management of Change (MOC) K3 sesuai ISO 45001 dan PP 50/2012: alur 6 tahap, matriks kriteria perubahan, PSSR checklist, dan formulir.";
const canonical = "/management-of-change-k3/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Panduan & Artikel K3", "item": "https://konsultank3.com/artikel/" },
        { "@type": "ListItem", "position": 3, "name": "Management of Change (MOC) K3", "item": "https://konsultank3.com/management-of-change-k3/" }
      ]
    },
    {
      "@type": "Article",
      "headline": "Management of Change (MOC) K3: Mengendalikan Risiko dari Setiap Perubahan Fasilitas & Operasional",
      "description": description,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://konsultank3.com/management-of-change-k3/"
      },
      "author": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    },
    {
      "@type": "HowTo",
      "name": "Alur 6 Tahap Prosedur Management of Change (MOC) K3",
      "description": "Siklus sistematis pelaksanaan manajemen perubahan K3 untuk mencegah bahaya operasional.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Tahap 1: Inisiasi Usulan Perubahan & Pengisian Formulir MOC",
          "text": "Pemrakarsa perubahan merinci deskripsi modifikasi teknis, justifikasi bisnis/keselamatan, dan estimasi durasi."
        },
        {
          "@type": "HowToStep",
          "name": "Tahap 2: Penilaian Risiko & Analisis Dampak Multidisiplin",
          "text": "Melakukan evaluasi bahaya menggunakan metode HAZOP, JSA, atau What-If bersama tim teknis dan HSE."
        },
        {
          "@type": "HowToStep",
          "name": "Tahap 3: Review Teknis & Persetujuan Manajemen",
          "text": "Komite MOC dan manajemen berwenang meninjau rencana mitigasi risiko sebelum memberikan izin eksekusi."
        },
        {
          "@type": "HowToStep",
          "name": "Tahap 4: Implementasi & Sosialisasi Perubahan",
          "text": "Melaksanakan instalasi fisik, memperbarui gambar P&ID/SOP, dan menyelenggarakan briefing kepada operator terdampak."
        },
        {
          "@type": "HowToStep",
          "name": "Tahap 5: Pre-Startup Safety Review (PSSR)",
          "text": "Inspeksi fisik mandiri sebelum pengoperasian untuk memastikan semua kontrol keselamatan telah terpasang sempurna."
        },
        {
          "@type": "HowToStep",
          "name": "Tahap 6: Penutupan (Closure) & Pemantauan Pasca-Perubahan",
          "text": "Menutup berkas MOC secara administratif dan memonitor kestabilan performa proses di lapangan."
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/artikel/" class="hover:text-amber-400 transition-colors">Panduan &amp; Edukasi K3</a>
        <span>/</span>
        <span class="text-slate-300">Management of Change (MOC) K3</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse-glow"></span>
            Process Safety Management &bull; ISO 45001 Klausul 8.1.3
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Management of Change (MOC) K3: <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Kendalikan Risiko Setiap Perubahan Pabrik</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Panduan menyeluruh prosedur Manajemen Perubahan (MOC) untuk fasilitas manufaktur, migas, kimia, dan pembangkit: siklus 6 tahap, matriks kriteria perubahan, Pre-Startup Safety Review (PSSR), serta formulir evaluasi resmi.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#tahapan-moc"
              class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-xl shadow-amber-500/20 transition-all hover:scale-105"
            >
              Alur 6 Tahap MOC &darr;
            </a>
            <a
              href="#pssr-checklist"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Checklist PSSR Pre-Startup
            </a>
          </div>

          <!-- Quick Stat Features -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Standar Acuan</span>
              <p class="text-white font-bold text-sm">ISO 45001 &amp; OSHA PSM</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Regulasi Nasional</span>
              <p class="text-white font-bold text-sm">PP 50/2012 Elemen 6</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Tipe Perubahan</span>
              <p class="text-white font-bold text-sm">Permanen, Temp, Darurat</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Validasi Akhir</span>
              <p class="text-emerald-400 font-bold text-sm">PSSR Verifikasi Fisik</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/smk3-audit.jpg"
              alt="Audit dan Review Prosedur Management of Change MOC di Pabrik"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Manajemen Perubahan Terpadu
              </span>
              <div class="text-lg font-bold">Cegah Bahaya Sebelum Modifikasi Dimulai</div>
              <p class="text-xs text-slate-300 mt-1">Mengidentifikasi titik kritis pada perpipaan, mesin, parameter kimia, dan prosedur kerja.</p>
            </div>
          </div>

          <!-- Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">ISO 45001:2018</div>
              <div class="text-[10px] text-slate-400">Klausul 8.1.3 MOC</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">⚠️</div>
            <div>
              <div class="text-xs font-bold text-white">Mitigasi Risiko Katastrofik</div>
              <div class="text-[10px] text-slate-400">Pelajaran Bencana Industri</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Rich Technical Article (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section 1: Pengertian & Landasan Hukum MOC -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Landasan Standar &amp; Regulasi</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Apa Itu Management of Change (MOC) K3?
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            <strong>Management of Change (MOC)</strong> atau Manajemen Perubahan adalah proses manajemen terstruktur dan terdokumentasi yang dirancang untuk mengidentifikasi, mengevaluasi, dan mengendalikan potensi bahaya keselamatan kerja, kesehatan lingkungan, dan integritas fasilitas sebelum suatu modifikasi fisik maupun non-fisik diterapkan di tempat kerja.
          </p>

          <p class="text-slate-700 leading-relaxed">
            Dalam dinamika operasional pabrik atau proyek industri, perubahan adalah hal yang lazim terjadi—mulai dari penggantian merek pompa, modifikasi perpipaan, penyesuaian suhu/tekanan reaksi kimia, revisi standar operasional prosedur (SOP), hingga perombakan struktur pengawas lapangan. Tanpa sistem MOC yang ketat, modifikasi kecil yang tampak sepele (<em>creeping changes</em>) dapat memicu bahaya tak terduga yang berujung pada ledakan, keracunan zat beracun, atau kegagalan struktur fatal.
          </p>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
            <div class="flex items-center gap-2 text-slate-900 font-bold text-sm">
              <span class="text-lg">⚖️</span>
              Mandat Regulasi Nasional &amp; Internasional
            </div>
            <ul class="text-xs sm:text-sm text-slate-700 space-y-2 leading-relaxed">
              <li>
                <strong>PP No. 50 Tahun 2012 (SMK3):</strong> Elemen 6 (Pengembangan Desain dan Rekayasa) mewajibkan identifikasi bahaya dan penilaian risiko dilakukan pada setiap modifikasi fasilitas, instalasi, dan proses baru.
              </li>
              <li>
                <strong>ISO 45001:2018 Klausul 8.1.3:</strong> Organisasi wajib menetapkan proses untuk penerapan dan pengendalian perubahan sementara maupun permanen yang memengaruhi kinerja K3 (termasuk lokasi kerja, proses, peralatan, tenaga kerja, serta regulasi hukum).
              </li>
              <li>
                <strong>OSHA 29 CFR 1910.119(l) (Process Safety Management):</strong> Mewajibkan prosedur tertulis untuk mengelola perubahan bahan kimia proses, teknologi, peralatan, dan prosedur pada fasilitas yang menangani bahan berbahaya berisiko tinggi.
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Pelajaran Sejarah Bencana Industri -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Studi Kasus Kegagalan</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Mengapa MOC Krusial? Pelajaran dari Bencana Industri Dunia
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            Hampir seluruh bencana industri berskala katastrofik dalam sejarah modern berakar dari kegagalan proses manajemen perubahan. Dua studi kasus paling terkenal berikut membuktikan betapa fatalnya mengabaikan MOC:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl bg-rose-50 border border-rose-200 space-y-3">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-rose-200 text-rose-900">Tragedi Flixborough (1974)</span>
              <h3 class="text-base font-bold text-slate-900">Pipa Bypass Sementara yang Berujung Ledakan Dahsyat</h3>
              <p class="text-xs text-slate-700 leading-relaxed">
                Di pabrik kimia Nypro di Inggris, reaktor No. 5 mengalami keretakan. Tim pemeliharaan memasang pipa penghubung bypass sementara tanpa perhitungan mekanikal engineering yang tepat dan tanpa kajian bahaya MOC. Akibat tekanan operasional, pipa sementara tersebut pecah dan melepaskan 40 ton uap sikloheksana panas yang meledak hebat, menewaskan 28 pekerja dan meluluhlantakkan seluruh fasilitas.
              </p>
            </div>

            <div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 space-y-3">
              <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-200 text-amber-900">Ledakan Kilang BP Texas City (2005)</span>
              <h3 class="text-base font-bold text-slate-900">Perubahan Prosedur Start-Up &amp; Indikator Rusak</h3>
              <p class="text-xs text-slate-700 leading-relaxed">
                Unit isomerisasi mengalami tumpahan hidrokarbon cair saat proses start-up karena perubahan kebiasaan operasional dan rusaknya sensor level cairan di menara splitter. Prosedur startup diubah secara informal tanpa peninjauan MOC terpadu, menyebabkan 15 pekerja tewas dan 180 lainnya luka-luka.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 3: Klasifikasi Perubahan (RIK vs MOC) -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Kriteria Penerapan</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Kapan MOC Wajib Dijalankan? (Replacement in Kind vs MOC)
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            Tidak setiap aktivitas pemeliharaan memerlukan proses MOC yang panjang. Industri membedakan antara <strong>Replacement in Kind (RIK)</strong> dan <strong>Perubahan Nyata (Modification)</strong>:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white uppercase text-xs">
                <tr>
                  <th class="py-3.5 px-4 font-bold">Kategori</th>
                  <th class="py-3.5 px-4 font-bold">Replacement in Kind (Non-MOC)</th>
                  <th class="py-3.5 px-4 font-bold">Wajib Melalui Prosedur MOC</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Peralatan / Hardware</td>
                  <td class="py-3.5 px-4">Penggantian motor/pompa dengan merek, tipe, daya, dan spesifikasi yang 100% identik.</td>
                  <td class="py-3.5 px-4 text-rose-700 font-semibold">Mengganti pompa dengan kapasitas berbeda, perubahan material pipa (misal: CS ke SS), atau mengubah diameter pipa.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Bahan Kimia / Proses</td>
                  <td class="py-3.5 px-4">Mengisi ulang katalis atau pelumas dengan kode spesifikasi teknis yang sama persis.</td>
                  <td class="py-3.5 px-4 text-rose-700 font-semibold">Mengganti vendor pelarut kimia baru, menaikkan suhu reaksi, atau menaikkan kapasitas laju alir melebihi desain awal.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">SOP &amp; Kontrol Keselamatan</td>
                  <td class="py-3.5 px-4">Koreksi saltik (typo) atau penomoran dokumen SOP tanpa mengubah instruksi kerja.</td>
                  <td class="py-3.5 px-4 text-rose-700 font-semibold">Menghapus salah satu langkah verifikasi keselamatan, mengubah urutan kerja kritis, atau membypass interlock sistem safety.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Organisasi &amp; Personel</td>
                  <td class="py-3.5 px-4">Rotasi shift normal antarpersonel dengan kualifikasi dan kompetensi setara.</td>
                  <td class="py-3.5 px-4 text-rose-700 font-semibold">Pengurangan jumlah operator di control room, pergantian kontraktor utama, atau perampingan struktur HSE.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section 4: Alur 6 Tahap Siklus MOC -->
        <section id="tahapan-moc" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Standard Operating Procedure</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Alur 6 Tahap Prosedur Management of Change (MOC) K3
            </h2>
          </div>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                01
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 1: Inisiasi Usulan &amp; Pengisian Formulir MOC</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Pemrakarsa (teknisi pemeliharaan, insinyur proses, atau manajer operasi) mengisi formulir pengajuan MOC resmi. Formulir merinci dasar teknis perubahan, tujuan bisnis/keamanan, lokasi spesifik, serta status perubahan: <strong>Permanen</strong>, <strong>Sementara (Temporary)</strong> dengan tanggal kedaluwarsa tegas, atau <strong>Darurat (Emergency)</strong>.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                02
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 2: Penilaian Risiko Multidisiplin (HIRA / HAZOP / JSA)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Tim peninjau lintas disiplin (melibatkan perwakilan Operasi, Engineering, Pemeliharaan, dan HSE) mengevaluasi potensi dampak bahaya. Pada industri proses kimia, kajian <a href="/jasa-konsultasi-hazop/" class="text-amber-600 font-bold hover:underline">HAZOP (Hazard and Operability Study)</a> atau What-If Analysis wajib digelar. Untuk modifikasi fisik alat kerja, lengkapi dengan <a href="/downloads/Formulir-JSA-Job-Safety-Analysis.html" class="text-amber-600 font-bold hover:underline">analisis Job Safety Analysis (JSA)</a>.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                03
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 3: Review Teknis &amp; Persetujuan Berwenang (Approval)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Usulan perubahan beserta daftar tindakan mitigasi risiko diajukan kepada pemegang otoritas yang ditunjuk (seperti Plant Manager, Engineering Lead, dan HSE Manager). Persetujuan hanya dapat diterbitkan jika seluruh bahaya telah ditekan ke tingkat ALARP (<em>As Low As Reasonably Practicable</em>).
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                04
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 4: Implementasi, Update Dokumen &amp; Pelatihan Personel</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Setelah disetujui, pekerjaan fisik dieksekusi dengan sistem izin kerja aman (Permit to Work). Bersamaan dengan itu, seluruh dokumentasi teknis wajib dimutakhirkan: gambar P&amp;ID, diagram kabel listrik, SOP operasi, dan matriks risiko. Seluruh operator dan kontraktor yang terdampak wajib mendapatkan <a href="/materi-safety-talk-harian/" class="text-amber-600 font-bold hover:underline">briefing safety talk harian</a> atau pelatihan sebelum unit beroperasi.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                05
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 5: Pre-Startup Safety Review (PSSR)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Inspeksi fisik mandiri langsung di lokasi instalasi sebelum sakelar dinyalakan atau fluida bertekanan dialirkan. Tim PSSR memverifikasi bahwa konstruksi sesuai spesifikasi rekayasa, seluruh perangkat pelindung keselamatan (safety valve, interlock, alarm) telah terkalibrasi, dan operator telah terlatih.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                06
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 6: Penutupan (Closure) &amp; Pemantauan Pasca-Perubahan</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Berkas MOC ditutup secara resmi setelah sistem terbukti beroperasi normal dan aman. Untuk perubahan sementara (Temporary MOC), sistem harus dikembalikan ke kondisi aslinya tepat saat batas waktu habis, atau pemrakarsa wajib mengajukan perpanjangan MOC permanen.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 5: Pre-Startup Safety Review (PSSR) Checklist -->
        <section id="pssr-checklist" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Gate Kritis Operasional</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Checklist Pre-Startup Safety Review (PSSR)
            </h2>
          </div>

          <p class="text-slate-700">
            PSSR adalah gerbang terakhir pencegahan insiden sebelum fasilitas baru atau fasilitas yang dimodifikasi mulai dioperasikan. Verifikasi 8 parameter kunci berikut di lapangan:
          </p>

          <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm my-6 relative group">
            <img
              src="/assets/images/hero-safety-officer.jpg"
              alt="Inspeksi Pre-Startup Safety Review PSSR oleh Tim Engineering dan Safety Officer"
              class="w-full h-72 object-cover group-hover:scale-105 transition-transform duration-700"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
            <div class="absolute bottom-4 left-6 right-6 text-white text-xs">
              <strong>Verifikasi Lapangan Multidisiplin:</strong> Tim engineering, operasi, dan pengawas K3 memverifikasi instalasi fisik sebelum sistem dialiri fluida atau daya listrik.
            </div>
          </div>

          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
            <div class="space-y-2 text-xs sm:text-sm text-slate-700">
              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
                <span class="text-emerald-600 font-bold text-base">☑</span>
                <div>
                  <strong>Kesesuaian Desain &amp; Konstruksi:</strong>
                  <p class="text-slate-600 text-xs">Peralatan fisik dan perpipaan terpasang sesuai cetak biru teknik P&amp;ID yang telah disetujui tim engineering.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
                <span class="text-emerald-600 font-bold text-base">☑</span>
                <div>
                  <strong>Uji Kalibrasi &amp; Instrumen Safety:</strong>
                  <p class="text-slate-600 text-xs">Pressure relief valve (PRV), sensor gas detector, alarm kebocoran, dan emergency trip switch telah diuji fungsi (function test).</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
                <span class="text-emerald-600 font-bold text-base">☑</span>
                <div>
                  <strong>Penyelesaian Rekomendasi PHA/HAZOP:</strong>
                  <p class="text-slate-600 text-xs">Seluruh catatan tindakan mitigasi bahaya dari sesi studi risiko telah ditutup dan diverifikasi di lapangan.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
                <span class="text-emerald-600 font-bold text-base">☑</span>
                <div>
                  <strong>Pembaruan SOP &amp; Prosedur Tanggap Darurat:</strong>
                  <p class="text-slate-600 text-xs">Instruksi kerja start-up, operasi normal, shutdown, dan emergency shutdown telah direvisi dan tersedia di workstation.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
                <span class="text-emerald-600 font-bold text-base">☑</span>
                <div>
                  <strong>Pelatihan Operator &amp; Teknisi Pemeliharaan:</strong>
                  <p class="text-slate-600 text-xs">Seluruh personel yang mengoperasikan atau memelihara alat telah mengikuti briefing teknis dan memahami parameter kritis.</p>
                </div>
              </div>

              <div class="flex items-start gap-3 p-3 rounded-xl bg-slate-50 border border-slate-200">
                <span class="text-emerald-600 font-bold text-base">☑</span>
                <div>
                  <strong>Kesiapan Proteksi Kebakaran &amp; Rambu K3:</strong>
                  <p class="text-slate-600 text-xs">Tabung APAR, sistem hidran, rambu bahaya titik jepit/bahan kimia, dan jalur evakuasi telah siap dan tidak terhalang.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 6: Format Formulir MOC Siap Pakai -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Arsip Dokumentasi Audit</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Format Formulir Pengajuan Management of Change (MOC)
            </h2>
          </div>

          <p class="text-slate-700">
            Berikut adalah struktur format formulir MOC standar industri yang memenuhi persyaratan pembuktian audit SMK3 PP 50/2012 dan ISO 45001:
          </p>

          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-700 pb-4 border-b border-slate-200">
              <div><strong>Nomor Registrasi MOC:</strong> MOC/HSE/2026/.....</div>
              <div><strong>Departemen / Unit:</strong> ........................................</div>
              <div><strong>Nama Pemrakarsa (Initiator):</strong> ........................................</div>
              <div><strong>Kategori:</strong> [  ] Permanen &nbsp; [  ] Sementara &nbsp; [  ] Darurat</div>
            </div>

            <div class="space-y-2 text-xs text-slate-700">
              <p><strong>1. Uraian Perubahan:</strong> (Jelaskan secara rinci modifikasi fisik, proses, atau SOP yang diusulkan)</p>
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 min-h-[50px]">............................................................................................................................</div>
            </div>

            <div class="space-y-2 text-xs text-slate-700">
              <p><strong>2. Alasan &amp; Justifikasi Perubahan:</strong> (Tujuan peningkatan keselamatan, mutu produk, efisiensi kapasitas, dsb.)</p>
              <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 min-h-[50px]">............................................................................................................................</div>
            </div>

            <div class="space-y-2 text-xs text-slate-700">
              <p><strong>3. Identifikasi Bahaya &amp; Tindakan Mitigasi:</strong></p>
              <table class="w-full text-left text-xs border border-slate-200">
                <thead class="bg-slate-100 font-bold">
                  <tr>
                    <th class="p-2 border">Potensi Bahaya Baru</th>
                    <th class="p-2 border">Dampak K3 / Fasilitas</th>
                    <th class="p-2 border">Tindakan Pengendalian Wajib</th>
                    <th class="p-2 border">PIC</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td class="p-2 border">..............................</td>
                    <td class="p-2 border">..............................</td>
                    <td class="p-2 border">..............................</td>
                    <td class="p-2 border">............</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-4 border-t border-slate-200 text-center text-xs">
              <div class="p-3 rounded-xl bg-slate-50 border">
                <span class="text-slate-400 block mb-1">Diajukan Oleh</span>
                <strong class="text-slate-900 block">Pemrakarsa (Initiator)</strong>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 border">
                <span class="text-slate-400 block mb-1">Ditinjau Oleh</span>
                <strong class="text-slate-900 block">Lead Engineering / HSE</strong>
              </div>
              <div class="p-3 rounded-xl bg-slate-50 border">
                <span class="text-slate-400 block mb-1">Disetujui Oleh</span>
                <strong class="text-slate-900 block">Plant / Operational Manager</strong>
              </div>
            </div>
          </div>
        </section>

        <!-- Section 7: FAQ Pertanyaan Sering Diajukan -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Tanya Jawab</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Pertanyaan yang Sering Diajukan Seputar Management of Change (MOC)
            </h2>
          </div>

          <div class="space-y-3">
            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Berapa lama masa berlaku MOC Sementara (Temporary MOC)?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Durasi MOC sementara harus ditetapkan secara tegas sejak awal pengajuan, umumnya tidak melebihi <strong>30 hingga 90 hari</strong> kalender tergantung kebijakan internal perusahaan. Saat tanggal kedaluwarsa tiba, fasilitas wajib dikembalikan ke kondisi aslinya atau pemrakarsa harus mengajukan evaluasi MOC permanen dengan analisis rekayasa lengkap.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Kapan Emergency MOC diizinkan untuk digunakan?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Emergency MOC hanya diizinkan dalam kondisi darurat operasional di mana penundaan tindakan modifikasi dapat memicu bahaya langsung terhadap keselamatan jiwa pekerja atau kerusakan parah fasilitas. Modifikasi darurat tetap membutuhkan persetujuan lisan/tertulis minimal dari Manajer Operasi jaga, dan dokumentasi MOC resmi wajib dilengkapi dalam waktu 1x24 jam setelah situasi terkendali.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Siapa saja yang wajib duduk di dalam Komite Review MOC?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Komite MOC harus bersifat multidisiplin, minimal terdiri dari: (1) Perwakilan Insinyur Teknik/Engineering, (2) Pengawas Operasi Produksi, (3) Tim Pemeliharaan/Maintenance, dan (4) Ahli K3 / HSE Specialist. Keterlibatan lintas disiplin mencegah bias keputusan yang hanya mementingkan kecepatan produksi.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Mengapa dokumen MOC menjadi sasaran utama auditor SMK3 dan ISO 45001?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Auditor eksternal memeriksa rekaman MOC untuk memverifikasi apakah perusahaan benar-benar menjalankan manajemen risiko proaktif, bukan hanya reaktif setelah terjadi kecelakaan. Temuan modifikasi lapangan yang tidak memiliki dokumen MOC merupakan temuan ketidaksesuaian mayor (major non-conformance) dalam audit SMK3 PP 50/2012.
              </p>
            </details>
          </div>
        </section>

      </article>

