---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Pelatihan K3 Ketinggian TKPK Palembang Jakarta Kemnaker";
const description = "Pelatihan K3 Bekerja di Ketinggian TKPK dan TKBT Kemnaker di Palembang, Lampung, Jakarta. Teknik rope access sesuai Permenaker 9/2016. Cek WA.";
const canonical = "/pelatihan-k3-ketinggian-palembang-jakarta/";
const ogImage = "https://konsultank3.com/assets/images/pelatihan-k3-ketinggian-palembang-hero.jpg";

const faqs = [
  {
    q: "Mengapa pekerja tower, gedung, dan kilang di Palembang serta Jakarta wajib memiliki lisensi Permenaker 9/2016?",
    a: "Permenaker No. 9 Tahun 2016 tentang Keselamatan dan Kesehatan Kerja dalam Pekerjaan pada Ketinggian mewajibkan setiap tenaga kerja yang bekerja pada lantai kerja tetap maupun akses tali (rope access) di ketinggian memiliki sertifikat pembinaan dan Lisensi K3 (TKBT atau TKPK) Kemnaker RI. Jatuh dari ketinggian secara konsisten menjadi penyebab kecelakaan kerja fatal terbanyak di proyek konstruksi gedung, tower telekomunikasi, maupun pemeliharaan fasilitas kilang."
  },
  {
    q: "Apa perbedaan skema TKPK (Tenaga Kerja Pada Ketinggian) vs TKBT (Tenaga Kerja Bangunan Tinggi)?",
    a: "TKBT (Tingkat 1 dan Tingkat 2) ditujukan bagi pekerja yang bekerja pada lantai kerja tetap atau sementara yang memiliki pengaman tepi (seperti perancah/scaffolding, atap gudang, maupun gondola). Sedangkan TKPK (Tingkat 1, Tingkat 2, dan Tingkat 3) wajib bagi pekerja yang menggunakan sistem penahanan jatuh dan teknik akses tali (rope access / full body harness sebagai tumpuan utama) seperti pemanjat tower BTS, turbin angin, pembersih kaca fasad gedung bertingkat, maupun inspeksi struktur jembatan dan kilang."
  },
  {
    q: "Berapa estimasi biaya Pelatihan K3 Ketinggian TKPK / TKBT Kemnaker RI di Palembang, Lampung, dan Jakarta?",
    a: "Estimasi investasi pembinaan resmi Kemnaker RI meliputi program TKBT maupun TKPK Tingkat 1 hingga Tingkat 3 berkisar antara Rp6.000.000 hingga Rp8.500.000 per peserta, bergantung pada tingkat kompetensi yang diambil, penyediaan menara/tower praktik tali, serta metode pelaksanaan publik vs In-House perusahaan."
  },
  {
    q: "Apa perbedaan kewenangan TKPK Tingkat 1, Tingkat 2, dan Tingkat 3?",
    a: "TKPK Tingkat 1 bertindak sebagai pemanjat dasar yang melaksanakan pekerjaan pada akses tali di bawah pengawasan TKPK tingkat lebih tinggi dan melakukan penyelamatan sederhana pada dirinya/rekannya satu jalur. TKPK Tingkat 2 menguasai rigging jalur tali (anchor system, deviation, re-anchor) dan teknik rescue kompleks. TKPK Tingkat 3 berwenang menyusun perencanaan kerja ketinggian (rescue & rigging plan), menjadi supervisor tim, serta memimpin operasi penyelamatan darurat."
  },
  {
    q: "Apakah pelatihan ini cocok bagi teknisi telekomunikasi BTS, facade cleaning, dan maintenance kilang Plaju Palembang?",
    a: "Sangat cocok. Sektor utama pengguna sertifikat TKPK dan TKBT di koridor Palembang–Lampung–Jakarta mencakup kontraktor pembangunan & maintenance menara BTS 4G/5G, tim inspeksi jembatan Musi/jalan layang, pembersih kaca gedung CBD Sudirman–Thamrin–Kuningan, pemeliharaan tangki tinggi kilang minyak Plaju, hingga tim fabrikasi baja Cikarang."
  },
  {
    q: "Apakah peserta praktik menggunakan alat pelindung jatuh pribadi (full body harness, double lanyard, ascender, descender)?",
    a: "Ya. Sesi praktik lapangan menguji cara inspeksi kelayakan harness EN 361/EN 358, pemasangan energy absorber lanyard dua kait (100% tie-off), pemasangan simpul dasar pada titik angkur kuat (min. 15 kN), teknik naik-turun menggunakan descender & ascender, hingga praktik penyelamatan korban tergantung (suspension trauma rescue) menggunakan tandu atau skenario penurunan terkendali."
  },
  {
    q: "Apa syarat kesehatan dan batas ketakutan ketinggian untuk ikut sertifikasi TKPK / TKBT?",
    a: "Peserta wajib sehat jasmani dan rohani berdasarkan surat keterangan dokter, tidak memiliki riwayat epilepsi, gangguan keseimbangan/vertigo berat, penyakit jantung tak terkontrol, maupun fobia ketinggian akut, serta minimal berusia 18 tahun dengan pendidikan minimal SLTP/SLTA."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Program Pelatihan K3", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "K3 Ketinggian TKPK Palembang Jakarta", "item": "https://konsultank3.com/pelatihan-k3-ketinggian-palembang-jakarta/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan K3 Bekerja di Ketinggian (TKPK 1–3 & TKBT 1–2) Palembang, Lampung & Jakarta Kemnaker RI",
      "description": description,
      "courseCode": "K3-TINGGI-PLG-JKT",
      "educationalCredentialAwarded": "Sertifikat Pembinaan & Kartu Lisensi K3 (TKPK / TKBT) Kemnaker RI",
      "occupationalCategory": "Tenaga Kerja Pada Ketinggian (TKPK) / Teknisi Rope Access",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": "6000000",
        "highPrice": "8500000",
        "offerCount": "3"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": ["Onsite", "Blended"],
        "courseWorkload": "PT40H",
        "location": {
          "@type": "Place",
          "name": "Koridor Sumatra Selatan - Lampung - Jabodetabek (Palembang & Jakarta)",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Jakarta",
            "addressRegion": "DKI Jakarta",
            "addressCountry": "ID"
          }
        }
      }
    },
    {
      "@type": "Service",
      "name": "Pelatihan & Sertifikasi Working at Height (TKPK & TKBT) Sumatra Selatan - Jakarta",
      "serviceType": "Pembinaan Keselamatan Kerja pada Ketinggian Kemnaker RI",
      "url": "https://konsultank3.com/pelatihan-k3-ketinggian-palembang-jakarta/",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com",
        "telephone": "+62-895-1025-3435"
      },
      "areaServed": [
        "Palembang",
        "Plaju",
        "Prabumulih",
        "Muara Enim",
        "Tanjung Api-Api",
        "Bandar Lampung",
        "Jakarta",
        "Bekasi",
        "Tangerang",
        "Karawang",
        "Cilegon"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={pageSchema}
  presetMessage="Halo Kak, saya butuh info jadwal dan biaya Pelatihan K3 Ketinggian TKPK / TKBT Kemnaker untuk wilayah Palembang / Lampung / Jakarta."
>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">

      <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Program Pelatihan K3</a>
        <span>/</span>
        <span class="text-slate-300">K3 Ketinggian TKPK Palembang &amp; Jakarta</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-500/15 text-sky-300 text-xs font-semibold border border-sky-500/25">
            <span class="w-1.5 h-1.5 rounded-full bg-sky-400 animate-pulse-glow"></span>
            Permenaker 9/2016 &bull; Koridor Palembang &ndash; Plaju &ndash; Lampung &ndash; Jabodetabek &ndash; Cilegon
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan <span class="text-transparent bg-clip-text bg-gradient-to-r from-sky-300 via-cyan-200 to-emerald-300">K3 Ketinggian (TKPK &amp; TKBT) Palembang &amp; Jakarta</span> Kemnaker
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Program sertifikasi resmi <strong>Tenaga Kerja Pada Ketinggian (TKPK 1, 2, 3)</strong> serta <strong>TKBT (Tingkat 1 &amp; 2)</strong> berlisensi Kemnaker RI untuk teknisi menara telekomunikasi, facade gedung tinggi, konstruksi baja, dan fasilitas kilang migas.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, tim kami mau daftar Pelatihan K3 Ketinggian TKPK / TKBT Kemnaker untuk area Palembang / Jakarta.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Konsultasi Jadwal &amp; Biaya WA</span>
              <span>&rarr;</span>
            </a>
            <a
              href="/aspek-k3-bekerja-di-ketinggian-1522.html"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Baca Panduan Teknis Permen 9/2016 &rarr;
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Skema Lisensi</span>
              <p class="text-white font-bold text-sm">TKPK 1–3 &amp; TKBT 1–2</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Praktik Inti</span>
              <p class="text-white font-bold text-sm">Rope Access &amp; Rescue</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Beban Angkur</span>
              <p class="text-white font-bold text-sm">Min. 15 kN Standar</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Koridor Wilayah</span>
              <p class="text-sky-300 font-bold text-sm">Palembang &amp; Jakarta</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/pelatihan-k3-ketinggian-palembang-hero.jpg"
              alt="Teknisi TKPK memanjat struktur menara baja menggunakan full body harness dan double lanyard standar Permenaker 9/2016"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-sky-600 text-white mb-2">
                Pencegahan Jatuh &amp; Suspension Trauma Rescue
              </span>
              <div class="text-lg font-bold">Praktik 100% Tie-Off &amp; Angkur Ganda</div>
              <p class="text-xs text-slate-300 mt-1">
                Latihan langsung teknik pemanjatan menara, manajemen energi jatuh (fall factor), dan penyelamatan korban tergantung.
              </p>
            </div>
          </div>

          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-sky-600 text-white flex items-center justify-center font-bold text-lg">✓</div>
            <div>
              <div class="text-xs font-bold text-white">SIO K3 Ketinggian Kemnaker</div>
              <div class="text-[10px] text-slate-400">Permenaker No. 9/2016</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🧗</div>
            <div>
              <div class="text-xs font-bold text-white">Praktik Menara / Gedung</div>
              <div class="text-[10px] text-slate-400">Palembang &bull; Jakarta</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <aside aria-label="Informasi Pembaruan & Jadwal" class="w-full bg-sky-500/10 border-b border-sky-500/20 py-3 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-800 font-medium">
      <span class="inline-flex items-center gap-1.5 font-bold text-sky-950">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Diperbarui November 2026 &bull; Palembang, Lampung &amp; Jabodetabek:
      </span>
      <span class="text-slate-700">Tersedia pembinaan TKPK Tingkat 1–3, TKBT Tingkat 1–2, serta paket In-House Tower &amp; Maintenance Tim.</span>
      <a
        href={waLink("Halo Kak, minta jadwal pelatihan K3 Ketinggian TKPK / TKBT terdekat di Palembang atau Jakarta.")}
        target="_blank"
        rel="noopener"
        class="text-sky-800 hover:text-sky-950 font-bold underline ml-1"
      >
        Cek Slot via WhatsApp ({WA_DISPLAY}) &rarr;
      </a>
    </div>
  </aside>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Quick Answer + Comparison Matrix -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-sky-700 block">Ringkasan Jawaban Cepat</span>
        <h2 class="text-2xl font-serif font-bold text-slate-900">Mengapa Lisensi TKPK/TKBT Wajib di Sektor Telko, Kilang Palembang &amp; Gedung Jakarta?</h2>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          Baik teknisi menara BTS dan jaringan serat optik di koridor <strong>Palembang, Prabumulih, dan Lampung</strong>, kru pemeliharaan tangki tinggi di kompleks kilang Plaju maupun pelabuhan Tanjung Api-Api, hingga pekerja facade high-rise dan crane gantry di <strong>Jakarta serta kawasan industri Bekasi–Tangerang</strong> menghadapi ancaman jatuh bebas dan cedera <em>suspension trauma</em> jika tali penahan tidak dirancang oleh pemegang lisensi resmi.
        </p>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          Agar perusahaan lolos inspeksi <strong>Permenaker No. 9 Tahun 2016</strong> serta persyaratan izin kerja (Permit to Work) pengelola gedung dan operator telko nasional, pastikan tim Anda mengantongi kartu lisensi yang tepat antara <strong>TKPK</strong> (akses tali) dan <strong>TKBT</strong> (lantai kerja tinggi). Simak juga ulasan regulasi dasar di artikel <a href="/aspek-k3-bekerja-di-ketinggian-1522.html" class="text-sky-700 font-bold underline">Aspek K3 Bekerja di Ketinggian Permenaker 9/2016</a>.
        </p>
      </div>

      <div class="lg:col-span-6 overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-slate-700">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th class="py-3.5 px-4">Skema Sertifikasi</th>
              <th class="py-3.5 px-4">Kewenangan Lapangan</th>
              <th class="py-3.5 px-4">Estimasi Biaya</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">TKPK Tingkat 1 (Rope Access)</td>
              <td class="py-3 px-4">Pemanjat/pekerja akses tali, pemeliharaan tower &amp; bangunan tinggi</td>
              <td class="py-3 px-4 font-semibold text-sky-700">Rp6,0 – 7,5 jt</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">TKPK Tingkat 2 (Rigging &amp; Rescue)</td>
              <td class="py-3 px-4">Pemasangan angkur/rigging jalur tali dan evakuasi korban tergantung</td>
              <td class="py-3 px-4 font-semibold text-sky-700">Rp6,8 – 8,0 jt</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">TKPK Tingkat 3 (Supervisor)</td>
              <td class="py-3 px-4">Perencana rencana kerja ketinggian, audit tali, dan pemimpin penyelamatan</td>
              <td class="py-3 px-4 font-semibold text-sky-700">Rp7,5 – 8,5 jt</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">TKBT Tingkat 1 &amp; 2</td>
              <td class="py-3 px-4">Pekerjaan pada lantai kerja tinggi ber-guardrail, atap, serta perancah</td>
              <td class="py-3 px-4 font-semibold text-sky-700">Rp6,0 – 7,5 jt</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Regional Industrial Coverage -->
    <section class="space-y-8">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-sky-700 block">Koridor Layanan Sumatra Bagian Selatan hingga Jawa Barat</span>
        <h2 class="text-3xl font-serif font-extrabold text-slate-900">Cakupan Pembinaan Wilayah Palembang, Lampung, Jakarta &amp; Sekitarnya</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Palembang, Plaju &amp; Tanjung Api-Api</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Pembinaan tim pemeliharaan pipa udara, tangki industri pupuk/kilang minyak, pengecatan struktur dermaga, serta instalasi atap gudang logistik Sumsel.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Prabumulih, Muara Enim &amp; Lahat</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Sertifikasi pekerja rig pemboran, jaringan menara SUTET PLN, PLTU mulut tambang, serta pemeliharaan conveyor tinggi kawasan batu bara.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Bandar Lampung &amp; Bakauheni</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Program TKBT &amp; TKPK untuk tim konstruksi pelabuhan penyeberangan, pemanjat tower telekomunikasi regional Sumbagsel, serta pabrik industri Panjang.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">DKI Jakarta (Sudirman, Thamrin, Kuningan, TB Simatupang)</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Sertifikasi rutin operator akses tali gedung bertingkat (facade maintenance, pemasangan signage, cleaning kaca gondola &amp; tali), serta proyek MRT/gedung CBD.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Bekasi, Cikarang, Karawang &amp; Tangerang</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Tim maintenance atap pabrik manufaktur, instalasi solar panel (PLTS atap pabrik), serta teknisi overhead crane rail dan gudang logistik high-bay.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Cilegon, Anyer &amp; Merak</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Pekerjaan konstruksi perancah kolom distilasi petrokimia dan akses tali untuk inspeksi Non-Destructive Testing (NDT) cerobong asap pabrik kimia.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Fall Protection Hierarchy & Practical Drills -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
