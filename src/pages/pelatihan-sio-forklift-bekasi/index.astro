---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { waLink } from '../../data/contact.js';

const title = "Pelatihan SIO Operator Forklift Bekasi Resmi Kemnaker";
const description = "Pelatihan SIO Operator Forklift resmi Kemnaker RI di Bekasi dan Cikarang. Praktik unit kelas I dan II, in-house MM2100 serta Jababeka. Cek jadwal WA.";
const canonical = "/pelatihan-sio-forklift-bekasi/";
const ogImage = "https://konsultank3.com/assets/images/pelatihan-sio-forklift-bekasi-hero.jpg";

const faqs = [
  {
    q: "Apa syarat mengikuti pelatihan SIO Operator Forklift di Bekasi?",
    a: "Sesuai Permenaker No. 8 Tahun 2020, calon peserta wajib berusia minimal 18 tahun, sehat jasmani dan rohani (dibuktikan surat keterangan sehat dokter), berpendidikan minimal SMP/SMA sederajat untuk Kelas II atau SMA/SMK sederajat untuk Kelas I, melampirkan fotokopi KTP, pasfoto latar belakang merah, serta surat rekomendasi perusahaan jika dikirim sebagai utusan pabrik atau gudang."
  },
  {
    q: "Apa perbedaan SIO Forklift Kelas I dan Kelas II Kemnaker RI?",
    a: "SIO Forklift Kelas II berwenang mengoperasikan forklift dengan kapasitas angkat di bawah 15 ton (paling umum untuk counterbalance, reach truck, dan forklift gudang 2,5–10 ton). Sedangkan SIO Forklift Kelas I berwenang mengoperasikan forklift berkapasitas di atas 15 ton (termasuk reach stacker dan heavy forklift logistik/kontainer) serta berhak mengawasi operator Kelas II."
  },
  {
    q: "Berapa estimasi biaya pelatihan SIO Forklift Bekasi untuk perusahaan dan mandiri?",
    a: "Estimasi investasi kelas public offline di Bekasi berkisar Rp4.800.000–Rp6.000.000 per peserta untuk Kelas II (< 15 ton) dan Rp6.000.000–Rp7.500.000 untuk Kelas I (> 15 ton), sudah termasuk modul, praktik unit forklift, konsumsi, evaluasi, serta pengurusan Sertifikat & Lisensi SIO Kemnaker RI. Untuk paket in-house di pabrik kawasan MM2100, Jababeka, atau EJIP tersedia tarif korporasi sesuai kuota peserta."
  },
  {
    q: "Berapa lama durasi pelatihan dan berapa lama kartu SIO terbit?",
    a: "Pelatihan berlangsung 3 hingga 4 hari kerja efektif (teori K3 pesawat angkat-angkut, perhitungan beban aman, pemeriksaan P2H harian, serta praktik olah gerak unit dan ujian evaluasi). Setelah dinyatakan lulus, Surat Keterangan Lulus (SKL) sementara dapat diterbitkan sambil menunggu pencetakan kartu fisik SIO/Lisensi K3 melalui sistem TemanK3 Kemnaker RI."
  },
  {
    q: "Apakah bisa mengadakan In-House Training SIO Forklift di pabrik kawasan Cikarang dan Cibitung?",
    a: "Bisa. Kami rutin menyelenggarakan in-house training langsung di fasilitas gudang dan manufaktur di MM2100 Cibitung, Kawasan Industri Jababeka, EJIP, Delta Silicon, GIIC Deltamas, BIIE Hyundai, hingga Marunda dan Narogong menggunakan unit forklift operasional perusahaan Anda."
  },
  {
    q: "Apakah bisa sekalian mengurus perpanjangan SIO Forklift yang sudah habis masa berlakunya?",
    a: "Ya. Masa berlaku Lisensi/SIO Operator Forklift Kemnaker RI adalah 5 (lima) tahun. Kami melayani proses perpanjangan SIO sebelum maupun sesudah masa berlaku berakhir dengan estimasi biaya Rp2.200.000–Rp2.800.000 per peserta, meliputi verifikasi dokumen lama, penyegaran materi K3, dan penerbitan kartu perpanjangan resmi."
  },
  {
    q: "Apakah keaslian SIO Forklift bisa dicek saat audit pelanggan atau sidak Disnaker Bekasi?",
    a: "Ya. Seluruh sertifikat pembinaan dan Lisensi/SIO K3 Operator Forklift diterbitkan melalui PJK3 penunjukan resmi Kemnaker RI dan dilengkapi QR code serta nomor registrasi yang dapat diverifikasi langsung melalui portal TemanK3 maupun saat inspeksi UPTD Pengawasan Ketenagakerjaan Wilayah II Jawa Barat."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "SIO Forklift Bekasi", "item": "https://konsultank3.com/pelatihan-sio-forklift-bekasi/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan & Sertifikasi SIO Operator Forklift Bekasi Resmi Kemnaker RI",
      "description": description,
      "courseCode": "SIO-FL-BKS-KEMNAKER",
      "educationalCredentialAwarded": "Sertifikat Pembinaan & Surat Izin Operator (SIO) Forklift Kemnaker RI",
      "occupationalCategory": "Operator Pesawat Angkat dan Pesawat Angkut (Forklift)",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": "4800000",
        "highPrice": "7500000",
        "offerCount": "2"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": ["Onsite", "Blended"],
        "courseWorkload": "PT32H",
        "location": {
          "@type": "Place",
          "name": "Pusat Praktik & Pelatihan K3 Bekasi - Cikarang",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Bekasi",
            "addressRegion": "Jawa Barat",
            "addressCountry": "ID"
          }
        }
      }
    },
    {
      "@type": "Service",
      "name": "Layanan Pelatihan & In-House SIO Forklift Wilayah Bekasi dan Cikarang",
      "serviceType": "Sertifikasi Operator Pesawat Angkat & Angkut Kemnaker RI",
      "url": "https://konsultank3.com/pelatihan-sio-forklift-bekasi/",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com",
        "telephone": "+62-895-1025-3435"
      },
      "areaServed": [
        "Kota Bekasi",
        "Kabupaten Bekasi",
        "Cikarang",
        "Cibitung",
        "Tambun",
        "MM2100",
        "Jababeka",
        "Delta Silicon",
        "Deltamas",
        "Narogong"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={pageSchema}
  presetMessage="Halo Kak, saya mau info jadwal dan biaya Pelatihan SIO Operator Forklift Kemnaker di Bekasi."
>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">

      <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">SIO Forklift Bekasi</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse-glow"></span>
            Permenaker No. 8 Tahun 2020 &bull; Koridor Industri Bekasi &amp; Cikarang
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-yellow-300 to-amber-500">SIO Operator Forklift Bekasi</span> Resmi Kemnaker
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Program pembinaan resmi Kementerian Ketenagakerjaan RI untuk mencetak operator forklift bersertifikat dan berlisensi Surat Izin Operator (SIO) Kelas I &amp; II bagi pabrik manufaktur, pusat logistik, dan pergudangan di kawasan Bekasi, Cibitung, dan Cikarang.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, saya mau info jadwal dan biaya Pelatihan SIO Forklift Kemnaker di Bekasi.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Konsultasi Jadwal &amp; Biaya WA</span>
              <span>&rarr;</span>
            </a>
            <a
              href="#biaya"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Estimasi Biaya &amp; Silabus
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kewenangan</span>
              <p class="text-white font-bold text-sm">Kelas I &amp; II Kemnaker</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi Pembinaan</span>
              <p class="text-white font-bold text-sm">3 – 4 Hari (30–40 JP)</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Zona Industri</span>
              <p class="text-white font-bold text-sm">MM2100 &amp; Jababeka</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Masa Berlaku SIO</span>
              <p class="text-emerald-400 font-bold text-sm">5 Tahun (TemanK3)</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Hero Photo Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/pelatihan-sio-forklift-bekasi-hero.jpg"
              alt="Pelatihan SIO Operator Forklift di gudang industri Bekasi"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Teori Regulasi + Praktik Unit Langsung
              </span>
              <div class="text-lg font-bold">Standar Operasi Gudang &amp; Pabrik Bekasi</div>
              <p class="text-xs text-slate-300 mt-1">
                Uji kestabilan beban, inspeksi P2H harian, olah gerak lorong sempit, dan verifikasi lisensi Kemnaker RI.
              </p>
            </div>
          </div>

          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">✓</div>
            <div>
              <div class="text-xs font-bold text-white">Lisensi Resmi Kemnaker</div>
              <div class="text-[10px] text-slate-400">Terdata Portal TemanK3</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🏭</div>
            <div>
              <div class="text-xs font-bold text-white">In-House Cikarang &amp; Cibitung</div>
              <div class="text-[10px] text-slate-400">Praktik di Gudang Klien</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Notice Strip -->
  <aside aria-label="Informasi Pembaruan & Jadwal" class="w-full bg-amber-500/10 border-b border-amber-500/20 py-3 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-800 font-medium">
      <span class="inline-flex items-center gap-1.5 font-bold text-amber-900">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Diperbarui November 2026 &bull; Kelas Bekasi &amp; Cikarang:
      </span>
      <span class="text-slate-700">Tersedia Public Class Bekasi, Perpanjangan SIO, dan In-House Pabrik.</span>
      <a
        href={waLink("Halo Kak, boleh minta jadwal batch SIO Forklift Bekasi bulan ini dan penawaran corporate?")}
        target="_blank"
        rel="noopener"
        class="text-emerald-700 hover:text-emerald-800 font-bold underline ml-1"
      >
        Cek Jadwal via WhatsApp &rarr;
      </a>
    </div>
  </aside>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Quick Answer + Summary Table -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block">Ringkasan Jawaban Cepat</span>
        <h2 class="text-2xl font-serif font-bold text-slate-900">Apa Itu Pelatihan SIO Forklift Bekasi?</h2>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          <strong>Pelatihan SIO Operator Forklift Bekasi</strong> adalah pembinaan resmi berbasis <strong>Permenaker No. 8 Tahun 2020</strong> untuk membekali operator gudang dan pabrik agar mampu mengoperasikan forklift secara aman sekaligus memperoleh <strong>Sertifikat &amp; Lisensi Surat Izin Operator (SIO) Kemnaker RI</strong>. Pelatihan berlangsung 3–4 hari (teori K3 dan praktik unit langsung) di area Bekasi–Cikarang maupun secara in-house di lokasi pabrik.
        </p>
        <div class="p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-xs text-emerald-950 leading-relaxed">
          <strong>Catatan Audit Gudang:</strong> Mengoperasikan forklift tanpa SIO sah melanggar UU No. 1 Tahun 1970 dan langsung menjadi temuan mayor pada audit SMK3 PP 50/2012, ISO 45001, maupun inspeksi pelanggan otomotif dan logistik.
        </div>
      </div>

      <div class="lg:col-span-6 overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-slate-700">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th class="py-3.5 px-5">Informasi Utama</th>
              <th class="py-3.5 px-5">Detail Program Bekasi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Lembaga Penerbit</td>
              <td class="py-3 px-5">Kementerian Ketenagakerjaan RI (via PJK3 Resmi)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Dokumen Terbit</td>
              <td class="py-3 px-5">Sertifikat Pembinaan K3 + Kartu Lisensi SIO</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Jenjang Kelas</td>
              <td class="py-3 px-5">Kelas II (&lt; 15 Ton) &amp; Kelas I (&ge; 15 Ton)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Durasi &amp; Metode</td>
              <td class="py-3 px-5">3 – 4 Hari (Teori + Praktik Unit Lapangan / In-House)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Estimasi Biaya</td>
              <td class="py-3 px-5 font-semibold text-emerald-700">Mulai Rp4.800.000 / peserta (Kelas II Corporate/Public)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Masa Berlaku</td>
              <td class="py-3 px-5">5 Tahun (Dapat diperpanjang sebelum kedaluwarsa)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Local Industrial Context Bekasi & Cikarang -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-2">Konteks Industri Bekasi</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Mengapa Operator Forklift di Kawasan Bekasi &amp; Cikarang Wajib Mengantongi SIO Resmi?
        </h2>
        <div class="h-1 w-20 bg-amber-500 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          Koridor Bekasi hingga Cikarang merupakan klaster manufaktur dan pusat distribusi logistik terpadat di Indonesia. Ribuan unit forklift counterbalance (diesel, LPG, elektrik), reach truck rak tinggi, hingga reach stacker beroperasi 24 jam penuh di lintas shift pabrik otomotif, FMCG, bahan kimia, dan gudang 3PL.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center font-bold text-xl">⚖️</div>
          <h3 class="font-bold text-slate-900 text-lg">Kepatuhan Audit Disnaker &amp; Klien Tier-1</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Pabrik pemasok otomotif, elektronik, dan FMCG di Bekasi rutin diaudit oleh <strong>UPTD Pengawasan Ketenagakerjaan Wilayah II Jawa Barat</strong> serta auditor vendor CSMS. Kepemilikan SIO yang aktif bagi setiap operator shift merupakan syarat kelulusan wajib.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-blue-500/10 text-blue-700 flex items-center justify-center font-bold text-xl">📦</div>
          <h3 class="font-bold text-slate-900 text-lg">Risiko Gudang Rak Tinggi &amp; Lalu Lintas</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Kecelakaan forklift terguling, palet jatuh dari rak tinggi, atau benturan dengan pejalan kaki sering berakar pada kesalahan membaca <em>load chart</em> dan titik berat beban. Pembekalan teknis mencegah kerusakan aset bernilai ratusan juta rupiah.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 text-emerald-700 flex items-center justify-center font-bold text-xl">🛡️</div>
          <h3 class="font-bold text-slate-900 text-lg">Perlindungan Hukum &amp; Klaim BPJS</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Apabila terjadi insiden kecelakaan kerja yang melibatkan unit forklift tanpa operator bersertifikat SIO resmi, manajemen berisiko terkena sanksi pidana pelanggaran UU No. 1 Tahun 1970 serta kendala investigasi klaim asuransi kerja.
          </p>
        </div>
      </div>

      <div class="p-8 rounded-3xl bg-slate-900 text-white border border-white/10 space-y-5">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-amber-400">Jangkauan Kawasan Industri</span>
            <h3 class="text-xl sm:text-2xl font-bold font-serif text-white mt-1">Area Layanan Public &amp; In-House Forklift Bekasi Raya</h3>
          </div>
          <a
            href={waLink("Halo Kak, kami mau minta penawaran In-House Training SIO Forklift untuk gudang/pabrik kami di Bekasi/Cikarang.")}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition-colors whitespace-nowrap self-start md:self-auto"
          >
            Ajukan Penawaran In-House &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-300">
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">MM2100 Industrial Town (Cibitung)</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Jababeka I–VI (Cikarang)</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">EJIP &amp; BIIE Hyundai (Cikarang Selatan)</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Delta Silicon &amp; GIIC Deltamas</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Kawasan Industri Tambun &amp; Setu</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Koridor Narogong &amp; Bantargebang</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Marunda Center &amp; Tarumajaya</div>
