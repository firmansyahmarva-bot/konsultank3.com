        </h2>
      </div>

      <div class="divide-y divide-slate-200 border-y border-slate-200">
        {pageSchema["@graph"][3].mainEntity.map((item, idx) => (
          <div class="py-5 space-y-2">
            <h3 class="font-bold text-slate-900 text-base flex items-start gap-3">
              <span class="text-teal-600 font-serif font-black">Q{idx + 1}.</span>
              <span>{item.name}</span>
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed pl-8">
              {item.acceptedAnswer.text}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Bottom Conversion Banner -->
    <section class="p-8 sm:p-12 rounded-3xl bg-slate-950 text-white relative overflow-hidden shadow-2xl border border-white/10">
      <div class="relative z-10 max-w-2xl space-y-6">
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Kuasai Standar Pengukuran Lingkungan Kerja &amp; Raih Sertifikat HIMU BNSP
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Amankan sertifikat kompetensi resmi berlogo Garuda Emas. Fasilitas lengkap: modul komprehensif, simulasi alat ukur, bimbingan portofolio pra-asesmen, dan jaminan kelayakan ujian.
        </p>
        <div class="flex flex-wrap gap-4 pt-2">
          <a
            href={waLink("Halo Kak, boleh minta kirimkan proposal resmi dan silabus pelatihan HIMU BNSP untuk perusahaan kami.")}
            target="_blank"
            rel="noopener"
            class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-400 hover:to-emerald-500 text-slate-950 font-bold text-sm shadow-lg shadow-teal-500/20 transition-all"
          >
            Minta Proposal &amp; Jadwal Terdekat
          </a>
          <a
            href="/kontak/"
            class="px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/10 transition-colors"
          >
