---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pillars } from '../../data/topics.js';

const publishedArticles = await getCollection('artikel', ({ data }) => !data.draft);
const hasPublished = publishedArticles.length > 0;

const title = "Pusat Artikel & Rujukan K3 Indonesia";
const description = "Indeks publikasi dan rujukan ilmiah keselamatan dan kesehatan kerja (K3), standar kepatuhan regulasi Kemnaker RI, dan panduan audit SMK3.";
const canonical = "/artikel/";

const grouped = {
  'program-pengendalian-kebisingan': publishedArticles.filter(a => a.data.pillar === 'program-pengendalian-kebisingan'),
  'alat-pelindung-diri': publishedArticles.filter(a => a.data.pillar === 'alat-pelindung-diri'),
  'penyakit-akibat-kerja': publishedArticles.filter(a => a.data.pillar === 'penyakit-akibat-kerja'),
  'panduan-penerapan-smk3': publishedArticles.filter(a => a.data.pillar === 'panduan-penerapan-smk3')
};

const robots = hasPublished ? 'index, follow' : 'noindex, follow';
---

<BaseLayout
  title={`${title} » Konsultan K3`}
  description={description}
  canonical={canonical}
  robots={robots}
  presetMessage="Halo KonsultanK3, saya ingin konsultasi topik artikel keselamatan kerja."
>
  <header class="bg-slate-950 text-white pt-12 pb-16 border-b border-white/10 relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:16px_16px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-slate-300">Pusat Artikel</span>
      </nav>

      <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
        Pusat Publikasi &amp; Edukasi K3
      </span>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
        Indeks Artikel &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Rujukan Kepatuhan K3</span>
      </h1>

      <p class="text-slate-300 text-base sm:text-lg max-w-3xl leading-relaxed">
        Pusat kajian keselamatan dan kesehatan kerja industri, telaah regulasi ketenagakerjaan terkini, pedoman implementasi lapangan, dan standar keselamatan terverifikasi.
      </p>
    </div>
  </header>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    {hasPublished ? (
      <div class="space-y-16">
        {Object.values(pillars).map((p) => {
          const items = grouped[p.id] || [];
          if (items.length === 0) return null;
          return (
            <section class="space-y-6">
              <div class="flex items-center justify-between border-b border-slate-200 pb-4">
                <div>
                  <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block mb-1">Kategori Pilar</span>
                  <h2 class="font-serif text-2xl font-bold text-slate-900">{p.title}</h2>
                </div>
                <a href={p.path} class="text-xs font-bold text-emerald-600 hover:text-emerald-700">
                  Lihat Pilar Induk &rarr;
                </a>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                {items.map((entry) => {
                  const slug = entry.id.replace(/\.[^/.]+$/, '').replace(/\\/g, '/').split('/').pop();
                  return (
                    <article class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-lg transition-all flex flex-col justify-between">
                      <div class="space-y-2">
                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 block">
                          {p.shortName}
                        </span>
                        <h3 class="font-serif font-bold text-lg text-slate-900 hover:text-amber-600 transition-colors">
                          <a href={`/artikel/${slug}/`}>{entry.data.title}</a>
                        </h3>
                        <p class="text-xs text-slate-600 leading-relaxed line-clamp-3">
                          {entry.data.description}
                        </p>
                      </div>
                      <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                        <span class="text-slate-400">
                          {entry.data.updated ? entry.data.updated.toISOString().split('T')[0] : '2026-11-10'}
                        </span>
                        <a href={`/artikel/${slug}/`} class="font-bold text-emerald-600 hover:text-emerald-700">
                          Baca &rarr;
                        </a>
                      </div>
                    </article>
                  );
                })}
              </div>
            </section>
          );
        })}
      </div>
    ) : (
      <div class="max-w-2xl mx-auto p-12 text-center rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-2xl mx-auto">
          📚
        </div>
        <h2 class="font-serif text-2xl font-bold text-slate-900">Koleksi Artikel Sedang Dalam Penyusunan</h2>
        <p class="text-sm text-slate-600 leading-relaxed">
          Koleksi artikel regulasi baru sedang dipersiapkan oleh dewan redaksi keselamatan kerja. Untuk saat ini, Anda dapat mengakses panduan lengkap pada 4 pilar utama kami:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 text-left">
          {Object.values(pillars).map((p) => (
            <a
              href={p.path}
              class="p-4 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/50 transition-all block"
            >
              <h4 class="font-serif font-bold text-sm text-slate-900">{p.shortName}</h4>
              <p class="text-[11px] text-slate-500 mt-1 line-clamp-1">{p.anchorText}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </main>
</BaseLayout>
