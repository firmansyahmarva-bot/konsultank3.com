---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { getPillarById } from '../../../data/topics.js';

export async function getStaticPaths() {
  const articles = await getCollection('artikel', ({ data }) => !data.draft);
  return articles.map((entry) => {
    const slug = entry.id.replace(/\.[^/.]+$/, '').replace(/\\/g, '/').split('/').pop();
    return {
      params: { slug },
      props: { entry }
    };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const canonical = `/artikel/${Astro.params.slug}/`;
const pillar = getPillarById(entry.data.pillar);
const updatedStr = entry.data.updated ? entry.data.updated.toISOString().split('T')[0] : '2026-11-10';
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonical}
  publishDate={updatedStr}
  updatedDate={updatedStr}
  category={pillar ? pillar.shortName : 'Panduan K3'}
  pillarId={entry.data.pillar}
>
  <Content />
</ArticleLayout>
