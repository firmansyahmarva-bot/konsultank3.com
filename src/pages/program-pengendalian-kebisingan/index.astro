---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticlesForPillar } from '../../data/topics.js';

const title = "Program Pengendalian Kebisingan Industri & Standar NAB";
const metaTitle = "Program Pengendalian Kebisingan Industri & Standar NAB";
const description = "Panduan lengkap program pengendalian kebisingan kerja, standar NAB 85 dBA per 8 jam Permenaker 5/2018, hierarki kendali akustik, dan hearing conservation.";
const canonical = "/program-pengendalian-kebisingan/";

const mappedArticles = getArticlesForPillar('program-pengendalian-kebisingan');

const faqs = [
  {
    q: "Berapa Nilai Ambang Batas (NAB) kebisingan di tempat kerja untuk waktu kerja 8 jam per hari?",
    a: "Berdasarkan Permenaker No. 5 Tahun 2018 tentang K3 Lingkungan Kerja, Nilai Ambang Batas (NAB) kebisingan di tempat kerja ditetapkan sebesar 85 dBA untuk waktu pajanan maksimum 8 jam per hari tanpa alat pelindung telinga."
  },
  {
    q: "Bagaimana perhitungan batas waktu pajanan jika kebisingan melebihi 85 dBA?",
    a: "Regulasi menerapkan exchange rate 3 dBA, di mana setiap peningkatan intensitas bising sebesar 3 dBA akan memotong durasi pajanan aman menjadi setengahnya: 88 dBA untuk 4 jam, 91 dBA untuk 2 jam, 94 dBA untuk 1 jam, 97 dBA untuk 30 menit, dan 100 dBA untuk 15 menit per hari. Intensitas 140 dBA tidak boleh diterima pekerja sama sekali walaupun sesaat."
  },
  {
    q: "Mengapa nilai NRR pada label kemasan pelindung telinga harus dihitung ulang (derating)?",
    a: "Pengujian laboratorium dilakukan pada kondisi ideal dan pas sempurna. Di tempat kerja nyata, terjadi penurunan performa akibat pergerakan rahang, rambut, kacamata, atau pemasangan longgar. Formula derating menghitung reduksi nyata di gendang telinga: Kebisingan Terukur (dBA) dikurangi [(NRR - 7) / 2]."
  },
  {
    q: "Apa saja langkah pengendalian teknis (engineering controls) untuk meredam kebisingan mesin?",
    a: "Pengendalian teknis meliputi pemasangan silencer atau peredam pada exhaust udara bertekanan, acoustic enclosure (penutup kedap suara) untuk genset dan turbin, vibration dampener pada fondasi penyangga mesin getar, dan penyekatan kabin ruang kontrol operator."
  },
  {
    q: "Kapan perusahaan wajib menerapkan program konservasi pendengaran (Hearing Conservation Program)?",
    a: "Perusahaan wajib menerapkan Hearing Conservation Program ketika pajanan kebisingan di area operasional menyentuh atau melampaui action level 85 dBA. Program ini mencakup pemetaan kebisingan berkala, pengendalian hierarkis, penyediaan APD telinga teruji, pelatihan pekerja, dan uji audiometri berkala."
  }
];
---

