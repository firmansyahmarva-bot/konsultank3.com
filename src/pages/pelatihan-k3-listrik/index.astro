---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { batches } from '../../data/batches.js';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const batch = batches.listrik;

const title = "Pelatihan Teknisi & Ahli K3 Listrik Kemnaker";
const description = "Program pembinaan sertifikasi Teknisi K3 Listrik dan Ahli K3 Listrik resmi Kemnaker RI sesuai Permenaker No. 12 Tahun 2015 dan standar teknis PUIL 2020.";
const canonical = "/pelatihan-k3-listrik/";

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "K3 Listrik", "item": "https://konsultank3.com/pelatihan-k3-listrik/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan Teknisi & Ahli K3 Listrik Industri Kemnaker RI",
      "description": "Program pembinaan kompetensi teknis keselamatan ketenagalistrikan industri untuk Teknisi K3 Listrik dan Ahli K3 Listrik sesuai Permenaker No. 12 Tahun 2015.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={courseSchema}>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">K3 Listrik</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold border border-blue-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
            Sertifikasi Resmi Kemnaker RI &bull; Permenaker No. 12 Tahun 2015
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Teknisi &amp; Ahli K3 Listrik</span> Industri
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Pembinaan keselamatan ketenagalistrikan industri untuk mencegah bahaya sengatan listrik, kebakaran akibat arus pendek, ledakan busur api (arc flash), serta memastikan instalasi memenuhi standar teknis PUIL 2020.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi Pelatihan Teknisi dan Ahli K3 Listrik")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi WhatsApp Resmi &rarr;
            </a>
            <a
              href="#jenjang-pelatihan"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Jenjang Teknisi &amp; Ahli
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Tingkatan</span>
              <p class="text-white font-bold text-sm">Teknisi &amp; Ahli</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Standar</span>
              <p class="text-white font-bold text-sm">PUIL 2020 &amp; IEC</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen</span>
              <p class="text-white font-bold text-sm">Lisensi Kemnaker RI</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kualifikasi</span>
              <p class="text-emerald-400 font-bold text-sm">Kompetensi Industri</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/Ilmu-Keseker.jpg"
              alt="Inspeksi Panel Daya dan Pengukuran Grounding K3 Listrik"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-500 text-white mb-2">
                Standar PUIL &amp; SNI Elektrikal
              </span>
              <div class="text-lg font-bold">Kelaikan Panel &amp; Proteksi Arus Bocor</div>
              <p class="text-xs text-slate-300 mt-1">Uji resistansi isolasi, pembumian grounding &lt;5 Ohm, serta proteksi penyalur petir instalasi gedung dan pabrik.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500 text-white flex items-center justify-center font-bold text-lg">
              ⚡
            </div>
            <div>
              <div class="text-xs font-bold text-white">Lisensi K3 Listrik</div>
              <div class="text-[10px] text-slate-400">Teknisi &amp; Ahli Resmi Kemnaker</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🔌</div>
            <div>
              <div class="text-xs font-bold text-white">Safety Lockout / Tagout (LOTO)</div>
              <div class="text-[10px] text-slate-400">Proteksi Nol Energi Maintenance</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Article Content Column -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section 1: Apa itu Pelatihan K3 Listrik -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Pengenalan Program</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Apa itu Pelatihan K3 Listrik</h2>
          </div>
          <p class="text-base sm:text-lg text-slate-700 font-light leading-relaxed">
            Pelatihan K3 Listrik adalah program pembinaan dan sertifikasi kompetensi ketenagakerjaan yang dirancang secara terpadu untuk membekali tenaga kerja teknik dengan wawasan regulasi, pemahaman bahaya listrik, keterampilan pengukuran instrumen elektrikal, serta penerapan prosedur keselamatan kerja pada instalasi listrik di industri. Energi listrik merupakan penggerak utama mesin produksi dan fasilitas fasilitas kerja modern, namun menyimpan potensi bahaya fatal apabila tidak dirancang, dipasang, dioperasikan, dan diperiksa oleh personel yang memiliki kompetensi teknis resmi.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Bahaya ketenagalistrikan di tempat kerja dapat termanifestasi dalam berbagai bentuk ancaman fisik. Bahaya sengatan arus kejut listrik terhadap tubuh manusia dapat melumpuhkan sistem syaraf dan menyebabkan henti jantung mendadak. Selain itu, arus hubung singkat (short circuit) berpotensi memicu percikan bunga api berkekuatan tinggi, pelepasan energi busur api (arc flash), serta ledakan termal pada ruang panel distribusi yang berujung pada kebakaran fasilitas industri berskala besar.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kewajiban penyelenggaraan keselamatan instalasi listrik ditegaskan secara yuridis dalam ketentuan Permenaker No. 12 Tahun 2015 tentang Keselamatan dan Kesehatan Kerja Listrik di Tempat Kerja. Peraturan ini mewajibkan setiap perusahaan yang membangkitkan, mentransmisikan, mendistribusikan, atau memanfaatkan energi listrik untuk mempekerjakan Teknisi K3 Listrik dan Ahli K3 Listrik yang telah lulus pembinaan dan memiliki lisensi kewenangan resmi dari Kementerian Ketenagakerjaan RI.
          </p>
          <div class="p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20 space-y-3">
            <h3 class="text-base font-bold text-amber-900">Siapa Saja yang Membutuhkan Pelatihan Ini?</h3>
            <p class="text-sm text-slate-700 font-light leading-relaxed">
              Program pembinaan teknis ketenagalistrikan ini mutlak dibutuhkan oleh seluruh instalasi kerja yang menggunakan jaringan listrik industri, antara lain:
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-700 font-light">
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Teknisi Pemeliharaan Listrik (Electrical Maintenance):</strong> Bertanggung jawab atas perawatan rutin trafo, kubikel, dan gardu distribusi.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pabrik Manufaktur &amp; Industri Berat:</strong> Mengoperasikan motor listrik berdaya besar, kompresor, dan panel daya tegangan menengah.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Kontraktor Mekanikal &amp; Elektrikal (MEP):</strong> Melakukan instalasi kabel jaringan, terminasi panel distribusi, dan pemipaan konduit.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pengelola Gedung Komersial &amp; Rumah Sakit:</strong> Mengelola gardu listrik internal, generator cadangan (genset), dan instalasi sistem UPS.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Supervisor &amp; Ahli K3 Perusahaan:</strong> Mengawasi kepatuhan kelaikan instalasi listrik dan menyusun dokumen izin kerja kelistrikan.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Sektor Pembangkit &amp; Energi:</strong> Menjalankan operasional turbin, jaringan transmisi daya, serta gardu hubung tegangan tinggi.</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Jenjang / Jenis Pelatihan -->
        <section id="jenjang-pelatihan" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Klasifikasi &amp; Tingkatan</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Jenjang / Jenis Pelatihan</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Sistem kualifikasi K3 kelistrikan diatur secara berjenjang guna membedakan ruang lingkup pelaksanaan teknis lapangan dengan fungsi perencanaan, pengawasan, serta audit kelaikan instalasi. Penjenjangan resmi terdiri dari Teknisi K3 Listrik dan Ahli K3 Listrik sebagaimana dirangkum dalam tabel berikut:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white text-xs uppercase font-semibold">
                <tr>
                  <th class="py-4 px-4 sm:px-6">Jenjang / Jenis</th>
                  <th class="py-4 px-4 sm:px-6">Peran</th>
                  <th class="py-4 px-4 sm:px-6">Tugas utama</th>
                  <th class="py-4 px-4 sm:px-6">Materi kunci</th>
                  <th class="py-4 px-4 sm:px-6">Persyaratan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">Teknisi K3 Listrik</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Pelaksana Teknis Lapangan</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Pemasangan, perbaikan, pemeliharaan instalasi listrik, serta penerapan isolasi energi berbahaya LOTO</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Dasar keselamatan listrik, bahaya arus kejut &amp; short circuit, prosedur isolasi energi Lockout Tagout (LOTO), pengukuran tahanan isolasi &amp; pembumian</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Minimal SMK Teknik Listrik / SLTA + pengalaman kerja 2 tahun</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">Ahli K3 Listrik</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Pengawas &amp; Auditor Kelaikan</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Perencanaan sistem proteksi, pengawasan norma keselamatan elektrikal, serta penyusunan laporan audit kelaikan instalasi berlisensi</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Kajian regulasi &amp; PUIL 2020, proteksi perlengkapan &amp; circuit breaker, audit &amp; inspeksi K3 listrik, penyusunan laporan evaluasi kelaikan instalasi berlisensi Kemnaker RI</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Minimal D3 / S1 Teknik Elektro / Mesin / Fisika</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-sm text-slate-600 font-light leading-relaxed">
            Pembagian jenjang ini memastikan pembagian tanggung jawab yang jelas dalam operasional kelistrikan. Teknisi K3 Listrik bertindak sebagai pelaksana yang memastikan setiap tindakan intervensi pada kabel, panel, dan mesin industri dilakukan dengan aman tanpa risiko sengatan listrik. Sementara itu, Ahli K3 Listrik menjalankan kewenangan pengawasan kepatuhan teknis menyeluruh, merancang instalasi proteksi, serta mengevaluasi keandalan sistem agar seluruh peralatan memenuhi standar kelaikan operasi yang ditetapkan pemerintah.
          </p>
        </section>

        <!-- Section 3: Dasar Hukum -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Landasan Regulasi</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Dasar Hukum</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Pelaksanaan pembinaan kompetensi K3 listrik serta penerapan norma keselamatan ketenagalistrikan di tempat kerja berlandaskan pada peraturan perundang-undangan nasional yang berkekuatan hukum tetap, meliputi:
          </p>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">UU No. 1 Tahun 1970 tentang Keselamatan Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Undang-Undang Keselamatan Kerja merupakan payung hukum utama perlindungan keselamatan tenaga kerja di Indonesia. Pada Pasal 3 ayat (1) huruf q diamanatkan secara tegas kewajiban untuk mencegah terkena aliran listrik yang berbahaya di setiap tempat kerja. Regulasi ini menjadi landasan primer yang mewajibkan pengusaha menyediakan lingkungan kerja yang aman dari risiko sengatan listrik dan kebakaran instalasi daya.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Permenaker No. 12 Tahun 2015 tentang Keselamatan dan Kesehatan Kerja Listrik di Tempat Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peraturan ini mengatur secara komprehensif kewajiban perencanaan, pemasangan, penggunaan, perubahan, pemeliharaan, serta pemeriksaan dan pengujian instalasi listrik di tempat kerja. Regulasi ini mewajibkan perusahaan menunjuk Teknisi K3 Listrik dan Ahli K3 Listrik berlisensi resmi Kemnaker RI guna mengendalikan potensi bahaya arus listrik, sengatan listrik, serta bahaya kebakaran akibat korsleting. Ketentuan ini juga mewajibkan pemeriksaan dan pengujian instalasi listrik secara berkala oleh pengawas atau ahli yang berwenang.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Standar PUIL 2020 (Persyaratan Umum Instalasi Listrik) &amp; Standar IEC/NFPA</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Standar PUIL 2020 adalah acuan teknis nasional utama bagi seluruh perancangan dan pemasangan instalasi ketenagalistrikan tegangan rendah maupun menengah di Indonesia. Standar ini menetapkan batas aman resistansi pembumian grounding kurang dari 5 Ohm, tata cara proteksi sentuh langsung dan tidak langsung, serta pemilihan kapasitas pemutus arus sirkuit. Pedoman ini diharmonisasikan dengan standar internasional seperti IEC dan NFPA guna menjamin keselamatan manusia dan keandalan proteksi properti industri.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 4: Silabus Pembelajaran -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Materi Kurikulum</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Silabus Pembelajaran</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kurikulum pembinaan K3 listrik disusun secara sistematis mengacu pada standar pengawasan norma ketenagalistrikan Kemnaker RI. Setiap modul materi menggabungkan penguasaan landasan regulasi, pemahaman fisika kelistrikan, serta aplikasi instrumen pengujian lapangan:
          </p>

          <div class="space-y-5">
            <!-- Topic 1 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">01</span>
                Dasar Keselamatan Listrik
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini mengkaji fenomena fisika tegangan sentuh, ambang batas arus listrik yang berbahaya bagi tubuh manusia, serta mekanisme terjadinya fibrilasi jantung saat tersengat listrik. Peserta mempelajari kalkulasi beban daya, identifikasi potensi bahaya hubung singkat (short circuit), serta analisis bahaya termal akibat kelebihan beban jaringan. Pemahaman konseptual ini menjadi fondasi penting bagi teknisi dalam mengantisipasi kegagalan sistem kelistrikan sejak dini.
              </p>
            </div>

            <!-- Topic 2 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">02</span>
                Prosedur LOTO (Lockout / Tagout)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini membahas metodologi isolasi energi berbahaya pada pemeliharaan gardu induk, panel distribusi utama, dan motor-motor listrik industri bertenaga besar. Peserta dilatih menerapkan gembok pengaman fisik (lockout), label peringatan larangan operasi (tagout), serta prosedur pengujian energi sisa (zero energy state verification) sebelum pekerjaan dimulai. Penerapan disiplin prosedur LOTO terbukti efektif mengeliminasi risiko kecelakaan fatal akibat penyalaan mesin tanpa sengaja selama masa perbaikan.
              </p>
            </div>

            <!-- Topic 3 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">03</span>
                Sistem Grounding &amp; Proteksi Petir
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Materi ini mendalami konfigurasi sistem pembumian proteksi dan pembumian operasional pada jaringan distribusi listrik. Peserta dibekali teknik pengukuran nilai tahanan tanah menggunakan alat ukur Earth Resistance Tester guna memastikan resistansi pembumian berada di bawah batas ambang 5 Ohm. Selain itu, dipelajari pula audit instalasi sistem proteksi petir eksternal maupun internal pada gedung bertingkat dan bangunan industri guna melindungi struktur dari sambaran petir langsung.
              </p>
            </div>

            <!-- Topic 4 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">04</span>
                Peraturan Perundang-undangan K3 Listrik
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Kelompok materi ini membedah kebijakan nasional keselamatan kerja di sektor ketenagalistrikan sesuai amanat UU No. 1 Tahun 1970 dan Permenaker No. 12 Tahun 2015. Peserta mempelajari hak serta kewajiban hukum pengusaha, peran pengawasan ketenagakerjaan, serta harmonisasi ketentuan teknis dengan standar PUIL 2020 dan standar internasional IEC/NFPA. Modul ini menegaskan akuntabilitas hukum bagi penanggung jawab instalasi listrik dalam menjamin keselamatan fasilitas kerja.
              </p>
            </div>

            <!-- Topic 5 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">05</span>
                Identifikasi Bahaya &amp; Proteksi Listrik
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini berfokus pada analisis bahaya sengatan arus kejut listrik, pelepasan energi busur api (arc flash), serta potensi ledakan kelistrikan di area berbahaya. Peserta mempelajari prinsip rekayasa sistem pengamanan sentuh langsung melalui isolasi kabel dan penutup panel, serta proteksi sentuh tak langsung menggunakan gawai proteksi arus sisa (RCD/ELCB). Pembahasan juga mencakup karakteristik pemutus daya sirkuit (circuit breaker) dalam mengisolasi gangguan beban lebih secara selektif.
              </p>
            </div>

            <!-- Topic 6 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">06</span>
                Praktik Workshop &amp; Pengujian Instrumen
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Sesi workshop memberikan pengalaman langsung dalam melakukan pengujian fisik instalasi listrik menggunakan peralatan ukur standar industri. Peserta mempraktikkan pengukuran tahanan isolasi konduktor kabel menggunakan Megger Tester untuk mendeteksi degradasi isolasi sebelum terjadi kebocoran arus. Dilakukan pula pengukuran resistansi elektroda pembumian grounding dan inspeksi termografi inframerah pada sambungan terminal panel guna menemukan titik panas (hotspot) penyebab kebakaran.
              </p>
            </div>

            <!-- Topic 7 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">07</span>
                Inspeksi &amp; Audit K3 Listrik
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini dirancang khusus untuk membekali calon Ahli K3 Listrik dengan keterampilan melakukan audit instalasi elektrikal secara komprehensif. Peserta dilatih menyusun daftar periksa inspeksi kelaikan panel, menganalisis hasil uji resistansi, mengidentifikasi ketidaksesuaian terhadap standar PUIL 2020, serta merumuskan rencana tindakan perbaikan teknis. Kompetensi ini bermuara pada penyusunan dokumen laporan evaluasi kelaikan instalasi berlisensi resmi Kemnaker RI.
              </p>
            </div>

            <!-- Topic 8 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-blue-500/10 text-blue-700 font-mono text-xs flex items-center justify-center font-bold">08</span>
                Evaluasi
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Tahap evaluasi komprehensif diselenggarakan untuk mengukur daya serap materi teoritis dan kemahiran teknis peserta setelah mengikuti seluruh sesi pembinaan. Evaluasi mencakup ujian tertulis mengenai regulasi serta norma kelistrikan nasional, pengujian praktik penggunaan instrumen ukur, dan presentasi kertas kerja evaluasi instalasi. Hasil evaluasi ini menentukan kelayakan peserta untuk memperoleh lisensi kewenangan K3 listrik resmi.
              </p>
            </div>
          </div>
        </section>

