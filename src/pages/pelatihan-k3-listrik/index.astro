---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { batches } from '../../data/batches.js';
import { waLink } from '../../data/contact.js';

const batch = batches.listrik;

const title = "Pelatihan Teknisi & Ahli K3 Listrik Kemnaker";
const description = "Program pembinaan sertifikasi Teknisi K3 Listrik dan Ahli K3 Listrik berlisensi resmi Kemnaker RI sesuai Permenaker No. 12 Tahun 2015.";
const canonical = "/pelatihan-k3-listrik/";
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">K3 Listrik</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 text-blue-400 text-xs font-semibold border border-blue-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-blue-400 animate-ping"></span>
            Sertifikasi Resmi Kemnaker RI &bull; Permenaker No. 12 Tahun 2015
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Teknisi &amp; Ahli K3 Listrik</span> Industri
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Pembinaan keselamatan ketenagalistrikan industri untuk mencegah bahaya sengatan listrik, kebakaran akibat arus pendek, ledakan busur api (arc flash), serta memastikan instalasi memenuhi standar teknis PUIL 2020.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin info jadwal pelatihan Teknisi dan Ahli K3 Listrik")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Daftar Batch Listrik &rarr;
            </a>
            <a
              href="#modul-listrik"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Kurikulum Teknisi &amp; Ahli
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi</span>
              <p class="text-white font-bold text-sm">6 – 15 Hari</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Metode</span>
              <p class="text-white font-bold text-sm">Zoom + Workshop PUIL</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen</span>
              <p class="text-white font-bold text-sm">SKP &amp; Lisensi Kemnaker</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Tingkat Uji</span>
              <p class="text-emerald-400 font-bold text-sm">Garansi 100%</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/Ilmu-Keseker.jpg"
              alt="Inspeksi Panel Daya dan Pengukuran Grounding K3 Listrik"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-500 text-white mb-2">
                Standar PUIL &amp; SNI Elektrikal
              </span>
              <div class="text-lg font-bold">Kelaikan Panel &amp; Proteksi Arus Bocor</div>
              <p class="text-xs text-slate-300 mt-1">Uji resistansi isolasi, pembumian (grounding &lt;5 Ohm), dan penyalur petir gedung bertingkat.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-blue-500 text-white flex items-center justify-center font-bold text-lg">
              ⚡
            </div>
            <div>
              <div class="text-xs font-bold text-white">Lisensi K3 Listrik</div>
              <div class="text-[10px] text-slate-400">Teknisi &amp; Ahli Resmi Kemnaker</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🔌</div>
            <div>
              <div class="text-xs font-bold text-white">Safety Lockout / Tagout (LOTO)</div>
              <div class="text-[10px] text-slate-400">Proteksi Nol Energi Maintenance</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Layout -->
  <main class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <div class="lg:col-span-8 space-y-12">
        <div id="modul-listrik" class="grid grid-cols-1 sm:grid-cols-2 gap-6 scroll-mt-24">
          
    <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
      <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
        01
      </div>
      <h3 class="font-serif text-2xl font-normal text-zinc-900">Dasar Keselamatan Listrik</h3>
      <p class="text-zinc-600 font-light text-sm leading-relaxed">Pemahaman tegangan sentuh, bahaya arus kejut tubuh manusia, dan mitigasi bahaya short circuit.</p>
    </div>
  
    <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
      <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
        02
      </div>
      <h3 class="font-serif text-2xl font-normal text-zinc-900">Prosedur LOTO (Lockout/Tagout)</h3>
      <p class="text-zinc-600 font-light text-sm leading-relaxed">Pengendalian energi berbahaya pada pemeliharaan gardu induk, panel distribusi, dan motor industri.</p>
    </div>
  
    <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
      <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
        03
      </div>
      <h3 class="font-serif text-2xl font-normal text-zinc-900">Sistem Grounding & Proteksi Petir</h3>
      <p class="text-zinc-600 font-light text-sm leading-relaxed">Pengukuran resistansi pembumian menggunakan Earth Tester dan audit instalasi penangkal petir.</p>
    </div>
  
    <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
      <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
        04
      </div>
      <h3 class="font-serif text-2xl font-normal text-zinc-900">Inspeksi & Audit K3 Listrik</h3>
      <p class="text-zinc-600 font-light text-sm leading-relaxed">Kualifikasi Ahli K3 Listrik untuk menyusun laporan evaluasi kelaikan instalasi berlisensi Kemnaker RI.</p>
    </div>
  
        </div>

        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-zinc-200/80 shadow-sm space-y-8">
          <div class="border-b border-zinc-200 pb-6">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 block mb-1">Materi Pokok</span>
            <h2 class="font-serif text-3xl font-normal text-zinc-900">Silabus &amp; Kurikulum Pelatihan</h2>
          </div>
          <div class="space-y-6">
            
    <div class="p-6 rounded-2xl bg-zinc-50 border border-zinc-200/60 space-y-3">
      <h4 class="font-serif text-xl font-normal text-zinc-900">A. Peraturan Perundang-undangan K3 Listrik</h4>
      <ul class="list-disc pl-6 space-y-1.5 text-zinc-600 text-sm font-light">
        <li>Kebijakan K3 Nasional di Bidang Kelistrikan</li><li>Permenaker No. 12 Tahun 2015 tentang K3 Listrik di Tempat Kerja</li><li>Penerapan Standar PUIL 2020 & Standar IEC/NFPA</li>
      </ul>
    </div>
  
    <div class="p-6 rounded-2xl bg-zinc-50 border border-zinc-200/60 space-y-3">
      <h4 class="font-serif text-xl font-normal text-zinc-900">B. Identifikasi Bahaya & Proteksi Listrik</h4>
      <ul class="list-disc pl-6 space-y-1.5 text-zinc-600 text-sm font-light">
        <li>Bahaya Arus Kejut, Busur Api (Arc Flash), & Ledakan Listrik</li><li>Sistem Pengamanan Sentuh Langsung & Tak Langsung</li><li>Proteksi Perlengkapan Instalasi & Karakteristik Circuit Breaker</li><li>Penyelenggaraan Prosedur Isolasi & Lockout Tagout (LOTO)</li>
      </ul>
    </div>
  
    <div class="p-6 rounded-2xl bg-zinc-50 border border-zinc-200/60 space-y-3">
      <h4 class="font-serif text-xl font-normal text-zinc-900">C. Praktik Workshop & Pengujian</h4>
      <ul class="list-disc pl-6 space-y-1.5 text-zinc-600 text-sm font-light">
        <li>Pengukuran Tahanan Isolasi menggunakan Megger Tester</li><li>Pengujian Tahanan Pembumian (Grounding Resistance < 5 Ohm)</li><li>Inspeksi Termografi Inframerah pada Terminal Panel Listrik</li><li>Penyusunan Rencana Tindakan Perbaikan Instalasi Elektrikal</li>
      </ul>
    </div>
  
          </div>
        </div>

        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-zinc-200/80 shadow-sm space-y-6">
          <div class="border-b border-zinc-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 block mb-1">Persyaratan Peserta</span>
            <h3 class="font-serif text-2xl font-normal text-zinc-900">Kualifikasi &amp; Berkas Administrasi</h3>
          </div>
          <p class="text-zinc-700 font-light text-sm leading-relaxed">Teknisi: Minimal SMK Teknik Listrik / SLTA + pengalaman kerja 2 tahun. Ahli K3 Listrik: Minimal D3/S1 Teknik Elektro / Mesin / Fisika.</p>
        </div>
      </div>

      <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-32 self-start">
        <div class="bg-zinc-900 text-white rounded-3xl p-8 space-y-6 shadow-xl">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400">Pendaftaran Batch Resmi</span>
            <h3 class="font-serif text-2xl font-normal text-white">Amankan Kursi Pembinaan Anda</h3>
            <p class="text-xs font-mono text-zinc-400 leading-relaxed">
              Daftar sekarang untuk mendapatkan silabus lengkap, penawaran korporasi, dan kepastian kuota batch resmi Kemnaker RI.
            </p>
          </div>

          {batch ? (
            <div class="p-4 rounded-2xl bg-zinc-800/80 border border-zinc-700/60 space-y-2 text-xs">
              <div class="flex items-center justify-between">
                <span class="text-zinc-400">Jadwal Batch:</span>
                <span class="text-white font-mono font-bold">{batch.tanggal}</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-zinc-400">Sisa Kursi:</span>
                <span class="text-emerald-400 font-mono font-bold">{batch.sisa} Kursi</span>
              </div>
            </div>
          ) : (
            <div class="p-4 rounded-2xl bg-zinc-800/80 border border-zinc-700/60 text-xs text-zinc-300">
              <p>Jadwal batch dan biaya terbaru: tanyakan via WhatsApp</p>
            </div>
          )}

          <a href={waLink("Halo KonsultanK3, saya ingin mendaftar Pelatihan Teknisi & Ahli K3 Listrik Kemnaker RI")} target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 p-4 rounded-full bg-white text-zinc-900 font-semibold text-xs font-mono uppercase tracking-wider hover:bg-zinc-200 transition-colors shadow-lg">
            <span>Daftar via WhatsApp Resmi</span>
            <span>&rarr;</span>
          </a>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-3">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-500 block">Jaminan Layanan</span>
          <p class="text-xs text-zinc-600 font-light leading-relaxed">
            Didukung oleh instruktur senior praktisi industri dengan sertifikasi resmi Kemnaker RI dan fasilitas uji komprehensif.
          </p>
        </div>
      </aside>

    </div>
  </main>

  
</BaseLayout>
