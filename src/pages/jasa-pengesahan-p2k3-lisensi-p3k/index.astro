---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Jasa Pengesahan P2K3 & Lisensi Petugas P3K Resmi";
const description = "Jasa pengesahan P2K3 Kemnaker Disnaker dan pengurusan lisensi petugas P3K tempat kerja. Layanan cepat, legalitas terjamin, pendampingan pelaporan triwulan.";
const canonical = "/jasa-pengesahan-p2k3-lisensi-p3k/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Layanan Legalitas", "item": "https://konsultank3.com/audit-kepatuhan-regulasi-k3/" },
        { "@type": "ListItem", "position": 3, "name": "Pengesahan P2K3 & Lisensi P3K", "item": "https://konsultank3.com/jasa-pengesahan-p2k3-lisensi-p3k/" }
      ]
    },
    {
      "@type": "Service",
      "name": "Jasa Pengesahan P2K3 Disnaker & Pengurusan Lisensi Petugas P3K Kemnaker",
      "serviceType": "Labor & OSH Legal Compliance Consulting",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Kapan perusahaan wajib membentuk dan mengesahkan struktur P2K3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Berdasarkan Permenaker No. 04/MEN/1987 Pasal 2, perusahaan wajib membentuk dan mengesahkan P2K3 ke Disnaker apabila mempekerjakan 100 orang tenaga kerja atau lebih, atau mempekerjakan kurang dari 100 orang namun menggunakan bahan, proses, dan instalasi yang memiliki risiko bahaya besar (peledakan, kebakaran, keracunan, dan radiasi)."
          }
        },
        {
          "@type": "Question",
          "name": "Siapa yang wajib menjabat sebagai Ketua dan Sekretaris P2K3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ketua P2K3 wajib dijabat oleh pimpinan puncak perusahaan (Direktur/General Manager/Kepala Cabang) agar memiliki wewenang eksekutif dalam pengambilan keputusan keselamatan. Sedangkan Sekretaris P2K3 wajib dijabat oleh Ahli K3 Umum yang telah memiliki Surat Keputusan Penunjukan (SKP) aktif dari Kemnaker RI."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama masa berlaku Lisensi Petugas P3K di Tempat Kerja?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Lisensi Petugas P3K Kemnaker RI berlaku selama 3 (tiga) tahun. Perusahaan wajib mengajukan perpanjangan lisensi sebelum masa berlakunya habis. Apabila telah kedaluwarsa lebih dari 1 tahun, Kemnaker/Disnaker mewajibkan petugas mengikuti pelatihan penyegaran (refreshment training) ulang."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa rasio jumlah petugas P3K yang wajib disediakan perusahaan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sesuai Permenaker No. 15 Tahun 2008, untuk tempat kerja dengan potensi bahaya rendah (perkantoran/ritel), rasionya adalah 1 petugas P3K untuk setiap 150 pekerja. Untuk tempat kerja dengan potensi bahaya tinggi (pabrik kimia, konstruksi, pertambangan), rasionya adalah 1 petugas P3K untuk setiap 100 pekerja atau fraksinya."
          }
        },
        {
          "@type": "Question",
          "name": "Apa sanksi jika perusahaan tidak memiliki SK Pengesahan P2K3 dan tidak lapor triwulan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Perusahaan dapat dikenai Nota Pemeriksaan oleh Pengawas Ketenagakerjaan Disnaker, sanksi administratif, hambatan kelulusan audit sertifikasi SMK3 PP 50/2012 (Elemen 1.4), diskualifikasi dalam prakualifikasi tender BUMN/Migas, hingga tuntutan hukum sesuai UU No. 1 Tahun 1970."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/audit-kepatuhan-regulasi-k3/" class="hover:text-amber-400 transition-colors">Kepatuhan Regulasi</a>
        <span>/</span>
        <span class="text-slate-300">Pengesahan P2K3 &amp; Lisensi P3K</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse-glow"></span>
            Legalitas Resmi Disnaker &bull; Permenaker 04/1987 &amp; Permenaker 15/2008
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Jasa Pengesahan <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">P2K3 Disnaker</span> &amp; Lisensi Petugas P3K
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Layanan pendampingan legalitas K3 terpadu: penerbitan SK Pengesahan P2K3 Disnaker Provinsi/Kota, pengurusan dan perpanjangan lisensi Petugas P3K Kemnaker, hingga asistensi Laporan Triwulan K3.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, kami membutuhkan jasa pengesahan P2K3 Disnaker / pengurusan perpanjangan lisensi P3K untuk perusahaan kami")}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all transform hover:-translate-y-0.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Konsultasi Legalitas P2K3
            </a>
            <a
              href="#syarat-dokumen"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/10 transition-colors"
            >
              Cek Syarat Dokumen
            </a>
          </div>
        </div>

        <!-- Right Column: Quick Highlights -->
        <div class="lg:col-span-5">
          <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-white/10 backdrop-blur-sm shadow-2xl space-y-6">
            <h3 class="font-serif text-lg font-bold text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              Cakupan Layanan Legalitas
            </h3>
            
            <dl class="space-y-4 text-xs sm:text-sm">
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Legalitas P2K3</dt>
                <dd class="text-white font-semibold text-right">SK Pengesahan Disnaker Resmi</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Lisensi Petugas P3K</dt>
                <dd class="text-amber-300 font-semibold text-right">Kartu Lisensi &amp; Buku Kegiatan</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Estimasi Proses</dt>
                <dd class="text-white font-semibold text-right">7 – 14 Hari Kerja (Lengkap)</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Wilayah Layanan</dt>
                <dd class="text-white font-semibold text-right">Jabodetabek &amp; Seluruh Indonesia</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Kepatuhan Berkelanjutan</dt>
                <dd class="text-emerald-400 font-semibold text-right">Asistensi Laporan Triwulan P2K3</dd>
              </div>
            </dl>

            <div class="pt-2">
              <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-200 leading-relaxed">
                <strong>Catatan Audit SMK3:</strong> Ketiadaan SK Pengesahan P2K3 yang sah dari Disnaker merupakan temuan Kategori Mayor yang langsung menggugurkan syarat kelulusan sertifikasi SMK3 PP 50/2012.
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Navigation Anchor Strip -->
  <div class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm text-xs sm:text-sm font-medium">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto gap-6 py-3 scrollbar-none text-slate-600">
      <a href="#kewajiban-hukum" class="hover:text-amber-600 whitespace-nowrap">Dasar Hukum P2K3</a>
      <a href="#struktur-organisasi" class="hover:text-amber-600 whitespace-nowrap">Struktur Baku P2K3</a>
      <a href="#rasio-p3k" class="hover:text-amber-600 whitespace-nowrap text-amber-700 font-bold">Rasio Petugas &amp; Kotak P3K</a>
      <a href="#syarat-dokumen" class="hover:text-amber-600 whitespace-nowrap">Syarat Dokumen</a>
      <a href="#alur-proses" class="hover:text-amber-600 whitespace-nowrap">Alur Pengurusan</a>
      <a href="#faq" class="hover:text-amber-600 whitespace-nowrap">FAQ</a>
    </div>
  </div>

  <!-- Main Content Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Kewajiban Hukum P2K3 -->
    <section id="kewajiban-hukum" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-8 space-y-6 text-slate-700 leading-relaxed text-base">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">Kewajiban Pokok Perusahaan</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Mengapa Perusahaan Wajib Memiliki SK Pengesahan P2K3?
        </h2>
        <p>
          Berdasarkan <strong>Undang-Undang No. 1 Tahun 1970</strong> Pasal 10, <strong>Permenaker No. PER.04/MEN/1987</strong>, serta pembaruan tata kelola kelembagaan K3 terkini (<strong>Permenaker No. 13 Tahun 2025</strong>), Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3) adalah badan pembantu di tempat kerja yang menjadi wadah kerjasama antara pengusaha dan pekerja untuk mengembangkan kerja sama saling pengertian dan partisipasi efektif dalam penerapan K3.
        </p>
        <p>
          Setiap perusahaan yang mempekerjakan <strong>100 orang atau lebih</strong>, atau mempekerjakan kurang dari 100 orang namun memiliki proses berisiko bahaya tinggi (bahan kimia, peledakan, kebakaran, instalasi bertekanan), <strong>diwajibkan secara hukum membentuk P2K3 dan mengesahkan susunannya ke Dinas Ketenagakerjaan setempat</strong>.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-rose-500"></span>
              Risiko Tanpa Pengesahan P2K3
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Mendapat teguran Nota Pemeriksaan dari Pengawas Ketenagakerjaan, terganjal audit CSMS tender BUMN/Migas, dan temuan ketidaksesuaian Mayor pada sertifikasi SMK3 PP 50/2012 kriteria 1.4.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <h4 class="font-bold text-slate-900 text-sm flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              Kelebihan Menggunakan Jasa Kami
            </h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Penyusunan berkas permohonan sesuai format baku Disnaker, monitoring proses verifikasi, asistensi penunjukan Ahli K3 Umum sebagai sekretaris, hingga terbit SK resmi tanpa birokrasi berbelit.
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4 p-6 rounded-3xl bg-slate-900 text-white space-y-5 border border-slate-800 shadow-xl">
        <h3 class="font-serif text-lg font-bold text-amber-400">Syarat Wajib Pembentukan P2K3</h3>
        <ul class="space-y-4 text-xs leading-relaxed">
          <li class="pb-3 border-b border-white/10 space-y-1">
            <span class="font-bold text-white block text-sm">&ge; 100 Orang Tenaga Kerja</span>
            <span class="text-slate-300">Wajib mutlak dibentuk di kantor pusat, cabang, pabrik, maupun site proyek operasional.</span>
          </li>
          <li class="pb-3 border-b border-white/10 space-y-1">
            <span class="font-bold text-white block text-sm">&lt; 100 Orang dengan Risiko Tinggi</span>
            <span class="text-slate-300">Perusahaan dengan bahan mudah terbakar, meledak, beracun, instalasi listrik besar, atau pekerjaan konstruksi.</span>
          </li>
          <li class="space-y-1">
            <span class="font-bold text-white block text-sm">Pelaporan Rutin Setiap 3 Bulan</span>
            <span class="text-slate-300">P2K3 wajib menyusun dan melaporkan kegiatan pelaksanaan K3 secara berkala ke Disnaker setiap triwulan.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Section 2: Struktur Baku P2K3 -->
    <section id="struktur-organisasi" class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">Kesesuaian Regulasi Permenaker 04/1987</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Standar Susunan Struktur Organisasi P2K3
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Struktur organisasi P2K3 tidak boleh dibuat sembarangan karena memiliki ketentuan jabatan yang mengikat secara yuridis:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Ketua -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-base">01</div>
          <h3 class="font-serif text-lg font-bold text-slate-900">Ketua P2K3</h3>
          <p class="text-xs text-slate-500 font-semibold uppercase">Wajib Pimpinan Puncak Perusahaan</p>
          <p class="text-xs text-slate-600 leading-relaxed">
            Dijabat oleh Direktur Utama, General Manager, atau Kepala Pabrik. Bertanggung jawab penuh memimpin rapat rutin, menetapkan kebijakan keselamatan, dan mengalokasikan anggaran program K3.
          </p>
        </div>

        <!-- Sekretaris -->
        <div class="p-6 rounded-2xl bg-white border border-amber-300 shadow-sm space-y-3 bg-amber-50/20">
          <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 flex items-center justify-center font-bold text-base">02</div>
          <h3 class="font-serif text-lg font-bold text-slate-900">Sekretaris P2K3</h3>
          <p class="text-xs text-amber-700 font-bold uppercase">Wajib Ahli K3 Umum Ber-SKP Aktif</p>
          <p class="text-xs text-slate-600 leading-relaxed">
            Dijabat oleh personil yang telah lulus pembinaan dan memegang Surat Keputusan Penunjukan (SKP) Ahli K3 Umum dari Kemnaker RI yang sah dan terikat di perusahaan tersebut.
          </p>
        </div>

        <!-- Anggota -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-base">03</div>
          <h3 class="font-serif text-lg font-bold text-slate-900">Anggota P2K3</h3>
          <p class="text-xs text-slate-500 font-semibold uppercase">Perwakilan Manajemen &amp; Pekerja</p>
          <p class="text-xs text-slate-600 leading-relaxed">
            Terdiri dari perwakilan departemen operasi, HRD, pemeliharaan, serta perwakilan serikat pekerja / buruh untuk menampung masukan keselamatan dari lini terdepan.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Rasio Petugas & Kotak P3K di Tempat Kerja -->
    <section id="rasio-p3k" class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white space-y-10 border border-slate-800">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block">Kepatuhan Permenaker No. 15 Tahun 2008</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Standar Rasio Petugas P3K &amp; Klasifikasi Kotak P3K
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Setiap perusahaan wajib menyediakan personil P3K yang memiliki lisensi resmi dari Kemnaker RI dan menyediakan fasilitas kotak P3K sesuai rasio jumlah pekerja:
        </p>
      </div>

      <!-- Ratio Table -->
      <div class="overflow-x-auto rounded-2xl border border-white/10 bg-slate-800/60">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-950 text-white font-semibold uppercase tracking-wider text-[11px]">
            <tr>
              <th class="p-4">Tingkat Risiko Bahaya</th>
              <th class="p-4">Jumlah Tenaga Kerja</th>
              <th class="p-4">Rasio Minimum Petugas P3K Berlisensi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/10 text-slate-300">
            <tr>
              <td class="p-4 font-bold text-white">Bahaya Rendah (Kantor, Ritel, Jasa)</td>
              <td class="p-4">25 – 150 pekerja</td>
              <td class="p-4 text-emerald-400 font-semibold">1 orang petugas P3K</td>
            </tr>
            <tr>
              <td class="p-4 font-bold text-white">Bahaya Rendah</td>
              <td class="p-4">&gt; 150 pekerja</td>
              <td class="p-4 text-emerald-400 font-semibold">1 orang untuk setiap 150 pekerja (atau fraksinya)</td>
            </tr>
            <tr class="bg-amber-500/10">
              <td class="p-4 font-bold text-amber-300">Bahaya Tinggi (Pabrik, Tambang, Konstruksi, Kimia)</td>
              <td class="p-4">&le; 100 pekerja</td>
              <td class="p-4 text-amber-300 font-semibold">1 orang petugas P3K</td>
            </tr>
            <tr class="bg-amber-500/10">
              <td class="p-4 font-bold text-amber-300">Bahaya Tinggi</td>
              <td class="p-4">&gt; 100 pekerja</td>
              <td class="p-4 text-amber-300 font-semibold">1 orang untuk setiap 100 pekerja (atau fraksinya)</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Kotak P3K Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs">
        <div class="p-5 rounded-2xl bg-slate-800/80 border border-white/10 space-y-2">
          <span class="text-amber-400 font-bold block text-sm">Kotak P3K Tipe A</span>
          <p class="text-slate-300 text-xs">Disediakan untuk unit kerja dengan kapasitas sampai dengan <strong>25 pekerja</strong>. Berisi 21 item wajib standar Permenaker 15/2008.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-800/80 border border-white/10 space-y-2">
          <span class="text-amber-400 font-bold block text-sm">Kotak P3K Tipe B</span>
          <p class="text-slate-300 text-xs">Disediakan untuk unit kerja dengan kapasitas <strong>26 sampai 50 pekerja</strong>, atau ekuivalen 2 kotak tipe A.</p>
        </div>
        <div class="p-5 rounded-2xl bg-slate-800/80 border border-white/10 space-y-2">
          <span class="text-amber-400 font-bold block text-sm">Kotak P3K Tipe C</span>
          <p class="text-slate-300 text-xs">Disediakan untuk unit kerja dengan kapasitas <strong>51 sampai 100 pekerja</strong>, atau ekuivalen 2 kotak tipe B / 4 kotak tipe A.</p>
        </div>
      </div>
    </section>

    <!-- Section 4: Persyaratan Dokumen & Prosedur -->
    <section id="syarat-dokumen" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-6 space-y-6">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">Kelengkapan Administrasi</span>
