---
import ArticleLayout from '../layouts/ArticleLayout.astro';

const title = "Basic Cardiac Life Support (BCLS) Medis K3";
const description = "Pelatihan Basic Cardiac Life Support (BCLS), Resusitasi Jantung Paru (RJP/CPR), penggunaan Automated External Defibrillator (AED), dan P3K resmi Kemnaker RI.";
const canonical = "/bclsbasic-cardiac-life-support-for-paramedic-111.html";
---

<ArticleLayout
  title={title}
  description={description}
  canonical={canonical}
  category="Panduan & Regulasi K3"
>
  <p><strong>Basic Cardiac Life Support (BCLS)</strong> adalah keterampilan medis dasar penyelamatan jiwa darurat yang wajib dikuasai oleh petugas paramedis perusahaan, dokter pemeriksa kesehatan kerja, dan anggota tim First Aider (Petugas P3K). Henti jantung mendadak (<em>Sudden Cardiac Arrest</em>) di tempat kerja memerlukan tindakan RJP segera dalam 4 menit pertama (<em>Golden Period</em>) sebelum terjadi kerusakan otak permanen.</p>

            <h2>Rantai Kelangsungan Hidup (Chain of Survival)</h2>
            <ol>
              <li><strong>Pengenalan Dini & Aktivasi Sistem Darurat:</strong> Menilai kesadaran korban dan segera memanggil bantuan medis darurat.</li>
              <li><strong>RJP Dini Berkualitas Tinggi (High-Quality CPR):</strong>
                <ul>
                  <li>Kompresi dada berkecepatan 100 - 120 kali per menit.</li>
                  <li>Kedalaman kompresi 5 - 6 cm pada orang dewasa.</li>
                  <li>Memastikan rekoil dada sempurna (full chest recoil) di antara kompresi.</li>
                  <li>Meminimalkan jeda henti kompresi.</li>
                  <li>Rasio kompresi dan ventilasi napas bantuan 30 : 2.</li>
                </ul>
              </li>
              <li><strong>Defibrilasi Cepat dengan AED:</strong> Pemasangan Automated External Defibrillator segera setelah alat tiba di lokasi untuk mendeteksi ritme Ventricular Fibrillation (VF).</li>
              <li><strong>Bantuan Hidup Lanjutan & Perawatan Pasca Henti Jantung di Rumah Sakit.</strong></li>
            </ol>
</ArticleLayout>
