---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Panduan Penerapan & Pendampingan Audit SMK3 PP 50/2012";
const description = "Layanan konsultasi dan pendampingan implementasi Sistem Manajemen Keselamatan dan Kesehatan Kerja (SMK3) sesuai Peraturan Pemerintah No. 50 Tahun 2012 untuk meraih predikat Bendera Emas.";
const canonical = "/panduan-penerapan-smk3/";

const smk3Schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Layanan Konsultasi", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Audit SMK3 PP 50/2012", "item": "https://konsultank3.com/panduan-penerapan-smk3/" }
      ]
    },
    {
      "@type": "Service",
      "name": "Pendampingan Audit SMK3 PP 50/2012 Menuju Bendera Emas",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "PT Wahana Totalita Konsultan",
        "sameAs": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout
  title={`${title} » Konsultan K3 Indonesia`}
  description={description}
  canonical={canonical}
  schema={smk3Schema}
  presetMessage="Halo KonsultanK3, saya ingin konsultasi pendampingan audit SMK3 PP 50/2012 untuk perusahaan kami."
>
  <!-- Hero Section with Split-Screen & Photography Card -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Layanan Konsultasi</a>
        <span>/</span>
        <span class="text-slate-300">Audit SMK3 PP 50/2012</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Regulasi Wajib Pemerintah &bull; PP No. 50 Tahun 2012
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pendampingan &amp; Audit <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">SMK3 PP 50/2012</span> Menuju Bendera Emas
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Konsultasi komprehensif pendampingan penyusunan dokumen, integrasi kebijakan K3, pemenuhan 166 kriteria audit, hingga pencapaian audit eksternal berpredikat <strong>Memuaskan (Bendera Emas)</strong> resmi dari Kementerian Ketenagakerjaan RI.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20konsultasi%20pendampingan%20audit%20SMK3%20PP%2050/2012"
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Jadwalkan Konsultasi Gratis &rarr;
            </a>
            <a
              href="/downloads/Checklist-Audit-SMK3-166-Kriteria.html"
              target="_blank"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Unduh Checklist 166 Kriteria
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi Asistensi</span>
              <p class="text-white font-bold text-sm">1 – 3 Bulan</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kriteria Audit</span>
              <p class="text-white font-bold text-sm">64 / 122 / 166</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Target Hasil</span>
              <p class="text-white font-bold text-sm">Bendera Emas</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Tingkat Lulus</span>
              <p class="text-emerald-400 font-bold text-sm">Garansi 100%</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/hero-safety-officer.jpg"
              alt="Konsultansi dan Pendampingan Audit SMK3 PP 50/2012"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-400 text-slate-950 mb-2">
                Sertifikasi Kemnaker RI
              </span>
              <h3 class="font-serif text-lg font-bold leading-snug">
                Pencapaian Audit SMK3 Memuaskan Tingkat Lanjutan
              </h3>
              <p class="text-xs text-slate-300 mt-1">
                Dampingi perusahaan meraih sertifikat resmi dan Bendera Emas tanpa temuan mayor.
              </p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="absolute -top-4 -right-4 p-3 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl flex items-center gap-3 hidden sm:flex">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-lg">
              ★
            </div>
            <div>
              <div class="text-xs font-bold text-white">Bendera Emas SMK3</div>
              <div class="text-[10px] text-slate-400">Pencapaian &gt; 85% Kriteria</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Main Content Column -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- 4 Step Methodology Bento Grid -->
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-serif mb-6">
            4 Tahapan Pendampingan Audit SMK3 Terstruktur
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                01
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Gap Analysis &amp; Diagnostik Awal</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Pemetaan menyeluruh kesenjangan antara kondisi faktual perusahaan dengan 64, 122, atau 166 kriteria audit SMK3.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                02
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Penyusunan Manual &amp; Prosedur SOP</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Pembuatan manual SMK3, prosedur kerja aman, instruksi kerja teknis, formulir inspeksi, dan matriks HIRADC terpadu.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                03
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Pelatihan Audit Internal SMK3</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Pembekalan personel internal agar mampu melaksanakan audit mandiri, tinjauan manajemen berkala, dan tindakan korektif (CAPA).</p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                04
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Pendampingan Audit Eksternal Resmi</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Asistensi penuh selama audit langsung oleh Badan Audit independen yang ditunjuk Kemnaker RI hingga sertifikat dan bendera terbit.</p>
            </div>
          </div>
        </div>

        <!-- Curriculum & Deliverables -->
        <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200/80 shadow-sm space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs uppercase tracking-wider text-slate-500 font-bold block mb-1">Cakupan Layanan</span>
            <h2 class="font-serif text-2xl font-bold text-slate-900">Ruang Lingkup Pendampingan Sistem SMK3</h2>
          </div>
          
          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/60 space-y-2">
              <h4 class="font-serif text-lg font-bold text-slate-900">A. 5 Prinsip Dasar SMK3 PP 50/2012</h4>
              <ul class="list-disc pl-5 space-y-1 text-slate-600 text-sm">
                <li>Penetapan Komitmen &amp; Kebijakan K3 Pimpinan Tertinggi</li>
                <li>Perencanaan Strategis K3 &amp; Matriks HIRADC (Identifikasi Bahaya &amp; Penilaian Risiko)</li>
                <li>Pelaksanaan Rencana K3 dengan Dukungan Sumber Daya Personel Terlatih</li>
                <li>Pemantauan, Evaluasi Kinerja K3, &amp; Uji Lingkungan Fisika/Kimia</li>
                <li>Peninjauan &amp; Peningkatan Kinerja Manajemen secara Berkelanjutan</li>
              </ul>
            </div>

            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/60 space-y-2">
              <h4 class="font-serif text-lg font-bold text-slate-900">B. Dokumentasi Sistem &amp; Operasional</h4>
              <ul class="list-disc pl-5 space-y-1 text-slate-600 text-sm">
                <li>Penyusunan Manual Kebijakan K3, Prosedur ERP (Tanggap Darurat), &amp; Evakuasi</li>
                <li>Pengendalian Rekanan Kontraktor (Contractor Safety Management System - CSMS)</li>
                <li>Sistem Izin Kerja Khusus (Hot Work, Confined Space, Working at Height, Electrical LOTO)</li>
                <li>Penyusunan Standar Penyelenggaraan Pelayanan Kesehatan Kerja &amp; MCU Karyawan</li>
              </ul>
            </div>

            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200/60 space-y-2">
              <h4 class="font-serif text-lg font-bold text-slate-900">C. Simulasi Mock-Audit &amp; Penyelesaian Temuan</h4>
              <ul class="list-disc pl-5 space-y-1 text-slate-600 text-sm">
                <li>Pre-Audit internal menyeluruh sebelum kedatangan auditor eksternal Kemnaker</li>
                <li>Perbaikan temuan ketidaksesuaian (Non-Conformance) kategori Minor &amp; Mayor</li>
                <li>Asistensi verifikasi bukti objektif saat audit lapangan berlangsung</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Download Toolkit Callout -->
        <div class="p-8 rounded-3xl bg-gradient-to-br from-slate-900 to-slate-950 text-white shadow-xl border border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
          <div class="space-y-1">
            <span class="text-xs font-bold uppercase tracking-wider text-amber-400">Pusat Unduhan Resmi</span>
            <h3 class="text-xl font-bold font-serif text-white">Checklist Audit Mandiri SMK3 166 Kriteria</h3>
            <p class="text-xs text-slate-300 max-w-md">Gunakan lembar kerja ini untuk mengukur kesiapan audit perusahaan Anda secara independen.</p>
          </div>
          <a
            href="/downloads/Checklist-Audit-SMK3-166-Kriteria.html"
            target="_blank"
            class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 text-xs font-bold uppercase tracking-wider transition-all whitespace-nowrap shadow-md hover:scale-105 shrink-0"
          >
            Buka Checklist 166 Kriteria &rarr;
          </a>
        </div>

      </div>

      <!-- Right Column: Consultation Sidebar -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-28">
        
        <!-- Fast Booking Card -->
        <div class="bg-slate-950 text-white rounded-3xl p-6 sm:p-8 space-y-6 shadow-2xl border border-white/10">
          <div class="space-y-2">
            <span class="text-xs uppercase tracking-widest text-amber-400 font-bold">Konsultasi Terjadwal</span>
            <h3 class="font-serif text-xl font-bold text-white">Konsultasi Kesiapan Audit Perusahaan</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Dapatkan proposal pendampingan resmi, roadmap estimasi waktu, serta estimasi biaya yang disesuaikan dengan skala kriteria audit perusahaan Anda.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Format Pendampingan:</span>
              <span class="text-white font-bold">Hybrid / On-site</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-slate-400">Garansi:</span>
              <span class="text-emerald-400 font-bold">Bimbingan Sampai Lulus</span>
            </div>
          </div>

          <a
            href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20jadwalkan%20konsultasi%20pendampingan%20audit%20SMK3%20PP%2050/2012"
            target="_blank"
            rel="noopener"
            class="w-full inline-flex items-center justify-center gap-2 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider transition-all shadow-lg shadow-emerald-600/30 hover:scale-[1.02]"
          >
            <span>Hubungi via WhatsApp Resmi &rarr;</span>
          </a>
        </div>

        <!-- Trust Badge -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-2">
          <span class="text-xs uppercase tracking-wider text-slate-500 font-bold block">Didukung Instruktur Senior</span>
          <p class="text-xs text-slate-600 leading-relaxed">
            Didampingi oleh Lead Auditor bersertifikasi Kemnaker RI dengan pengalaman mendampingi lebih dari 450+ perusahaan di sektor migas, tambang, konstruksi, dan manufaktur.
          </p>
        </div>

      </aside>

    </div>
  </main>
</BaseLayout>
