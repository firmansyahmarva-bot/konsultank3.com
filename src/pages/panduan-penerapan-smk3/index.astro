---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArticlesForPillar } from '../../data/topics.js';

const title = "Panduan Penerapan & Audit SMK3 PP 50/2012";
const description = "Panduan lengkap penerapan dan pendampingan audit SMK3 PP No. 50 Tahun 2012 serta Permenaker 26/2014 untuk 64, 122, dan 166 kriteria meraih Bendera Emas.";
const canonical = "/panduan-penerapan-smk3/";

const mappedArticles = getArticlesForPillar('panduan-penerapan-smk3');

const smk3Schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Layanan Konsultasi", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Audit SMK3 PP 50/2012", "item": "https://konsultank3.com/panduan-penerapan-smk3/" }
      ]
    },
    {
      "@type": "Article",
      "headline": title,
      "description": description,
      "mainEntityOfPage": "https://konsultank3.com/panduan-penerapan-smk3/",
      "datePublished": "2026-10-29",
      "dateModified": "2026-11-10",
      "author": {
        "@type": "Organization",
        "name": "Dewan Pakar K3 & Tim Redaksi KonsultanK3.com",
        "url": "https://konsultank3.com/tentang-kami/"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "logo": {
          "@type": "ImageObject",
          "url": "https://konsultank3.com/assets/images/logo.png"
        }
      }
    },
    {
      "@type": "Service",
      "name": "Pendampingan Audit SMK3 PP 50/2012 Menuju Bendera Emas",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};

const faqs = [
  {
    q: "Perusahaan apa saja yang wajib menerapkan SMK3 sesuai PP No. 50 Tahun 2012?",
    a: "Sesuai Pasal 5 PP No. 50 Tahun 2012, kewajiban penerapan SMK3 berlaku bagi setiap perusahaan yang mempekerjakan tenaga kerja paling sedikit 100 orang, atau perusahaan yang mempunyai potensi bahaya tinggi (seperti sektor pertambangan, minyak & gas, konstruksi, kimia, dan manufaktur berat)."
  },
  {
    q: "Berapa pembagian tingkat kriteria audit SMK3 berdasarkan Permenaker No. 26 Tahun 2014?",
    a: "Permenaker No. 26 Tahun 2014 menetapkan tiga tingkatan penilaian penerapan SMK3: Tingkat Awal (64 kriteria untuk perusahaan berisiko rendah), Tingkat Transisi (122 kriteria untuk perusahaan berisiko sedang), dan Tingkat Lanjutan (166 kriteria untuk perusahaan berisiko tinggi atau skala besar)."
  },
  {
    q: "Berapa persentase pencapaian pemenuhan kriteria untuk meraih predikat Bendera Emas SMK3?",
    a: "Untuk meraih predikat Memuaskan (Bendera Emas) dari Kementerian Ketenagakerjaan RI, perusahaan wajib memenuhi pencapaian minimal 85% sampai dengan 100% dari total kriteria audit yang dinilai, tanpa adanya temuan ketidaksesuaian kategori Mayor."
  },
  {
    q: "Apa saja 4 tahapan metodologi pendampingan audit SMK3 yang terstruktur?",
    a: "Tahapan pendampingan mencakup: (1) Gap Analysis & Diagnostik Awal terhadap kriteria regulasi, (2) Penyusunan & Revisi Manual Kebijakan K3 serta Prosedur SOP, (3) Pelatihan & Pelaksanaan Audit Internal mandiri, serta (4) Pendampingan saat audit eksternal resmi oleh Badan Audit independen yang ditunjuk Kemnaker."
  },
  {
    q: "Apa saja 5 prinsip dasar penerapan SMK3 sesuai amanat PP No. 50 Tahun 2012?",
    a: "Lima prinsip dasar SMK3 meliputi: (1) Penetapan kebijakan K3 oleh pimpinan tertinggi, (2) Perencanaan K3 berbasis matriks HIRADC, (3) Pelaksanaan rencana K3 didukung sumber daya personel kompeten, (4) Pemantauan dan evaluasi kinerja K3 melalui inspeksi dan audit internal, serta (5) Peninjauan dan peningkatan kinerja manajemen K3 secara berkesinambungan."
  }
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={smk3Schema}
  presetMessage="Halo KonsultanK3, saya ingin konsultasi pendampingan audit SMK3 PP 50/2012 untuk perusahaan kami."
>
  <!-- Hero Section with Split-Screen & Photography Card -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Layanan Konsultasi</a>
        <span>/</span>
        <span class="text-slate-300">Audit SMK3 PP 50/2012</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
              Regulasi Wajib Pemerintah &bull; PP No. 50 Tahun 2012
            </span>
            <span class="text-xs text-emerald-400 font-medium flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Terakhir diperbarui: November 2026
            </span>
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pendampingan &amp; Audit <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">SMK3 PP 50/2012</span> Menuju Bendera Emas
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Konsultasi komprehensif pendampingan penyusunan dokumen, integrasi kebijakan K3, pemenuhan 166 kriteria audit, hingga pencapaian audit eksternal berpredikat <strong>Memuaskan (Bendera Emas)</strong> resmi dari Kementerian Ketenagakerjaan RI.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20konsultasi%20pendampingan%20audit%20SMK3%20PP%2050/2012"
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Jadwalkan Konsultasi Gratis &rarr;
            </a>
            <a
              href="/downloads/Checklist-Audit-SMK3-166-Kriteria.html"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Unduh Checklist 166 Kriteria
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi Asistensi</span>
              <p class="text-white font-bold text-sm">1 – 3 Bulan</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kriteria Audit</span>
              <p class="text-white font-bold text-sm">64 / 122 / 166</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Target Hasil</span>
              <p class="text-white font-bold text-sm">Bendera Emas</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Tingkat Lulus</span>
              <p class="text-emerald-400 font-bold text-sm">Garansi 100%</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/hero-safety-officer.jpg"
              alt="Konsultansi dan Pendampingan Audit SMK3 PP 50/2012"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-400 text-slate-950 mb-2">
                Sertifikasi Kemnaker RI
              </span>
              <h3 class="font-serif text-lg font-bold leading-snug">
                Pencapaian Audit SMK3 Memuaskan Tingkat Lanjutan
              </h3>
              <p class="text-xs text-slate-300 mt-1">
                Dampingi perusahaan meraih sertifikat resmi dan Bendera Emas tanpa temuan mayor.
              </p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="absolute -top-4 -right-4 p-3 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl flex items-center gap-3 hidden sm:flex">
            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-lg">
              ★
            </div>
            <div>
              <div class="text-xs font-bold text-white">Bendera Emas SMK3</div>
              <div class="text-[10px] text-slate-400">Pencapaian &gt; 85% Kriteria</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Main Content Column -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- Table of Contents -->
        <nav class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm not-prose" aria-label="Daftar Isi Halaman">
          <div class="flex items-center gap-2 text-slate-900 font-bold font-serif text-lg mb-4 pb-3 border-b border-slate-100">
            <span>📑</span> Daftar Isi Panduan Penerapan &amp; Audit SMK3
          </div>
          <ol class="grid grid-cols-1 md:grid-cols-2 gap-2 text-sm text-slate-700 list-decimal list-inside font-medium">
            <li><a href="#dasar-hukum" class="text-emerald-700 hover:text-emerald-600 hover:underline">Dasar Hukum Penerapan &amp; Penilaian SMK3</a></li>
            <li><a href="#tahapan-pendampingan" class="text-emerald-700 hover:text-emerald-600 hover:underline">4 Tahapan Pendampingan Audit SMK3</a></li>
            <li><a href="#kriteria-penilaian" class="text-emerald-700 hover:text-emerald-600 hover:underline">Tingkatan Kriteria Penilaian SMK3 (64 / 122 / 166)</a></li>
            <li><a href="#ruang-lingkup" class="text-emerald-700 hover:text-emerald-600 hover:underline">Ruang Lingkup Pendampingan Sistem SMK3</a></li>
            <li><a href="#strategi-bendera-emas" class="text-emerald-700 hover:text-emerald-600 hover:underline">Strategi Kelulusan Predikat Bendera Emas</a></li>
            <li><a href="#artikel-pembahasan" class="text-emerald-700 hover:text-emerald-600 hover:underline">Artikel Pembahasan Terkait</a></li>
            <li><a href="#faq-smk3" class="text-emerald-700 hover:text-emerald-600 hover:underline">Pertanyaan yang Sering Diajukan (FAQ)</a></li>
            <li><a href="#daftar-pustaka" class="text-emerald-700 hover:text-emerald-600 hover:underline">Daftar Pustaka</a></li>
          </ol>
        </nav>

        <!-- Dasar Hukum Section -->
        <section id="dasar-hukum" class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm space-y-4">
          <div class="border-b border-slate-200 pb-3">
            <span class="text-xs uppercase tracking-wider text-slate-500 font-bold block mb-1">Landasan Regulasi</span>
            <h2 class="font-serif text-2xl font-bold text-slate-900">Dasar Hukum Penerapan &amp; Penilaian SMK3</h2>
          </div>
          <p class="text-slate-700 text-sm leading-relaxed">
            Penyelenggaraan Sistem Manajemen Keselamatan dan Kesehatan Kerja (SMK3) serta pelaksanaan audit eksternal di Indonesia diatur secara sah dan mengikat melalui ketentuan hukum pemerintah berikut:
          </p>
          <ul class="list-disc pl-5 space-y-2 text-slate-700 text-sm">
            <li>
              <strong>Peraturan Pemerintah No. 50 Tahun 2012</strong> tentang Penerapan Sistem Manajemen Keselamatan dan Kesehatan Kerja, yang mewajibkan penerapan SMK3 bagi setiap perusahaan yang mempekerjakan pekerja/buruh paling sedikit 100 orang atau memiliki potensi bahaya tinggi.
            </li>
            <li>
              <strong>Peraturan Menteri Ketenagakerjaan No. 26 Tahun 2014</strong> tentang Penyelenggaraan Penilaian Penerapan Sistem Manajemen Keselamatan dan Kesehatan Kerja (penilaian SMK3: 166 kriteria untuk tingkat lanjutan/perusahaan potensi bahaya tinggi, 122 kriteria untuk tingkat transisi/perusahaan potensi bahaya sedang, dan 64 kriteria untuk tingkat awal/perusahaan potensi bahaya rendah).
            </li>
          </ul>
        </section>

        <!-- 4 Step Methodology Bento Grid -->
        <div id="tahapan-pendampingan">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 font-serif mb-6">
            4 Tahapan Pendampingan Audit SMK3 Terstruktur
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                01
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Gap Analysis &amp; Diagnostik Awal</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Pemetaan menyeluruh kesenjangan antara kondisi faktual perusahaan dengan 64, 122, atau 166 kriteria audit SMK3.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                02
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Penyusunan Manual &amp; Prosedur SOP</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Pembuatan manual SMK3, prosedur kerja aman, instruksi kerja teknis, formulir inspeksi, dan matriks HIRADC terpadu.</p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                03
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Pelatihan Audit Internal SMK3</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Pembekalan personel internal agar mampu melaksanakan audit mandiri, tinjauan manajemen berkala, dan tindakan korektif (CAPA).</p>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200/80 shadow-sm space-y-3 hover:border-amber-400/50 transition-colors">
              <div class="w-10 h-10 rounded-xl bg-slate-900 text-amber-400 flex items-center justify-center font-bold text-sm">
                04
              </div>
              <h3 class="font-serif text-xl font-bold text-slate-900">Pendampingan Audit Eksternal Resmi</h3>
              <p class="text-slate-600 text-sm leading-relaxed">Asistensi penuh selama audit langsung oleh Badan Audit independen yang ditunjuk Kemnaker RI hingga sertifikat dan bendera terbit.</p>
            </div>
          </div>
        </div>

        <!-- Tingkatan Kriteria Penilaian SMK3 Permenaker 26/2014 -->
        <section id="kriteria-penilaian" class="bg-white rounded-3xl p-8 border border-slate-200/80 shadow-sm space-y-6">
          <div class="border-b border-slate-200 pb-3">
            <span class="text-xs uppercase tracking-wider text-slate-500 font-bold block mb-1">Standardisasi Penilaian</span>
            <h2 class="font-serif text-2xl font-bold text-slate-900">Tingkatan Kriteria Penilaian SMK3 (Permenaker No. 26 Tahun 2014)</h2>
          </div>
          <p class="text-slate-700 text-sm leading-relaxed">
            Berdasarkan Peraturan Menteri Ketenagakerjaan No. 26 Tahun 2014, penilaian penerapan SMK3 dikelompokkan ke dalam tiga tingkatan skala pembuktian audit yang disesuaikan dengan profil risiko dan skala operasi perusahaan:
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 not-prose">
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block">Tingkat Awal</span>
              <h4 class="font-serif text-lg font-bold text-slate-900">64 Kriteria</h4>
              <p class="text-xs text-slate-600 leading-relaxed">
                Ditujukan bagi perusahaan dengan tingkat potensi bahaya rendah. Menitikberatkan pada kebijakan K3 mendasar, pembentukan panitia P2K3, dan prosedur identifikasi bahaya awal.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">Tingkat Transisi</span>
              <h4 class="font-serif text-lg font-bold text-slate-900">122 Kriteria</h4>
              <p class="text-xs text-slate-600 leading-relaxed">
                Ditujukan bagi perusahaan dengan tingkat potensi bahaya sedang. Mencakup pengendalian dokumen, inspeksi terencana, kesiapsiagaan darurat, dan manajemen kesehatan kerja.
              </p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
              <span class="text-xs font-bold uppercase tracking-wider text-blue-600 block">Tingkat Lanjutan</span>
              <h4 class="font-serif text-lg font-bold text-slate-900">166 Kriteria</h4>
              <p class="text-xs text-slate-600 leading-relaxed">
                Wajib bagi perusahaan dengan tingkat potensi bahaya tinggi atau skala besar. Mencakup seluruh klausul audit termasuk audit internal mandiri dan evaluasi manajemen puncak berkesinambungan.
              </p>
            </div>
          </div>
        </section>

        <!-- Curriculum & Deliverables -->
        <div id="ruang-lingkup" class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200/80 shadow-sm space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs uppercase tracking-wider text-slate-500 font-bold block mb-1">Cakupan Layanan</span>
            <h2 class="font-serif text-2xl font-bold text-slate-900">Ruang Lingkup Pendampingan Sistem SMK3</h2>
          </div>
          
          <div class="space-y-6">
            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/60 space-y-3">
              <h4 class="font-serif text-lg font-bold text-slate-900">A. 5 Prinsip Dasar SMK3 PP 50/2012</h4>
              <p class="text-xs text-slate-600 leading-relaxed mb-2">
                Penerapan SMK3 berlandaskan siklus PDCA (Plan-Do-Check-Act) yang terangkum dalam lima prinsip pokok wajib:
              </p>
              <ul class="list-disc pl-5 space-y-2 text-slate-700 text-sm">
                <li>
                  <strong>Penetapan Kebijakan K3:</strong> Komitmen tertulis bertanggal yang ditandatangani oleh pimpinan tertinggi organisasi, memuat visi keselamatan kerja, serta disosialisasikan secara efektif kepada seluruh karyawan dan tamu perusahaan.
                </li>
                <li>
                  <strong>Perencanaan K3:</strong> Disusun berdasarkan telaah awal (initial review), identifikasi potensi bahaya, penilaian dan pengendalian risiko (HIRADC), serta pemenuhan seluruh peraturan perundangan ketenagakerjaan yang relevan.
                </li>
                <li>
                  <strong>Pelaksanaan Rencana K3:</strong> Penyediaan sarana dan prasarana penunjang, penunjukan personil berlisensi, alokasi anggaran safety, pembentukan tim tanggap darurat, dan pelaksanaan instruksi kerja operasional yang aman.
                </li>
                <li>
                  <strong>Pemantauan &amp; Evaluasi Kinerja K3:</strong> Pengukuran berkala higiene lingkungan kerja, inspeksi peralatan kerja rutin, pencatatan statistik insiden, dan pelaksanaan audit internal SMK3 secara berkala oleh personil auditor internal bersertifikat.
                </li>
                <li>
                  <strong>Peninjauan &amp; Peningkatan Kinerja SMK3:</strong> Rapat tinjauan manajemen (Management Review Meeting) secara periodik oleh dewan direksi guna menjamin kesesuaian dan keefektifan sistem manajemen keselamatan kerja yang berkelanjutan.
                </li>
              </ul>
            </div>

            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/60 space-y-3">
              <h4 class="font-serif text-lg font-bold text-slate-900">B. 12 Elemen Audit Pemenuhan Kriteria SMK3</h4>
              <p class="text-xs text-slate-600 leading-relaxed mb-2">
                Dalam pelaksanaan audit 64, 122, maupun 166 kriteria, pendampingan kami membedah secara menyeluruh kedua belas elemen audit resmi:
              </p>
              <ol class="list-decimal pl-5 space-y-1.5 text-slate-700 text-sm">
                <li><strong>Pembangunan dan Pemeliharaan Komitmen:</strong> Pembentukan Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3), keterlibatan serikat pekerja, dan tinjauan kontrak kerja.</li>
                <li><strong>Strategi Pendokumentasian:</strong> Manual SMK3 terpusat, pengendalian prosedur kerja, dan tata kelola formulir operasional.</li>
                <li><strong>Pengendalian Perancangan dan Peninjauan Kontrak:</strong> Identifikasi bahaya saat tahap desain proyek dan verifikasi aspek keselamatan vendor kontraktor.</li>
                <li><strong>Pengendalian Dokumen:</strong> Sistem persetujuan, penerbitan, penomoran revisi, dan penarikan dokumen kedaluwarsa.</li>
                <li><strong>Pembelian dan Pengendalian Produk:</strong> Spesifikasi K3 pada pesanan pengadaan barang dan verifikasi lembar data keselamatan (SDS).</li>
                <li><strong>Keamanan Bekerja Berdasarkan SMK3:</strong> Sistem izin kerja risiko tinggi (PTW), prosedur LOTO (Lockout/Tagout), dan standardisasi APD.</li>
                <li><strong>Standar Pemantauan:</strong> Kalibrasi instrumen uji, pengukuran lingkungan kerja fisik/kimia, dan pemantauan kesehatan kerja.</li>
                <li><strong>Pelaporan dan Perbaikan Kekurangan:</strong> Investigasi kecelakaan kerja, pelaporan near-miss, dan tindakan korektif (CAPA).</li>
                <li><strong>Pengelolaan Material dan Perpindahannya:</strong> Penanganan bahan kimia B3, pelabelan simbol bahaya, dan kelayakan alat angkut-angkat.</li>
                <li><strong>Pengumpulan dan Penggunaan Data:</strong> Statistik frekuensi dan keparahan kecelakaan serta evaluasi efektivitas pelatihan K3.</li>
                <li><strong>Pemeriksaan SMK3:</strong> Audit internal terencana, kompetensi auditor independen internal, dan laporan audit komprehensif.</li>
                <li><strong>Pengembangan Keterampilan dan Kemampuan:</strong> Matriks kompetensi pelatihan karyawan, lisensi keahlian resmi, dan evaluasi hasil belajar.</li>
              </ol>
            </div>

            <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200/60 space-y-3">
