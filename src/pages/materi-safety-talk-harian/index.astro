---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Materi Safety Talk Harian K3 & Contoh 5 Menit";
const description = "Kumpulan materi safety talk harian K3 (P5M/Toolbox Meeting) 5 menit siap pakai: skrip briefing, topik mingguan, SOP pelaksanaan, dan formulir absensi.";
const canonical = "/materi-safety-talk-harian/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Panduan & Artikel K3", "item": "https://konsultank3.com/artikel/" },
        { "@type": "ListItem", "position": 3, "name": "Materi Safety Talk Harian", "item": "https://konsultank3.com/materi-safety-talk-harian/" }
      ]
    },
    {
      "@type": "Article",
      "headline": "Kumpulan Materi Safety Talk Harian K3 (P5M): Contoh Skrip 5 Menit Siap Pakai & Format Absensi",
      "description": description,
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://konsultank3.com/materi-safety-talk-harian/"
      },
      "author": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    },
    {
      "@type": "HowTo",
      "name": "Cara Melaksanakan Safety Talk Harian 5 Menit yang Efektif",
      "description": "5 langkah terstruktur memimpin toolbox meeting harian sebelum shift kerja dimulai.",
      "step": [
        {
          "@type": "HowToStep",
          "name": "Menit 1: Pembukaan & Cek Kesiapan Fisik (Fit to Work)",
          "text": "Sapa tim dengan ramah, periksa kondisi fisik pekerja (tidak mengantuk/sakit), dan bangun fokus kerja."
        },
        {
          "@type": "HowToStep",
          "name": "Menit 2: Ulas Bahaya Kerja Hari Ini & Review Insiden Kemarin",
          "text": "Sampaikan aktivitas spesifik yang akan dikerjakan dan ulas temuan near-miss atau insiden shift sebelumnya."
        },
        {
          "@type": "HowToStep",
          "name": "Menit 3: Bahas 1 Topik Fokus K3 & Pemeriksaan APD",
          "text": "Fokus pada satu topik inti (seperti pencegahan jepitan mesin, ergonomi, atau bahaya listrik) dan cek kelayakan APD."
        },
        {
          "@type": "HowToStep",
          "name": "Menit 4: Tanya Jawab Interaktif & Umpan Balik Lapangan",
          "text": "Beri kesempatan pekerja menyampaikan kendala alat atau kondisi tidak aman di area kerja."
        },
        {
          "@type": "HowToStep",
          "name": "Menit 5: Komitmen Bersama, Yel-Yel Keselamatan & Doa",
          "text": "Tutup dengan komitmen zero accident, yel-yel penyemangat, dan doa bersama sebelum menuju workstation."
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/artikel/" class="hover:text-amber-400 transition-colors">Panduan &amp; Edukasi K3</a>
        <span>/</span>
        <span class="text-slate-300">Materi Safety Talk Harian</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Panduan Praktis Supervisor &amp; Safety Officer Lapangan
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Kumpulan Materi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Safety Talk Harian K3</span> (P5M Siap Pakai)
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Panduan lengkap skrip briefing 5 menit, matriks jadwal mingguan, contoh kasus pencegahan kecelakaan, dan format formulir absensi harian untuk memenuhi klausul komunikasi K3 PP 50/2012.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="#skrip-materi"
              class="px-6 py-3.5 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-sm shadow-xl shadow-amber-500/20 transition-all hover:scale-105"
            >
              Lihat 10 Contoh Skrip 5 Menit &darr;
            </a>
            <a
              href="#alur-p5m"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Struktur 5 Langkah P5M
            </a>
          </div>

          <!-- Quick Stat Features -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi Ideal</span>
              <p class="text-white font-bold text-sm">5 &ndash; 10 Menit</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Frekuensi</span>
              <p class="text-white font-bold text-sm">Setiap Awal Shift</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Legal Basis</span>
              <p class="text-white font-bold text-sm">UU 1/1970 Pasal 9</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Keluaran</span>
              <p class="text-emerald-400 font-bold text-sm">Budaya K3 Aktif</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Briefing Keselamatan Kerja Safety Talk Harian P5M di Lapangan"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Toolbox Meeting Harian
              </span>
              <div class="text-lg font-bold">Komunikasi Dua Arah di Garis Depan</div>
              <p class="text-xs text-slate-300 mt-1">Mengubah kepatuhan K3 dari sekadar aturan tertulis menjadi kebiasaan refleks setiap pekerja.</p>
            </div>
          </div>

          <!-- Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">SOP Komunikasi K3</div>
              <div class="text-[10px] text-slate-400">Elemen 5 SMK3 PP 50/2012</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">📋</div>
            <div>
              <div class="text-xs font-bold text-white">Formulir &amp; Absensi</div>
              <div class="text-[10px] text-slate-400">Bukti Audit Eksternal</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Comprehensive Guide & Scripts (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section: Pengertian & Landasan Hukum -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Konsep Fundamental</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Apa Itu Safety Talk Harian (P5M / Toolbox Meeting)?
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            <strong>Safety talk harian</strong>—yang di Indonesia juga dikenal dengan istilah <strong>P5M (Pembicaraan 5 Menit)</strong>, <em>Toolbox Meeting (TBM)</em>, atau <em>Safety Briefing</em>—adalah pertemuan keselamatan kerja singkat berdurasi 5 hingga 10 menit yang diselenggarakan tepat sebelum shift kerja dimulai. Pertemuan ini dipimpin oleh mandor, supervisor produksi, atau safety officer untuk memastikan seluruh regu kerja memahami potensi bahaya spesifik dari pekerjaan yang akan mereka eksekusi hari itu.
          </p>

          <p class="text-slate-700 leading-relaxed">
            Berbeda dengan pelatihan K3 formal yang berjam-jam, safety talk berfokus pada <strong>satu pesan kunci praktis</strong>, evaluasi insiden nyaris celaka (<em>near miss</em>) terbaru, dan pengecekan fisik kesiapan kerja (<em>fit to work</em>) para personel.
          </p>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
            <div class="flex items-center gap-2 text-slate-900 font-bold text-sm">
              <span class="text-lg">⚖️</span>
              Kewajiban Perundangan di Indonesia
            </div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              Berdasarkan <strong>Undang-Undang No. 1 Tahun 1970 Pasal 9</strong>, pengurus tempat kerja diwajibkan secara berulang menunjukkan dan menjelaskan kondisi dan bahaya di tempat kerja kepada seluruh tenaga kerja. Pelaksanaan safety talk yang terdokumentasi rapi juga merupakan bukti kepatuhan pemenuhan kriteria <strong>Komunikasi K3 pada Sistem Manajemen Keselamatan dan Kesehatan Kerja (SMK3) PP No. 50 Tahun 2012</strong> dan standar internasional <strong>ISO 45001:2018 Klausul 7.4</strong>.
            </p>
          </div>
        </section>

        <!-- Section: Alur 5 Menit P5M -->
        <section id="alur-p5m" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Metodologi Eksekusi</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Struktur 5 Langkah Memimpin Safety Talk yang Efektif (P5M)
            </h2>
          </div>

          <p class="text-slate-700">
            Banyak safety talk gagal karena pembicara bertele-tele dan pekerja kehilangan konsentrasi. Terapkan rumus 5 menit berikut agar briefing berlangsung dinamis, interaktif, dan berdampak:
          </p>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                01
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Menit 1: Pembukaan &amp; Cek Kesiapan Fisik (Fit to Work)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Beri salam penyemangat, perhatikan tatap mata dan ekspresi fisik pekerja. Tanyakan secara langsung apakah ada anggota regu yang sedang sakit kepala, kurang tidur, mengonsumsi obat pemicu kantuk, atau memiliki keluhan fisik lainnya. Jangan izinkan pekerja yang tidak bugar menangani pekerjaan kritis.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                02
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Menit 2: Ulas Tugas Hari Ini &amp; Pelajaran Near-Miss Shift Kemarin</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Sampaikan target operasional hari ini dan review kejadian kemarin. Contoh: <em>"Kemarin ada kabel gerinda tersenggol forklift di jalur barat. Hari ini kita tata jalur kabel di atas gantungan agar tidak terulang."</em> Jadikan insiden masa lalu sebagai pelajaran tanpa mempermalukan individu.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                03
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Menit 3: Bedah 1 Topik Bahaya Inti &amp; Verifikasi APD</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Pilih tepat satu topik bahaya (lihat skrip di bawah). Jelaskan mekanismenya secara gamblang dan periksa kepatuhan Alat Pelindung Diri (APD) rekan di sebelah kanan-kiri masing-masing (<em>Buddy Check System</em>).
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                04
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Menit 4: Tanya-Jawab Interaktif &amp; Laporan Bahaya Pekerja</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Beri ruang bagi pekerja untuk menyampaikan hambatan: <em>"Apakah ada penerangan yang mati di area tangki? Ada perkakas yang aus?"</em> Safety talk harus berupa dialog dua arah, bukan sekadar instruksi sepihak dari pimpinan.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                05
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Menit 5: Komitmen Bersama, Yel-Yel Keselamatan &amp; Doa</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Tegaskan bahwa setiap pekerja berhak dan berwajib menghentikan pekerjaan (<em>Stop Work Authority</em>) jika menemukan kondisi bahaya kritis. Tutup dengan yel-yel keselamatan regu dan doa bersama memohon perlindungan kerja.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section: 10 Contoh Skrip Materi Safety Talk Siap Pakai -->
        <section id="skrip-materi" class="space-y-8 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Perpustakaan Skrip Briefing</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              10 Contoh Skrip Materi Safety Talk Harian Siap Baca
            </h2>
          </div>

          <p class="text-slate-700">
            Berikut adalah naskah skrip yang dapat dibaca atau diimprovisasi langsung oleh pengawas lapangan sesuai sektor pekerjaan:
          </p>

          <div class="space-y-6">
            
            <!-- Skrip 1 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-100 text-amber-800">Topik 01 &bull; Manufaktur &amp; Mekanikal</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Bahaya Titik Jepit (Pinch Point) pada Bagian Mesin Berputar
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-amber-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Selamat pagi rekan-rekan. Pagi ini kita ingatkan kembali tentang bahaya titik jepit atau <em>pinch point</em> di area conveyor, gir, dan mesin pres. Anggota tubuh kita, terutama jari tangan dan lengan, tidak memiliki cadangan. Sekali tergilas gir, kerusakannya permanen."
                </p>
                <p>
                  "Tiga aturan wajib kita hari ini: Pertama, jangan pernah melepas pelindung mesin (<em>machine guard</em>) saat mesin masih dalam posisi ON. Kedua, dilarang memakai sarung tangan longgar, cincin, jam tangan, atau pakaian gombrang saat mengoperasikan mesin berputar. Ketiga, jika terjadi kemacetan bahan baku (<em>jammed</em>), matikan sakelar utama, pasang gembok LOTO (Lockout/Tagout), baru lakukan pembersihan. Keselamatan tangan Anda lebih penting daripada mengejar satu menit waktu produksi."
                </p>
              </div>
            </div>

            <!-- Skrip 2 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-100 text-blue-800">Topik 02 &bull; Ketinggian &amp; Konstruksi</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Bekerja di Ketinggian &amp; Prosedur Cek Full Body Harness
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-blue-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Rekan-rekan yang bertugas di atas perancah (scaffolding) dan atap hari ini, perhatikan: gravitasi tidak pernah bernegosiasi. Jatuh dari ketinggian 2 meter sudah cukup menyebabkan fraktur tengkorak atau kelumpuhan fatal."
                </p>
                <p>
                  "Sebelum naik, periksa 3 hal pada body harness Anda: (1) Jahitan webbing—apakah ada serat koyak atau terpapar asam? (2) Gesper pengunci (buckle)—pastikan berbunyi 'klik' terkunci rapat. (3) Hook lanyard—pastikan kait otomatis menutup sempurna. Kaitkan hook ganda secara bergantian ke titik angkur yang kuat di atas dada (<em>100% tie-off</em>). Jangan pernah mencantolkan hook ke pipa conduit atau talang air yang rapuh!"
                </p>
              </div>
            </div>

            <!-- Skrip 3 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-rose-100 text-rose-800">Topik 03 &bull; Keselamatan Listrik</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Pemeriksaan Kabel Ekstensi dan Bahaya Sengatan Listrik
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-rose-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Pagi ini cuaca mendung dan area kerja outdoor relatif lembap. Listrik adalah bahaya tak terlihat; Anda tidak tahu kabel itu beraliran sampai Anda menyentuhnya."
                </p>
                <p>
                  "Sebelum mencolokkan steker peralatan potong atau gerinda, telusuri kabel dari ujung ke ujung. Jika ada isolasi terkelupas yang hanya ditambal lakban hitam biasa, laporkan dan minta tukar ke gudang alat. Dilarang merangkai steker bertumpuk-tumpuk (<em>overload socket</em>) dan dilarang menyentuh panel dalam kondisi tangan basah. Ingat, arus 50 miliampere saja sudah bisa menghentikan detak jantung manusia."
                </p>
              </div>
            </div>

            <!-- Skrip 4 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-100 text-emerald-800">Topik 04 &bull; Ergonomi Fisik</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Teknik Manual Handling: Lindungi Tulang Belakang Saat Mengangkat Beban
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-emerald-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Nyeri pinggang (low back pain) adalah penyakit akibat kerja nomor satu yang sering merenggut produktivitas pekerja gudang dan pabrik. Tulang belakang kita bukan tuas pengungkit derek."
                </p>
                <p>
                  "Terapkan teknik angkat aman: Dekati beban, buka kaki selebar bahu agar seimbang, tekuk lutut Anda, jaga punggung tetap tegak, dan angkat beban menggunakan kekuatan otot paha—bukan pinggang! Jika beban di atas 20 kg atau berbentuk canggung, jangan sok kuat. Minta bantuan rekan kerja (<em>team lifting</em>) atau gunakan hand pallet dan trolley."
                </p>
              </div>
            </div>

            <!-- Skrip 5 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-indigo-100 text-indigo-800">Topik 05 &bull; Housekeeping 5R</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Housekeeping Rapi: Singkirkan Bahaya Terpeleset dan Tersandung (Slip, Trip, Fall)
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-indigo-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Kerapian area kerja bukan hanya soal estetika, melainkan benteng pertahanan pertama keselamatan kita. Sebagian besar kecelakaan cedera ringan hingga patah tulang berasal dari hal sepele: ceceran oli, tali packing tercecer, atau potongan kayu di jalur pejalan kaki."
                </p>
                <p>
                  "Prinsip kita hari ini: 'Lihat bahaya, bersihkan sekarang! Jangan tunggu regu kebersihan!' Jika melihat tumpahan minyak, taburkan serbuk gergaji atau pasang tanda peringatan lantai licin. Pastikan seluruh lorong evakuasi dan akses ke kotak APAR tidak terhalang palet barang. Tempat kerja yang bersih adalah cermin profesionalitas kita."
                </p>
              </div>
            </div>

            <!-- Visual Infographic Callout -->
            <div class="my-8 p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
              <div class="flex items-center justify-between border-b border-slate-100 pb-3">
                <span class="text-xs font-bold uppercase tracking-wider text-amber-600">Alat Peraga Visual Briefing</span>
                <span class="text-[11px] text-slate-400">Standar ISO 7010 &amp; SNI</span>
              </div>
              <img
                src="/wp-content/uploads/2017/03/Rambu-Rambu-K3-Beserta-Penjelasannya.png"
                alt="Rambu-Rambu Keselamatan Kerja K3 Beserta Penjelasannya untuk Materi Safety Talk"
                class="w-full h-auto rounded-xl object-contain border border-slate-100"
                loading="lazy"
              />
              <p class="text-xs text-slate-500 leading-relaxed italic text-center">
                Klasifikasi rambu peringatan, rambu larangan, rambu kewajiban APD, dan rambu jalur evakuasi darurat yang dapat ditunjukkan kepada regu kerja saat briefing safety talk harian.
              </p>
            </div>

            <!-- Skrip 6 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-cyan-100 text-cyan-800">Topik 06 &bull; Logistik &amp; Gudang</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Interaksi Forklift dan Pejalan Kaki: Menghindari Titik Buta (Blind Spot)
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-cyan-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Forklift yang mengangkut beban berat memerlukan jarak pengereman lebih panjang dan memiliki banyak titik buta (blind spot), terutama saat melintas di sudut gang sempit gudang."
                </p>
                <p>
                  "Bagi pejalan kaki: Gunakan selalu jalur hijau bertanda pejalan kaki (<em>pedestrian walkway</em>). Jangan pernah berasumsi operator forklift sudah melihat Anda. Lakukan kontak mata dan acungkan tangan sebelum menyeberang. Bagi operator: Bunyikan klakson di setiap tikungan dan persimpangan, jaga kecepatan di bawah 10 km/jam di dalam ruang, dan dilarang mengoperasikan kemudi sambil memainkan ponsel!"
                </p>
              </div>
            </div>

            <!-- Skrip 7 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-red-100 text-red-800">Topik 07 &bull; Bahaya Kebakaran</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Pencegahan Kebakaran: Hot Work Permit &amp; Kesiapan Tabung APAR
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-red-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Pekerjaan pengelasan dan pemotongan gerinda memancarkan percikan api bersuhu lebih dari 1.000 derajat Celsius yang sanggup terbang sejauh belasan meter."
                </p>
                <p>
                  "Sebelum menyalakan api las: (1) Pastikan Izin Kerja Panas (<em>Hot Work Permit</em>) sudah ditandatangani. (2) Bersihkan material mudah terbakar (kardus, tiner, majun bekas oli) dalam radius minimal 10 meter. (3) Wajib sediakan minimal 1 unit tabung APAR serbuk kimia (powder) siap pakai tepat di dekat titik kerja. (4) Tunjuk satu orang sebagai pengawas api (<em>fire watch</em>) selama pekerjaan berlangsung hingga 30 menit setelahnya."
                </p>
              </div>
            </div>

            <!-- Skrip 8 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-purple-100 text-purple-800">Topik 08 &bull; Bahan Kimia B3</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Penanganan Bahan Kimia: Baca Label MSDS &amp; Gunakan Respirator Tepat
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-purple-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Bahan kimia berbahaya dapat merusak paru-paru, membutakan mata, atau meresap ke aliran darah secara perlahan tanpa menimbulkan gejala seketika."
                </p>
                <p>
                  "Jangan pernah memindahkan bahan kimia ke wadah bekas minuman tanpa label identitas! Bacalah Lembar Data Keselamatan Bahan (MSDS/LDKB) sebelum menuang larutan. Gunakan sarung tangan berbahan nitril/neoprena (bukan katun biasa) dan gunakan masker respirator khusus cartridge uap organik—bukan masker bedah tipis. Ketahui juga posisi darurat terdekat: di mana lokasi <em>emergency eyewash</em> dan <em>safety shower</em> di lorong Anda."
                </p>
              </div>
            </div>

            <!-- Skrip 9 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-100 text-amber-800">Topik 09 &bull; Cuaca &amp; Kesehatan</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Waspada Heat Stress: Cegah Dehidrasi dan Heat Exhaustion
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-amber-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Suhu tinggi di area boiler, fabrikasi logam, atau proyek terbuka menguras cairan tubuh secara drastis. Dehidrasi memperlambat refleks otak dan memicu pusing yang berbahaya saat mengoperasikan mesin."
                </p>
                <p>
                  "Minumlah air putih secara berkala sebelum merasa haus, minimal segelas setiap 20–30 menit. Jika rekan Anda mulai tampak pucat, berkeringat dingin, linglung, atau kram otot, segera bimbing ke area teduh berangin, longgarkan pakaiannya, dan berikan air minum dingin. Jangan biarkan rekan yang terkena heat exhaustion bekerja sendirian."
                </p>
              </div>
            </div>

            <!-- Skrip 10 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-100 text-emerald-800">Topik 10 &bull; Budaya Pelaporan</span>
                <span class="text-xs text-slate-400">Durasi: 3 Menit Baca</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">
                Budaya Lapor Near Miss (Nyaris Celaka): Laporkan Sebelum Jadi Bencana
              </h3>
              <div class="p-4 rounded-xl bg-slate-50 border-l-4 border-emerald-500 text-xs sm:text-sm text-slate-700 italic space-y-2">
                <p>
                  "Berdasarkan Piramida Heinrich, di balik 1 kecelakaan fatal selalu ada 30 kecelakaan ringan dan 300 kejadian nyaris celaka (<em>near miss</em>) yang diabaikan."
                </p>
                <p>
                  "Ketika palet nyaris menimpa helm Anda, atau perkakas hampir jatuh dari perancah, jangan hanya mengucap 'untung selamat!'. Hari ini Anda beruntung, besok rekan kerja Anda yang mungkin menjadi korban. Laporkan setiap near-miss kepada pengawas atau safety officer. Kami tidak mencari siapa yang salah, tetapi memperbaiki sistem dan peralatannya agar tidak ada darah yang tertumpah."
                </p>
              </div>
            </div>

          </div>
        </section>

        <!-- Section: Jadwal Matriks Topik Mingguan (Senin - Jumat) -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Rencana Kerja Mingguan</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Matriks Jadwal Tema Safety Talk Mingguan (Senin &ndash; Jumat)
            </h2>
          </div>

          <p class="text-slate-700">
            Agar materi briefing tidak membosankan dan mencakup seluruh pilar keselamatan kerja pabrik, gunakan pola rotasi tema mingguan terstruktur berikut:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white uppercase text-xs">
                <tr>
                  <th class="py-3.5 px-4 font-bold">Hari</th>
                  <th class="py-3.5 px-4 font-bold">Tema Pokok</th>
                  <th class="py-3.5 px-4 font-bold">Fokus Aktivitas Briefing</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Senin</td>
                  <td class="py-3.5 px-4 text-amber-600 font-semibold">Target Kerja &amp; Izin Kerja Kritis</td>
                  <td class="py-3.5 px-4">Review target mingguan, identifikasi bahaya kerja kritis, dan kelengkapan JSA / Work Permit.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Selasa</td>
                  <td class="py-3.5 px-4 text-blue-600 font-semibold">Peralatan &amp; Cek APD (Buddy System)</td>
                  <td class="py-3.5 px-4">Inspeksi fisik perkakas tangan, kabel kelistrikan, dan uji kelayakan helm, sepatu, serta kacamata kerja.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Rabu</td>
                  <td class="py-3.5 px-4 text-purple-600 font-semibold">Kesehatan Kerja &amp; Higiene Industri</td>
                  <td class="py-3.5 px-4">Edukasi hidrasi, bahaya kebisingan tinggi, ergonomi postur kerja, dan penanganan zat kimia B3.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Kamis</td>
                  <td class="py-3.5 px-4 text-rose-600 font-semibold">Near Miss &amp; Unsafe Action Sharing</td>
                  <td class="py-3.5 px-4">Sesi diskusi terbuka membahas perilaku tidak aman yang terpantau dan solusi pencegahannya.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">Jumat</td>
                  <td class="py-3.5 px-4 text-emerald-600 font-semibold">Housekeeping 5R &amp; Evaluasi Mingguan</td>
                  <td class="py-3.5 px-4">Gotong royong pembersihan area kerja 5R (Ringkas, Rapi, Resik, Rawat, Rajin) dan apresiasi kepatuhan regu.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section: Format Lembar Absensi Safety Talk -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Dokumentasi Audit</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Format Formulir Notulen &amp; Daftar Hadir Safety Talk
            </h2>
          </div>

          <p class="text-slate-700">
            Agar pelaksanaan briefing sah sebagai rekaman mutu audit SMK3 dan ISO 45001, form catatan harian minimal harus memuat kolom-kolom berikut:
          </p>

          <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs text-slate-700 pb-4 border-b border-slate-200">
              <div><strong>Nama Perusahaan / Proyek:</strong> PT ........................................</div>
              <div><strong>Tanggal &amp; Waktu:</strong> ......................, Pukul ............. WIB</div>
              <div><strong>Departemen / Unit Kerja:</strong> ........................................</div>
              <div><strong>Nama Pemimpin Briefing:</strong> ........................................</div>
            </div>

            <div class="space-y-2">
              <span class="text-xs font-bold text-slate-900 block">Tabel Daftar Hadir Peserta:</span>
              <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border border-slate-200">
                  <thead class="bg-slate-100 font-bold text-slate-700">
                    <tr>
                      <th class="p-2 border">No</th>
                      <th class="p-2 border">Nama Lengkap Pekerja</th>
                      <th class="p-2 border">Jabatan / Regu</th>
                      <th class="p-2 border">Kondisi Fisik (Sehat/Tidak)</th>
                      <th class="p-2 border">Tanda Tangan</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr>
                      <td class="p-2 border text-center">1</td>
                      <td class="p-2 border">................................................</td>
                      <td class="p-2 border">..........................</td>
                      <td class="p-2 border text-emerald-700 font-semibold">[  ] Sehat  [  ] Keluhan</td>
                      <td class="p-2 border">..........................</td>
                    </tr>
                    <tr>
                      <td class="p-2 border text-center">2</td>
                      <td class="p-2 border">................................................</td>
                      <td class="p-2 border">..........................</td>
                      <td class="p-2 border text-emerald-700 font-semibold">[  ] Sehat  [  ] Keluhan</td>
                      <td class="p-2 border">..........................</td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>

            <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-600 space-y-1">
              <strong>Catatan Tindak Lanjut Pengawas:</strong>
              <p>Tuliskan temuan bahaya lapangan yang dilaporkan pekerja dan tindakan korektif yang disepakati bersama sebelum bubar barisan.</p>
            </div>
          </div>
        </section>

        <!-- Section: FAQ Pertanyaan Sering Diajukan -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Tanya Jawab</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Pertanyaan yang Sering Diajukan Seputar Safety Talk Harian
            </h2>
          </div>

          <div class="space-y-3">
            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apa perbedaan antara Safety Talk, Toolbox Meeting (TBM), dan Safety Induction?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                <strong>Safety Induction</strong> adalah pengenalan K3 komprehensif bagi karyawan baru atau tamu sebelum pertama kali memasuki gerbang pabrik. Sedangkan <strong>Safety Talk / Toolbox Meeting (TBM) / P5M</strong> adalah briefing singkat harian (5–10 menit) khusus untuk regu kerja yang akan memulai tugas harian tertentu guna menyegarkan fokus pada bahaya aktual saat itu.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Berapa durasi waktu yang paling efektif untuk safety talk?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Durasi ideal adalah <strong>5 hingga maksimal 10 menit</strong>. Jika lebih dari 15 menit, konsentrasi pekerja cenderung menurun drastis dan jadwal operasional terganggu. Kunci utama adalah konsistensi setiap hari, bukan panjangnya durasi berbicara.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Siapa yang paling tepat memimpin jalannya safety talk harian?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Paling ideal dipimpin oleh <strong>supervisor langsung, mandor, atau team leader</strong> dari regu tersebut, dengan didampingi atau dimonitor oleh Safety Officer. Hal ini memperkuat prinsip bahwa keselamatan kerja adalah tanggung jawab lini operasional, bukan semata-mata tugas departemen HSE.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apakah daftar absensi safety talk wajib diarsipkan untuk audit SMK3?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Ya, sangat wajib. Rekaman absensi harian dan notulen safety talk merupakan bukti objektif (objective evidence) yang diperiksa auditor dalam pembuktian klausul Komunikasi, Partisipasi, dan Konsultasi K3 sesuai regulasi PP No. 50 Tahun 2012 dan ISO 45001.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Bagaimana cara mengatasi pekerja yang bosan atau pasif saat briefing?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Terapkan metode rotasi giliran berbicara antarpekerja, gunakan alat peraga fisik (misalnya menunjukkan helm yang retak akibat benturan), lontarkan pertanyaan studi kasus langsung, dan berikan apresiasi kepada pekerja yang aktif melaporkan bahaya di lapangan.
              </p>
            </details>
          </div>
        </section>

      </article>

