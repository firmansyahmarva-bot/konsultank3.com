---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "In-House Training K3 Jakarta Surabaya Balikpapan";
const description = "In-House Training K3 resmi Kemnaker RI dan BNSP di Jakarta, Surabaya, Balikpapan dan kawasan industri. Jadwal fleksibel dan hemat anggaran.";
const canonical = "/in-house-training-k3-jakarta-surabaya-balikpapan/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "In-House Training K3 Multi-Kota", "item": "https://konsultank3.com/in-house-training-k3-jakarta-surabaya-balikpapan/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Program In-House Training K3 Perusahaan Resmi Kemnaker RI & BNSP",
      "description": "Layanan pelatihan keselamatan dan kesehatan kerja (K3) eksklusif di lokasi perusahaan atau fasilitas klien di Jakarta, Surabaya, Balikpapan, Yogyakarta, dan seluruh Indonesia.",
      "courseCode": "INHOUSE-K3-MULTICITY",
      "educationalCredentialAwarded": "Sertifikat Kemnaker RI, Lisensi Kewenangan K3, Sertifikat Kompetensi BNSP, SKP Ahli K3",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "hasCourseInstance": [
        {
          "@type": "CourseInstance",
          "courseMode": ["Onsite", "Blended"],
          "location": {
            "@type": "Place",
            "name": "In-House Training Area Jakarta & Bodetabek",
            "address": { "@type": "PostalAddress", "addressLocality": "DKI Jakarta", "addressRegion": "Jakarta", "addressCountry": "ID" }
          }
        },
        {
          "@type": "CourseInstance",
          "courseMode": ["Onsite", "Blended"],
          "location": {
            "@type": "Place",
            "name": "In-House Training Area Surabaya & Jawa Timur",
            "address": { "@type": "PostalAddress", "addressLocality": "Surabaya", "addressRegion": "Jawa Timur", "addressCountry": "ID" }
          }
        },
        {
          "@type": "CourseInstance",
          "courseMode": ["Onsite", "Blended"],
          "location": {
            "@type": "Place",
            "name": "In-House Training Area Balikpapan & Kalimantan Timur",
            "address": { "@type": "PostalAddress", "addressLocality": "Balikpapan", "addressRegion": "Kalimantan Timur", "addressCountry": "ID" }
          }
        },
        {
          "@type": "CourseInstance",
          "courseMode": ["Onsite", "Blended"],
          "location": {
            "@type": "Place",
            "name": "In-House Training Area Yogyakarta & Jawa Tengah",
            "address": { "@type": "PostalAddress", "addressLocality": "Yogyakarta", "addressRegion": "D.I. Yogyakarta", "addressCountry": "ID" }
          }
        }
      ]
    },
    {
      "@type": ["EducationalOrganization", "LocalBusiness"],
      "name": "Layanan In-House Training K3 Indonesia - KonsultanK3.com",
      "url": "https://konsultank3.com/in-house-training-k3-jakarta-surabaya-balikpapan/",
      "description": description,
      "telephone": "+62-895-1025-3435",
      "areaServed": [
        "DKI Jakarta",
        "Surabaya",
        "Balikpapan",
        "Yogyakarta",
        "Bekasi",
        "Karawang",
        "Semarang",
        "Medan",
        "Batam",
        "Cilegon",
        "Samarinda"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Jakarta",
        "addressCountry": "ID"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa keuntungan utama memilih In-House Training K3 dibanding Public Training?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keuntungan utama In-House Training K3 mencakup penghematan biaya investasi hingga 40-60% per peserta, jadwal dan tanggal pelatihan yang sepenuhnya fleksibel menyesuaikan jam operasional pabrik/kantor, kurikulum dan studi kasus yang disesuaikan langsung dengan profil bahaya fasilitas kerja Anda, serta eliminasi biaya tiket pesawat dan akomodasi hotel karyawan."
          }
        },
        {
          "@type": "Question",
          "name": "Kota mana saja yang dilayani untuk In-House Training K3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kami melayani penyelenggaraan In-House Training K3 di seluruh kota dan kawasan industri utama di Indonesia, dengan fokus utama di Jakarta & Bodetabek, Surabaya & Gresik, Balikpapan & Samarinda, Yogyakarta & Solo, Cikarang & Karawang, Semarang & Batang, Medan, Batam, serta Cilegon."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah sertifikat yang diterbitkan resmi dari Kemnaker RI / BNSP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya. Seluruh program sertifikasi resmi (seperti Ahli K3 Umum, K3 Kebakaran, K3 Listrik, K3 Bekerja di Ketinggian, Petugas P3K, Operator Forklift/Crane, dan POP Pertambangan) diterbitkan resmi oleh Kementerian Ketenagakerjaan RI (Kemnaker) atau Badan Nasional Sertifikasi Profesi (BNSP) lengkap dengan nomor registrasi, SKP, lisensi, atau barcode resmi yang sah secara nasional."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa batas minimal peserta untuk menyelenggarakan In-House Training?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Untuk mencapai efisiensi biaya optimal, batas minimal rombongan peserta In-House Training berkisar antara 10 hingga 30 orang per batch tergantung jenis program sertifikasi yang dipilih. Namun kami juga melayani rombongan khusus skala kecil sesuai kesepakatan korporasi."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana skema pembayaran dan kelengkapan administrasi korporasi (Invoice, Faktur Pajak)?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kami menyediakan sistem administrasi korporasi lengkap mencakup Purchase Order (PO) terms, surat penawaran resmi (quotation), faktur pajak PPN/PPh 23 resmi, kuitansi bermaterai, berita acara serah terima pekerjaan (BAST), serta opsi termin pembayaran (Down Payment dan pelunasan setelah pelatihan selesai)."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah materi dan studi kasus pelatihan bisa disesuaikan dengan SOP perusahaan kami?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, sangat bisa. Sebelum pelatihan dimulai, tim instruktur senior kami akan melakukan koordinasi pre-training review bersama tim HSE/HR perusahaan Anda untuk mengintegrasikan HIRADC, SOP keselamatan internal, data riwayat insiden perusahaan, dan observasi langsung pada mesin kerja Anda."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah peralatan praktik (APAR, Harness, Gas Detector) disediakan oleh pihak penyelenggara?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kami dapat menyediakan seluruh peralatan simulasi dan alat uji praktik (seperti gas detector, tripod winch, dummy rescue, APAR simulasi, alat ukur listrik PUIL) sesuai modul pelatihan yang disepakati, atau memadukannya dengan fasilitas proteksi keselamatan yang telah terpasang di pabrik Anda."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama waktu yang dibutuhkan untuk mempersiapkan jadwal In-House Training?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Waktu persiapan ideal adalah 2 hingga 3 minggu sebelum tanggal pelaksanaan yang diinginkan, guna memastikan penerbitan surat tugas instruktur, koordinasi administrasi izin Kemnaker/BNSP, pengiriman modul cetak dan training kit ke lokasi perusahaan."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">In-House Training Multi-Kota</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Strategic Multi-City In-House Pitch -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-400 text-xs font-semibold border border-emerald-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse-glow"></span>
            Layanan Eksklusif Perusahaan &bull; Sertifikasi Kemnaker RI &amp; BNSP
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            In-House Training K3 <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Jakarta, Surabaya, Balikpapan</span> &amp; Nasional
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Solusi pembinaan keselamatan kerja korporasi langsung di lokasi pabrik, site proyek, atau kantor cabang perusahaan Anda. Jadwal fleksibel, studi kasus disesuaikan dengan risiko spesifik industri, dan hemat anggaran hingga 50%.
          </p>

          <!-- Action Buttons with Fast Proposal Route -->
          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, kami mau meminta proposal & penawaran In-House Training K3 untuk perusahaan kami.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Minta Proposal In-House Cepat</span>
              <span>&rarr;</span>
            </a>
            <a
              href="#hub-wilayah"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Pilih Wilayah Layanan
            </a>
          </div>

          <!-- Quick Value Props Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Jangkauan</span>
              <p class="text-white font-bold text-sm">Seluruh Indonesia</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Sertifikasi</span>
              <p class="text-white font-bold text-sm">Kemnaker &amp; BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Efisiensi Biaya</span>
              <p class="text-emerald-400 font-bold text-sm">Hemat 40% &ndash; 60%</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kurikulum</span>
              <p class="text-white font-bold text-sm">Custom Kasus Pabrik</p>
            </div>
          </div>
        </div>

        <!-- Right: Corporate Visual & Fast Quotation Pill -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="In-House Training K3 Perusahaan di Jakarta Surabaya Balikpapan"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white space-y-2">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950">
                Penyelenggaraan Eksklusif Pabrik &amp; Kantor
              </span>
              <div class="text-lg font-bold">Trainer &amp; Tim Asesor Hadir Langsung</div>
              <p class="text-xs text-slate-300">
                Instruktur senior Kemnaker RI &amp; praktisi HSE industri membawa modul, studi kasus, serta perlengkapan simulasi uji praktik ke fasilitas Anda.
              </p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              🏢
            </div>
            <div>
              <div class="text-xs font-bold text-white">Administrasi Lengkap</div>
              <div class="text-[10px] text-slate-400">PO Terms, Invoice &amp; Faktur Pajak</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">⏱️</div>
            <div>
              <div class="text-xs font-bold text-white">Jadwal Menyesuaikan Shift</div>
              <div class="text-[10px] text-slate-400">Operasional Pabrik Tetap Berjalan</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Interactive City Quick-Nav Bar -->
  <aside aria-label="Navigasi Wilayah" class="w-full bg-slate-900 border-b border-white/10 py-3.5 px-4 sticky top-0 z-30 backdrop-blur-md bg-slate-900/95">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4 text-xs">
      <div class="flex items-center gap-2 text-slate-300 font-semibold">
        <span class="text-amber-400">Pilih Kota Proyek Anda:</span>
      </div>
      <div class="flex flex-wrap items-center gap-2 font-mono">
        <a href="#jakarta" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-emerald-600 text-white transition-colors">Jakarta &amp; Bodetabek</a>
        <a href="#surabaya" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-emerald-600 text-white transition-colors">Surabaya &amp; Gresik</a>
        <a href="#balikpapan" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-emerald-600 text-white transition-colors">Balikpapan &amp; Kaltim</a>
        <a href="#yogyakarta" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-emerald-600 text-white transition-colors">Yogyakarta &amp; Jateng</a>
        <a href="#kawasan-industri" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-emerald-600 text-white transition-colors">Cikarang &amp; Karawang</a>
      </div>
      <a
        href={waLink("Halo Kak, saya butuh konsultasi cepat in-house training K3 perusahaan.")}
        target="_blank"
        rel="noopener"
        class="hidden lg:inline-flex items-center gap-1.5 text-emerald-400 hover:text-emerald-300 font-bold"
      >
        <span>WA Cepat: {WA_DISPLAY}</span> &rarr;
      </a>
    </div>
  </aside>

  <!-- Main Content Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: The Corporate In-House Advantage (Why Choose In-House?) -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-2">Efisiensi &amp; Return on Investment</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Mengapa Perusahaan Terkemuka Memilih Skema In-House Training K3?
        </h2>
        <div class="h-1 w-20 bg-amber-500 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          Mengirim belasan karyawan ke kelas publik secara terpisah menghabiskan biaya akomodasi tinggi dan mengganggu rotasi kerja harian. In-House Training hadir sebagai solusi strategis untuk melatih tim secara terpadu langsung di tempat kerja:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center font-bold text-xl">
            💰
          </div>
          <h3 class="font-bold text-slate-900 text-base">Hemat Anggaran 40% &ndash; 60%</h3>
          <p class="text-slate-600 text-xs leading-relaxed">
            Biaya paket in-house dihitung per kelompok (rombongan 10-30 orang), mengeliminasi pengeluaran tiket transportasi antar-kota, sewa kamar hotel, dan uang harian karyawan.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-xl bg-blue-100 text-blue-800 flex items-center justify-center font-bold text-xl">
            📅
          </div>
          <h3 class="font-bold text-slate-900 text-base">Jadwal Bebas Tentukan Sendiri</h3>
          <p class="text-slate-600 text-xs leading-relaxed">
            Tanggal pelatihan, jam sesi, dan pembagian batch dapat diselaraskan dengan shift produksi pabrik sehingga lini operasional tidak berhenti dan produktivitas tetap terjaga.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-xl bg-amber-100 text-amber-800 flex items-center justify-center font-bold text-xl">
            🎯
          </div>
          <h3 class="font-bold text-slate-900 text-base">Kurikulum Disesuaikan Profil Risiko</h3>
          <p class="text-slate-600 text-xs leading-relaxed">
            Materi dikontekstualisasikan dengan SOP internal, jenis bahaya riil di pabrik/site Anda, serta dokumen HIRADC perusahaan untuk perbaikan langsung sistem kerja.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-xl bg-purple-100 text-purple-800 flex items-center justify-center font-bold text-xl">
            🔒
          </div>
          <h3 class="font-bold text-slate-900 text-base">Kerahasiaan Data (NDA Terjamin)</h3>
          <p class="text-slate-600 text-xs leading-relaxed">
            Diskusi proses produksi, layout fasilitas berbahaya, dan investigasi insiden internal dilakukan secara aman dan tertutup tanpa keterlibatan pihak luar atau kompetitor.
          </p>
        </div>
      </div>

      <!-- Public vs In-House Comparison Table -->
      <div class="overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm mt-8">
        <table class="w-full text-left text-sm text-slate-700 border-collapse">
          <thead>
            <tr class="bg-slate-900 text-white text-xs uppercase tracking-wider font-mono">
              <th class="py-4 px-6 border-b border-slate-800">Faktor Evaluasi</th>
              <th class="py-4 px-6 border-b border-slate-800 bg-emerald-950/80 text-emerald-300">In-House Training (Rekomendasi)</th>
              <th class="py-4 px-6 border-b border-slate-800">Public Class Reguler</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-xs sm:text-sm">
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Lokasi Pelaksanaan</td>
              <td class="py-4 px-6 bg-emerald-50/40 text-emerald-950 font-medium">Di ruang meeting pabrik, training room kantor, atau onsite site proyek</td>
              <td class="py-4 px-6">Di hotel atau ruang kelas publik yang ditentukan penyelenggara</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Penentuan Tanggal &amp; Waktu</td>
              <td class="py-4 px-6 bg-emerald-50/40 text-emerald-950 font-medium">100% Fleksibel mengikuti kalender kerja &amp; shift perusahaan</td>
              <td class="py-4 px-6">Terikat jadwal kaku batch bulanan penyelenggara</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Total Biaya per Orang</td>
              <td class="py-4 px-6 bg-emerald-50/40 text-emerald-950 font-medium">Jauh lebih hemat (skema paket rombongan tanpa biaya hotel peserta)</td>
              <td class="py-4 px-6">Tarif penuh per individu + biaya tiket travel &amp; penginapan</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Studi Kasus &amp; Praktik</td>
              <td class="py-4 px-6 bg-emerald-50/40 text-emerald-950 font-medium">Langsung menganalisis instalasi mesin, APAR, dan bahaya nyata tempat kerja sendiri</td>
              <td class="py-4 px-6">Studi kasus generik simulasi industri umum</td>
            </tr>
            <tr>
              <td class="py-4 px-6 font-bold text-slate-900">Dampak terhadap Operasional</td>
              <td class="py-4 px-6 bg-emerald-50/40 text-emerald-950 font-medium">Minimal &ndash; karyawan tetap berada di area lingkungan kerja</td>
              <td class="py-4 px-6">Karyawan absen berhari-hari meninggalkan tempat tugas</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Regional City Hubs & Specialized Sectors (Multi-City SEO Cluster) -->
    <section id="hub-wilayah" class="space-y-12 scroll-mt-20">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-2">Cakupan Sentra Industri Utama</span>
