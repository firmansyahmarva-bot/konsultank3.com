            </thead>
            <tbody class="divide-y divide-amber-100 text-slate-700">
              <tr>
                <td class="p-3 font-bold text-slate-900">Absorbent Boom / Sock</td>
                <td class="p-3">Membendung perimeter luapan cairan</td>
                <td class="p-3">4 – 8 buah (panjang 1.2 – 3m)</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-900">Absorbent Pads</td>
                <td class="p-3">Menyerap tumpahan di permukaan lantai</td>
                <td class="p-3">50 – 100 lembar</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-900">Absorbent Pillows</td>
                <td class="p-3">Menampung titik kebocoran yang menetes</td>
                <td class="p-3">4 – 6 buah bantal serap</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-900">Drain Cover / Penutup Got</td>
                <td class="p-3">Mencegah zat B3 mengalir ke riol umum</td>
                <td class="p-3">1 unit lembar magnet/poly</td>
              </tr>
              <tr>
                <td class="p-3 font-bold text-slate-900">Alat Sekop Non-Sparking</td>
                <td class="p-3">Membersihkan serbuk tanpa percikan api</td>
                <td class="p-3">1 set sekop polimer khusus</td>
              </tr>
              <tr>
