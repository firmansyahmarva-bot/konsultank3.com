---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { batches } from '../../data/batches.js';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const batch = batches.pppu;

const title = "Sertifikasi BNSP PPPU & POIPPU Emisi Udara";
const description = "Pelatihan & sertifikasi resmi BNSP PPPU dan POIPPU Operasional Emisi sesuai SKKNI 282/2020. Pembekalan intensif, bimbingan portofolio, dan uji kompetensi.";
const canonical = "/pelatihan-pppu-poippu/";

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Sertifikasi BNSP PPPU & POIPPU", "item": "https://konsultank3.com/pelatihan-pppu-poippu/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan dan Sertifikasi BNSP PPPU & POIPPU Emisi Udara Industri",
      "description": "Sertifikasi kompetensi resmi BNSP untuk Penanggung Jawab Pengendalian Pencemaran Udara (PPPU) dan Pengendali Emisi (POIPPU) sesuai SKKNI No. 282 Tahun 2020.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={courseSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">BNSP PPPU &amp; POIPPU</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 text-cyan-400 text-xs font-semibold border border-cyan-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
            Standar Kompetensi Kerja Nasional Indonesia &bull; SKKNI No. 282/2020
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Sertifikasi BNSP <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">PPPU &amp; POIPPU</span> Emisi Udara Industri
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Sertifikasi kompetensi resmi <strong>Badan Nasional Sertifikasi Profesi (BNSP)</strong> untuk Penanggung Jawab Pengendalian Pencemaran Udara (PPPU) dan Operasional Alat Pengendali Emisi (POIPPU). Pastikan emisi boiler, cerobong genset, dan tungku industri memenuhi baku mutu KLHK.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi Sertifikasi BNSP PPPU dan POIPPU Emisi Udara")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi WhatsApp Resmi &rarr;
            </a>
            <a
              href="#jenjang-pelatihan"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Skema PPPU &amp; POIPPU
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Skema</span>
              <p class="text-white font-bold text-sm">PPPU &amp; POIPPU</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Standar</span>
              <p class="text-white font-bold text-sm">SKKNI 282/2020</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen</span>
              <p class="text-white font-bold text-sm">Garuda Emas BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kualifikasi</span>
              <p class="text-emerald-400 font-bold text-sm">LSP Lingkungan</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pembekalan Asesmen Portofolio Sertifikasi BNSP PPPU Pengendalian Pencemaran Udara"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-500 text-slate-950 mb-2">
                Emisi Cerobong &amp; Isokinetik
              </span>
              <div class="text-lg font-bold">Kepatuhan Baku Mutu Emisi</div>
              <p class="text-xs text-slate-300 mt-1">Pemantauan Wet Scrubber, Bag Filter (Baghouse), CEMS online, dan pelaporan semester SISPEK.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-cyan-500 text-white flex items-center justify-center font-bold text-lg">
              💨
            </div>
            <div>
              <div class="text-xs font-bold text-white">LSP Lingkungan Resmi</div>
              <div class="text-[10px] text-slate-400">Badan Sertifikasi BNSP RI</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🏭</div>
            <div>
              <div class="text-xs font-bold text-white">Skema PPPU &amp; POIPPU</div>
              <div class="text-[10px] text-slate-400">Pengendali &amp; Operator APPU</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Article Content Column -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section 1: Apa itu Sertifikasi BNSP PPPU & POIPPU -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Pengenalan Program</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Apa itu Sertifikasi BNSP PPPU &amp; POIPPU</h2>
          </div>
          <p class="text-base sm:text-lg text-slate-700 font-light leading-relaxed">
            Sertifikasi BNSP PPPU dan POIPPU adalah program sertifikasi profesi resmi berskala nasional yang diselenggarakan melalui Lembaga Sertifikasi Profesi (LSP) terakreditasi Badan Nasional Sertifikasi Profesi (BNSP) untuk memberikan pengakuan atas kompetensi kerja Penanggung Jawab Pengendalian Pencemaran Udara (PPPU) dan Penanggung Jawab Operasional Instalasi Pengendalian Pencemaran Udara (POIPPU). Sertifikat kompetensi yang diterbitkan berlambang Garuda Emas dan menjadi bukti autentik pemenuhan kualifikasi teknis di bidang pengendalian emisi industri.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Aktivitas pembakaran bahan bakar pada boiler industri, generator pembangkit (genset), tanur peleburan (kiln), insinerator limbah, dan peralatan termal lainnya melepaskan emisi gas buang ke atmosfer yang berpotensi menurunkan kualitas udara ambien. Polutan udara seperti sulfur dioksida (SO2), nitrogen dioksida (NO2), karbon monoksida (CO), serta partikulat debu halus (PM10 dan PM2.5) dapat memicu gangguan kesehatan pernapasan akut bagi manusia serta hujan asam. Kehadiran personel pengendali pencemaran udara menjamin operasional peralatan pembersih gas buang berjalan efektif dan konsisten memenuhi standar baku mutu emisi nasional.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Regulasi Kementerian Lingkungan Hidup dan Kehutanan (KLHK) menetapkan kepatuhan baku mutu emisi cerobong sebagai indikator wajib dalam penilaian PROPER dan pelaporan berkala melalui platform Sistem Informasi Pelaporan Lingkungan Hidup (SIMPEL) dan Sistem Informasi Pemantauan Emisi Industri Secara Terus Menerus (SISPEK). Skema sertifikasi ini berpedoman pada Standar Kompetensi Kerja Nasional Indonesia (SKKNI) No. 282 Tahun 2020 guna menjamin keandalan pengawasan emisi industri.
          </p>
          <div class="p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20 space-y-3">
            <h3 class="text-base font-bold text-amber-900">Siapa Saja yang Membutuhkan Sertifikasi Ini?</h3>
            <p class="text-sm text-slate-700 font-light leading-relaxed">
              Program sertifikasi ini wajib dipenuhi oleh industri manufaktur dan fasilitas yang mengoperasikan sumber emisi tidak bergerak, antara lain:
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-700 font-light">
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Manajer Lingkungan &amp; HSE Pabrik:</strong> Bertanggung jawab atas perencanaan mitigasi polusi udara, integrasi CEMS, dan pelaporan semester SIMPEL/SISPEK.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Operator Alat Pengendali Udara (APPU):</strong> Mengoperasikan dan merawat wet scrubber, baghouse filter (dust collector), cyclone, dan electrostatic precipitator (ESP).</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pabrik Semen, Baja, Kimia &amp; Keramik:</strong> Industri dengan emisi debu partikulat, asam gas buang, dan suhu cerobong tinggi.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pembangkit Listrik (PLTU / PLTD / PLTG):</strong> Mengelola cerobong emisi skala besar, boiler batu bara/biomassa, dan jaringan genset darurat.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pabrik Kelapa Sawit &amp; Pengolahan Kayu:</strong> Mengoperasikan boiler biomassa cangkang-fiber dengan potensi asap dan partikulat cerobong.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Teknisi Sampling Emisi Isokinetik:</strong> Melakukan pengukuran kecepatan alir gas buang, kadar opasitas, dan sampling partikulat di ketinggian cerobong.</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Jenjang / Jenis Pelatihan -->
        <section id="jenjang-pelatihan" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Klasifikasi &amp; Tingkatan</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Jenjang / Jenis Pelatihan</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Sertifikasi BNSP bidang pengendalian pencemaran udara terbagi menjadi dua skema kualifikasi profesi yang memiliki batas tanggung jawab spesifik:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white text-xs uppercase font-semibold">
                <tr>
                  <th class="py-4 px-4 sm:px-6">Jenjang / Skema</th>
                  <th class="py-4 px-4 sm:px-6">Peran</th>
                  <th class="py-4 px-4 sm:px-6">Tugas utama</th>
                  <th class="py-4 px-4 sm:px-6">Materi kunci</th>
                  <th class="py-4 px-4 sm:px-6">Persyaratan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">PPPU</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Penanggung Jawab Pengendalian Pencemaran Udara (Tingkat Manajerial)</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Merancang program reduksi emisi, mengawasi integrasi sistem Continuous Emission Monitoring System (CEMS), mengoordinasikan uji emisi laboratorium terakreditasi KAN, dan pelaporan SISPEK KLHK</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Identifikasi sumber emisi boiler/genset/insinerator, karakterisasi emisi SO2, NO2, CO, partikulat debu, kalkulasi beban emisi tahunan, regulasi baku mutu cerobong, pelaporan SIMPEL/SISPEK</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Pendidikan relevan atau pengalaman kerja terbukti di bidang pengendalian pencemaran udara industri</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">POIPPU</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Penanggung Jawab Operasional Instalasi Pengendalian Pencemaran Udara (Tingkat Operasional)</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Mengoperasikan alat pengendali pencemaran udara (APPU), memantau indikator tekanan diferensial filter, melakukan pembersihan hopper debu, dan merawat blower hisap</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Pengoperasian unit Wet Scrubber, Bag Filter (Baghouse), Cyclone, Electrostatic Precipitator (ESP), penggantian filter bag, pemeriksaan magnehelic gauge, dan keselamatan K3 sampling cerobong</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Pendidikan relevan atau pengalaman operasional alat pengendali emisi APPU di industri</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-sm text-slate-600 font-light leading-relaxed">
            Pembagian skema PPPU dan POIPPU menciptakan integrasi kendali emisi yang kokoh. Penanggung Jawab Pengendalian (PPPU) mengelola kalkulasi beban emisi dan kepatuhan perizinan lingkungan, sedangkan Operator Instalasi (POIPPU) memastikan bahwa peralatan scrubber, baghouse filter, dan blower pembuangan berfungsi dalam efisiensi penangkapan polutan tertinggi setiap saat.
          </p>
        </section>

        <!-- Section 3: Dasar Hukum -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Landasan Regulasi</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Dasar Hukum</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Penyelenggaraan pembinaan dan sertifikasi kompetensi profesi pengendalian emisi udara berpijak pada ketentuan perundang-undangan nasional yang berkekuatan hukum tetap, meliputi:
          </p>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                <h3 class="text-base font-bold text-slate-900">UU No. 1 Tahun 1970 tentang Keselamatan Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Undang-Undang Keselamatan Kerja mewajibkan perlindungan keselamatan terhadap seluruh faktor fisik dan kimia berbahaya di tempat kerja. Pada Pasal 3 ayat (1) huruf f dan k diatur kewajiban untuk mencegah dan mengendalikan timbulnya atau menyebarluasnya suhu, kelembaban, debu, kotoran, asap, uap, dan gas buang beracun di tempat kerja guna melindungi kesehatan tenaga kerja serta mencegah bahaya peledakan atau kebakaran.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                <h3 class="text-base font-bold text-slate-900">SKKNI No. 282 Tahun 2020 tentang Pengendalian Pencemaran Udara</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Standar Kompetensi Kerja Nasional Indonesia yang ditetapkan oleh Menteri Ketenagakerjaan RI sebagai acuan baku kompetensi profesi bidang pengendalian pencemaran udara. Menetapkan standar unit kompetensi yang meliputi identifikasi sumber emisi, penilaian tingkat pencemaran gas buang, pengoperasian dan perawatan alat pengendali emisi (APPU), pemantauan sistem CEMS, hingga keselamatan kerja K3 pada cerobong emisi.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                <h3 class="text-base font-bold text-slate-900">Permen LHK No. 11 Tahun 2021 tentang Baku Mutu Emisi Mesin dengan Pembakaran Dalam</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peraturan Menteri Lingkungan Hidup dan Kehutanan yang menetapkan standar baku mutu emisi gas buang untuk mesin pembakaran dalam (Internal Combustion Engine), seperti genset pembangkit listrik dan pompa berbahan bakar minyak atau gas. Mengatur batas ambang konsentrasi parameter karbon monoksida (CO), nitrogen oksida (NOx), sulfur dioksida (SO2), dan partikulat debu serta kewajiban pengukuran berkala.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
                <h3 class="text-base font-bold text-slate-900">Permen LHK No. P.15/MENLHK/SETJEN/KUM.1/4/2019 tentang Baku Mutu Emisi Pembangkit Termal</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Regulasi yang menetapkan batas baku mutu emisi cerobong untuk pembangkit listrik tenaga termal berbahan bakar batu bara, gas, dan minyak. Menetapkan kewajiban pemasangan Continuous Emission Monitoring System (CEMS) yang terkoneksi langsung secara online ke sistem SISPEK KLHK serta mengatur tata cara uji akurasi relatif (RATA) pada instrumen penganalisis gas emisi.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 4: Silabus Pembelajaran -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Materi Kurikulum</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Silabus Pembelajaran</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kurikulum pembekalan disusun secara terstruktur berdasarkan daftar unit kompetensi SKKNI No. 282 Tahun 2020, memadukan wawasan regulasi emisi dengan keterampilan teknis pengoperasian alat pengendali udara:
          </p>

          <div class="space-y-5">
            <!-- Topic 1 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-700 font-mono text-xs flex items-center justify-center font-bold">01</span>
                Mengidentifikasi Sumber Pencemaran Udara dari Emisi (Unit E.370000.010.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Unit kompetensi ini membekali peserta dengan keterampilan melakukan inventarisasi menyeluruh terhadap sumber-sumber emisi tidak bergerak di fasilitas industri. Peserta memetakan cerobong buangan boiler, cerobong genset diesel, tanur kiln peleburan, insinerator limbah, dan thermal oxidizer. Diidentifikasi jenis bahan bakar yang digunakan, laju konsumsi energi, serta dimensi teknis cerobong pembuangan.
              </p>
            </div>

            <!-- Topic 2 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-700 font-mono text-xs flex items-center justify-center font-bold">02</span>
                Menentukan Karakteristik Sumber Pencemaran Udara (Unit E.370000.011.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini mendalami analisis parameter gas buang industri, meliputi konsentrasi sulfur dioksida (SO2), nitrogen dioksida (NO2), karbon monoksida (CO), kadar partikulat debu (PM10 dan PM2.5), serta tingkat kepekatan asap (opasitas). Peserta mempelajari pengaruh kecepatan alir gas buang cerobong dan suhu gas buang terhadap pola dispersi polutan di atmosfer. Pemahaman ini menjadi rujukan utama penentuan teknologi pengendalian emisi yang sesuai.
              </p>
            </div>

            <!-- Topic 3 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-700 font-mono text-xs flex items-center justify-center font-bold">03</span>
                Menilai Tingkat Pencemaran Udara dari Emisi (Unit E.370000.012.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini membahas metodologi kalkulasi beban emisi tahunan berdasarkan konsentrasi gas polutan, laju alir volumetrik cerobong, dan jam kerja operasional peralatan. Peserta mengevaluasi kesesuaian hasil emisi terhadap baku mutu Permen LHK No. 11/2021 dan Permen LHK No. P.15/2019. Analisis ini esensial guna memastikan perusahaan tidak melampaui kuota alokasi beban pencemaran udara yang ditetapkan pemerintah.
              </p>
            </div>

            <!-- Topic 4 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-700 font-mono text-xs flex items-center justify-center font-bold">04</span>
                Mengoperasikan Alat Pengendali Pencemaran Udara / APPU (Unit E.370000.013.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peserta dibekali keahlian operasional terhadap berbagai teknologi unit APPU, mencakup sistem Wet Scrubber untuk menyerap gas asam, Bag Filter (Baghouse Dust Collector) untuk menangkap debu partikulat, Cyclone untuk pemisahan partikel kasar, serta Electrostatic Precipitator (ESP). Dipelajari prosedur startup, penyesuaian laju aliran cairan scrubbing, pembersihan kantong filter secara pneumatik, serta prosedur penghentian sistem secara aman.
              </p>
            </div>

            <!-- Topic 5 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-700 font-mono text-xs flex items-center justify-center font-bold">05</span>
                Melakukan Perawatan Alat Pengendali Pencemaran Udara (Unit E.370000.015.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini menitikberatkan pada pemeliharaan preventif instrumen pengendali emisi di lapangan. Peserta dilatih memantau pembacaan tekanan diferensial menggunakan magnehelic gauge guna mendeteksi penyumbatan atau robekan pada kantong filter bag. Pembahasan mencakup prosedur penggantian filter bag yang rusak, pengosongan hopper debu, pemeriksaan nozzle semprot scrubber, serta pelumasan berkala pada bearing fan blower pengisap gas.
              </p>
            </div>

            <!-- Topic 6 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-cyan-500/10 text-cyan-700 font-mono text-xs flex items-center justify-center font-bold">06</span>
                Mengidentifikasi Bahaya &amp; K3 pada Cerobong Emisi (Unit E.370000.018.01)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini berfokus pada pencegahan kecelakaan kerja saat melakukan aktivitas pemantauan di ketinggian cerobong industri. Peserta mempelajari kriteria tangga monyet berpelindung kurung (cage ladder), kelaikan platform lantai kerja sampling cerobong, serta penyediaan lubang sampling isokinetik berflens 8D/2D yang memenuhi standar teknis. Dipelajari pula penggunaan alat pelindung diri pernapasan terhadap gas panas beracun dan fall arrester penahan jatuh.
              </p>
            </div>

            <!-- Topic 7 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
