---
import BaseLayout from '../../layouts/BaseLayout.astro';

const units = [
  { code: 'E.370000.010.01', title: 'Mengidentifikasi Sumber Pencemaran Udara dari Emisi', desc: 'Inventarisasi sumber tidak bergerak (boiler, genset, kiln, incinerator, thermal oxidizer) dan cerobong pembuangan.' },
  { code: 'E.370000.011.01', title: 'Menentukan Karakteristik Sumber Pencemaran Udara', desc: 'Parameter SO2, NO2, CO, partikulat debu (PM10/PM2.5), opasitas, kecepatan alir gas buang, dan suhu cerobong.' },
  { code: 'E.370000.012.01', title: 'Menilai Tingkat Pencemaran Udara dari Emisi', desc: 'Perhitungan beban emisi tahunan dan kesesuaian terhadap Permen LHK No. 11/2021 dan Permen LHK No. P.15/2019.' },
  { code: 'E.370000.013.01', title: 'Mengoperasikan Alat Pengendali Pencemaran Udara (APPU)', desc: 'Pengendalian unit Wet Scrubber, Bag Filter (Dust Collector), Cyclone, dan Electrostatic Precipitator (ESP).' },
  { code: 'E.370000.015.01', title: 'Melakukan Perawatan Alat Pengendali Pencemaran Udara', desc: 'Penggantian filter bag, pembersihan hopper debu, pemeriksaan tekanan diferensial (magnehelic), dan sistem pelumasan fan blower.' },
  { code: 'E.370000.018.01', title: 'Mengidentifikasi Bahaya & K3 pada Cerobong Emisi', desc: 'Keselamatan bekerja di ketinggian (tangga monyet cerobong), lubang sampling isokinetik, dan gas panas beracun.' }
];

const faqs = [
  {
    q: 'Apa perbedaan skema PPPU dan POIPPU dalam sertifikasi BNSP?',
    a: 'PPPU (Penanggung Jawab Pengendalian Pencemaran Udara) diperuntukkan bagi level manajer teknis atau kepala HSE yang bertugas mengelola kepatuhan perizinan emisi, pelaporan SIMPEL/SISPEK KLHK, dan perencanaan reduksi emisi. Sedangkan POIPPU (Penanggung Jawab Operasional Instalasi Pengendalian Pencemaran Udara) adalah sertifikasi untuk operator lapangan yang mengoperasikan boiler, scrubber, baghouse, atau dust collector.'
  },
  {
    q: 'Apakah sertifikasi ini mencakup integrasi sistem Continuous Emission Monitoring System (CEMS)?',
    a: 'Ya, modul pembekalan mencakup pemahaman regulasi CEMS online, konektivitas SISPEK KLHK, uji relatif akurasi (RATA), dan kalibrasi instrumen penganalisis gas emisi.'
  },
  {
    q: 'Bagaimana pelaksanaan uji kompetensi BNSP berlangsung?',
    a: 'Uji kompetensi dilaksanakan melalui metode verifikasi portofolio berkas kerja, tes tulis, dan wawancara teknis mendalam bersama Asesor Lembaga Sertifikasi Profesi (LSP) berlisensi resmi BNSP.'
  }
];

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Sertifikasi BNSP PPPU & POIPPU", "item": "https://konsultank3.com/pelatihan-pppu-poippu/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan dan Sertifikasi BNSP PPPU & POIPPU Emisi Udara Industri",
      "description": "Sertifikasi kompetensi resmi BNSP untuk Penanggung Jawab Pengendalian Pencemaran Udara (PPPU) dan Pengendali Emisi (POIPPU) sesuai SKKNI No. 282 Tahun 2020.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout
  title="Sertifikasi BNSP PPPU & POIPPU Emisi Udara"
  description="Pelatihan & sertifikasi resmi BNSP PPPU dan POIPPU (Operasional Alat Emisi) sesuai SKKNI 282/2020. Pembekalan intensif & bimbingan portofolio."
  canonical="/pelatihan-pppu-poippu/"
  schema={courseSchema}
  presetMessage="Halo KonsultanK3, saya ingin konsultasi pendaftaran sertifikasi BNSP PPPU / POIPPU emisi udara."
>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">BNSP PPPU &amp; POIPPU</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 text-cyan-400 text-xs font-semibold border border-cyan-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-ping"></span>
            Standar Kompetensi Kerja Nasional Indonesia &bull; SKKNI No. 282/2020
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Sertifikasi BNSP <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">PPPU &amp; POIPPU</span> Emisi Udara Industri
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Sertifikasi kompetensi resmi <strong>Badan Nasional Sertifikasi Profesi (BNSP)</strong> untuk Penanggung Jawab Pengendalian Pencemaran Udara (PPPU) dan Operasional Alat Pengendali Emisi (POIPPU). Pastikan emisi boiler, cerobong genset, dan tungku industri memenuhi baku mutu KLHK.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20info%20jadwal%20dan%20biaya%20sertifikasi%20BNSP%20PPPU%20POIPPU"
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Daftar Batch Terdekat &rarr;
            </a>
            <a
              href="#unit-kompetensi-udara"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Unit Kompetensi
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi</span>
              <p class="text-white font-bold text-sm">3 Hari (Bimtek + Uji)</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Metode</span>
              <p class="text-white font-bold text-sm">Online / Hybrid</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Sertifikat</span>
              <p class="text-white font-bold text-sm">Garuda Emas BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Masa Berlaku</span>
              <p class="text-emerald-400 font-bold text-sm">3 Tahun Nasional</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pembekalan Asesmen Portofolio Sertifikasi BNSP PPPU Pengendalian Pencemaran Udara"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-500 text-slate-950 mb-2">
                Emisi Cerobong &amp; Isokinetik
              </span>
              <div class="text-lg font-bold">Kepatuhan Baku Mutu Emisi</div>
              <p class="text-xs text-slate-300 mt-1">Pemantauan Wet Scrubber, Bag Filter (Baghouse), CEMS online, dan pelaporan semester SISPEK.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-cyan-500 text-white flex items-center justify-center font-bold text-lg">
              💨
            </div>
            <div>
              <div class="text-xs font-bold text-white">LSP Lingkungan Resmi</div>
              <div class="text-[10px] text-slate-400">Badan Sertifikasi BNSP RI</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🏭</div>
            <div>
              <div class="text-xs font-bold text-white">Skema PPPU &amp; POIPPU</div>
              <div class="text-[10px] text-slate-400">Pengendali &amp; Operator APPU</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <div class="lg:col-span-8 space-y-12">
        
        <!-- Overview Card -->
        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
          <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900">
            Mengapa Personel Pengendali Udara Wajib Bersertifikat BNSP?
          </h2>
          <p class="text-base text-slate-700 leading-relaxed font-sans">
            Sesuai regulasi Kementerian LHK, setiap industri yang mengoperasikan sumber emisi tidak bergerak (seperti pembangkit genset, boiler bahan bakar batu bara/biomassa/gas, serta proses pembakaran industri) wajib melakukan pengendalian emisi udara secara berkala. Sertifikasi BNSP memberikan legalitas pengakuan keahlian bagi personel dalam mengoperasikan alat pengendali pencemaran udara (APPU) dan memastikan emisi memenuhi baku mutu udara nasional.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-cyan-700 block mb-1">Skema PPPU (Penanggung Jawab)</span>
              <p class="text-xs text-slate-600 leading-relaxed">Pengelolaan strategi pencegahan polusi udara, kalkulasi beban emisi, koordinasi laboratorium lingkungan terakreditasi KAN, dan pelaporan SISPEK.</p>
            </div>
            <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
              <span class="text-xs font-bold uppercase tracking-wider text-emerald-700 block mb-1">Skema POIPPU (Operator Teknis)</span>
              <p class="text-xs text-slate-600 leading-relaxed">Pengoperasian praktis alat pengendali udara (Cyclone, Wet Scrubber, Baghouse Filter, ESP), inspeksi fan blower, dan pembersihan filter berkala.</p>
            </div>
          </div>
        </div>

        <!-- Unit Kompetensi SKKNI -->
        <div id="unit-kompetensi-udara" class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6 scroll-mt-24">
          <h3 class="text-2xl font-bold font-serif text-slate-900">
            Daftar Unit Kompetensi SKKNI No. 282 Tahun 2020
          </h3>
          
          <div class="space-y-4">
            {units.map((u, idx) => (
              <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                <div class="space-y-1">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono font-bold text-cyan-700 bg-cyan-100 px-2 py-0.5 rounded-md">{u.code}</span>
                    <span class="text-xs font-bold text-slate-500">Unit {idx + 1}</span>
                  </div>
                  <h4 class="font-bold text-slate-900 text-base">{u.title}</h4>
                  <p class="text-xs text-slate-600 leading-relaxed">{u.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- FAQs -->
        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
          <h3 class="text-2xl font-bold font-serif text-slate-900">
            Pertanyaan Umum Seputar Uji Kompetensi Emisi
          </h3>
          
          <div class="space-y-3">
            {faqs.map(f => (
              <details class="group p-4 rounded-2xl bg-slate-50 border border-slate-200 [&_summary::-webkit-details-marker]:hidden">
                <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-sm">
                  <span>{f.q}</span>
                  <span class="ml-2 text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                </summary>
                <p class="mt-3 text-xs text-slate-600 leading-relaxed pt-2 border-t border-slate-200">
                  {f.a}
                </p>
              </details>
            ))}
          </div>
        </div>

      </div>

      <!-- Sticky Sidebar -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        
        <div class="p-6 rounded-3xl bg-slate-900 text-white space-y-4 shadow-xl">
          <div class="text-xs font-bold uppercase tracking-wider text-amber-400">Pendaftaran Batch</div>
          <h4 class="text-lg font-bold font-serif">Jadwal Sertifikasi BNSP Terdekat</h4>
          <div class="space-y-2 text-xs text-slate-300">
            <div class="flex justify-between border-b border-white/10 pb-1.5">
              <span>Metode:</span>
              <strong class="text-white">Online Pra-Uji + Uji Asesor</strong>
            </div>
            <div class="flex justify-between border-b border-white/10 pb-1.5">
              <span>Output:</span>
              <strong class="text-emerald-400">Sertifikat Garuda BNSP</strong>
            </div>
            <div class="flex justify-between">
              <span>Status:</span>
              <strong class="text-cyan-400">Buka Kuota Peserta</strong>
            </div>
          </div>

          <a
            href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20mendaftar%20sertifikasi%20BNSP%20PPPU%20POIPPU"
            target="_blank"
            rel="noopener"
            class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg transition-all"
          >
            <span>Daftar via WhatsApp</span> &rarr;
          </a>
        </div>

        <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Sertifikasi Terkait</div>
          <div class="space-y-2 text-sm font-semibold text-slate-800">
            <a href="/pelatihan-pppa-popal/" class="block hover:text-cyan-600">💧 Sertifikasi BNSP PPPA &amp; POPAL (Air Limbah)</a>
            <a href="/pelatihan-k3-kebakaran/" class="block hover:text-cyan-600">🔥 K3 Penanggulangan Kebakaran</a>
            <a href="/pelatihan-ahli-k3-umum/" class="block hover:text-cyan-600">🎓 Pembinaan Ahli K3 Umum</a>
          </div>
        </div>

      </aside>

    </div>
  </main>
</BaseLayout>
