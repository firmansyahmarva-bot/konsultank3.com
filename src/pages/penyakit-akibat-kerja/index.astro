    <div>
      <span class="block text-[11px] uppercase tracking-wider text-slate-500 font-bold mb-1">Regulasi Rujukan</span>
      <span class="text-sm font-extrabold text-slate-900">Perpres No. 7/2019</span>
    </div>
    <div>
      <span class="block text-[11px] uppercase tracking-wider text-slate-500 font-bold mb-1">Standar Diagnosis</span>
