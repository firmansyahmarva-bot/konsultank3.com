---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticlesForPillar } from '../../data/topics.js';

const title = "Diagnosis & Pencegahan Penyakit Akibat Kerja (PAK)";
const metaTitle = "Diagnosis & Pencegahan Penyakit Akibat Kerja (PAK)";
const description = "Pedoman identifikasi pajanan tempat kerja, 7 langkah penegakan diagnosis okupasi, dan program pencegahan Penyakit Akibat Kerja sesuai Perpres No. 7/2019.";
const canonical = "/penyakit-akibat-kerja/";

const mappedArticles = getArticlesForPillar('penyakit-akibat-kerja');

const faqs = [
  {
    q: "Apa perbedaan antara Penyakit Akibat Kerja (PAK) murni dan penyakit terkait kerja (work-related disease)?",
    a: "Penyakit Akibat Kerja (PAK) adalah penyakit yang memiliki hubungan sebab-akibat langsung dengan faktor bahaya pajanan di tempat kerja. Sedangkan penyakit terkait kerja (work-related disease) adalah penyakit umum yang diperberat atau dipicu manifestasinya oleh kondisi lingkungan atau beban kerja."
  },
  {
    q: "Siapa yang berwenang menetapkan diagnosis formal Penyakit Akibat Kerja?",
    a: "Penetapan diagnosis Penyakit Akibat Kerja wajib ditegakkan secara resmi oleh dokter pemeriksa kesehatan tenaga kerja atau dokter spesialis kedokteran okupasi melalui 7 langkah pembuktian kausalitas klinis okupasi."
  },
  {
    q: "Mengapa riwayat pekerjaan masa lalu sangat penting dalam 7 langkah diagnosis okupasi?",
    a: "Banyak Penyakit Akibat Kerja memiliki masa laten (latency period) yang sangat panjang sebelum menimbulkan gejala klinis, seperti asbestosis atau silikosis yang baru muncul belasan hingga puluhan tahun setelah masa paparan awal di tempat kerja sebelumnya."
  },
  {
    q: "Kapan perusahaan wajib menyelenggarakan pemeriksaan kesehatan khusus bagi pekerja?",
    a: "Pemeriksaan kesehatan khusus diselenggarakan bagi tenaga kerja yang melakukan pekerjaan dengan tingkat risiko bahaya tinggi, seperti terpapar radiasi, bekerja di ruang terbatas, menangani pestisida atau bahan kimia B3 karsinogenik, serta pekerja yang baru pulih dari penyakit berat."
  },
  {
    q: "Bagaimana peran surveilans kesehatan berkala dalam mencegah disabilitas akibat PAK?",
    a: "Surveilans kesehatan berkala (MCU rutin) berfungsi mendeteksi perubahan fungsi fisiologis atau kerusakan organ tubuh pada stadium preklinis sebelum timbulnya kecacatan permanen, sehingga intervensi perbaikan lingkungan kerja dapat segera dilakukan."
  }
];
