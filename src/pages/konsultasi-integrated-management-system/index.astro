---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Konsultasi Integrated Management System (IMS)";
const description = "Jasa konsultasi Integrated Management System (IMS): integrasi ISO 45001, ISO 14001, ISO 9001, dan SMK3 PP 50/2012. Gap analysis, manual terpadu, dan audit.";
const canonical = "/konsultasi-integrated-management-system/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Layanan Konsultasi", "item": "https://konsultank3.com/panduan-penerapan-smk3/" },
        { "@type": "ListItem", "position": 3, "name": "Konsultasi IMS", "item": "https://konsultank3.com/konsultasi-integrated-management-system/" }
      ]
    },
    {
      "@type": "Service",
      "name": "Jasa Konsultasi Integrated Management System (IMS) - ISO 45001, 14001, 9001 & SMK3",
      "serviceType": "QHSE Corporate Consulting",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa keuntungan mengintegrasikan ISO 45001, ISO 14001, ISO 9001 dan SMK3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Integrasi sistem menghilangkan duplikasi dokumen manual, menghemat waktu audit internal hingga 50%, menyatukan risk register mutu-K3-lingkungan, dan memangkas biaya sertifikasi auditor eksternal."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama durasi implementasi konsultasi IMS hingga siap sertifikasi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durasi tipikal berkisar antara 4 hingga 6 bulan tergantung pada kompleksitas operasional, jumlah site/cabang, dan kematangan sistem dokumentasi awal perusahaan."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah SMK3 PP 50/2012 bisa benar-benar disatukan dengan ISO 45001?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bisa. Meskipun format penomoran kriteria SMK3 (64, 122, 166 kriteria) berbeda dengan struktur klausul ISO (Annex SL High-Level Structure), matriks korelasi yang kami susun memungkinkan 1 prosedur operasional memenuhi persyaratan kedua standar sekaligus."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/panduan-penerapan-smk3/" class="hover:text-amber-400 transition-colors">Konsultasi Sistem</a>
        <span>/</span>
        <span class="text-slate-300">Integrated Management System (IMS)</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Value Prop -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse-glow"></span>
            Konsultasi Terpadu QHSE &bull; ISO 45001, 14001, 9001 &amp; SMK3
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Konsultasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Integrated Management System</span> (IMS)
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Satukan sistem mutu (ISO 9001), lingkungan (ISO 14001), dan keselamatan kerja (ISO 45001 &amp; SMK3 PP 50/2012) ke dalam satu arsitektur operasional yang ramping, efisien, dan siap audit.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, kami membutuhkan proposal konsultasi Integrated Management System (ISO 45001, 14001, 9001 & SMK3)")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Diskusi Kebutuhan via WhatsApp &rarr;
            </a>
            <a
              href="#roadmap-implementasi"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Roadmap 5 Tahap Integrasi
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Cakupan Standar</span>
              <p class="text-white font-bold text-sm">4 Standar Kunci</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Efisiensi Audit</span>
              <p class="text-white font-bold text-sm">Hemat s.d 50% Waktu</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Struktur Desain</span>
              <p class="text-white font-bold text-sm">Annex SL HLS Core</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Output Kelulusan</span>
              <p class="text-emerald-400 font-bold text-sm">Sertifikasi &amp; SMK3</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/smk3-audit.jpg"
              alt="Tim Konsultan Mendampingi Audit Integrated Management System IMS Perusahaan"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Arsitektur QHSE Terpadu
              </span>
              <div class="text-lg font-bold">Hilangkan Birokrasi Dokumen Ganda</div>
              <p class="text-xs text-slate-300 mt-1">Satu manual, satu tim internal audit, dan satu tinjauan manajemen untuk seluruh sistem mutu, lingkungan, dan keselamatan.</p>
            </div>
          </div>

          <!-- Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">ISO 9001 + 14001 + 45001</div>
              <div class="text-[10px] text-slate-400">Harmonisasi dengan PP 50/2012</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">📊</div>
            <div>
              <div class="text-xs font-bold text-white">Audit Lintas Disiplin</div>
              <div class="text-[10px] text-slate-400">Efisiensi Biaya Audit Badan Sertifikasi</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Comprehensive Consulting Roadmap (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section: Problem & Solution -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Tantangan Tata Kelola Perusahaan</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Mengapa Sistem Parsial Menjadi Beban Berat bagi Organisasi?
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            Banyak korporasi di Indonesia membangun sistem manajemennya secara bertahap dan terpisah (<em>siloed system</em>). Akibatnya, departemen Mutu menjalankan ISO 9001 sendiri, departemen Lingkungan membuat prosedur ISO 14001 sendiri, dan tim K3 menyusun dokumen terpisah untuk ISO 45001 dan SMK3 PP No. 50 Tahun 2012.
          </p>

          <p class="text-slate-700 leading-relaxed">
            Dampaknya adalah <strong>kelelahan audit (audit fatigue)</strong>, tumpang tindih prosedur, instruksi kerja yang saling bertentangan bagi operator lapangan, serta pemborosan anggaran yang signifikan untuk audit sertifikasi independen berulang kali dalam setahun.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2">
            <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 space-y-2">
              <span class="text-xl">📑</span>
              <h3 class="text-sm font-bold text-slate-900">Duplikasi Dokumen</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Tiga formulir pengendalian dokumen, tiga register risiko berbeda, dan laporan evaluasi yang berulang.</p>
            </div>
            <div class="p-5 rounded-2xl bg-amber-50 border border-amber-200 space-y-2">
              <span class="text-xl">⏱️</span>
              <h3 class="text-sm font-bold text-slate-900">Pemborosan Waktu</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Pekerja lapangan disibukkan melayani tim auditor internal dan eksternal hingga 4–6 kali setiap tahunnya.</p>
            </div>
            <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 space-y-2">
              <span class="text-xl">💡</span>
              <h3 class="text-sm font-bold text-slate-900">Solusi: Integrasi IMS</h3>
              <p class="text-xs text-slate-600 leading-relaxed">Satu arsitektur sistem manajemen terpadu yang memangkas beban administrasi dan biaya sertifikasi.</p>
            </div>
          </div>
        </section>

        <!-- Section: 4 Pilar Standar yang Diintegrasikan -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Komparasi Standar</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Integrasi 4 Pilar Sistem Manajemen: Mutu, Lingkungan, K3 &amp; SMK3
            </h2>
          </div>

          <p class="text-slate-700">
            Pendekatan kami mengadopsi struktur <em>Annex SL (High-Level Structure)</em> yang secara alami menjadi fondasi bersama standar ISO modern, lalu menyelaraskannya dengan kriteria wajib SMK3 Indonesia:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white uppercase text-xs">
                <tr>
                  <th class="py-3.5 px-4 font-bold">Standar Acuan</th>
                  <th class="py-3.5 px-4 font-bold">Fokus Inti Organisasi</th>
                  <th class="py-3.5 px-4 font-bold">Harmonisasi dalam IMS</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">ISO 9001:2015</td>
                  <td class="py-3.5 px-4">Konsistensi mutu produk &amp; kepuasan pelanggan</td>
                  <td class="py-3.5 px-4">Menjadi kerangka alur proses bisnis inti dan kontrol kepuasan stakeholder.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">ISO 14001:2015</td>
                  <td class="py-3.5 px-4">Pencegahan pencemaran &amp; aspek dampak lingkungan</td>
                  <td class="py-3.5 px-4">Disatukan dalam register identifikasi aspek lingkungan dan pengelolaan limbah B3.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-slate-900">ISO 45001:2018</td>
                  <td class="py-3.5 px-4">Kesehatan, keselamatan kerja &amp; partisipasi pekerja</td>
                  <td class="py-3.5 px-4">Mengintegrasikan matriks HIRARC/IBPR dan investigasi insiden ke alur manajemen risiko.</td>
                </tr>
                <tr>
                  <td class="py-3.5 px-4 font-bold text-emerald-700">SMK3 PP 50/2012</td>
                  <td class="py-3.5 px-4">Kepatuhan legalitas wajib Ketenagakerjaan RI</td>
                  <td class="py-3.5 px-4">Memetakan 64/122/166 kriteria audit Kemnaker ke dalam prosedur operasional IMS.</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Section: Roadmap 5 Tahap Pendampingan -->
        <section id="roadmap-implementasi" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Metodologi Konsultansi</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Roadmap 5 Tahap Pendampingan Konsultasi IMS Terpadu
            </h2>
          </div>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                01
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 1: Gap Analysis &amp; Diagnostic Baseline Review</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Konsultan senior kami melakukan audit diagnosis menyeluruh terhadap dokumentasi eksisting dan observasi operasional fasilitas Anda untuk memetakan tingkat kesenjangan (gap percentage) terhadap ISO 9001, 14001, 45001, dan SMK3.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                02
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 2: Penyusunan Manual IMS &amp; Standardisasi SOP Terpadu</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Menyusun 1 Manual Sistem Manajemen Terpadu, menyatukan Kebijakan QHSE, menyusun matriks integrasi identifikasi bahaya &amp; aspek lingkungan, serta menyederhanakan ratusan SOP menjadi prosedur terintegrasi yang ramping.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                03
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 3: Pelatihan Internal Auditor IMS (ISO 19011:2018) &amp; Implementasi</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Melatih tim internal auditor dari berbagai departemen perusahaan agar mampu mengaudit aspek mutu, lingkungan, dan keselamatan kerja secara simultan dengan pedoman ISO 19011:2018.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                04
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 4: Pelaksanaan Audit Internal Terpadu &amp; Tinjauan Manajemen</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Mendampingi pelaksanaan siklus audit internal penuh, penyusunan laporan ketidaksesuaian (CAR), perbaikan akar masalah (RCA), hingga fasilitasi rapat Tinjauan Manajemen Terpadu (Management Review Meeting) bersama jajaran Direksi.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                05
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 5: Pendampingan Audit Sertifikasi Eksternal</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Mendampingi perwakilan perusahaan selama berlangsungnya Stage 1 (Document Review) dan Stage 2 (Main Assessment) oleh Badan Sertifikasi independen terakreditasi KAN/internasional, serta pendampingan audit resmi SMK3 oleh Badan Audit Kemnaker RI.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section: Deliverables untuk Procurement / Manajemen -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Paket Luaran</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Deliverables Resmi Konsultasi bagi Korporasi
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">📘 Manual IMS Terpadu</div>
              <p class="text-xs text-slate-600">Dokumen level-1 terpadu yang memetakan seluruh klausul ISO 9001, 14001, 45001, dan PP 50/2012.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">📋 Matriks Risiko &amp; Aspek QHSE</div>
              <p class="text-xs text-slate-600">Register risiko terpadu yang mencakup potensi bahaya keselamatan (HIRARC), aspek dampak lingkungan, dan risiko mutu bisnis.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">🎓 Sertifikat Internal Auditor</div>
              <p class="text-xs text-slate-600">Pelatihan dan sertifikasi personel internal audit perusahaan berdasarkan panduan audit ISO 19011:2018.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">🛡️ Pendampingan Audit Sertifikasi</div>
              <p class="text-xs text-slate-600">Konsultan mendampingi langsung tim Anda saat berhadapan dengan lead auditor badan sertifikasi hingga close-out temuan.</p>
            </div>
          </div>
        </section>

        <!-- Section: FAQ -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">FAQ</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Pertanyaan yang Sering Diajukan Seputar Konsultasi IMS
            </h2>
          </div>

          <div class="space-y-3">
            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apakah perusahaan kami harus sudah memiliki sertifikat ISO sebelumnya?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Tidak harus. Kami melayani implementasi dari nol (Greenfield implementation) di mana 4 standar langsung dirancang menyatu sejak hari pertama, maupun integrasi sistem pada perusahaan yang sudah memiliki salah satu sertifikat (misalnya sudah ISO 9001 lalu ingin menambah ISO 14001, 45001, dan SMK3).
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apakah sertifikat ISO dan bendera SMK3 diterbitkan oleh KonsultanK3.com?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
