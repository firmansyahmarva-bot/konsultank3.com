---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "LPK & Pusat Sertifikasi K3 Kota Tangerang";
const description = "Lembaga Pelatihan Kerja (LPK) & pusat sertifikasi K3 resmi Kemnaker RI dan BNSP di Tangerang. Melayani in-house training dan uji kompetensi industri.";
const canonical = "/lpk-k3-tangerang/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "LPK K3 Kota Tangerang", "item": "https://konsultank3.com/lpk-k3-tangerang/" }
      ]
    },
    {
      "@type": ["EducationalOrganization", "LocalBusiness"],
      "name": "LPK & Pusat Sertifikasi K3 Kota Tangerang - KonsultanK3.com",
      "url": "https://konsultank3.com/lpk-k3-tangerang/",
      "description": description,
      "telephone": "+62-895-1025-3435",
      "areaServed": [
        "Kota Tangerang",
        "Kabupaten Tangerang",
        "Tangerang Selatan",
        "Banten",
        "Jabodetabek"
      ],
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Kota Tangerang",
        "addressRegion": "Banten",
        "addressCountry": "ID"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">LPK K3 Kota Tangerang</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Headline & Local Value Prop -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Pusat Pembinaan &amp; Sertifikasi Resmi Kemnaker RI &bull; BNSP
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Lembaga Pelatihan Kerja &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Pusat Sertifikasi K3 Kota Tangerang</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Solusi terpadu pembinaan sertifikasi personel K3, lisensi operator alat berat, dan audit keselamatan kerja untuk perusahaan di koridor industri Tangerang, Banten, dan sekitarnya.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi pelatihan sertifikasi K3 untuk perusahaan di Tangerang")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi WhatsApp Resmi &rarr;
            </a>
            <a
              href="#program-sertifikasi"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Program Sertifikasi
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Wilayah Layanan</span>
              <p class="text-white font-bold text-sm">Kota Tangerang &amp; Sekitarnya</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Legalitas</span>
              <p class="text-white font-bold text-sm">Kemnaker RI &amp; BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Format Kelas</span>
              <p class="text-white font-bold text-sm">In-House &amp; Blended</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Validasi Dokumen</span>
              <p class="text-emerald-400 font-bold text-sm">Portal Teman K3 Sah</p>
            </div>
          </div>
        </div>

        <!-- Right: Photo Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/hero-safety-officer.jpg"
              alt="Instruktur dan Personel K3 Bersertifikasi Kemnaker RI di Tangerang"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Zona Industri Tangerang
              </span>
              <div class="text-lg font-bold">Layanan In-House &amp; Public Class</div>
              <p class="text-xs text-slate-300 mt-1">Mendukung kawasan Jatake, Manis, Batuceper, Daan Mogot, hingga pergudangan Bandara Soetta.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">SKP &amp; Lisensi Resmi</div>
              <div class="text-[10px] text-slate-400">Kemnaker RI &amp; BNSP</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🏭</div>
            <div>
              <div class="text-xs font-bold text-white">Fasilitas Uji Praktik</div>
              <div class="text-[10px] text-slate-400">Standar Keselamatan Pabrik</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Main Content (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section: Mengapa Sertifikasi K3 Krusial di Tangerang -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Konteks Regulasi Lokal</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Pusat Pelatihan K3 Terpercaya untuk Ekosistem Industri Kota Tangerang
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            Kota Tangerang merupakan salah satu simpul manufaktur, pergudangan logistik, dan sentra industri pengolahan terpadat di Provinsi Banten. Dengan ratusan fasilitas pabrik berskala menengah hingga multinasional di kawasan seperti <strong>Kawasan Industri Manis, Jatake, Batuceper, Cikokol, hingga jalur koridor Daan Mogot dan lingkar Bandara Internasional Soekarno-Hatta</strong>, penegakan regulasi keselamatan dan kesehatan kerja menjadi syarat mutlak kepatuhan hukum perusahaan.
          </p>

          <p class="text-slate-700 leading-relaxed">
            Berdasarkan mandat <strong>Undang-Undang No. 1 Tahun 1970</strong> tentang Keselamatan Kerja dan <strong>Peraturan Pemerintah No. 50 Tahun 2012</strong> tentang Penerapan SMK3, setiap tempat kerja dengan potensi bahaya tinggi atau mempekerjakan lebih dari 100 tenaga kerja diwajibkan membentuk Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3) serta menunjuk personel berlisensi resmi dari Kementerian Ketenagakerjaan (Kemnaker) RI.
          </p>

          <div class="p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 space-y-3">
            <div class="flex items-center gap-2 text-amber-900 font-bold text-sm">
              <span class="text-lg">⚖️</span>
              Kewajiban Perusahaan dalam Pengawasan K3
            </div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              Pengawasan ketenagakerjaan berkala oleh Pengawas K3 Disnaker Banten secara aktif memverifikasi keabsahan Surat Keputusan Penunjukan (SKP) Ahli K3, lisensi operator alat berat (SIO), dan sertifikat kompetensi regu tanggap darurat guna mencegah risiko sanksi administratif dan penghentian izin operasional mesin.
            </p>
          </div>
        </section>

        <!-- Section: Program Sertifikasi Unggulan -->
        <section id="program-sertifikasi" class="space-y-8 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Katalog Pembinaan</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Program Pelatihan &amp; Sertifikasi K3 Unggulan di Tangerang
            </h2>
          </div>

          <p class="text-slate-700">
            Bersama jaringan Lembaga Pelatihan Kerja (LPK) dan PJK3 mitra resmi bersertifikasi pemerintah, kami menyediakan spektrum lengkap pembinaan kompetensi K3 bagi personel korporat maupun peserta mandiri:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- Card 1: Ahli K3 Umum -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-100 text-emerald-800">Kemnaker RI</span>
                  <span class="text-xs text-slate-500">12 Hari Pembinaan</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 hover:text-amber-600 transition-colors">
                  <a href="/pelatihan-ahli-k3-umum/">Pembinaan Calon Ahli K3 Umum</a>
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Program sertifikasi paling fundamental untuk mencetak sekretaris P2K3 berlisensi legal sesuai Permenaker No. 02/MEN/1992. Dilengkapi bimbingan PKL laporan audit SMK3.
                </p>
              </div>
              <a href="/pelatihan-ahli-k3-umum/" class="text-xs font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1">
                Pelajari Silabus &rarr;
              </a>
            </div>

            <!-- Card 2: K3 Kebakaran -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-rose-100 text-rose-800">Kemnaker RI</span>
                  <span class="text-xs text-slate-500">Kelas D, C, B, A</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 hover:text-amber-600 transition-colors">
                  <a href="/pelatihan-k3-kebakaran/">K3 Penanggulangan Kebakaran</a>
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Pelatihan unit penanggulangan kebakaran tempat kerja sesuai Kepmenaker No. KEP.186/MEN/1999 dengan simulasi pemadaman APAR, hidran, dan penyusunan Emergency Response Plan.
                </p>
              </div>
              <a href="/pelatihan-k3-kebakaran/" class="text-xs font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1">
                Pelajari Silabus &rarr;
              </a>
            </div>

            <!-- Card 3: K3 Listrik & Teknisi -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-100 text-amber-800">Kemnaker RI</span>
                  <span class="text-xs text-slate-500">Teknisi &amp; Ahli</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 hover:text-amber-600 transition-colors">
                  <a href="/pelatihan-k3-listrik/">Teknisi &amp; Ahli K3 Listrik</a>
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Standar kepatuhan instalasi listrik tegangan rendah dan menengah sesuai Permenaker No. 12 Tahun 2015, proteksi arus bocor, penangkal petir, serta pengukuran grounding resistansi tanah.
                </p>
              </div>
              <a href="/pelatihan-k3-listrik/" class="text-xs font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1">
                Pelajari Silabus &rarr;
              </a>
            </div>

            <!-- Card 4: Confined Space -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-indigo-100 text-indigo-800">Kemnaker RI</span>
                  <span class="text-xs text-slate-500">Madya &amp; Utama</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 hover:text-amber-600 transition-colors">
                  <a href="/pelatihan-k3-ruang-terbatas/">K3 Ruang Terbatas (Confined Space)</a>
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Sertifikasi keselamatan tangki, silo, manhole, dan reaktor sesuai SK Dirjen Binwasnaker No. KEP.113/DJPPK/IX/2006. Mencakup teknik gas testing, izin kerja, dan evakuasi darurat.
                </p>
              </div>
              <a href="/pelatihan-k3-ruang-terbatas/" class="text-xs font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1">
                Pelajari Silabus &rarr;
              </a>
            </div>

            <!-- Card 5: Operator Alat Berat (SIO) -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-100 text-blue-800">Kemnaker RI</span>
                  <span class="text-xs text-slate-500">Lisensi K3 (SIO)</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900">
                  Operator Pesawat Angkat Angkut &amp; Uap
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Pembinaan dan penerbitan Surat Izin Operator (SIO) untuk Forklift Kelas I/II, Overhead Crane, Mobile Crane, dan Operator Bejana Uap (Boiler) sesuai Permenaker No. 08/2020 &amp; Permenaker No. 01/1988.
                </p>
              </div>
              <a href={waLink("Halo KonsultanK3, saya ingin konsultasi sertifikasi SIO Forklift/Crane di Tangerang")} target="_blank" rel="noopener" class="text-xs font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1">
                Konsultasi SIO &rarr;
              </a>
            </div>

            <!-- Card 6: Sertifikasi BNSP Lingkungan & K3 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-cyan-100 text-cyan-800">BNSP / LSP</span>
                  <span class="text-xs text-slate-500">Sertifikat Profesi</span>
                </div>
                <h3 class="text-lg font-bold text-slate-900 hover:text-amber-600 transition-colors">
                  <a href="/pelatihan-pppa-popal/">Kompetensi BNSP K3 &amp; Lingkungan</a>
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed">
                  Uji kompetensi nasional untuk Penanggung Jawab Pengendalian Pencemaran Air (PPPA/POPAL), Pencemaran Udara (PPPU), Pengelolaan Limbah B3, serta skema Pengawas/Supervisor K3.
                </p>
              </div>
              <a href="/pelatihan-pppa-popal/" class="text-xs font-bold text-amber-600 hover:text-amber-700 inline-flex items-center gap-1">
                Pelajari Silabus &rarr;
              </a>
            </div>
          </div>
        </section>

        <!-- Section: Skema Pelaksanaan: In-House vs Blended -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Fleksibilitas Pelaksanaan</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Format Pelaksanaan Pelatihan Sesuai Kebutuhan Pabrik
            </h2>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="p-6 rounded-2xl bg-slate-900 text-white space-y-4">
              <div class="w-12 h-12 rounded-xl bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-xl">
                🏭
              </div>
              <h3 class="text-lg font-bold text-white">In-House Training (Di Lokasi Perusahaan)</h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                Tim instruktur berlisensi dan pengawas K3 hadir langsung ke pabrik atau fasilitas Anda di wilayah Tangerang Raya. Praktik lapangan menggunakan instalasi riil perusahaan Anda untuk efisiensi anggaran dan relevansi bahaya kerja yang spesifik.
              </p>
              <ul class="text-xs text-slate-300 space-y-2 pt-2 border-t border-white/10">
                <li class="flex items-center gap-2">✓ Jadwal fleksibel disesuaikan dengan shift operasional pabrik</li>
                <li class="flex items-center gap-2">✓ Studi kasus langsung pada potensi bahaya fasilitas setempat</li>
                <li class="flex items-center gap-2">✓ Biaya per peserta jauh lebih ekonomis untuk regu kerja besar</li>
              </ul>
            </div>

            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
              <div class="w-12 h-12 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-bold text-xl">
                💻
              </div>
              <h3 class="text-lg font-bold text-slate-900">Blended Learning / Public Class</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Kombinasi pembekalan teori regulasi secara daring melalui ruang kelas interaktif dengan sesi ujian evaluasi Kemnaker RI serta simulasi praktik di fasilitas training center resmi.
              </p>
              <ul class="text-xs text-slate-600 space-y-2 pt-2 border-t border-slate-100">
                <li class="flex items-center gap-2">✓ Cocok untuk pendaftaran peserta individu atau perwakilan 1–2 staf</li>
                <li class="flex items-center gap-2">✓ Menghemat waktu perjalanan dinas tanpa mengurangi jam pelajaran standar</li>
                <li class="flex items-center gap-2">✓ Akses materi pembelajaran digital dan bank soal evaluasi</li>
              </ul>
            </div>
          </div>
        </section>

        <!-- Section: Alur Pendaftaran & Persyaratan Dokumen -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Standard Operating Procedure</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Alur Pendaftaran dan Persyaratan Dokumen Peserta
            </h2>
          </div>

          <div class="space-y-4">
            <div class="flex gap-4 items-start p-4 rounded-xl bg-slate-50 border border-slate-200">
              <div class="w-8 h-8 rounded-full bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0 text-sm">
                1
              </div>
              <div class="space-y-1">
                <h3 class="text-sm font-bold text-slate-900">Konsultasi Kebutuhan &amp; Penjadwalan</h3>
                <p class="text-xs text-slate-600">
                  Konsultasikan target sertifikasi (Ahli K3, Petugas Kebakaran, Operator Forklift, dsb.) bersama konsultan kami via WhatsApp untuk mencocokkan jadwal dan skema pelatihan.
                </p>
              </div>
            </div>

            <div class="flex gap-4 items-start p-4 rounded-xl bg-slate-50 border border-slate-200">
              <div class="w-8 h-8 rounded-full bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0 text-sm">
                2
              </div>
              <div class="space-y-1">
                <h3 class="text-sm font-bold text-slate-900">Pengumpulan Berkas Administrasi Peserta</h3>
                <p class="text-xs text-slate-600">
