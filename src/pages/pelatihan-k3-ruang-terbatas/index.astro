---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { batches } from '../../data/batches.js';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const batch = batches.ruangTerbatas;

const title = "Pelatihan K3 Ruang Terbatas (Confined Space)";
const description = "Pelatihan sertifikasi K3 Bekerja di Ruang Terbatas resmi Kemnaker RI untuk Petugas Madya dan Utama. Kuasai deteksi gas, APD pernapasan, dan evakuasi darurat.";
const canonical = "/pelatihan-k3-ruang-terbatas/";

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "K3 Ruang Terbatas", "item": "https://konsultank3.com/pelatihan-k3-ruang-terbatas/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pembinaan & Sertifikasi K3 Bekerja di Ruang Terbatas (Confined Space)",
      "description": "Pelatihan dan sertifikasi Petugas Madya dan Petugas Utama K3 Ruang Terbatas resmi Kemnaker RI sesuai Keputusan Dirjen Binwasnaker No. KEP.113/DJPPK/IX/2006.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={courseSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">K3 Ruang Terbatas</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-400 border border-purple-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-ping"></span>
            Keputusan Dirjen Binwasnaker No. KEP.113/DJPPK/IX/2006
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Pembinaan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">K3 Ruang Terbatas</span> (Confined Space)
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-sans max-w-2xl">
            Cetak <strong>Petugas Madya</strong> dan <strong>Petugas Utama K3 Ruang Terbatas</strong> berlisensi Kemnaker RI. Kuasai prosedur keselamatan atmosfer berbahaya, pengoperasian gas detector, sistem izin masuk (entry permit), dan teknik evakuasi penyelamatan darurat.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi Pelatihan K3 Ruang Terbatas Petugas Madya dan Utama")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi WhatsApp Resmi &rarr;
            </a>
            <a
              href="#jenjang-pelatihan"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Jenjang Madya &amp; Utama
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Tingkatan</span>
              <p class="text-white font-bold text-sm">Madya &amp; Utama</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Metode</span>
              <p class="text-white font-bold text-sm">Gas Test &amp; Rescue</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen</span>
              <p class="text-white font-bold text-sm">Lisensi Kemnaker RI</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kualifikasi</span>
              <p class="text-emerald-400 font-bold text-sm">Confined Space</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/hero-safety-officer.jpg"
              alt="Petugas K3 Masuk Ruang Terbatas dengan Alat Pelindung Diri dan Gas Detector"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-purple-500 text-white mb-2">
                Standar Kep.113/DJPPK/IX/2006
              </span>
              <div class="text-lg font-bold">Petugas Madya &amp; Utama Resmi</div>
              <p class="text-xs text-slate-300 mt-1">Simulasi gas detector sampling bertingkat, isolasi energi LOTO, dan pemakaian tripod rescue winch.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500 text-white flex items-center justify-center font-bold text-lg">
              🛡️
            </div>
            <div>
              <div class="text-xs font-bold text-white">Lisensi Resmi Kemnaker</div>
              <div class="text-[10px] text-slate-400">Petugas Madya / Utama Sah</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🦺</div>
            <div>
              <div class="text-xs font-bold text-white">Non-Entry Rescue Ready</div>
              <div class="text-[10px] text-slate-400">Prosedur Tanggap Darurat</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Body Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Article Content Column -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section 1: Apa itu Pelatihan K3 Ruang Terbatas -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Pengenalan Program</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Apa itu Pelatihan K3 Ruang Terbatas</h2>
          </div>
          <p class="text-base sm:text-lg text-slate-700 font-light leading-relaxed">
            Pelatihan K3 Ruang Terbatas (Confined Space) adalah program pembinaan dan sertifikasi kompetensi teknis yang dirancang khusus untuk memberikan pengetahuan, pemahaman bahaya atmosfer berbahaya, serta keterampilan penyelamatan darurat bagi tenaga kerja yang bertugas di dalam maupun di luar ruang terbatas. Ruang terbatas didefinisikan sebagai ruangan yang memiliki akses masuk dan keluar terbatas, tidak dirancang untuk tempat kerja berkelanjutan, serta memiliki ventilasi alami yang sangat minim sehingga rentan mengalami akumulasi gas beracun, uap mudah terbakar, atau kekurangan kadar oksigen.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Bekerja di dalam ruang terbatas menyimpan tingkat fatalitas yang sangat tinggi. Sebagian besar kecelakaan fatal terjadi akibat pekerja mengalami kekurangan oksigen (asfiksia) atau terpapar gas beracun mematikan seperti hidrogen sulfida (H2S) dan karbon monoksida (CO) yang tidak kasat mata dan kerap tidak berbau pada konsentrasi tertentu. Selain itu, potensi gas hidrokarbon mudah meledak (Lower Explosive Limit / LEL) serta bahaya tertimbun material curah menjadi ancaman konstan. Tragedi kerap diperparah ketika calon penolong memasuki ruangan secara spontan tanpa alat pelindung pernapasan mandiri, sehingga turut menjadi korban jiwa.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Landasan yuridis penanganan pekerjaan ini ditetapkan melalui Keputusan Direktur Jenderal Pembinaan Pengawasan Ketenagakerjaan No. KEP.113/DJPPK/IX/2006 tentang Pedoman Pembinaan Teknis Petugas Keselamatan dan Kesehatan Kerja Ruang Terbatas. Regulasi ini mewajibkan pengusaha untuk memastikan bahwa setiap aktivitas pekerjaan di dalam ruang terbatas harus diawasi oleh Petugas Madya K3 Ruang Terbatas yang siaga di luar ruangan dan dilaksanakan oleh Petugas Utama K3 Ruang Terbatas yang telah lulus uji kompetensi dan berlisensi sah dari Kemnaker RI.
          </p>
          <div class="p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20 space-y-3">
            <h3 class="text-base font-bold text-amber-900">Siapa Saja yang Membutuhkan Pelatihan Ini?</h3>
            <p class="text-sm text-slate-700 font-light leading-relaxed">
              Program pembinaan keselamatan ini wajib diikuti oleh industri dan tenaga kerja yang mengoperasikan fasilitas terbatas, meliputi:
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-700 font-light">
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Petugas Tangki Minyak &amp; Bahan Kimia:</strong> Personel yang melakukan pencucian (tank cleaning), perbaikan dinding tangki, dan pemeliharaan bejana.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pekerja Utilitas Gorong-Gorong &amp; Saluran Bawah Tanah:</strong> Melakukan perawatan pipa sewer, manhole saluran kabel utilitas, dan terowongan bawah tanah.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Industri Pengolahan Pangan &amp; Pertanian:</strong> Personel perawatan silo penyimpanan biji-bijian, bunker gandum, dan bejana fermentasi.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Sektor Pembangkit Listrik &amp; Boiler:</strong> Teknisi pembersihan ruang bakar boiler, economizer, deaerator, dan kondensor pendingin.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Industri Maritim &amp; Perkapalan:</strong> Pekerja perawatan palka kapal, double bottom ballast tank, dan ruang mesin kapal.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Pengawas K3 &amp; Tim Tanggap Darurat:</strong> Petugas yang menerbitkan surat izin masuk (entry permit) dan memimpin skenario evakuasi darurat.</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Jenjang / Jenis Pelatihan -->
        <section id="jenjang-pelatihan" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Klasifikasi &amp; Tingkatan</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Jenjang / Jenis Pelatihan</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Sistem kualifikasi K3 ruang terbatas diatur ke dalam dua jenjang peran fungsional yang saling melengkapi guna membentuk sistem kerja yang selamat:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white text-xs uppercase font-semibold">
                <tr>
                  <th class="py-4 px-4 sm:px-6">Jenjang / Jenis</th>
                  <th class="py-4 px-4 sm:px-6">Peran</th>
                  <th class="py-4 px-4 sm:px-6">Tugas utama</th>
                  <th class="py-4 px-4 sm:px-6">Materi kunci</th>
                  <th class="py-4 px-4 sm:px-6">Persyaratan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">Petugas Madya</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Pengawas Siaga di Luar (Standby Person)</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Berjaga di pintu masuk ruang terbatas, mengawasi pergerakan pekerja, memantau atmosfer gas secara kontinu, dan mengendalikan evakuasi tanpa memasuki ruangan</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Regulasi K3 confined space, bahaya gas beracun H2S &amp; CO, batas aman oksigen (19.5% - 23.5%), verifikasi Confined Space Entry Permit, isolasi energi LOTO, serta pengoperasian tripod rescue winch</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Minimal SLTA / sederajat</td>
                </tr>
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">Petugas Utama</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Pekerja yang Masuk (Entrant)</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Memasuki ruang terbatas untuk melakukan pembersihan, perbaikan, pemotongan, atau inspeksi dengan perlengkapan keselamatan lengkap</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Karakteristik atmosfer berbahaya, penggunaan alat bantu pernapasan mandiri SCBA dan airline respirator, pemakaian Full Body Harness D-Ring vertikal, teknik pergerakan ruang sempit, dan penyelamatan darurat</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Minimal SLTA / sederajat</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-sm text-slate-600 font-light leading-relaxed">
            Sinergi antara Petugas Madya dan Petugas Utama merupakan syarat mutlak sebelum pekerjaan diizinkan berlangsung. Petugas Madya dilarang keras meninggalkan pos jaga pintu masuk atau memasuki ruangan selama ada pekerja di dalam. Bila terjadi perubahan atmosfer berbahaya atau kondisi darurat medis, Petugas Madya segera memerintahkan evakuasi dan mengoperasikan sistem kerek tripod dari luar ruangan (non-entry rescue) tanpa membahayakan dirinya sendiri.
          </p>
        </section>

        <!-- Section 3: Dasar Hukum -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Landasan Regulasi</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Dasar Hukum</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Penyelenggaraan pembinaan keselamatan dan izin kerja di ruang terbatas berlandaskan pada ketentuan regulasi nasional yang berkekuatan hukum tetap, meliputi:
          </p>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">UU No. 1 Tahun 1970 tentang Keselamatan Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Undang-Undang Keselamatan Kerja merupakan landasan pokok perlindungan keselamatan pekerja di segala tempat kerja di wilayah hukum Indonesia. Pada Pasal 2 ayat (2) huruf b, c, dan f diatur perlindungan bagi pekerjaan yang dilakukan dalam ruangan tertutup atau ruang terbatas di mana terdapat bahaya gas, uap, asap, atau kekurangan oksigen. Ketentuan ini mewajibkan pengusaha menyediakan syarat-syarat keselamatan dan alat perlindungan diri yang sesuai.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Keputusan Dirjen Binwasnaker No. KEP.113/DJPPK/IX/2006 tentang Pedoman Pembinaan Teknis Petugas K3 Ruang Terbatas</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Keputusan ini merupakan petunjuk teknis operasional resmi yang mengatur standar kurikulum, kualifikasi peserta, serta mekanisme sertifikasi Petugas Madya dan Petugas Utama K3 Ruang Terbatas di Indonesia. Regulasi ini menetapkan kewajiban izin masuk tertulis (Confined Space Entry Permit), pengujian atmosfer berkala, penyediaan sistem ventilasi tiup (blower), serta kewajiban prosedur penyelamatan darurat.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Surat Edaran Menteri Tenaga Kerja No. SE.01/MEN/1997 tentang Nilai Ambang Batas Faktor Kimia di Udara Lingkungan Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Surat Edaran ini memuat standar batas konsentrasi kontaminan kimia dan gas berbahaya yang diperbolehkan di udara lingkungan tempat kerja. Regulasi ini menjadi pedoman batas paparan aman untuk gas beracun seperti H2S dan CO, serta menetapkan kadar oksigen aman di ruang terbatas agar pekerja terhindar dari bahaya keracunan sistemik dan kekurangan oksigen akut.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 4: Silabus Pembelajaran -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Materi Kurikulum</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Silabus Pembelajaran</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kurikulum pembinaan K3 Ruang Terbatas dirancang secara komprehensif mengacu pada modul standar Ditjen Binwasnaker Kemnaker RI, memadukan teori pengawasan atmosfer dengan praktik simulasi fisik penyelamatan:
          </p>

          <div class="space-y-5">
            <!-- Topic 1 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">01</span>
                Kebijakan &amp; Dasar Hukum K3 Ruang Terbatas
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini mengkaji landasan yuridis keselamatan kerja berdasarkan UU No. 1 Tahun 1970, SE No. 01/MEN/1997, serta Keputusan Dirjen Binwasnaker No. KEP.113/DJPPK/IX/2006. Peserta mempelajari hak dan kewajiban hukum pengurus maupun tenaga kerja dalam kegiatan di ruang terbatas. Materi ini menekankan akuntabilitas kepatuhan regulasi dalam mencegah terjadinya insiden fatalitas di lingkungan kerja industri.
              </p>
            </div>

            <!-- Topic 2 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">02</span>
                Karakteristik &amp; Bahaya Atmosfer Ruang Terbatas
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini membedah berbagai parameter bahaya atmosfer, mencakup gas mudah terbakar (Lower Explosive Limit / LEL), gas beracun mematikan seperti hidrogen sulfida (H2S) dan karbon monoksida (CO), serta batas aman kandungan oksigen antara 19.5% hingga 23.5%. Peserta mempelajari dampak fisiologis defisiensi oksigen terhadap hilangnya kesadaran dalam hitungan detik. Pembahasan difokuskan pada bahaya atmosfer yang tidak terdeteksi oleh indra manusia.
              </p>
            </div>

            <!-- Topic 3 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">03</span>
                Teknik Pengukuran Gas &amp; Kalibrasi Gas Detector
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peserta dibekali pemahaman cara pengoperasian alat multi-gas detector portabel dan pelaksanaan uji respons (bump test) sebelum instrumen digunakan. Dipelajari metodologi pengambilan sampel udara secara bertingkat pada lapisan atas, tengah, dan bawah ruangan untuk mendeteksi variasi berat jenis gas kontaminan. Keterampilan ini krusial guna memastikan atmosfer benar-benar aman sebelum izin masuk diterbitkan.
              </p>
            </div>

            <!-- Topic 4 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">04</span>
                Sistem Izin Kerja Khusus (Confined Space Entry Permit)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini membahas tata cara penerbitan surat izin kerja masuk ruang terbatas dan pengisian daftar periksa keselamatan pra-masuk secara disiplin. Peserta mempelajari prosedur isolasi energi berbahaya melalui penerapan Lockout/Tagout (LOTO), penutupan jalur pipa menggunakan blind flange, serta pelaksanaan pembersihan dan ventilasi udara terus-menerus menggunakan blower mekanis. Prosedur ini menjamin tidak ada energi sisa atau gas susulan yang masuk ke ruang kerja.
              </p>
            </div>

            <!-- Topic 5 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">05</span>
                Alat Pelindung Diri &amp; Peralatan Akses Vertikal
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Pembahasan mencakup pemilihan dan penggunaan Full Body Harness dengan cincin D-Ring vertikal, sistem kerek penyelamatan tripod rescue winch, serta tali penahan jatuh (retrieval line). Peserta juga mempelajari pengoperasian alat bantu pernapasan mandiri Self-Contained Breathing Apparatus (SCBA) dan airline respirator dengan tabung cadangan darurat. Peralatan ini wajib dikuasai untuk mengamankan jalur masuk dan evakuasi pekerja pada posisi vertikal maupun horizontal.
              </p>
            </div>

            <!-- Topic 6 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">06</span>
                Prosedur Tanggap Darurat &amp; Penyelamatan (Emergency Rescue)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Materi ini menekankan prinsip utama keselamatan penolong dalam kondisi darurat di ruang terbatas. Peserta dilatih mempraktikkan skenario evakuasi korban tanpa memasuki ruangan (non-entry rescue) menggunakan tripod winch yang terhubung ke harness korban sejak awal masuk. Dipelajari pula komunikasi darurat berantai, koordinasi dengan tim medis darurat, serta langkah pertolongan pertama pada korban asfiksia akibat kekurangan oksigen.
              </p>
            </div>

            <!-- Topic 7 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">07</span>
                Praktik Lapangan &amp; Simulasi Evakuasi
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Sesi praktik langsung di simulator tangki atau manhole tiruan. Peserta mempraktikkan kalibrasi dan pembacaan multi-gas detector pada berbagai level kedalaman, pemasangan tripod penyelamat, pemakaian harness keselamatan, serta simulasi pengangkatan manekin korban dari dalam tangki. Latihan praktis ini menanamkan kesiapsiagaan mental, ketelitian prosedur, dan keterampilan fisik bagi petugas madya maupun utama.
              </p>
            </div>

            <!-- Topic 8 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-purple-500/10 text-purple-700 font-mono text-xs flex items-center justify-center font-bold">08</span>
                Evaluasi
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Tahap evaluasi komprehensif diselenggarakan untuk menilai pemahaman peserta terhadap seluruh materi instruksional dan ketepatan prosedur di lapangan. Evaluasi terdiri dari ujian teori tertulis mengenai regulasi serta bahaya atmosfer, ditambah ujian unjuk kerja praktik peragaan pengujian gas dan evakuasi tripod. Peserta yang memenuhi standar kelulusan berhak diajukan untuk penerbitan lisensi resmi Kemnaker RI.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 5: Alur Pelatihan dan Ujian -->
