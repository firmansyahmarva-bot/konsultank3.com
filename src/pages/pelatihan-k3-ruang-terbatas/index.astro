---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { waLink } from '../../data/contact.js';

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "K3 Ruang Terbatas", "item": "https://konsultank3.com/pelatihan-k3-ruang-terbatas/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pembinaan & Sertifikasi K3 Bekerja di Ruang Terbatas (Confined Space)",
      "description": "Pelatihan dan sertifikasi Petugas Madya dan Utama K3 Ruang Terbatas resmi Kemnaker RI sesuai Kep.113/DJPPK/IX/2006.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};

const syllabus = [
  { mod: 'Modul 1', title: 'Kebijakan & Dasar Hukum K3 Ruang Terbatas', desc: 'UU No. 1 Tahun 1970, SE No. 01/MEN/1997, dan Keputusan Dirjen Binwasnaker No. KEP.113/DJPPK/IX/2006.' },
  { mod: 'Modul 2', title: 'Karakteristik & Bahaya Atmosfer Ruang Terbatas', desc: 'Identifikasi gas mudah terbakar (LEL), gas beracun (H2S, CO), serta batas aman oksigen (19.5% - 23.5%).' },
  { mod: 'Modul 3', title: 'Teknik Pengukuran Gas & Kalibrasi Gas Detector', desc: 'Metodologi sampling udara berlapis (atas, tengah, bawah) dan bump test alat ukur atmosfer multi-gas.' },
  { mod: 'Modul 4', title: 'Sistem Izin Kerja Khusus (Confined Space Entry Permit)', desc: 'Penerbitan surat izin masuk, checklist keselamatan pra-masuk, isolasi energi Lockout/Tagout (LOTO), dan purging/ventilasi.' },
  { mod: 'Modul 5', title: 'Alat Pelindung Diri & Peralatan Akses Vertikal', desc: 'Penggunaan Full Body Harness D-Ring, Tripod Rescue Winch, Self-Contained Breathing Apparatus (SCBA), dan airline respirator.' },
  { mod: 'Modul 6', title: 'Prosedur Tanggap Darurat & Penyelamatan (Emergency Rescue)', desc: 'Simulasi evakuasi korban tanpa memasuki ruang terbatas (non-entry rescue) dan koordinasi regu medis darurat.' }
];

const faqs = [
  {
    q: 'Siapa saja yang wajib memiliki sertifikat K3 Ruang Terbatas Kemnaker RI?',
    a: 'Sesuai Kep.113/MEN/2006, setiap pekerja yang bertugas memasuki tangki, bejana transport, silo, bunker, saluran pembuangan (sewer), palka kapal, dan gorong-gorong (Petugas Utama), serta personel pengawas pintu masuk yang siaga di luar (Petugas Madya) wajib memiliki lisensi K3 resmi Kemnaker RI.'
  },
  {
    q: 'Berapa batas aman kandungan oksigen di dalam ruang terbatas sebelum pekerja diizinkan masuk?',
    a: 'Berdasarkan standar regulasi K3 nasional dan OSHA, kadar oksigen aman berada pada rentang 19.5% hingga 23.5%. Jika kadar oksigen berada di bawah 19.5% (asfiksia/defisiensi oksigen) atau di atas 23.5% (bahaya ledakan/oksigen enriched), pekerja dilarang masuk tanpa ventilasi kontinu atau alat bantu pernapasan mandiri (SCBA).'
  },
  {
    q: 'Apakah pelatihan mencakup simulasi praktik lapangan langsung?',
    a: 'Ya. Peserta akan mempraktikkan langsung pengoperasian multi-gas detector, pemasangan tripod winch dan retrieval line, pemakaian harness keselamatan, serta skenario simulasi evakuasi darurat menggunakan manekin.'
  }
];
---

<BaseLayout
  title="Pelatihan K3 Ruang Terbatas (Confined Space)"
  description="Pelatihan sertifikasi K3 Bekerja di Ruang Terbatas resmi Kemnaker RI (Petugas Madya & Utama Kep.113/2006). Modul, simulasi gas detector & rescue."
  canonical="/pelatihan-k3-ruang-terbatas/"
  schema={courseSchema}
  presetMessage="Halo KonsultanK3, saya ingin info pendaftaran sertifikasi K3 Ruang Terbatas (Confined Space)."
>
  <!-- Hero Section -->
  <section class="bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      
      <nav class="flex items-center gap-2 text-xs text-slate-400 mb-6">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">K3 Ruang Terbatas</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-500/10 text-purple-400 border border-purple-500/20">
            <span>🛡️</span> Keputusan Dirjen Binwasnaker No. KEP.113/DJPPK/IX/2006
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white leading-tight">
            Pembinaan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">K3 Ruang Terbatas</span> (Confined Space)
          </h1>

          <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-sans max-w-2xl">
            Cetak <strong>Petugas Madya</strong> dan <strong>Petugas Utama K3 Ruang Terbatas</strong> berlisensi Kemnaker RI. Kuasai prosedur keselamatan atmosfer berbahaya, pengoperasian gas detector, sistem izin masuk (entry permit), dan teknik evakuasi penyelamatan darurat.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi jadwal dan biaya K3 Ruang Terbatas")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Daftar Batch Terdekat &rarr;
            </a>
            <a
              href="#silabus"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Silabus Lengkap
            </a>
          </div>

          <div class="grid grid-cols-3 gap-4 pt-6 border-t border-white/10 text-center sm:text-left">
            <div>
              <div class="text-2xl font-bold text-white font-serif">3–5 Hari</div>
              <div class="text-xs text-slate-400 mt-1">Durasi Pelatihan</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-emerald-400 font-serif">Kemnaker RI</div>
              <div class="text-xs text-slate-400 mt-1">Sertifikat &amp; Lisensi</div>
            </div>
            <div>
              <div class="text-2xl font-bold text-amber-400 font-serif">Praktik Nyata</div>
              <div class="text-xs text-slate-400 mt-1">Gas Testing &amp; SCBA</div>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/hero-safety-officer.jpg"
              alt="Petugas K3 Masuk Ruang Terbatas dengan Alat Pelindung Diri dan Gas Detector"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-purple-500 text-white mb-2">
                Standard Kep.113/MEN/2006
              </span>
              <div class="text-lg font-bold">Petugas Madya &amp; Utama Resmi</div>
              <p class="text-xs text-slate-300 mt-1">Simulasi gas detector sampling bertingkat, isolasi energi LOTO, dan pemakaian tripod rescue winch.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-purple-500 text-white flex items-center justify-center font-bold text-lg">
              🛡️
            </div>
            <div>
              <div class="text-xs font-bold text-white">Lisensi Resmi Kemnaker</div>
              <div class="text-[10px] text-slate-400">Petugas Madya / Utama Sah</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🦺</div>
            <div>
              <div class="text-xs font-bold text-white">Non-Entry Rescue Ready</div>
              <div class="text-[10px] text-slate-400">Prosedur Evakuasi Tanggap Darurat</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Comprehensive Technical Overview -->
  <section class="py-16 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <div class="lg:col-span-8 space-y-12">
          
          <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-2xl sm:text-3xl font-bold font-serif text-slate-900">
              Mengapa Sertifikasi K3 Ruang Terbatas Sangat Kritis?
            </h2>
            <p class="text-base text-slate-700 leading-relaxed">
              Bekerja di dalam ruang terbatas (<em>confined space</em>) seperti tangki penyimpanan bahan bakar, boiler, reaktor kimia, manhole saluran pipa bawah tanah, dan silo biji-bijian mengandung potensi bahaya fatalitas yang sangat tinggi. Sebagian besar insiden fatal di ruang terbatas terjadi akibat <strong>kekurangan oksigen (asfiksia)</strong> atau <strong>keracunan gas beracun tak berbau</strong>, di mana lebih dari 60% korban jiwa adalah calon penolong yang masuk tanpa persiapan peralatan keselamatan.
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
              <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
                <span class="text-xs font-bold uppercase tracking-wider text-rose-600 block mb-1">Bahaya Atmosfer Utama</span>
                <p class="text-xs text-slate-700 leading-relaxed">Defisiensi Oksigen (&lt;19.5%), Gas Beracun H2S &amp; CO, serta Gas Mudah Meledak Metana (CH4).</p>
              </div>
              <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200">
                <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block mb-1">Kewajiban Hukum</span>
                <p class="text-xs text-slate-700 leading-relaxed">Wajib izin masuk tertulis (<em>Confined Space Entry Permit</em>) dan penunjukan personel bersertifikat SKP resmi.</p>
              </div>
            </div>
          </div>

          <!-- Syllabus Section -->
          <div id="silabus" class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
            <h3 class="text-2xl font-bold font-serif text-slate-900">
              Kurikulum &amp; Silabus Resmi Kemnaker RI
            </h3>
            
            <div class="space-y-4">
              {syllabus.map(s => (
                <div class="p-4 rounded-2xl bg-slate-50 border border-slate-200/80 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                  <div>
                    <span class="text-xs font-bold uppercase text-amber-600 tracking-wider">{s.mod}</span>
                    <h4 class="font-bold text-slate-900 text-base">{s.title}</h4>
                    <p class="text-xs text-slate-600 mt-1">{s.desc}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- FAQ Accordion -->
          <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
            <h3 class="text-2xl font-bold font-serif text-slate-900">
              Pertanyaan Umum (FAQ)
            </h3>
            
            <div class="space-y-3">
              {faqs.map(f => (
                <details class="group p-4 rounded-2xl bg-slate-50 border border-slate-200 [&_summary::-webkit-details-marker]:hidden">
                  <summary class="flex items-center justify-between cursor-pointer font-bold text-slate-900 text-sm">
                    <span>{f.q}</span>
                    <span class="ml-2 text-slate-400 group-open:rotate-180 transition-transform">▼</span>
                  </summary>
                  <p class="mt-3 text-xs text-slate-600 leading-relaxed pt-2 border-t border-slate-200">
                    {f.a}
                  </p>
                </details>
              ))}
            </div>
          </div>

        </div>

        <!-- Sidebar -->
        <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
          
          <div class="p-6 rounded-3xl bg-slate-900 text-white space-y-4 shadow-xl">
            <div class="text-xs font-bold uppercase tracking-wider text-amber-400">Jadwal Batch</div>
            <h4 class="text-lg font-bold font-serif">Pendaftaran Batch Bulan Ini</h4>
            <div class="space-y-2 text-xs text-slate-300">
              <div class="flex justify-between border-b border-white/10 pb-1.5">
                <span>Tanggal:</span>
                <strong class="text-white">Batch Mendatang</strong>
              </div>
              <div class="flex justify-between border-b border-white/10 pb-1.5">
                <span>Lokasi:</span>
                <strong class="text-white">Online Teori + Praktik</strong>
              </div>
              <div class="flex justify-between">
                <span>Status:</span>
                <strong class="text-emerald-400">Pendaftaran Dibuka</strong>
              </div>
            </div>

            <a
              href={waLink("Halo KonsultanK3, saya ingin mendaftar K3 Ruang Terbatas")}
              target="_blank"
              rel="noopener"
              class="w-full py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider flex items-center justify-center gap-2 shadow-lg transition-all"
            >
              <span>Amankan Kursi Sekarang</span> &rarr;
            </a>
          </div>

          <div class="p-6 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-3">
            <div class="text-xs font-bold uppercase tracking-wider text-slate-400">Program Terkait</div>
            <div class="space-y-2 text-sm font-semibold text-slate-800">
              <a href="/pelatihan-ahli-k3-umum/" class="block hover:text-amber-600">🎓 Pembinaan Ahli K3 Umum</a>
              <a href="/pelatihan-k3-kebakaran/" class="block hover:text-amber-600">🔥 K3 Penanggulangan Kebakaran</a>
              <a href="/pelatihan-k3-listrik/" class="block hover:text-amber-600">⚡ Teknisi &amp; Ahli K3 Listrik</a>
              <a href="/panduan-penerapan-smk3/" class="block hover:text-amber-600">📋 Audit SMK3 PP 50/2012</a>
            </div>
          </div>

        </aside>

      </div>

    </div>
  </section>
</BaseLayout>
