---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Ahli K3 Umum Semarang Sertifikat Kemnaker Resmi";
const description = "Pembinaan & sertifikasi Calon Ahli K3 Umum Kemnaker RI di Semarang & Jawa Tengah. Raih SKP, lisensi resmi, modul lengkap, dan bimbingan sampai kompeten.";
const canonical = "/pelatihan-ahli-k3-umum-semarang/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Ahli K3 Umum Semarang", "item": "https://konsultank3.com/pelatihan-ahli-k3-umum-semarang/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pembinaan & Sertifikasi Calon Ahli K3 Umum Kemnaker RI Semarang",
      "description": "Program pembinaan kompetensi calon Ahli K3 Umum resmi Kemnaker RI di wilayah Semarang dan Jawa Tengah untuk pengawasan norma K3 dan penunjukan sekretaris P2K3 sesuai Permenaker No. 02/MEN/1992.",
      "courseCode": "AK3U-SMG-KEMNAKER",
      "educationalCredentialAwarded": "Sertifikat Calon Ahli K3 Umum Kemnaker RI, Surat Keputusan Penunjukan (SKP), Kartu Lisensi Kewenangan K3",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": ["Blended", "Onsite"],
        "courseWorkload": "PT120H",
        "location": {
          "@type": "Place",
          "name": "Pusat Pelatihan K3 Semarang",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Kota Semarang",
            "addressRegion": "Jawa Tengah",
            "addressCountry": "ID"
          }
        }
      }
    },
    {
      "@type": "Service",
      "name": "Pelatihan & Sertifikasi Ahli K3 Umum Semarang - KonsultanK3.com",
      "serviceType": "Pembinaan & Sertifikasi Calon Ahli K3 Umum Kemnaker RI",
      "url": "https://konsultank3.com/pelatihan-ahli-k3-umum-semarang/",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com",
        "telephone": "+62-895-1025-3435"
      },
      "areaServed": [
        "Kota Semarang",
        "Kabupaten Semarang",
        "Kendal",
        "Demak",
        "Kudus",
        "Batang",
        "Salatiga",
        "Jawa Tengah"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apakah sertifikat Ahli K3 Umum Kemnaker ini resmi dan terdaftar di portal Teman K3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, 100% resmi. Seluruh peserta yang lulus evaluasi dan ujian komprehensif akan diterbitkan Sertifikat Calon Ahli K3 Umum resmi dari Kementerian Ketenagakerjaan RI (Kemnaker) yang dapat diverifikasi keabsahannya secara langsung melalui barcode dan nomor registrasi pada portal resmi Teman K3 Kemnaker."
          }
        },
        {
          "@type": "Question",
          "name": "Apa perbedaan sertifikat untuk Fresh Graduate dan Utusan Perusahaan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bagi fresh graduate / peserta mandiri, dokumen yang diperoleh adalah Sertifikat Pembinaan Calon Ahli K3 Umum dari Kemnaker RI. Sedangkan bagi peserta utusan perusahaan yang menyertakan surat penugasan dari instansi tempat bekerja, peserta akan memperoleh tiga dokumen sekaligus: Sertifikat Pembinaan Kemnaker RI, Surat Keputusan Penunjukan (SKP) Ahli K3, dan Kartu Lisensi Kewenangan K3. Peserta mandiri dapat mengurus SKP dan Lisensi tersebut di kemudian hari setelah bekerja tanpa perlu mengikuti pelatihan ulang."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama durasi pelatihan Ahli K3 Umum Kemnaker di Semarang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Durasi pembinaan berlangsung selama 12 hari kerja efektif (setara dengan 120 Jam Pelajaran / JP), sesuai dengan standar kurikulum wajib Ditjen Binwasnaker & K3 Kementerian Ketenagakerjaan RI. Pembinaan mencakup teori regulasi norma K3, simulasi audit SMK3, Praktik Kerja Lapangan (PKL), seminar laporan, hingga ujian evaluasi akhir."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah lulusan non-teknik bisa mendaftar pelatihan Ahli K3 Umum di Semarang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Bisa. Sesuai Permenaker No. 02/MEN/1992, syarat pendidikan minimal untuk mengikuti pembinaan Calon Ahli K3 Umum adalah Diploma Tiga (D3) atau Strata Satu (S1) dari semua jurusan, baik latar belakang teknik maupun non-teknik (seperti Ekonomi, Hukum, Komunikasi, Manajemen, Kesehatan Masyarakat, dan lainnya)."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa estimasi biaya pelatihan Ahli K3 Umum di Semarang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Biaya pembinaan Ahli K3 Umum di Semarang berkisar antara Rp 5.500.000 hingga Rp 7.500.000 tergantung pada metode kelas (Blended Learning Online vs Tatap Muka Onsite di Semarang) dan status kepesertaan (Fresh Graduate mandiri vs Utusan Perusahaan dengan SKP & Lisensi). Biaya tersebut sudah mencakup sertifikat resmi Kemnaker RI, modul undang-undang, bimbingan PKL, dan seragam/training kit."
          }
        },
        {
          "@type": "Question",
          "name": "Mengapa perusahaan di kawasan industri Semarang, Kendal, dan Batang wajib memiliki Ahli K3 Umum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Berdasarkan UU No. 1 Tahun 1970 dan Permenaker No. 04/MEN/1987, setiap tempat kerja yang mempekerjakan 100 orang buruh atau lebih, atau memiliki potensi bahaya tinggi (seperti pabrik kimia, manufaktur, konstruksi, dan logistik), wajib membentuk Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3) di mana sekretaris P2K3 wajib dijabat oleh Ahli K3 Umum berlisensi resmi Kemnaker RI."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama masa berlaku SKP dan Lisensi Ahli K3 Umum?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Surat Keputusan Penunjukan (SKP) dan Kartu Lisensi Ahli K3 Umum berlaku selama 3 (tiga) tahun dan berlaku selama personel yang bersangkutan tetap bekerja di perusahaan yang mengajukan penunjukan. Lisensi dapat diperpanjang secara berkala melalui pengajuan ke Kemnaker RI dengan melampirkan laporan kegiatan K3 berkala."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana metode pelaksanaan pembinaan di Semarang?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Kami menyediakan opsi Blended Learning (kombinasi sesi virtual interactive via Zoom meeting interaktif dengan bimbingan observasi lapangan/PKL mandiri) serta kelas Offline Tatap Muka di Semarang bagi rombongan corporate/in-house training langsung di lingkungan pabrik kawasan industri."
          }
        },
        {
          "@type": "Question",
          "name": "Apa saja syarat dokumen yang harus disiapkan untuk pendaftaran?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dokumen yang harus disiapkan antara lain: scan ijazah minimal D3/S1, scan transkrip nilai, scan KTP yang masih berlaku, pasfoto formal berlatar belakang merah, surat keterangan berbadan sehat dari dokter/klinik, serta surat rekomendasi/penugasan dari perusahaan (khusus jalur utusan perusahaan)."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah tersedia layanan In-House Training untuk perusahaan di Jawa Tengah?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, kami melayani program In-House Training Calon Ahli K3 Umum dan sertifikasi K3 spesifik lainnya langsung di tempat kerja/pabrik klien untuk wilayah Semarang (KIW, Terboyo, Candi), Kendal (KIK), Batang (KITB), Demak, Kudus, Salatiga, dan sekitarnya dengan penyesuaian jadwal batch sesuai kebutuhan korporasi."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb Navigation -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <a href="/pelatihan-ahli-k3-umum/" class="hover:text-amber-400 transition-colors">Ahli K3 Umum</a>
        <span>/</span>
        <span class="text-slate-300">Semarang &amp; Jawa Tengah</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column: Title & Strategic Offer -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse-glow"></span>
            Pembinaan Resmi Kemnaker RI &bull; Koridor Industri Semarang &amp; Jateng
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Ahli K3 Umum Semarang</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Raih sertifikat resmi Kementerian Ketenagakerjaan RI, Surat Keputusan Penunjukan (SKP), dan lisensi kewenangan Ahli K3 untuk menjawab mandatori Permenaker No. 02/MEN/1992 di kawasan industri Semarang, Kendal, Batang, dan sekitarnya.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, saya mau mendaftar Pelatihan Ahli K3 Umum Kemnaker RI di Semarang.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Konsultasi Batch Semarang</span>
              <span>&rarr;</span>
            </a>
            <a
              href="#silabus"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Silabus 120 JP &amp; Jadwal
            </a>
          </div>

          <!-- Quick Stats Indicators -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi Wajib</span>
              <p class="text-white font-bold text-sm">12 Hari (120 JP)</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Legalitas Dokumen</span>
              <p class="text-white font-bold text-sm">SKP &amp; Lisensi Kemnaker</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kawasan Industri</span>
              <p class="text-white font-bold text-sm">KIW, KIK, KITB &amp; Candi</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Validasi Online</span>
              <p class="text-emerald-400 font-bold text-sm">Portal Teman K3 Sah</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Visual Feature Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pembinaan Calon Ahli K3 Umum Semarang Kemnaker RI"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
              loading="eager"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Mandatori Permenaker 02/1992 &bull; Permenaker 04/1987
              </span>
              <div class="text-lg font-bold">Kualifikasi Sekretaris P2K3 Perusahaan</div>
              <p class="text-xs text-slate-300 mt-1">
                Kunci pemenuhan audit SMK3 PP 50/2012 dan izin operasional fasilitas manufaktur, energi, logistik, dan konstruksi di Jawa Tengah.
              </p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">Sertifikat Resmi Kemnaker</div>
              <div class="text-[10px] text-slate-400">Barcode &amp; QR Sah Nasional</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🏭</div>
            <div>
              <div class="text-xs font-bold text-white">Bimbingan PKL Industri</div>
              <div class="text-[10px] text-slate-400">Studi Kasus Pabrik Jateng</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Sticky Conversion Banner -->
  <aside aria-label="Informasi Batch" class="w-full bg-amber-500/10 border-b border-amber-500/20 py-3 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-800 font-medium">
      <span class="inline-flex items-center gap-1.5 font-bold text-amber-900">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Pendaftaran Batch Baru Wilayah Semarang &amp; Jawa Tengah Dibuka:
      </span>
      <span class="text-slate-700">Tersedia kuota kelas Blended Learning &amp; In-House Training Perusahaan.</span>
      <a
        href={waLink("Halo Kak, boleh minta info jadwal dan promo batch Ahli K3 Umum Semarang terbaru.")}
        target="_blank"
        rel="noopener"
        class="text-emerald-700 hover:text-emerald-800 font-bold underline ml-1"
      >
        Cek Ketersediaan Kuota via WhatsApp &rarr;
      </a>
    </div>
  </aside>

  <!-- Main Content Body -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Regional Industrial Context Semarang & Jawa Tengah -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-2">Konteks Industri Lokal</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Mengapa Ahli K3 Umum Sangat Dibutuhkan di Wilayah Semarang &amp; Jawa Tengah?
        </h2>
        <div class="h-1 w-20 bg-amber-500 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          Provinsi Jawa Tengah, khususnya segitiga industri <strong>Semarang &ndash; Kendal &ndash; Batang</strong>, telah berkembang pesat menjadi episentrum manufaktur dan investasi nasional baru. Kehadiran mega-kawasan seperti Kawasan Industri Kendal (KIK), Kawasan Industri Terpadu Batang (KITB), Kawasan Industri Wijayakusuma (KIW) di Tugu Semarang, kawasan Candi di Ngaliyan, serta zona industri pelabuhan Tanjung Emas memicu lonjakan kebutuhan tenaga ahli keselamatan kerja yang bersertifikat resmi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-3">
          <div class="w-12 h-12 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center font-bold text-xl">
            ⚖️
          </div>
          <h3 class="font-bold text-slate-900 text-lg">Kewajiban Mutlak Regulasi K3</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Sesuai UU No. 1 Tahun 1970 dan Permenaker No. 04/MEN/1987, setiap perusahaan dengan tenaga kerja minimal 100 orang atau memiliki potensi risiko bahaya tinggi wajib membentuk Panitia Pembina K3 (P2K3) dan menunjuk sekretaris P2K3 berlisensi Ahli K3 Umum.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-3">
          <div class="w-12 h-12 rounded-xl bg-blue-500/10 text-blue-700 flex items-center justify-center font-bold text-xl">
            🏭
          </div>
          <h3 class="font-bold text-slate-900 text-lg">Ekspansi Zona Industri Jateng</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Ratusan pabrik multinasional di sektor tekstil, garmen, elektronik, otomotif, pengolahan makanan, dan farmasi di KIW Semarang, KIK Kendal, dan KITB Batang membutuhkan ratusan HSE Officer dan Safety Supervisor setiap tahunnya.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-md transition-shadow space-y-3">
          <div class="w-12 h-12 rounded-xl bg-emerald-500/10 text-emerald-700 flex items-center justify-center font-bold text-xl">
            📈
          </div>
          <h3 class="font-bold text-slate-900 text-lg">Akselerasi Karier Profesional</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Sertifikasi Kemnaker RI adalah batu loncatan tercepat bagi fresh graduate D3/S1 maupun praktisi lapangan untuk menembus posisi bergengsi seperti HSE Specialist, K3 Coordinator, Safety Auditor, dan Safety Manager dengan standar gaji kompetitif.
          </p>
        </div>
      </div>

      <!-- Industrial Cluster Highlight Box -->
      <div class="p-8 rounded-3xl bg-slate-900 text-white border border-white/10 space-y-6">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-amber-400">Peta Jangkauan Layanan</span>
            <h3 class="text-xl sm:text-2xl font-bold font-serif text-white mt-1">Cakupan Kawasan Industri Semarang Raya &amp; Jawa Tengah</h3>
          </div>
          <a
            href={waLink("Halo Kak, kami mau mengundang in-house training Ahli K3 Umum untuk pabrik kami di Jawa Tengah.")}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs tracking-wide transition-colors whitespace-nowrap self-start md:self-auto"
          >
            Permintaan In-House Perusahaan &rarr;
          </a>
        </div>
        
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 text-xs font-sans text-slate-300">
          <div class="p-4 rounded-xl bg-white/5 border border-white/10">
            <strong class="text-amber-400 block mb-1">Kota Semarang:</strong>
            KI Wijayakusuma (KIW), KI Candi (KIC), KI Terboyo, Genuk Industri, Tanjung Emas Pelabuhan.
          </div>
          <div class="p-4 rounded-xl bg-white/5 border border-white/10">
            <strong class="text-amber-400 block mb-1">Kendal &amp; Batang:</strong>
            Kawasan Industri Kendal (KIK), KIT Batang (KITB), industri kimia &amp; manufaktur pesisir pantura.
          </div>
          <div class="p-4 rounded-xl bg-white/5 border border-white/10">
            <strong class="text-amber-400 block mb-1">Ungaran &amp; Salatiga:</strong>
            Koridor manufaktur garmen, tekstil ekspor, industri pakan ternak, dan industri makanan minuman.
          </div>
          <div class="p-4 rounded-xl bg-white/5 border border-white/10">
            <strong class="text-amber-400 block mb-1">Demak, Kudus &amp; Sekitarnya:</strong>
            Industri rokok, percetakan, karoseri bus, logistik transportasi pantura, dan agroindustri.
          </div>
        </div>
      </div>
    </section>

    <!-- Section 2: Legal Foundation & Mandate -->
    <section class="space-y-6">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block mb-2">Landasan Hukum &amp; Legalitas</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Dasar Regulasi Penunjukan Ahli K3 Umum Kemnaker RI
        </h2>
        <div class="h-1 w-20 bg-amber-500 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          Pembinaan Calon Ahli K3 Umum bukan sekadar pelatihan teknis biasa, melainkan program pemenuhan syarat undang-undang yang diatur ketat oleh Kementerian Ketenagakerjaan Republik Indonesia.
        </p>
      </div>

