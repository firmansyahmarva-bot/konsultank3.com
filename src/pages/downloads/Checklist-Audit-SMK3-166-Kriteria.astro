---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Cuplikan Checklist Audit SMK3 (7 dari 166 Kriteria)";
const description = "Cuplikan Checklist Audit SMK3 (7 dari 166 Kriteria) PP 50/2012. Format tabel siap cetak dan PDF. Versi lengkap 166 kriteria tersedia via WhatsApp.";
const canonical = "/downloads/Checklist-Audit-SMK3-166-Kriteria.html";

const downloadSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pusat Unduhan", "item": "https://konsultank3.com/panduan-penerapan-smk3/" },
        { "@type": "ListItem", "position": 3, "name": title, "item": `https://konsultank3.com${canonical}` }
      ]
    },
    {
      "@type": "DigitalDocument",
      "name": title,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={downloadSchema}
  presetMessage="Halo KonsultanK3, saya ingin meminta format lengkap XLS/DOCX Checklist Audit SMK3 166 Kriteria."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-10 my-8 bg-white rounded-3xl shadow-sm border border-slate-200">
    
    <!-- Action Toolbar (Hidden in Print) -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-slate-200 not-prose">
      <a href="/panduan-penerapan-smk3/" class="text-sm font-semibold text-slate-600 hover:text-amber-600 flex items-center gap-1.5 transition-colors">
        <span>&larr;</span> Panduan Audit SMK3
      </a>
      
      <div class="flex flex-wrap items-center gap-3">
        <button
          onclick="window.print()"
          class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all flex items-center gap-2 cursor-pointer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
          <span>Cetak / Simpan PDF</span>
        </button>
        <a
          href={waLink("Halo KonsultanK3, saya ingin meminta format asli (DOCX/XLS) Checklist Audit SMK3 166 Kriteria")}
          target="_blank"
          rel="noopener"
          class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider shadow-md shadow-emerald-600/20 transition-all flex items-center gap-2"
        >
          <span>Format XLS Asli (WhatsApp) &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Document Header -->
    <div class="space-y-3 mb-8">
      <div class="inline-block px-3 py-1 rounded-md text-[11px] font-bold bg-amber-500/10 text-amber-700 border border-amber-500/20 uppercase tracking-wider">
        Format Audit Mandiri Lanjutan
      </div>
      <h1 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug">
        Cuplikan Checklist Audit SMK3 (7 dari 166 Kriteria)
      </h1>
      <p class="text-sm text-emerald-800 font-semibold font-sans bg-emerald-50 border border-emerald-200/80 p-3 rounded-xl">
        Versi lengkap 166 kriteria tersedia via WhatsApp.
      </p>
      <p class="text-sm text-slate-600 font-sans">
        <strong>Dasar Hukum:</strong> Peraturan Pemerintah No. 50 Tahun 2012 tentang Penerapan Sistem Manajemen K3 (Tingkat Lanjutan).
      </p>
    </div>
    
    <!-- Printable Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm border-collapse border border-slate-300">
        <thead>
          <tr class="bg-slate-100 text-slate-900 font-bold font-serif">
            <th class="p-3 border border-slate-300 w-16 text-center">No.</th>
            <th class="p-3 border border-slate-300 w-36">Kriteria</th>
            <th class="p-3 border border-slate-300">Deskripsi Elemen Audit</th>
            <th class="p-3 border border-slate-300 w-24 text-center">Status</th>
            <th class="p-3 border border-slate-300 w-44">Bukti Objektif</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-slate-700">
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">1.1.1</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Kebijakan K3</td>
            <td class="p-3 border border-slate-300">Terdapat kebijakan K3 tertulis, bertanggal, ditandatangani oleh pimpinan tertinggi, dan disosialisasikan ke seluruh pekerja.</td>
            <td class="p-3 border border-slate-300 text-center font-mono">[ &nbsp; ]</td>
            <td class="p-3 border border-slate-300">SK Kebijakan K3 Tertulis</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">1.2.2</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Penanggung Jawab K3</td>
            <td class="p-3 border border-slate-300">Penunjukan penanggung jawab K3 (Ahli K3 Umum) secara resmi dan memenuhi kualifikasi perundangan Kemnaker RI.</td>
            <td class="p-3 border border-slate-300 text-center font-mono">[ &nbsp; ]</td>
            <td class="p-3 border border-slate-300">SKP &amp; Lisensi K3 Kemnaker</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">1.4.1</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Struktur P2K3</td>
            <td class="p-3 border border-slate-300">Organisasi P2K3 (Panitia Pembina Keselamatan &amp; Kesehatan Kerja) telah disahkan oleh Disnaker setempat.</td>
            <td class="p-3 border border-slate-300 text-center font-mono">[ &nbsp; ]</td>
            <td class="p-3 border border-slate-300">SK Pengesahan Disnaker</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">2.1.1</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">HIRARC / IBPR</td>
            <td class="p-3 border border-slate-300">Identifikasi bahaya, penilaian risiko, dan penentuan kendali (HIRARC) terdokumentasi untuk seluruh lini kegiatan.</td>
            <td class="p-3 border border-slate-300 text-center font-mono">[ &nbsp; ]</td>
            <td class="p-3 border border-slate-300">Matriks HIRARC / JSA</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">6.1.1</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Alat Pelindung Diri</td>
            <td class="p-3 border border-slate-300">Identifikasi kebutuhan APD, penyediaan cuma-cuma sesuai standar SNI/ANSI, dan rekaman kartu serah terima.</td>
            <td class="p-3 border border-slate-300 text-center font-mono">[ &nbsp; ]</td>
            <td class="p-3 border border-slate-300">Form Serah Terima APD</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">6.7.1</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Tanggap Darurat</td>
            <td class="p-3 border border-slate-300">Rencana tanggap darurat terdokumentasi, simulasi (drill) kebakaran berkala, dan tim tanggap darurat terlatih.</td>
            <td class="p-3 border border-slate-300 text-center font-mono">[ &nbsp; ]</td>
            <td class="p-3 border border-slate-300">Laporan Fire Drill &amp; Evakuasi</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">11.1.1</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Audit Internal</td>
            <td class="p-3 border border-slate-300">Audit internal SMK3 dilakukan secara periodik oleh auditor internal bersertifikat dan dilaporkan dalam tinjauan manajemen.</td>
            <td class="p-3 border border-slate-300 text-center font-mono">[ &nbsp; ]</td>
            <td class="p-3 border border-slate-300">Laporan Audit Internal</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Document Footer -->
    <div class="mt-8 pt-6 border-t border-slate-200 text-center text-xs text-slate-500 font-sans">
      Dokumen diterbitkan oleh <strong>KonsultanK3.com</strong> sebagai panduan rujukan audit internal SMK3 PP 50/2012.<br/>
      Konsultasi persiapan pendampingan sertifikasi SMK3 PP 50/2012: WhatsApp <strong>{WA_DISPLAY}</strong>
    </div>

  </div>
<style is:inline>
.dl-guide{max-width:64rem;margin:0 auto 3rem;padding:0 1rem;color:#334155;line-height:1.7}
.dl-guide h2{font-size:1.5rem;line-height:1.3;color:#0f172a;margin:2rem 0 .75rem;font-weight:800}
.dl-guide h3{font-size:1.15rem;line-height:1.4;color:#0f172a;margin:1.75rem 0 .5rem;font-weight:700}
.dl-guide p,.dl-guide li{font-size:.95rem}
.dl-guide p{margin:.5rem 0}
.dl-guide ul,.dl-guide ol{padding-left:1.25rem;margin:.5rem 0 1rem}
.dl-guide ul{list-style:disc}
.dl-guide ol{list-style:decimal}
.dl-guide li{margin:.25rem 0}
.dl-scroll{overflow-x:auto}
.dl-guide table{width:100%;border-collapse:collapse;font-size:.85rem;margin:1rem 0}
.dl-guide th,.dl-guide td{border:1px solid #cbd5e1;padding:.6rem .75rem;text-align:left;vertical-align:top}
.dl-guide th{background:#f1f5f9;color:#0f172a}
.dl-guide a{color:#047857;text-decoration:underline}
@media print{.dl-guide{display:none}}
</style>
<section class="dl-guide" aria-labelledby="dl-guide-title">
<h2 id="dl-guide-title">Cara Memakai Checklist Audit SMK3 untuk Audit Internal</h2>
<p>PP No. 50 Tahun 2012 mewajibkan perusahaan yang mempekerjakan paling sedikit 100 orang, atau yang memiliki potensi bahaya tinggi, untuk menerapkan Sistem Manajemen K3 (SMK3). Penilaian penerapannya dibagi menjadi tiga tingkat: awal dengan 64 kriteria, menengah dengan 122 kriteria, dan lanjutan dengan 166 kriteria. Tabel di atas hanya cuplikan 7 kriteria agar Anda memahami bentuk dan cara pengisiannya.</p>

<h3>Arti Setiap Kolom</h3>
<div class="dl-scroll">
<table>
<thead><tr><th>Kolom</th><th>Fungsi</th><th>Cara mengisi</th></tr></thead>
<tbody>
<tr><td>No.</td><td>Nomor butir kriteria</td><td>Dipakai apa adanya agar temuan mudah ditelusuri</td></tr>
<tr><td>Kriteria</td><td>Nama elemen yang dinilai</td><td>Dipakai apa adanya</td></tr>
<tr><td>Deskripsi Elemen Audit</td><td>Apa yang harus terpenuhi</td><td>Dibaca sebagai pertanyaan: apakah hal ini ada dan dijalankan?</td></tr>
<tr><td>Status</td><td>Hasil penilaian</td><td>Sesuai, tidak sesuai, atau tidak berlaku, ditetapkan setelah bukti diperiksa</td></tr>
<tr><td>Bukti Objektif</td><td>Dasar penilaian</td><td>Catat dokumen, rekaman, hasil wawancara, atau pengamatan yang benar-benar dilihat</td></tr>
</tbody>
</table>
</div>

<h3>Jenis Bukti Objektif</h3>
<ul>
<li><strong>Dokumen:</strong> kebijakan, prosedur, instruksi kerja, dan program kerja.</li>
<li><strong>Rekaman:</strong> daftar hadir, laporan inspeksi, notulen rapat, dan hasil pelatihan.</li>
<li><strong>Wawancara:</strong> pertanyaan kepada pekerja di semua tingkat untuk memastikan prosedur dipahami.</li>
<li><strong>Pengamatan lapangan:</strong> kondisi tempat kerja dan perilaku kerja yang terlihat langsung.</li>
</ul>
<p>Praktik yang baik adalah memeriksa satu kriteria dari lebih dari satu sumber. Dokumen yang lengkap belum cukup bila pekerja di lapangan tidak mengetahui isinya.</p>

<h3>Langkah Audit Internal</h3>
<ol>
<li>Tetapkan ruang lingkup dan susun tim auditor yang independen dari area yang diaudit.</li>
<li>Siapkan daftar dokumen dan jadwal pemeriksaan.</li>
<li>Adakan rapat pembukaan untuk menjelaskan tujuan dan jadwal.</li>
<li>Periksa dokumen, wawancarai pekerja, dan amati lapangan.</li>
<li>Catat setiap temuan beserta buktinya.</li>
<li>Tetapkan status tiap kriteria dan prioritaskan temuan yang berisiko besar.</li>
<li>Adakan rapat penutupan, lalu susun rencana tindakan korektif dengan penanggung jawab dan tenggat.</li>
<li>Verifikasi bahwa tindakan korektif benar-benar selesai.</li>
</ol>

<h3>Contoh Pengisian</h3>
<div class="dl-scroll">
<table>
<thead><tr><th>No.</th><th>Kriteria (contoh)</th><th>Status</th><th>Bukti objektif dan tindak lanjut</th></tr></thead>
<tbody>
<tr><td>1.1.1</td><td>Kebijakan K3</td><td>Sesuai</td><td>Dokumen kebijakan K3 bernomor, bertanggal, dan ditandatangani pimpinan tertinggi; foto papan pengumuman di pintu masuk; daftar hadir sosialisasi</td></tr>
<tr><td>1.1.1</td><td>Kebijakan K3 (kondisi lain)</td><td>Tidak sesuai</td><td>Kebijakan ada tetapi tidak pernah ditinjau sejak diterbitkan. Tindakan korektif: jadwalkan peninjauan tahunan, penanggung jawab kepala HSE, selesai dalam satu bulan</td></tr>
</tbody>
</table>
</div>
<p>Contoh di atas hanya ilustrasi. Isi bukti harus berasal dari hal yang benar-benar Anda temukan di perusahaan.</p>

<h3>Dari Audit Internal ke Penilaian Resmi</h3>
<p>Audit internal membantu perusahaan mengetahui kesiapan lebih dulu. Penilaian resmi penerapan SMK3 dilakukan oleh badan audit independen yang ditunjuk pemerintah, dan hasilnya menjadi dasar penghargaan berupa bendera perak atau emas sesuai Permenaker No. 26 Tahun 2014. Checklist ini bukan pengganti audit resmi. Penjelasan lengkap ada di <a href="/panduan-penerapan-smk3/">panduan penerapan dan audit SMK3</a>.</p>

<h2>Pertanyaan yang Sering Diajukan</h2>
<h3>Apakah checklist ini bisa dipakai untuk memperoleh sertifikat SMK3?</h3>
<p>Tidak. Checklist ini untuk persiapan dan audit internal. Penilaian untuk penghargaan atau sertifikat dilakukan oleh badan audit yang ditunjuk sesuai peraturan.</p>
<h3>Siapa yang boleh menjadi auditor internal?</h3>
<p>Orang yang memahami PP No. 50 Tahun 2012 dan teknik audit, serta independen dari area yang diaudit. Pelatihan auditor internal membantu menyamakan cara menilai. Informasi program pelatihan ada di <a href="/pelatihan/">halaman pelatihan</a>.</p>
<h3>Seberapa sering audit internal dilakukan?</h3>
<p>Dilakukan secara berkala, umumnya setahun sekali, dan bisa lebih sering untuk area berisiko tinggi atau setelah ada perubahan besar pada proses kerja.</p>

<h3>Daftar Pustaka</h3>
<ul>
<li>Peraturan Pemerintah No. 50 Tahun 2012 tentang Penerapan Sistem Manajemen Keselamatan dan Kesehatan Kerja (SMK3)</li>
<li>Peraturan Menteri Ketenagakerjaan No. 26 Tahun 2014 tentang Penyelenggaraan Penilaian Penerapan SMK3</li>
<li>Undang-Undang No. 1 Tahun 1970 tentang Keselamatan Kerja</li>
<li>ISO 45001:2018 Occupational health and safety management systems</li>
</ul>
</section>
</BaseLayout>
