---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Formulir Standar Job Safety Analysis (JSA)";
const description = "Template formulir tabel Job Safety Analysis (JSA) standar keselamatan kerja industri. Format siap cetak dan simpan ke PDF.";
const canonical = "/downloads/Formulir-JSA-Job-Safety-Analysis.html";

const jsaSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pusat Unduhan", "item": "https://konsultank3.com/alat-pelindung-diri/" },
        { "@type": "ListItem", "position": 3, "name": "Formulir Standar JSA", "item": `https://konsultank3.com${canonical}` }
      ]
    },
    {
      "@type": "DigitalDocument",
      "name": title,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "PT Wahana Totalita Konsultan",
        "url": "https://wahanatotalita.com"
      }
    }
  ]
};
---

<BaseLayout
  title={`${title} » Konsultan K3 Indonesia`}
  description={description}
  canonical={canonical}
  schema={jsaSchema}
  presetMessage="Halo KonsultanK3, saya ingin meminta format file asli XLS/DOCX Formulir Job Safety Analysis (JSA)."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-8 py-10 my-8 bg-white rounded-3xl shadow-sm border border-slate-200">
    
    <!-- Action Toolbar (Hidden in Print) -->
    <div class="flex flex-wrap items-center justify-between gap-4 pb-6 mb-8 border-b border-slate-200 not-prose">
      <a href="/alat-pelindung-diri/" class="text-sm font-semibold text-slate-600 hover:text-amber-600 flex items-center gap-1.5 transition-colors">
        <span>&larr;</span> Panduan Standar APD
      </a>
      
      <div class="flex flex-wrap items-center gap-3">
        <button
          onclick="window.print()"
          class="px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider shadow-md transition-all flex items-center gap-2 cursor-pointer"
        >
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><path d="M6 14h12v8H6z"/></svg>
          <span>Cetak / Simpan PDF</span>
        </button>
        <a
          href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20meminta%20format%20asli%20(DOCX/XLS)%20Formulir%20Job%20Safety%20Analysis%20(JSA)"
          target="_blank"
          rel="noopener"
          class="px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs uppercase tracking-wider shadow-md shadow-emerald-600/20 transition-all flex items-center gap-2"
        >
          <span>Format XLS Asli (WhatsApp) &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Document Header -->
    <div class="space-y-3 mb-8">
      <div class="inline-block px-3 py-1 rounded-md text-[11px] font-bold bg-amber-500/10 text-amber-700 border border-amber-500/20 uppercase tracking-wider">
        Format Analisa Keselamatan Kerja
      </div>
      <h1 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight leading-snug">
        Formulir Job Safety Analysis (JSA)
      </h1>
      <p class="text-sm text-slate-600 font-sans">
        Instrumen identifikasi bahaya per tahapan kerja dan perumusan rekomendasi kontrol pencegahan insiden kerja.
      </p>
    </div>

    <!-- Metadata Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 p-5 rounded-2xl bg-slate-50 border border-slate-200 text-xs text-slate-700 mb-6">
      <div class="space-y-2">
        <p><strong>Nama Pekerjaan:</strong> ...........................................................</p>
        <p><strong>Lokasi / Departemen:</strong> ...........................................................</p>
        <p><strong>Tanggal Pelaksanaan:</strong> ...........................................................</p>
      </div>
      <div class="space-y-2">
        <p><strong>Disusun Oleh:</strong> ...........................................................</p>
        <p><strong>Ditinjau (HSE Officer):</strong> ...........................................................</p>
        <p><strong>Disetujui (Pengawas):</strong> ...........................................................</p>
      </div>
    </div>

    <div class="p-4 rounded-xl bg-amber-50/70 border border-amber-200/80 text-xs text-amber-950 mb-6">
      <strong>APD Wajib Disiapkan:</strong> [ &nbsp; ] Safety Helmet &nbsp; [ &nbsp; ] Safety Shoes &nbsp; [ &nbsp; ] Kacamata Safety &nbsp; [ &nbsp; ] Sarung Tangan &nbsp; [ &nbsp; ] Full Body Harness &nbsp; [ &nbsp; ] Respirator
    </div>
    
    <!-- Printable Table -->
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs sm:text-sm border-collapse border border-slate-300">
        <thead>
          <tr class="bg-slate-100 text-slate-900 font-bold font-serif">
            <th class="p-3 border border-slate-300 w-16 text-center">No.</th>
            <th class="p-3 border border-slate-300 w-1/3">Urutan Tahapan Kerja</th>
            <th class="p-3 border border-slate-300 w-1/3">Potensi Bahaya Teridentifikasi</th>
            <th class="p-3 border border-slate-300 w-1/3">Tindakan Pengendalian Rekomendasi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200 text-slate-700">
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">1</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Persiapan area &amp; perizinan (Work Permit)</td>
            <td class="p-3 border border-slate-300">Izin kerja belum tervalidasi, bahaya lingkungan sekitar belum dikomunikasikan.</td>
            <td class="p-3 border border-slate-300">Lakukan inspeksi pra-kerja, pastikan permit ditandatangani pengawas yang berwenang.</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">2</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Pemeriksaan peralatan kerja &amp; mesin</td>
            <td class="p-3 border border-slate-300">Peralatan aus/rusak, isolasi kabel terkelupas, risiko sengatan listrik.</td>
            <td class="p-3 border border-slate-300">Lakukan checklist peralatan harian, beri tag "Out of Service" pada alat cacat.</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">3</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Pelaksanaan pekerjaan inti</td>
            <td class="p-3 border border-slate-300">Terjepit, tergores, terjatuh dari ketinggian, terpapar radiasi atau uap kimia.</td>
            <td class="p-3 border border-slate-300">Ikuti SOP teknis aman, pertahankan postur ergonomis, gunakan APD spesifik wajib.</td>
          </tr>
          <tr class="hover:bg-slate-50">
            <td class="p-3 border border-slate-300 font-mono text-center">4</td>
            <td class="p-3 border border-slate-300 font-semibold text-slate-900">Housekeeping &amp; penutupan izin kerja</td>
            <td class="p-3 border border-slate-300">Material berserakan berisiko tersandung (trip hazard), bara api tertinggal.</td>
            <td class="p-3 border border-slate-300">Bersihkan sisa material kerja (5R), pastikan area aman, tutup permit dengan verifikasi pengawas.</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Document Footer -->
    <div class="mt-8 pt-6 border-t border-slate-200 text-center text-xs text-slate-500 font-sans">
      Dokumen diterbitkan oleh <strong>KonsultanK3.com</strong> bekerjasama dengan <strong>PT Wahana Totalita Konsultan</strong>.<br/>
      Konsultasi teknis penyusunan JSA dan Risk Assessment: WhatsApp <strong>0813-9294-3146</strong>
    </div>

  </div>
</BaseLayout>
