---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Formulir Standar Job Safety Analysis (JSA)";
const description = "Template formulir tabel Job Safety Analysis (JSA) standar keselamatan kerja industri. Format siap cetak dan simpan ke PDF.";
const canonical = "/downloads/Formulir-JSA-Job-Safety-Analysis.html";

const jsaSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pusat Unduhan", "item": "https://konsultank3.com/alat-pelindung-diri/" },
        { "@type": "ListItem", "position": 3, "name": "Formulir Standar JSA", "item": `https://konsultank3.com${canonical}` }
      ]
    },
    {
      "@type": "DigitalDocument",
      "name": title,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
