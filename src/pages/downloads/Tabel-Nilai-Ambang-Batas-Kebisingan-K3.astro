import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Tabel Nilai Ambang Batas (NAB) Kebisingan Tempat Kerja";
const description = "Tabel referensi resmi Nilai Ambang Batas (NAB) kebisingan di tempat kerja sesuai Permenaker No. 5 Tahun 2018. Siap cetak ke PDF.";
const canonical = "/downloads/Tabel-Nilai-Ambang-Batas-Kebisingan-K3.html";

const nabSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pusat Unduhan", "item": "https://konsultank3.com/program-pengendalian-kebisingan/" },
        { "@type": "ListItem", "position": 3, "name": "Tabel Standar NAB Kebisingan", "item": `https://konsultank3.com${canonical}` }
      ]
    },
    {
      "@type": "DigitalDocument",
      "name": title,
      "description": description,
      "publisher": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
