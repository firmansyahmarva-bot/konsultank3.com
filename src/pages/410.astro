---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="410 - Konten Telah Dihapus Permanen » Konsultan K3"
  description="Halaman arsip lama ini telah dihapus secara permanen (HTTP 410 Gone) dalam rangka standardisasi mutu KonsultanK3.com."
  canonical="/410.html"
  robots="noindex, nofollow"
>
  <section class="min-h-[70vh] flex items-center justify-center py-20 px-4 sm:px-6">
    <div class="max-w-xl mx-auto text-center space-y-6">
      <div class="inline-flex items-center justify-center w-20 h-20 rounded-3xl bg-rose-500/10 text-rose-500 font-extrabold text-3xl border border-rose-500/20 font-serif">
        410
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 font-serif">
        Konten Telah Dihapus Permanen (HTTP 410 Gone)
      </h1>
      <p class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-md mx-auto">
        Halaman arsip atau permutasi URL lama ini telah dipensiunkan secara permanen. Seluruh program sertifikasi resmi kini dipusatkan di portal kurikulum terpadu.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
        <a
          href="/"
          class="px-6 py-3 rounded-xl bg-slate-900 hover:bg-slate-800 text-white font-bold text-sm shadow-md transition-all"
        >
          &larr; Menuju Beranda Resmi
        </a>
        <a
          href="/pelatihan-ahli-k3-umum/"
          class="px-6 py-3 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-md transition-all"
        >
          Program Ahli K3 Umum &rarr;
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
