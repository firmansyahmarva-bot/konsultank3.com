---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { waLink } from '../../data/contact.js';

const title = "Pelatihan Petugas Gas H2S Balikpapan Sertifikat BNSP";
const description = "Pelatihan & uji kompetensi Petugas Gas Beracun H2S BNSP di Balikpapan. Praktik gas detector, SCBA/EEBA & rescue migas Kaltim. Cek jadwal & biaya.";
const canonical = "/pelatihan-h2s-balikpapan/";
const ogImage = "https://konsultank3.com/assets/images/pelatihan-h2s-balikpapan-hero.jpg";

const faqs = [
  {
    q: "Siapa saja yang wajib mengikuti Pelatihan Petugas Gas H2S BNSP di Balikpapan?",
    a: "Pelatihan ini wajib diikuti oleh pekerja kilang minyak, kontraktor hulu migas (drilling, well service, workover, wireline), teknisi pengolahan gas/LNG, pekerja geothermal, hingga tim safety standby ruang terbatas di kawasan industri Balikpapan, Kariangau, Handil, Senipah, dan Bontang yang berpotensi terpapar gas Hidrogen Sulfida."
  },
  {
    q: "Apa saja syarat pendaftaran sertifikasi Petugas Penanganan Bahaya Gas H2S BNSP?",
    a: "Calon asesi minimal lulusan SLTA/SMK sederajat dengan pengalaman kerja di sektor migas, petrokimia, atau K3 minimal 1–2 tahun (atau lulusan D3/S1 Teknik/K3). Dokumen yang perlu disiapkan meliputi fotokopi KTP, ijazah terakhir, CV/surat pengalaman kerja, pasfoto latar belakang merah, dan surat rekomendasi perusahaan bila diutus instansi."
  },
  {
    q: "Berapa estimasi biaya Pelatihan H2S Balikpapan bersertifikat BNSP?",
    a: "Untuk skema Blended/Online pra-asesmen + uji kompetensi BNSP berkisar Rp5.500.000–Rp6.800.000 per peserta. Sementara kelas Public Offline di Balikpapan (lengkap dengan TUK, praktik SCBA/EEBA, multi-gas detector, modul, dan konsumsi) berkisar Rp7.000.000–Rp9.500.000 per peserta. Untuk pengiriman tim atau in-house di yard/rig tersedia tarif paket korporasi."
  },
  {
    q: "Berapa Nilai Ambang Batas (NAB) paparan gas H2S menurut regulasi Indonesia?",
    a: "Berdasarkan Permenaker No. 5 Tahun 2018 dan standar keselamatan migas, batas pajanan rata-rata 8 jam kerja (TWA) adalah 1 ppm, batas pajanan jangka pendek 15 menit (STEL) adalah 5 ppm, dan ambang bahaya langsung terhadap jiwa/kesehatan (IDLH) adalah 100 ppm. Pada konsentrasi di atas 100 ppm, indra penciuman lumpuh seketika (olfactory fatigue)."
  },
  {
    q: "Apakah pelatihan di Balikpapan mencakup praktik langsung alat SCBA dan Gas Detector?",
    a: "Ya. Sesi praktik lapangan mencakup inspeksi pra-pakai, bump test dan kalibrasi dasar portable gas detector, teknik pemasangan Work SCBA (300 bar) serta Escape SCBA/EEBA di bawah batas waktu aman, penggunaan buddy system, pembacaan arah angin (wind sock), dan skenario evakuasi korban."
  },
  {
    q: "Apakah sertifikat H2S BNSP diakui untuk tender kontraktor migas dan kilang di Kalimantan Timur?",
    a: "Ya. Sertifikat kompetensi berlogo Garuda Emas yang diterbitkan oleh BNSP melalui Lembaga Sertifikasi Profesi (LSP) terlisensi diakui secara nasional oleh KKKS migas, operator kilang, kontraktor EPC, dan perusahaan penunjang energi di seluruh wilayah Kalimantan Timur dan Indonesia."
  },
  {
    q: "Bisakah menyelenggarakan In-House Training H2S di yard Kariangau, Senipah, atau site offshore?",
    a: "Sangat bisa. Tim instruktur dan asesor LSP mitra kami siap hadir langsung di fasilitas basecamp, yard fabrikasi, maupun lokasi proyek di Balikpapan, Handil, Muara Badak, Bontang, hingga Sangatta menyesuaikan jadwal rotasi kru (crew change)."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Petugas Gas H2S BNSP", "item": "https://konsultank3.com/pelatihan-petugas-gas-beracun-h2s-bnsp/" },
        { "@type": "ListItem", "position": 3, "name": "Pelatihan H2S Balikpapan", "item": "https://konsultank3.com/pelatihan-h2s-balikpapan/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan & Uji Kompetensi Petugas Penanganan Bahaya Gas H2S BNSP Balikpapan",
      "description": description,
      "courseCode": "H2S-BPN-BNSP",
      "educationalCredentialAwarded": "Sertifikat Kompetensi Petugas Penanganan Bahaya Gas H2S BNSP",
      "occupationalCategory": "H2S Safety Officer / Oil & Gas Safety Personnel",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": "5500000",
        "highPrice": "9500000",
        "offerCount": "2"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": ["Onsite", "Blended"],
        "courseWorkload": "PT24H",
        "location": {
          "@type": "Place",
          "name": "Pusat Pelatihan & Uji Kompetensi Migas Balikpapan",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Balikpapan",
            "addressRegion": "Kalimantan Timur",
            "addressCountry": "ID"
          }
        }
      }
    },
    {
      "@type": "Service",
      "name": "Layanan Pelatihan & In-House Sertifikasi H2S Balikpapan dan Kaltim",
      "serviceType": "Sertifikasi Kompetensi Penanganan Gas H2S BNSP",
      "url": "https://konsultank3.com/pelatihan-h2s-balikpapan/",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com",
        "telephone": "+62-895-1025-3435"
      },
      "areaServed": [
        "Balikpapan",
        "Kariangau",
        "Handil",
        "Senipah",
        "Samboja",
        "Muara Badak",
        "Bontang",
        "Samarinda",
        "Penajam Paser Utara"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={pageSchema}
  presetMessage="Halo Kak, saya mau info jadwal dan biaya Pelatihan Petugas Gas H2S BNSP di Balikpapan."
>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">

      <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan-petugas-gas-beracun-h2s-bnsp/" class="hover:text-amber-400 transition-colors">Petugas Gas H2S BNSP</a>
        <span>/</span>
        <span class="text-slate-300">Balikpapan &amp; Kaltim</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/10 text-red-400 text-xs font-semibold border border-red-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-pulse-glow"></span>
            Sertifikasi Kompetensi BNSP &bull; Hub Migas &amp; Kilang Balikpapan
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-400 via-orange-300 to-amber-400">Petugas Gas Beracun H2S Balikpapan</span> Resmi BNSP
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Pembekalan teknis dan uji kompetensi resmi BNSP untuk kru operasi, maintenance, dan tim HSE kontraktor migas serta kilang di Balikpapan, Delta Mahakam, dan Bontang. Kuasai deteksi gas, pemakaian Work SCBA &amp; EEBA, hingga protokol rescue darurat.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, saya mau info jadwal dan biaya Pelatihan H2S BNSP di Balikpapan.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-red-500 to-orange-600 hover:from-red-400 hover:to-orange-500 text-slate-950 font-bold text-sm shadow-xl shadow-red-500/20 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Konsultasi Jadwal Balikpapan</span>
              <span>&rarr;</span>
            </a>
            <a
              href="#biaya"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Biaya &amp; Skema Uji
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Sertifikat</span>
              <p class="text-white font-bold text-sm">Garuda Emas BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi Program</span>
              <p class="text-white font-bold text-sm">3 Hari (24 JP)</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Praktik Alat</span>
              <p class="text-white font-bold text-sm">SCBA, EEBA &amp; Gas Test</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Wilayah Operasi</span>
              <p class="text-amber-400 font-bold text-sm">Balikpapan &amp; Mahakam</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/pelatihan-h2s-balikpapan-hero.jpg"
              alt="Pelatihan petugas gas H2S dengan SCBA dan detektor gas di kilang Balikpapan"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-red-500 text-white mb-2">
                Standar Operasi Kilang &amp; Hulu Migas
              </span>
              <div class="text-lg font-bold">Deteksi Gas, SCBA &amp; Prosedur Rescue</div>
              <p class="text-xs text-slate-300 mt-1">
                Persiapan wajib kru kontraktor sebelum mobilisasi ke zona gas asam (sour gas) dan proyek kilang Balikpapan.
              </p>
            </div>
          </div>

          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-red-500 text-white flex items-center justify-center font-bold text-lg">✓</div>
            <div>
              <div class="text-xs font-bold text-white">Asesmen Asesor BNSP</div>
              <div class="text-[10px] text-slate-400">Standar SKKNI Migas</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🛢️</div>
            <div>
              <div class="text-xs font-bold text-white">In-House Yard &amp; Site</div>
              <div class="text-[10px] text-slate-400">Balikpapan &bull; Handil &bull; Bontang</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <aside aria-label="Informasi Pembaruan & Jadwal" class="w-full bg-red-500/10 border-b border-red-500/20 py-3 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-800 font-medium">
      <span class="inline-flex items-center gap-1.5 font-bold text-red-900">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Diperbarui November 2026 &bull; Kelas Balikpapan &amp; Kalimantan Timur:
      </span>
      <span class="text-slate-700">Tersedia kelas Public Offline Balikpapan, Blended Pra-Uji, dan In-House Yard Kontraktor.</span>
      <a
        href={waLink("Halo Kak, boleh minta jadwal uji kompetensi H2S BNSP di Balikpapan bulan ini?")}
        target="_blank"
        rel="noopener"
        class="text-red-700 hover:text-red-900 font-bold underline ml-1"
      >
        Cek Jadwal via WhatsApp &rarr;
      </a>
    </div>
  </aside>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Quick Answer + Quick Info Table -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-red-600 block">Ringkasan Jawaban Cepat</span>
        <h2 class="text-2xl font-serif font-bold text-slate-900">Apa Itu Pelatihan H2S BNSP di Balikpapan?</h2>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          <strong>Pelatihan Petugas Gas Beracun H2S Balikpapan</strong> adalah program pembekalan dan uji kompetensi resmi <strong>BNSP</strong> bagi personel industri migas, kilang, dan petrokimia di Kalimantan Timur. Selama 3 hari peserta mempelajari sifat toksikologi H2S, cara kerja detektor gas, pemakaian Work SCBA dan EEBA, serta teknik penyelamatan darurat untuk meraih sertifikat kompetensi berlogo Garuda Emas.
        </p>
        <div class="p-4 rounded-2xl bg-red-50 border border-red-200 text-xs text-red-950 leading-relaxed">
          <strong>Fakta Kritis di Lapangan:</strong> Pada konsentrasi &ge; 100 ppm, H2S melumpuhkan saraf penciuman secara instan sehingga bau telur busuk hilang—membuat pekerja mengira area sudah aman sebelum terjadi <em>knockdown</em>.
        </div>
      </div>

      <div class="lg:col-span-6 overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-slate-700">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th class="py-3.5 px-5">Informasi Utama</th>
              <th class="py-3.5 px-5">Spesifikasi Program Balikpapan</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Lembaga Penerbit</td>
              <td class="py-3 px-5">BNSP RI (via LSP Sektor Migas &amp; K3 Terlisensi)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Skema Kompetensi</td>
              <td class="py-3 px-5">Petugas Penanganan Bahaya Gas Beracun H2S</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Durasi &amp; Metode</td>
              <td class="py-3 px-5">3 Hari (Pembekalan Teori + Praktik Alat + Asesmen TUK)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Area Cakupan</td>
              <td class="py-3 px-5">Balikpapan, Kariangau, Handil, Senipah, Muara Badak, Bontang</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Estimasi Biaya</td>
              <td class="py-3 px-5 font-semibold text-red-700">Blended Rp5,5–6,8 jt &bull; Offline Balikpapan Rp7–9,5 jt</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Masa Berlaku</td>
              <td class="py-3 px-5">3 Tahun (Memenuhi syarat tender &amp; pass masuk site migas)</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Balikpapan & Kaltim Industry Demand -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-red-600 block mb-2">Konteks Industri Balikpapan</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Mengapa Sertifikasi H2S Wajib bagi Kontraktor Energi di Balikpapan &amp; Delta Mahakam?
        </h2>
        <div class="h-1 w-20 bg-red-500 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          Sebagai pusat logistik energi nasional di Kalimantan Timur, proyek pengembangan kilang (RDMP Balikpapan), pabrik petrokimia di Bontang, bengkel fabrikasi alat berat di Kariangau, serta operasi lapangan minyak dan gas di Cekungan Kutai dan Selat Makassar mewajibkan standar izin masuk (<em>site pass</em>) bebas insiden gas beracun.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-red-500/10 text-red-700 flex items-center justify-center font-bold text-xl">🔥</div>
          <h3 class="font-bold text-slate-900 text-lg">Zona <em>Turnaround</em> Kilang &amp; <em>Sour Service</em></h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Pekerjaan pembukaan flange pipa, pembersihan separator, tangki sludge, dan pengelasan di area kilang maupun fasilitas pemrosesan gas mengandung akumulasi H2S serta gas mudah terbakar yang wajib dipantau petugas berkompetensi resmi.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center font-bold text-xl">📋</div>
          <h3 class="font-bold text-slate-900 text-lg">Syarat Prakualifikasi CSMS Kontraktor</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Vendor penunjang migas di Sepinggan, Somber, Manggar, hingga Kariangau wajib membuktikan personel lapangannya memiliki sertifikat H2S BNSP yang sah pada evaluasi dokumen <a href="/contractor-safety-management-system-csms/" class="text-red-700 font-semibold underline">CSMS</a> dan pemeriksaan gate pass.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-slate-900/10 text-slate-900 flex items-center justify-center font-bold text-xl">🚑</div>
          <h3 class="font-bold text-slate-900 text-lg">Kesiapan Evakuasi Cepat (Zero-Fatality)</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Dalam kecelakaan H2S, penolong yang panik masuk tanpa mengenakan SCBA justru sering menjadi korban kedua. Pelatihan menekankan disiplin <em>buddy system</em>, zona aman arah angin, dan teknik penyelamatan terukur.
          </p>
        </div>
      </div>

      <div class="p-8 rounded-3xl bg-slate-900 text-white border border-white/10 space-y-5">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-amber-400">Klaster Layanan Kalimantan Timur</span>
            <h3 class="text-xl sm:text-2xl font-bold font-serif text-white mt-1">Wilayah Layanan Pelatihan &amp; TUK H2S Balikpapan Raya</h3>
          </div>
          <a
            href={waLink("Halo Kak, kami butuh jadwal In-House H2S BNSP untuk kru kontraktor kami di Balikpapan/Kaltim.")}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 rounded-xl bg-red-600 hover:bg-red-500 text-white font-semibold text-xs transition-colors whitespace-nowrap self-start md:self-auto"
          >
            Request Proposal In-House &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-300">
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Kariangau Industrial Estate (KIK)</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Koridor Sepinggan, Batakan &amp; Manggar</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Somber &amp; Pelabuhan Logistik Semayang</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Handil, Senipah &amp; Samboja</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Muara Badak &amp; Tanjung Santan</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Kawasan Petrokimia &amp; LNG Bontang</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Penajam Paser Utara &amp; Sepaku (IKN)</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Samarinda &amp; Kutai Kartanegara</div>
        </div>
      </div>
    </section>

    <!-- Section 3: Legal Basis & Toxicology Matrix -->
