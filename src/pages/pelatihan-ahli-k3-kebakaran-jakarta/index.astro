---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { waLink } from '../../data/contact.js';

const title = "Pelatihan Ahli K3 Kebakaran Jakarta Resmi Kemnaker";
const description = "Pelatihan Ahli K3 Kebakaran Jakarta resmi Kemnaker RI (Kelas D, C, B, A). Praktik APAR, hidran, proteksi gedung bertingkat & in-house korporasi.";
const canonical = "/pelatihan-ahli-k3-kebakaran-jakarta/";
const ogImage = "https://konsultank3.com/assets/images/pelatihan-ahli-k3-kebakaran-jakarta-hero.jpg";

const faqs = [
  {
    q: "Apa perbedaan Pelatihan K3 Kebakaran Kelas D, C, B, dan Ahli K3 Kebakaran (Kelas A) di Jakarta?",
    a: "Berdasarkan Kepmenaker No. KEP.186/MEN/1999: Kelas D adalah Petugas Peran Kebakaran tingkat dasar (wajib minimal 2 orang per 25 pekerja), Kelas C adalah Regu Penanggulangan Kebakaran lapangan, Kelas B adalah Koordinator Unit Penanggulangan Kebakaran, dan Kelas A adalah Ahli K3 Spesialis Penanggulangan Kebakaran yang menyusun evaluasi sistem proteksi aktif/pasif dan Emergency Response Plan gedung atau pabrik."
  },
  {
    q: "Berapa estimasi biaya Pelatihan Ahli K3 Kebakaran Jakarta resmi Kemnaker?",
    a: "Estimasi investasi tatap muka per peserta di Jakarta adalah Kelas D Rp4.500.000–Rp5.800.000 (3 hari), Kelas C Rp7.000.000–Rp9.200.000 (6 hari), Kelas B Rp7.500.000–Rp9.800.000 (6–7 hari), dan Kelas A (Ahli K3 Kebakaran) Rp8.500.000–Rp11.000.000. Tersedia pula paket berjenjang Kelas D–A (Rp24.000.000–Rp28.000.000) serta penawaran khusus In-House gedung atau pabrik."
  },
  {
    q: "Apakah untuk ikut Ahli K3 Kebakaran Kelas A harus lulus Kelas D, C, dan B terlebih dahulu?",
    a: "Ya. Sesuai ketentuan jenjang pembinaan penanggulangan kebakaran Kemnaker RI, peserta Kelas A (Ahli K3 Kebakaran) wajib memiliki sertifikat jenjang di bawahnya atau mengambil jalur paket terusan berjenjang D–C–B–A dengan pendidikan minimal D3/S1 teknik atau non-teknik."
  },
  {
    q: "Mengapa gedung perkantoran, hotel, rumah sakit, dan data center di Jakarta wajib memiliki personel berlisensi Kep.186/1999?",
    a: "Selain amanat Kepmenaker KEP.186/MEN/1999 dan pengawasan Disnakertransgi DKI Jakarta, bangunan gedung tinggi dan fasilitas publik di Jakarta wajib memenuhi standar pemeriksaan Dinas Penanggulangan Kebakaran dan Penyelamatan (Gulkarmat DKI) serta Perda DKI Jakarta No. 8 Tahun 2008 dalam penerbitan maupun perpanjangan Sertifikat Laik Fungsi (SLF) dan rekomendasi proteksi kebakaran."
  },
  {
    q: "Bagaimana skema praktik pemadaman api untuk peserta di wilayah Jakarta?",
    a: "Pelatihan tatap muka Jakarta melaksanakan simulasi langsung di lapangan praktik pemadaman api (fire ground) mitra PJK3, meliputi teknik pemadaman api awal dengan APAR berbagai media (dry chemical powder, CO2, foam), penggelaran selang dan pengoperasian nozzle hidran bertekanan, hingga formasi regu pemadam darurat."
  },
  {
    q: "Apakah bisa menyelenggarakan In-House Training K3 Kebakaran langsung di gedung CBD atau kawasan industri Pulogadung/Cakung?",
    a: "Bisa. Kami melayani program In-House Training resmi Kemnaker maupun drill kesiapsiagaan kebakaran langsung di halaman fasilitas gedung perkantoran Sudirman–Thamrin–Kuningan, TB Simatupang, rumah sakit, serta pabrik di JIEP Pulogadung, KBN Cakung, Marunda, dan Sunter."
  },
  {
    q: "Bagaimana cara memastikan sertifikat dan SKP Ahli K3 Kebakaran terdaftar sah?",
    a: "Seluruh pembinaan diselenggarakan bersama PJK3 resmi berizin Kemnaker RI. Sertifikat, Surat Keputusan Penunjukan (SKP), dan kartu lisensi kewenangan dilengkapi kode registrasi resmi yang dapat diverifikasi melalui portal TemanK3 Kemnaker RI."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "K3 Kebakaran Kemnaker", "item": "https://konsultank3.com/pelatihan-k3-kebakaran/" },
        { "@type": "ListItem", "position": 3, "name": "Ahli K3 Kebakaran Jakarta", "item": "https://konsultank3.com/pelatihan-ahli-k3-kebakaran-jakarta/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan Ahli K3 Kebakaran Jakarta Resmi Kemnaker RI (Kelas D, C, B, A)",
      "description": description,
      "courseCode": "K3-DAMKAR-JKT-KEMNAKER",
      "educationalCredentialAwarded": "Sertifikat, SKP & Lisensi Kewenangan Penanggulangan Kebakaran Kemnaker RI",
      "occupationalCategory": "Ahli K3 Kebakaran / Fire Safety Coordinator",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": "4500000",
        "highPrice": "11000000",
        "offerCount": "4"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": ["Onsite", "Blended"],
        "courseWorkload": "PT60H",
        "location": {
          "@type": "Place",
          "name": "Pusat Pelatihan & Fire Ground K3 Jakarta",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Jakarta",
            "addressRegion": "DKI Jakarta",
            "addressCountry": "ID"
          }
        }
      }
    },
    {
      "@type": "Service",
      "name": "Layanan Pelatihan & In-House Ahli K3 Kebakaran Wilayah DKI Jakarta",
      "serviceType": "Pembinaan & Sertifikasi Penanggulangan Kebakaran Kemnaker RI",
      "url": "https://konsultank3.com/pelatihan-ahli-k3-kebakaran-jakarta/",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com",
        "telephone": "+62-895-1025-3435"
      },
      "areaServed": [
        "Jakarta Pusat",
        "Jakarta Selatan",
        "Jakarta Timur",
        "Jakarta Utara",
        "Jakarta Barat",
        "Sudirman Thamrin Kuningan",
        "TB Simatupang",
        "Pulogadung",
        "KBN Cakung",
        "Sunter"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={pageSchema}
  presetMessage="Halo Kak, saya mau info jadwal dan biaya Pelatihan Ahli K3 Kebakaran Kemnaker di Jakarta."
>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">

      <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan-k3-kebakaran/" class="hover:text-amber-400 transition-colors">K3 Kebakaran</a>
        <span>/</span>
        <span class="text-slate-300">Ahli K3 Kebakaran Jakarta</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-rose-500/10 text-rose-400 text-xs font-semibold border border-rose-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-rose-400 animate-pulse-glow"></span>
            Kepmenaker No. KEP.186/MEN/1999 &bull; Gedung Tinggi &amp; Industri DKI Jakarta
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-rose-400 via-amber-300 to-orange-400">Ahli K3 Kebakaran Jakarta</span> Resmi Kemnaker
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Pembinaan berjenjang resmi Kementerian Ketenagakerjaan RI (Kelas D, C, B, hingga Ahli K3 Kebakaran Kelas A) untuk pengelola gedung bertingkat CBD, pusat perbelanjaan, rumah sakit, data center, dan pabrik di wilayah DKI Jakarta.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, saya mau info jadwal dan biaya Pelatihan Ahli K3 Kebakaran Kelas D/C/B/A di Jakarta.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Konsultasi Jadwal Jakarta</span>
              <span>&rarr;</span>
            </a>
            <a
              href="#biaya"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Biaya per Kelas &amp; Paket
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Jenjang Resmi</span>
              <p class="text-white font-bold text-sm">Kelas D, C, B &amp; A</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Praktik Lapangan</span>
              <p class="text-white font-bold text-sm">APAR, Hidran &amp; Fire Drill</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kepatuhan Gedung</span>
              <p class="text-white font-bold text-sm">SLF &amp; Audit Gulkarmat</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen Terbit</span>
              <p class="text-emerald-400 font-bold text-sm">Sertifikat, SKP &amp; Lisensi</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/pelatihan-ahli-k3-kebakaran-jakarta-hero.jpg"
              alt="Koordinator K3 kebakaran memeriksa instalasi hidran gedung bertingkat di Jakarta"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-rose-500 text-white mb-2">
                Building Safety &amp; Industrial Fire Unit
              </span>
              <div class="text-lg font-bold">Proteksi Kebakaran Gedung &amp; Pabrik Jakarta</div>
              <p class="text-xs text-slate-300 mt-1">
                Membentuk struktur organisasi tanggap darurat sesuai rasio karyawan Kepmenaker 186/1999.
              </p>
            </div>
          </div>

          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-rose-500 text-white flex items-center justify-center font-bold text-lg">✓</div>
            <div>
              <div class="text-xs font-bold text-white">SKP &amp; Lisensi Kemnaker</div>
              <div class="text-[10px] text-slate-400">Sah Secara Hukum</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🏢</div>
            <div>
              <div class="text-xs font-bold text-white">High-Rise &amp; Plant Ready</div>
              <div class="text-[10px] text-slate-400">CBD, Pulogadung, Cakung</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <aside aria-label="Informasi Pembaruan & Jadwal" class="w-full bg-rose-500/10 border-b border-rose-500/20 py-3 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-800 font-medium">
      <span class="inline-flex items-center gap-1.5 font-bold text-rose-950">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Diperbarui November 2026 &bull; Kelas Jakarta:
      </span>
      <span class="text-slate-700">Pembinaan tersedia per kelas satuan (D, C, B, A), paket terusan D–A, dan In-House Gedung/Pabrik.</span>
      <a
        href={waLink("Halo Kak, boleh minta jadwal batch K3 Kebakaran Jakarta bulan ini dan rincian syarat Kelas A?")}
        target="_blank"
        rel="noopener"
        class="text-rose-800 hover:text-rose-950 font-bold underline ml-1"
      >
        Cek Jadwal via WhatsApp &rarr;
      </a>
    </div>
  </aside>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Quick Answer + Quick Info Table -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-rose-600 block">Ringkasan Jawaban Cepat</span>
        <h2 class="text-2xl font-serif font-bold text-slate-900">Apa Itu Pelatihan Ahli K3 Kebakaran Jakarta?</h2>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          <strong>Pelatihan Ahli K3 Kebakaran Jakarta</strong> adalah pembinaan resmi berbasis <strong>Kepmenaker No. KEP.186/MEN/1999</strong> untuk membentuk unit penanggulangan kebakaran di gedung bertingkat dan kawasan industri DKI Jakarta. Tersedia jenjang <strong>Kelas D (3 hari)</strong>, <strong>Kelas C (6 hari)</strong>, <strong>Kelas B (6–7 hari)</strong>, hingga <strong>Ahli K3 Kebakaran Kelas A</strong> beserta praktik lapangan APAR dan hidran.
        </p>
        <div class="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-xs text-rose-950 leading-relaxed">
          <strong>Keterkaitan Audit Gedung:</strong> Kesiapan unit kebakaran berlisensi juga memengaruhi pemenuhan pemeriksaan berkala Dinas Gulkarmat DKI dan studi <a href="/fire-risk-assessment/" class="font-bold underline">Fire Risk Assessment</a> bangunan komersial maupun pabrik.
        </div>
      </div>

      <div class="lg:col-span-6 overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-slate-700">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th class="py-3.5 px-5">Informasi Utama</th>
              <th class="py-3.5 px-5">Detail Program Jakarta</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Lembaga Penerbit</td>
              <td class="py-3 px-5">Kementerian Ketenagakerjaan RI (via PJK3 Resmi)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Dasar Regulasi</td>
              <td class="py-3 px-5">Kepmenaker KEP.186/MEN/1999 &amp; Perda DKI 8/2008</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Jenjang Kelas</td>
              <td class="py-3 px-5">Kelas D (Petugas), C (Regu), B (Koordinator), A (Ahli K3)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Durasi Pembinaan</td>
              <td class="py-3 px-5">3 hari (Kelas D) hingga 6–7 hari per jenjang lanjutan</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Estimasi Biaya</td>
              <td class="py-3 px-5 font-semibold text-rose-700">Kelas D mulai Rp4,5 jt &bull; Kelas A Rp8,5–11 jt</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Output Legalitas</td>
              <td class="py-3 px-5">Sertifikat Resmi, SKP Penunjukan &amp; Kartu Lisensi K3</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Jakarta Local Context -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-rose-600 block mb-2">Konteks Proteksi Jakarta</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Mengapa Gedung Tinggi &amp; Kawasan Industri Jakarta Wajib Membentuk Unit K3 Kebakaran?
        </h2>
        <div class="h-1 w-20 bg-rose-500 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          DKI Jakarta memiliki konsentrasi gedung pencakar langit, pusat perbelanjaan, hotel bintang lima, rumah sakit rujukan nasional, data center, dan fasilitas pergudangan padat di Jakarta Timur serta Jakarta Utara. Kompleksitas evakuasi vertikal dan instalasi kelistrikan berkapasitas besar menjadikan kesiapan tim kebakaran terlatih sebagai garis pertahanan pertama sebelum pemadam kota tiba.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-rose-500/10 text-rose-700 flex items-center justify-center font-bold text-xl">🏙️</div>
          <h3 class="font-bold text-slate-900 text-lg">Kepatuhan SLF &amp; Pemeriksaan Gulkarmat</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Pengelola bangunan gedung di Sudirman, Thamrin, Kuningan, hingga TB Simatupang membutuhkan penanggung jawab kebakaran berlisensi Kemnaker untuk mendukung audit manajemen proteksi kebakaran dan pembaruan Sertifikat Laik Fungsi (SLF).
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center font-bold text-xl">🏭</div>
          <h3 class="font-bold text-slate-900 text-lg">Risiko Gudang, Pabrik &amp; Data Center</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Kawasan industri JIEP Pulogadung, KBN Cakung–Marunda, dan Sunter menyimpan material mudah terbakar, genset berkapasitas megawatt, serta panel distribusi listrik yang memerlukan koordinasi regu kebakaran (Kelas C) dan Ahli K3 (Kelas A).
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 text-emerald-700 flex items-center justify-center font-bold text-xl">⚖️</div>
          <h3 class="font-bold text-slate-900 text-lg">Rasio Wajib Kepmenaker 186/1999</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Setiap tempat kerja wajib menetapkan minimal <strong>2 Petugas Peran Kebakaran (Kelas D) untuk setiap 25 tenaga kerja</strong>, dilengkapi regu penanggulangan dan koordinator sesuai klasifikasi tingkat potensi bahaya ringan, sedang, maupun berat.
          </p>
        </div>
      </div>

      <div class="p-8 rounded-3xl bg-slate-900 text-white border border-white/10 space-y-5">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
          <div>
            <span class="text-xs font-mono uppercase tracking-widest text-amber-400">Cakupan Wilayah DKI Jakarta</span>
            <h3 class="text-xl sm:text-2xl font-bold font-serif text-white mt-1">Koridor Layanan Public &amp; In-House Kebakaran Jakarta</h3>
          </div>
          <a
            href={waLink("Halo Kak, kami mau adakan In-House Training K3 Kebakaran untuk manajemen gedung/pabrik kami di Jakarta.")}
            target="_blank"
            rel="noopener"
            class="px-5 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-semibold text-xs transition-colors whitespace-nowrap self-start md:self-auto"
          >
            Ajukan In-House Jakarta &rarr;
          </a>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs text-slate-300">
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">CBD Sudirman, Thamrin &amp; SCBD</div>
          <div class="p-3 rounded-xl bg-white/5 border border-white/10 font-medium">Kuningan, Gatot Subroto &amp; Kemayoran</div>
