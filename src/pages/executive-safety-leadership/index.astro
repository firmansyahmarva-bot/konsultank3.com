---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Executive Safety Leadership & Risk Governance K3";
const description = "Executive workshop safety leadership dan tata kelola risiko K3 untuk Direksi, General Manager, dan HSE Committee: Felt Leadership serta kurva Bradley.";
const canonical = "/executive-safety-leadership/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Budaya Keselamatan", "item": "https://konsultank3.com/safety-culture-assessment/" },
        { "@type": "ListItem", "position": 3, "name": "Executive Safety Leadership", "item": "https://konsultank3.com/executive-safety-leadership/" }
      ]
    },
    {
      "@type": "Service",
      "name": "Executive Safety Leadership & Risk Governance Corporate Program",
      "serviceType": "Executive Coaching & Safety Governance Workshop",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Mengapa program safety leadership dikhususkan untuk C-Suite dan Direksi?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Budaya K3 tidak dapat terbangun hanya dari level bawah jika pimpinan puncak tidak menunjukkan komitmen yang terasa (Felt Leadership). Keputusan alokasi anggaran, target produksi, dan respon pimpinan terhadap insiden menentukan apakah keselamatan kerja benar-benar menjadi nilai inti (core value) atau sekadar slogan."
          }
        },
        {
          "@type": "Question",
          "name": "Apa yang dimaksud dengan Felt Leadership?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Felt Leadership adalah kepemimpinan keselamatan kerja di mana kepedulian dan komitmen manajemen puncak dapat dirasakan secara langsung oleh pekerja garda depan melalui tindakan nyata, kehadiran fisik di lapangan, percakapan bermakna, dan keputusan yang mengutamakan keselamatan di atas kecepatan produksi."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana workshop ini diintegrasikan dengan program Safety Culture Assessment?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Program workshop eksekutif ini idealnya diselenggarakan sebagai tindak lanjut langsung dari hasil diagnosis Safety Culture & Climate Assessment, di mana gap kematangan budaya diterjemahkan menjadi rencana aksi kepemimpinan (Executive Safety Charter) dan roadmap tata kelola 12 bulan."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/safety-culture-assessment/" class="hover:text-amber-400 transition-colors">Budaya Keselamatan</a>
        <span>/</span>
        <span class="text-slate-300">Executive Safety Leadership</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Program Khusus Direksi, General Manager &amp; HSE Committee
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Executive Safety Leadership &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Risk Governance K3</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Workshop kepemimpinan keselamatan kerja tingkat tinggi: mentransformasikan komitmen pimpinan puncak menjadi <em>Felt Leadership</em>, membangun <em>Just Culture</em>, dan menyusun roadmap tata kelola risiko untuk menembus tahap interdependen kurva Bradley.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, kami membutuhkan proposal executive workshop Safety Leadership & Risk Governance untuk jajaran Direksi dan GM")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Diskusi TOR Eksekutif via WhatsApp &rarr;
            </a>
            <a
              href="#modul-leadership"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              4 Modul Inti Workshop
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Audiens Target</span>
              <p class="text-white font-bold text-sm">Board, GMs &amp; VP HSE</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Model Acuan</span>
              <p class="text-white font-bold text-sm">DuPont Bradley Curve</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Format Sesi</span>
              <p class="text-white font-bold text-sm">Retreat &amp; Boardroom</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Hasil Nyata</span>
              <p class="text-emerald-400 font-bold text-sm">Safety Charter &amp; KPI</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Executive Safety Leadership Workshop Direksi dan Komite K3 Perusahaan"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Tone from the Top
              </span>
              <div class="text-lg font-bold">Kultur K3 Dimulai dari Meja Direksi</div>
              <p class="text-xs text-slate-300 mt-1">Bukan sekadar pidato seremoni, melainkan keputusan bisnis dan teladan nyata sehari-hari.</p>
            </div>
          </div>

          <!-- Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">Felt Leadership</div>
              <div class="text-[10px] text-slate-400">Kepemimpinan Terasa di Lapangan</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">📈</div>
            <div>
              <div class="text-xs font-bold text-white">Leading KPI Metrics</div>
              <div class="text-[10px] text-slate-400">Pengawasan Risiko Proaktif</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Rich Leadership Guide (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section: Mengapa Leadership Menjadi Kunci -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Tata Kelola Risiko Eksekutif</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Mengapa Budaya Keselamatan Tidak Dapat Didelegasikan Hanya ke Tim HSE?
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            Dalam banyak organisasi, program K3 sering kali diperlakukan sebatas kepatuhan administratif di pundak Manajer HSE. Namun, ketika target volume produksi berbenturan dengan prosedur keselamatan, pekerja di garis depan akan selalu menatap ke atas: <em>apa yang sesungguhnya dipedulikan oleh Direksi dan General Manager?</em>
          </p>

          <p class="text-slate-700 leading-relaxed">
            Jika pimpinan hanya menuntut penurunan angka kecelakaan (Zero LTI) tanpa menyediakan sumber daya yang memadai, pekerja cenderung menyembunyikan kejadian nyaris celaka (<em>under-reporting</em>). Kondisi ini menciptakan ilusi keselamatan semu hingga akhirnya kecelakaan fatal (fatality) terjadi secara mendadak.
          </p>

          <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-3">
            <div class="flex items-center gap-2 text-slate-900 font-bold text-sm">
              <span class="text-lg">⚖️</span>
              Akuntabilitas Hukum Pengurus (UU No. 1 Tahun 1970)
            </div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              Pasal 1 ayat (2) dan Pasal 15 Undang-Undang No. 1 Tahun 1970 secara eksplisit menetapkan bahwa tanggung jawab pidana atas ditaatinya norma K3 berada pada pundak <strong>Pengurus (Direksi / Pimpinan Operasional)</strong>, bukan semata-mata staf keselamatan kerja.
            </p>
          </div>
        </section>

        <!-- Section: 4 Modul Inti Workshop -->
        <section id="modul-leadership" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Kurikulum Eksekutif</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              4 Modul Inti Workshop Executive Safety Leadership
            </h2>
          </div>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                01
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Modul 1: Felt Leadership &amp; Behavioral Visibility</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Melatih pimpinan puncak mempraktikkan kepemimpinan yang dapat dirasakan nyata oleh karyawan. Fokus pada teknik <em>Leadership Safety Walk &amp; Talk (LSWT)</em> yang autentik—yaitu berjalan ke lantai pabrik untuk berdialog empatik mengenai kendala kerja, bukan inspeksi birokratis mencari kesalahan bawahan.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                02
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Modul 2: Transformasi Kematangan Budaya (DuPont Bradley Curve)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Membedah posisi organisasi Anda pada 4 tingkatan kematangan kurva Bradley: <em>Reactive</em> (naluri alami), <em>Dependent</em> (patuh karena diawasi mandor), <em>Independent</em> (kesadaran diri), hingga <em>Interdependent</em> (budaya saling menjaga antarrekan kerja dan zero accident berkelanjutan).
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                03
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Modul 3: Membangun Just Culture &amp; Keamanan Psikologis</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Menghilangkan budaya saling menyalahkan (<em>blame culture</em>) yang mematikan pelaporan insiden. Menyusun pedoman Just Culture yang membedakan secara tegas antara kesalahan manusiawi yang jujur (human error), penyimpangan prosedural karena tekanan operasional, dan perilaku kecerobohan yang disengaja (reckless behavior).
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                04
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Modul 4: Risk Governance &amp; Metriks Kinerja Leading vs Lagging</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Menggeser fokus rapat evaluasi Direksi dari indikator lampau (lagging indicators seperti LTI dan Severity Rate) ke indikator proaktif (leading indicators): rasio penutupan temuan audit, frekuensi MOC yang ditinjau, kecepatan penyelesaian bahaya, dan keterlibatan manajemen di lapangan.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section: Format Sesi & Deliverables -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Paket Program</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Format Pelaksanaan &amp; Luaran Resmi Program
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">🏛️ 1-Day Boardroom Session</div>
              <p class="text-xs text-slate-600">Simulasi krisis pengambilan keputusan eksekutif, studi kasus insiden global, dan penetapan kebijakan keselamatan strategis.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">🌲 2-Day Executive Leadership Retreat</div>
              <p class="text-xs text-slate-600">Fasilitasi intensif di luar kantor untuk merumuskan Executive Safety Charter, resolusi budaya K3, dan target transformasi antardepartemen.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">📜 Executive Safety Charter</div>
              <p class="text-xs text-slate-600">Piagam komitmen keselamatan resmi yang ditandatangani seluruh jajaran Direksi sebagai komitmen moral dan hukum perusahaan.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">🗺️ Roadmap Transformasi Budaya 12 Bulan</div>
              <p class="text-xs text-slate-600">Rencana aksi terstruktur bulanan yang menetapkan penanggung jawab, jadwal safety walk pimpinan, dan matriks evaluasi triwulanan.</p>
            </div>
          </div>
        </section>

        <!-- Section: FAQ -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">FAQ</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Pertanyaan yang Sering Diajukan Seputar Executive Safety Leadership
            </h2>
          </div>

          <div class="space-y-3">
            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Siapa fasilitator yang memimpin workshop eksekutif ini?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Sesi ini difasilitasi oleh Principal Consultant senior kami yang memiliki pengalaman lebih dari 20 tahun memimpin keselamatan kerja di level multinasional dan BUMN, terbiasa berinteraksi dengan Board of Directors, serta memahami dinamika tata kelola bisnis korporat.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apakah program ini cocok untuk perusahaan yang sedang mengalami peningkatan tren insiden?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Sangat tepat. Ketika kecelakaan terus berulang meskipun prosedur sudah lengkap, masalahnya hampir selalu terletak pada kepemimpinan, kepatuhan perilaku, dan komunikasi hierarkis. Workshop ini membongkar akar masalah tersebut secara konstruktif dan solutif.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Bagaimana mengukur keberhasilan program ini pasca-workshop?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Keberhasilan dievaluasi secara berkala (triwulanan) melalui: (1) Ketercapaian jadwal Leadership Safety Walk Direksi, (2) Peningkatan signifikan pada pelaporan near-miss oleh pekerja lapangan (tanda meningkatnya kepercayaan psikologis), dan (3) Evaluasi ulang skor kematangan melalui survei Safety Climate.
              </p>
            </details>
          </div>
        </section>

      </article>

      <!-- Right Sidebar: Inquiries (4 cols) -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-24">
        
        <!-- B2B Proposal Box -->
        <div class="p-6 rounded-2xl bg-slate-900 text-white border border-white/10 shadow-xl space-y-4">
          <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md bg-amber-500/20 text-amber-400 text-xs font-semibold">
            <span class="w-2 h-2 rounded-full bg-amber-400"></span>
            Executive Workshop Proposal
          </div>

          <h3 class="text-lg font-bold text-white">Rencanakan Sesi Khusus Board of Directors</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Konsultasikan profil industri, tantangan budaya keselamatan, dan agenda manajemen Anda bersama Lead Consultant kami.
          </p>

          <a
            href={waLink("Halo KonsultanK3, kami ingin berdiskusi mengenai TOR executive workshop Safety Leadership & Risk Governance untuk Direksi dan GM")}
            target="_blank"
            rel="noopener"
            class="block w-full text-center py-3.5 px-4 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition-colors shadow-lg shadow-emerald-600/30"
          >
            Konsultasi via WhatsApp &rarr;
          </a>

          <div class="text-[11px] text-slate-400 text-center">
            Kerahasiaan Tingkat Tinggi Terjamin
          </div>
        </div>

        <!-- Related Corporate Pillars -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Layanan Terkait</h3>
          <ul class="text-xs space-y-2.5">
            <li>
              <a href="/safety-culture-assessment/" class="text-slate-700 hover:text-amber-600 font-semibold block">
                &rarr; Safety Culture &amp; Climate Assessment
              </a>
            </li>
            <li>
              <a href="/panduan-penerapan-smk3/" class="text-slate-700 hover:text-amber-600 font-semibold block">
                &rarr; Panduan Penerapan SMK3 PP 50/2012
              </a>
            </li>
            <li>
              <a href="/konsultasi-integrated-management-system/" class="text-slate-700 hover:text-amber-600 font-semibold block">
                &rarr; Konsultasi Integrated Management System (IMS)
              </a>
            </li>
            <li>
              <a href="/management-of-change-k3/" class="text-slate-700 hover:text-amber-600 font-semibold block">
                &rarr; Prosedur Management of Change (MOC)
              </a>
            </li>
            <li>
              <a href="/jasa-konsultasi-hazop/" class="text-slate-700 hover:text-amber-600 font-semibold block">
                &rarr; Studi HAZOP &amp; Process Safety Fasilitas
              </a>
            </li>
          </ul>
        </div>

        <!-- Downloads -->
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-4">
          <h3 class="text-sm font-bold text-slate-900 uppercase tracking-wider">Instrumen K3 Terkait</h3>
          <ul class="text-xs space-y-2.5">
            <li>
              <a href="/materi-safety-talk-harian/" class="text-slate-700 hover:text-amber-600 font-semibold block">
                &rarr; Kumpulan Materi Safety Talk Harian (P5M)
              </a>
