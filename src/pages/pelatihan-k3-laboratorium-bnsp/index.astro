---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Pelatihan & Sertifikasi Petugas K3 Laboratorium BNSP (Biosafety Officer)";
const description = "Sertifikasi resmi Petugas K3 Laboratorium BNSP. Kuasai pengelolaan bahan kimia reaktif B3, standar biosafety BSL-1 s.d. BSL-3, spill kit kimia, dan ISO/IEC 17025.";
const canonical = "/pelatihan-k3-laboratorium-bnsp/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pelatihan K3", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "K3 Laboratorium (Biosafety)", "item": "https://konsultank3.com/pelatihan-k3-laboratorium-bnsp/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan & Sertifikasi Petugas K3 Laboratorium & Biosafety Officer BNSP",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "educationalCredentialAwarded": "Sertifikat Kompetensi BNSP - Petugas K3 Laboratorium (Garuda Emas)",
      "occupationalCategory": "Laboratory Safety Specialist / Biosafety Officer",
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "Blended / Online / In-House Lab",
        "courseWorkload": "PT32H"
      }
    },
    {
      "@type": "Service",
      "name": "Audit Keselamatan Lab & In-House Training K3 Laboratorium Kimia / Biologi",
      "serviceType": "Laboratory Safety & Biosafety Containment Certification",
      "description": "Layanan in-house pembinaan keselamatan laboratorium pengujian, QC manufaktur, farmasi, dan R&D sesuai ISO/IEC 17025 dan WHO Laboratory Biosafety Manual di Cikarang, Karawang, Cilegon, Surabaya, dan Jakarta.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa tugas utama seorang Petugas K3 Laboratorium bersertifikat BNSP?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Petugas K3 Laboratorium bertanggung jawab memastikan bahwa penanganan bahan kimia berbahaya (B3), agen biologis/mikroorganisme patogen, gas bertekanan, dan limbah sisa pengujian berjalan sesuai standar keselamatan internasional. Tugasnya meliputi pengawasan operasional lemari asam (fume hood), Biosafety Cabinet (BSC), penanganan tumpahan kimia/biologis (spill kit), serta pemenuhan klausul keselamatan pada ISO/IEC 17025 dan ISO 15189."
          }
        },
        {
          "@type": "Question",
          "name": "Apa perbedaan antara Biosafety dan Biosecurity di laboratorium?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Biosafety mengacu pada prinsip penahanan (containment), teknologi, dan praktik kerja yang diterapkan untuk mencegah paparan tidak disengaja terhadap patogen dan racun biologis kepada analis atau lingkungan. Sedangkan Biosecurity mengacu pada langkah-langkah keamanan institusional dan fisik untuk mencegah kehilangan, pencurian, penyalahgunaan, atau pelepasan sengaja agen biologi berbahaya oleh pihak yang tidak berwenang."
          }
        },
        {
          "@type": "Question",
          "name": "Apa saja level Biosafety (BSL) yang dipelajari dalam sertifikasi ini?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Peserta mempelajari Biosafety Level 1 (BSL-1: agen risiko rendah), BSL-2 (agen patogen sedang seperti Salmonella, Hepatitis, influenza yang membutuhkan BSC Class II), BSL-3 (agen infeksius udara berisiko tinggi seperti TB dengan fasilitas tekanan udara negatif terkontrol), hingga pengenalan prinsip BSL-4 untuk patogen paling mematikan."
          }
        },
        {
          "@type": "Question",
          "name": "Mengapa laboratorium pengujian wajib memiliki personel bersertifikat K3 Lab?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Dalam proses akreditasi laboratorium oleh Komite Akreditasi Nasional (KAN) berbasis SNI ISO/IEC 17025:2017 klausul 6.3 tentang fasilitas dan kondisi lingkungan, laboratorium wajib menjamin keselamatan personel dari bahaya kimia, kebakaran, dan kontaminasi silang. Personel K3 yang kompeten menjamin kepatuhan audit KAN dan meminimalkan insiden ledakan/keracunan bahan kimia."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah pelatihan bisa dilakukan in-house langsung di laboratorium perusahaan kami?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Sangat bisa. Kami melayani In-House Training K3 Laboratorium langsung di fasilitas lab industri farmasi, petrokimia, pangan, mikrobiologi, maupun lab kampus di kawasan Cikarang, Karawang, Cilegon, Surabaya, Gresik, Medan, dan Bandung."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Header -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Pelatihan K3</a>
        <span>/</span>
        <span class="text-slate-300">K3 Laboratorium (Biosafety)</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 text-cyan-400 text-xs font-semibold border border-cyan-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse-glow"></span>
            SNI ISO/IEC 17025 &bull; Sertifikasi BNSP Resmi
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-sky-300 to-blue-400">Petugas K3 Laboratorium &amp; Biosafety</span> BNSP
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Kuasai penanganan bahan kimia reaktif B3, manajemen tumpahan beracun (*chemical spill kit*), pencegahan ledakan uap pelarut, dan sistem penahanan biosafety BSL-1 s.d. BSL-3 berstandar WHO &amp; KAN ISO 17025.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, saya mau konsultasi pendaftaran Pelatihan & Uji Kompetensi K3 Laboratorium BNSP. Mohon jadwal terdekat dan penawaran in-house laboratorium.")}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-400 hover:to-blue-500 text-slate-950 font-bold text-sm shadow-lg shadow-cyan-500/20 transition-all transform hover:-translate-y-0.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Konsultasi K3 Laboratorium
            </a>
            <a
              href="#matriks-bsl"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/10 transition-colors"
            >
              Cek Matriks BSL 1 - 4
            </a>
          </div>
        </div>

        <!-- Right Column: Profile Card -->
        <div class="lg:col-span-5">
          <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-white/10 backdrop-blur-sm shadow-2xl space-y-6">
            <h3 class="font-serif text-lg font-bold text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-cyan-400"></span>
              Profil Kualifikasi Petugas K3 Lab
            </h3>
            
            <dl class="space-y-4 text-xs sm:text-sm">
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Badan Sertifikasi</dt>
                <dd class="text-white font-semibold text-right">BNSP via LSP Terakreditasi</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Acuan Internasional</dt>
                <dd class="text-cyan-300 font-semibold text-right">ISO/IEC 17025 &amp; WHO Biosafety</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Fokus Pengendalian</dt>
                <dd class="text-white font-semibold text-right">Chemical B3, Biohazard, Fume Hood</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Masa Berlaku Sertifikat</dt>
                <dd class="text-white font-semibold text-right">3 Tahun (Berlogo Garuda Emas)</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Sektor Pengguna</dt>
                <dd class="text-sky-400 font-semibold text-right">QC Industri, Farmasi, Riset Lab</dd>
              </div>
            </dl>

            <div class="pt-2">
              <div class="p-3.5 rounded-xl bg-cyan-500/10 border border-cyan-500/20 text-xs text-cyan-200 leading-relaxed">
                <strong>Standar Akreditasi KAN:</strong> Personel laboratorium yang memiliki sertifikat kompetensi K3 resmi merupakan bukti pemenuhan keselamatan fasilitas uji pada surveilen berkala akreditasi KAN ISO/IEC 17025.
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Navigation Anchor Strip -->
  <div class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm text-xs sm:text-sm font-medium">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto gap-6 py-3 scrollbar-none text-slate-600">
      <a href="#urgensi" class="hover:text-cyan-600 whitespace-nowrap">Urgensi K3 Lab</a>
      <a href="#matriks-bsl" class="hover:text-cyan-600 whitespace-nowrap text-cyan-700 font-bold">Matriks Biosafety BSL 1-4</a>
      <a href="#chemical-segregation" class="hover:text-cyan-600 whitespace-nowrap">Penyimpanan B3 &amp; Inkompatibilitas</a>
      <a href="#unit-kompetensi" class="hover:text-cyan-600 whitespace-nowrap">Unit Uji SKKNI</a>
      <a href="#kawasan-industri" class="hover:text-cyan-600 whitespace-nowrap">In-House Lab Kawasan Industri</a>
      <a href="#faq" class="hover:text-cyan-600 whitespace-nowrap">FAQ</a>
    </div>
  </div>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Urgensi K3 Laboratorium -->
    <section id="urgensi" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-8 space-y-6 text-slate-700 leading-relaxed text-base">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 block">Kompilasi Bahaya Kimia &amp; Biologis</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Mengapa Laboratorium Membutuhkan Petugas K3 Bersertifikasi Khusus?
        </h2>
        <p>
          Laboratorium kimia dan biologi adalah salah satu lingkungan kerja paling dinamis sekaligus paling berbahaya. Di dalam ruangan berpendingin udara tertutup, analis bekerja berdampingan dengan zat karsinogenik, bahan mudah meledak (*flammable solvents*), uap asam pekat, serta kultur mikroorganisme patogen.
        </p>
        <p>
          Kegagalan dalam pengelolaan lemari asam (*fume hood*), kesalahan mencampur limbah kimia yang tidak cocok (*incompatible chemicals*), atau malfungsi Biosafety Cabinet dapat berujung pada ledakan dahsyat, keracunan fatal analis, atau pelepasan agen biologis berbahaya ke lingkungan sekitar.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-cyan-500/10 text-cyan-600 flex items-center justify-center font-bold text-sm">01</div>
            <h4 class="font-bold text-slate-900 text-sm">Mencegah Ledakan &amp; Reaksi Kimia Eksotermik</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Memahami matriks kompatibilitas penyimpanan reagen kimia dan prosedur pembuangan limbah sisa preparasi sampel tanpa memicu kebakaran.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-blue-500/10 text-blue-600 flex items-center justify-center font-bold text-sm">02</div>
            <h4 class="font-bold text-slate-900 text-sm">Pemenuhan Audit KAN ISO/IEC 17025</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Menjamin kepatuhan klausul 6.3 tentang kondisi lingkungan pengujian, kalibrasi sensor gas lab, eyewash/emergency shower, dan sertifikasi personel.
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4 p-6 rounded-3xl bg-slate-900 text-white space-y-5 border border-slate-800 shadow-xl">
        <h3 class="font-serif text-lg font-bold text-cyan-400">Target Profil Laboratorium</h3>
        <ul class="space-y-3 text-xs leading-relaxed text-slate-300">
          <li class="pb-2 border-b border-white/10">
            <strong class="text-white block">Lab QC Manufaktur:</strong> Industri petrokimia, cat/pelapis, polimer, makanan-minuman, dan otomotif.
          </li>
          <li class="pb-2 border-b border-white/10">
            <strong class="text-white block">Lab Industri Farmasi &amp; Kosmetik:</strong> Menangani bahan baku obat murni, pengujian mikrobiologi, dan sterilitas.
          </li>
          <li class="pb-2 border-b border-white/10">
            <strong class="text-white block">Lab Kalibrasi &amp; Lingkungan:</strong> Laboratorium rujukan pihak ketiga terakreditasi KAN.
          </li>
          <li>
            <strong class="text-white block">Lab Riset Kampus &amp; RS:</strong> Laboratorium riset bioteknologi molekuler dan patologi klinik.
          </li>
        </ul>
      </div>
    </section>

    <!-- Section 2: Matriks Biosafety BSL 1 - 4 -->
    <section id="matriks-bsl" class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 block">Standar Penahanan Biologis (Biosafety Containment)</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Matriks Tingkat Biosafety Laboratorium (BSL-1 s.d. BSL-4)
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Sesuai panduan WHO Laboratory Biosafety Manual dan regulasi penanganan agen biologi berbahaya:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-800 text-xs font-bold inline-block">BSL-1</span>
          <h3 class="font-bold text-slate-900 text-base">Risiko Minimal</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Menangani agen biologi yang tidak menyebabkan penyakit pada manusia dewasa sehat (contoh: <em>E. coli K12, Bacillus subtilis</em>). Praktik mikrobiologi standar pada meja terbuka, wastafel cuci tangan, dan jas lab.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-cyan-50/50 border border-cyan-200 shadow-sm space-y-3">
          <span class="px-2.5 py-1 rounded-full bg-cyan-100 text-cyan-800 text-xs font-bold inline-block">BSL-2</span>
          <h3 class="font-bold text-slate-900 text-base">Risiko Sedang (Patogenik)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Menangani patogen yang dapat menyebabkan penyakit jika tertusuk atau tertelan (contoh: <em>Salmonella, Hepatitis B, Staphylococcus</em>). Wajib menggunakan Biosafety Cabinet (BSC Class II), autoklaf limbah, dan akses terkontrol.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-sky-50/60 border border-sky-300 shadow-sm space-y-3">
          <span class="px-2.5 py-1 rounded-full bg-sky-100 text-sky-800 text-xs font-bold inline-block">BSL-3</span>
          <h3 class="font-bold text-slate-900 text-base">Risiko Tinggi (Aerosol)</h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            Menangani agen berbahaya dengan transmisi melalui aerosol pernapasan yang berpotensi mematikan (contoh: <em>Mycobacterium tuberculosis, SARS-CoV-2</em>). Tekanan udara ruangan negatif, filtrasi HEPA ganda, dan pintu ganda interlock.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-slate-900 text-white shadow-sm space-y-3">
          <span class="px-2.5 py-1 rounded-full bg-red-600 text-white text-xs font-bold inline-block">BSL-4</span>
          <h3 class="font-bold text-white text-base">Risiko Ekstrem (Fatal)</h3>
          <p class="text-xs text-slate-300 leading-relaxed">
            Menangani patogen mematikan tanpa ada vaksin atau obat pengobatan (contoh: virus Ebola, Marburg). Fasilitas isolasi total, analis mengenakan setelan pakaian bertekanan positif (*positive pressure suit*) berventilasi udara luar.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Chemical Incompatibility & Spill Kit -->
    <section id="chemical-segregation" class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      <div class="p-8 rounded-3xl bg-slate-900 text-white space-y-4 border border-slate-800 shadow-xl">
        <span class="text-xs font-mono font-bold text-cyan-400 uppercase tracking-wider block">Manajemen Penyimpanan Bahan Kimia B3</span>
        <h3 class="font-serif text-xl font-bold text-white">Aturan Matriks Pemisahan Reagen (Incompatibility)</h3>
        <p class="text-xs text-slate-300 leading-relaxed">
          Penyimpanan bahan kimia di rak lab tidak boleh disusun berdasarkan urutan alfabet semata! Peserta diajarkan segregasi fisiko-kimiawi:
        </p>
        <ul class="space-y-2 text-xs text-slate-400">
          <li>&bull; <strong class="text-white">Asam Anorganik Kuat</strong> (HCl, H2SO4) dilarang disimpan bersama Basa Kuat (NaOH) atau Pelarut Organik.</li>
          <li>&bull; <strong class="text-white">Bahan Oksidator</strong> (Asam Nitrat, Hidrogen Peroksida) wajib dipisahkan dari zat mudah terbakar (*flammable liquids*).</li>
          <li>&bull; <strong class="text-white">Bahan Reaktif Air</strong> (Natrium, Kalium) wajib disimpan dalam lemari kedap udara bebas percikan air.</li>
          <li>&bull; <strong class="text-white">Bahan Penghasil Gas Beracun</strong> (Sianida, Sulfida) dilarang bersentuhan dengan senyawa asam.</li>
        </ul>
      </div>

      <div class="p-8 rounded-3xl bg-white border border-slate-200 shadow-xl space-y-4">
        <span class="text-xs font-mono font-bold text-blue-600 uppercase tracking-wider block">Tanggap Darurat Laboratorium</span>
        <h3 class="font-serif text-xl font-bold text-slate-900">SOP Tumpahan Kimia (Chemical Spill Kit)</h3>
        <p class="text-xs text-slate-600 leading-relaxed">
          Ketika botol reagen asam pekat atau pelarut mudah meledak pecah di lantai laboratorium, langkah penanganan detik pertama menentukan keselamatan seluruh gedung:
        </p>
        <ul class="space-y-2 text-xs text-slate-600">
          <li>&check; Evakuasi analis dan aktifkan ventilasi darurat lemari asam.</li>
          <li>&check; Gunakan respirator uap organik / acid gas dan sarung tangan nitril tebal.</li>
          <li>&check; Batasi area tumpahan dengan bantal penyerap (*chemical spill sock*).</li>
          <li>&check; Taburkan penetral asam/basa (*neutralizer agent*) sebelum diserap dengan pad khusus.</li>
          <li>&check; Masukkan limbah ke dalam drum penampung B3 berlabel limbah reaktif.</li>
        </ul>
      </div>
    </section>

    <!-- Section 4: Kawasan Industri Coverage -->
    <section id="kawasan-industri" class="space-y-6">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-cyan-600 block">Jangkauan Kawasan Industri</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Layanan Pelatihan &amp; Audit K3 Lab di Sentra Manufaktur
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Konsultan K3 Indonesia memfasilitasi program sertifikasi Public Class daring serta <strong>In-House Training tatap muka langsung di laboratorium perusahaan Anda</strong>:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h4 class="font-bold text-slate-900 text-base">Jawa Barat &amp; Banten</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Cikarang (Kawasan GIIC, MM2100, EJIP), Karawang (KIIC, Surya Cipta), Cilegon (Petrokimia), Tangerang, dan Bogor.
