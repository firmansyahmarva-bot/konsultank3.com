      <span class="text-xs font-bold uppercase tracking-wider text-emerald-600 block mb-1">Rangkaian Pembahasan</span>
      <h3 class="font-serif text-2xl font-bold text-slate-900">
        Artikel Pembahasan Standar Alat Pelindung Diri (APD)
      </h3>
      <p class="text-xs sm:text-sm text-slate-600 mt-1">
        Kumpulan panduan teknis, template dokumen keselamatan, dan artikel rujukan terkait implementasi APD di tempat kerja:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {mappedArticles.map((art) => (
        <a
          href={art.path}
