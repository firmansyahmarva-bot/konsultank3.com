---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getArticlesForPillar } from '../../data/topics.js';

const title = "Standar Pemilihan & Penggunaan Alat Pelindung Diri (APD)";
const metaTitle = "Standar Pemilihan & Penggunaan Alat Pelindung Diri APD";
const description = "Pedoman standar penyediaan dan pemilihan Alat Pelindung Diri (APD) industri sesuai Permenakertrans PER.08/MEN/VII/2010 dan hierarki pengendalian bahaya kerja.";
const canonical = "/alat-pelindung-diri/";

const mappedArticles = getArticlesForPillar('alat-pelindung-diri');

const faqs = [
  {
    q: "Apakah perusahaan berhak memotong gaji karyawan untuk biaya penyediaan APD?",
    a: "Tidak berhak. Berdasarkan Permenakertrans No. PER.08/MEN/VII/2010 dan UU No. 1 Tahun 1970, pengusaha wajib menyediakan seluruh Alat Pelindung Diri (APD) bagi tenaga kerja dan orang lain yang memasuki tempat kerja secara cuma-cuma tanpa pungutan biaya apa pun."
  },
  {
    q: "Mengapa APD ditempatkan pada urutan paling bawah dalam hierarki pengendalian bahaya kerja?",
    a: "APD ditempatkan sebagai upaya terakhir (last line of defense) karena APD tidak mengeliminasi atau menurunkan potensi sumber bahaya di tempat kerja, melainkan hanya memberikan pembatas perlindungan fisik pada tubuh pekerja saat bahaya residual masih terjadi."
  },
  {
    q: "Berapa batas ketinggian kerja yang mewajibkan pekerja mengenakan Full Body Harness?",
    a: "Pekerja wajib mengenakan Full Body Harness saat melaksanakan pekerjaan pada ketinggian sama dengan atau lebih dari 1,8 meter, dilengkapi tali ganda (double lanyard), snap hook pengunci besar, serta energy absorber peredam kejut."
  },
  {
    q: "Berapa lama batas masa pakai (kedaluwarsa) helm keselamatan kerja (safety helmet)?",
    a: "Helm polimer keselamatan kerja umumnya memiliki masa pakai optimal berkisar antara 3 hingga 5 tahun sejak tanggal produksi atau penggunaan pertama, tergantung intensitas paparan panas matahari, bahan kimia, atau benturan fisik di lapangan."
  },
  {
    q: "Apa tindakan yang wajib dilakukan apabila APD mengalami kerusakan atau cacat fisik?",
    a: "APD yang retak, rusak, kedaluwarsa, atau telah menerima beban kejatuhan ekstrem (seperti body harness yang pernah menahan pekerja jatuh) harus segera ditarik dari peredaran, diafkir, dihancurkan agar tidak digunakan kembali, serta diganti baru secara cuma-cuma oleh pengusaha."
  }
];
