---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Profil PT Wahana Totalita Konsultan";
const description = "Profil lengkap PT Wahana Totalita Konsultan, Perusahaan Jasa K3 (PJK3) berlisensi resmi Kemnaker RI dan mitra strategis pembinaan keselamatan kerja sejak 2011.";
const canonical = "/tentang-kami/";

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Tentang Kami", "item": "https://konsultank3.com/tentang-kami/" }
      ]
    },
    {
      "@type": "AboutPage",
      "name": "Tentang PT Wahana Totalita Konsultan (KonsultanK3.com)",
      "description": description,
      "mainEntity": {
        "@type": "Organization",
        "name": "PT Wahana Totalita Konsultan",
        "url": "https://wahanatotalita.com",
        "sameAs": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout
  title={`${title} » Konsultan K3 Indonesia`}
  description={description}
  canonical={canonical}
  schema={aboutSchema}
  presetMessage="Halo KonsultanK3, saya ingin mengetahui profil kerjasama korporasi dengan PT Wahana Totalita Konsultan."
>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-slate-300">Profil Perusahaan</span>
      </nav>

      <div class="space-y-6 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          PJK3 Resmi Kemnaker RI &bull; Terdaftar LPSE Nasional Sejak 2011
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Membangun Budaya Keselamatan &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Kepatuhan Industri Berkelanjutan</span>
        </h1>

        <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-3xl">
          <strong>PT Wahana Totalita Konsultan</strong> adalah lembaga pembinaan sertifikasi personel K3 resmi dan pendampingan audit Sistem Manajemen K3 (SMK3) terpercaya di Indonesia yang telah mendampingi lebih dari 980+ korporasi sejak tahun 2011.
        </p>
      </div>

      <!-- Key Metrics Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 max-w-5xl border-t border-white/10">
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Tahun Berdiri</span>
          <p class="text-white font-bold text-base sm:text-lg">2011 (15 Tahun)</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Alumni Tersertifikasi</span>
          <p class="text-white font-bold text-base sm:text-lg">14.850+ Personel</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Klien Korporasi</span>
          <p class="text-white font-bold text-base sm:text-lg">980+ Perusahaan</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Status Legalitas</span>
          <p class="text-emerald-400 font-bold text-base sm:text-lg">SKP Kemnaker RI Aktif</p>
        </div>
      </div>

    </div>
  </header>

  <!-- Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- Vision & Mission Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600 block">Visi Kami</span>
        <h3 class="font-serif text-2xl font-bold text-slate-900 leading-tight">Menjadi Pusat Unggulan K3 Terdepan di Indonesia</h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Mewujudkan ekosistem tempat kerja nasional yang aman, produktif, dan nihil kecelakaan (zero accident) melalui standardisasi kompetensi personel yang berintegritas tinggi serta kepatuhan hukum ketenagakerjaan berkelanjutan.
        </p>
      </div>

      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block">Misi Kami</span>
        <h3 class="font-serif text-2xl font-bold text-slate-900 leading-tight">Mencetak SDM Kompeten &amp; Menjamin Kepatuhan Regulasi</h3>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 shrink-0"></span>
            <span>Menyelenggarakan pembinaan sertifikasi K3 berbasis kompetensi praktis sesuai kurikulum Ditjen Binwasnaker &amp; K3 Kemnaker RI.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 shrink-0"></span>
            <span>Mendampingi implementasi Sistem Manajemen K3 (SMK3 PP 50/2012) untuk membantu korporasi meraih predikat Memuaskan / Bendera Emas.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 shrink-0"></span>
            <span>Menyediakan literatur dan kajian ilmiah K3 yang terbuka dan mudah diakses bagi akademisi dan praktisi keselamatan di seluruh Indonesia.</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Corporate Credentials & Accreditations -->
    <div class="bg-slate-950 text-white rounded-3xl p-8 sm:p-12 space-y-8 shadow-xl border border-white/10">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400 block">Landasan Legalitas</span>
        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">Akreditasi &amp; Lisensi Penunjukan PJK3</h3>
        <p class="text-slate-300 text-sm leading-relaxed">
          PT Wahana Totalita Konsultan beroperasi dengan izin resmi dan Surat Keputusan Penunjukan (SKP) dari Kementerian Ketenagakerjaan Republik Indonesia untuk bidang Pembinaan K3, Asesmen Lingkungan Kerja, dan Sertifikasi Ketenagakerjaan.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-white/10 text-sm">
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Izin Operasional</span>
          <p class="font-bold text-white text-base">PJK3 Bidang Pembinaan K3</p>
          <p class="text-xs text-amber-400">Kemnaker RI</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Standarisasi BNSP</span>
          <p class="font-bold text-white text-base">Tempat Uji Kompetensi (TUK)</p>
          <p class="text-xs text-amber-400">LSP Terakreditasi BNSP</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Pengadaan Pemerintah</span>
          <p class="font-bold text-white text-base">Vendor Terverifikasi LPSE</p>
          <p class="text-xs text-amber-400">Katalog Elektronik LKPP</p>
        </div>
      </div>
    </div>

  </main>
</BaseLayout>
