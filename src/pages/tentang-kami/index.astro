---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Tentang KonsultanK3.com";
const description = "Tentang portal KonsultanK3.com: pusat literatur edukasi keselamatan kerja, konsultasi kepatuhan, dan panduan sertifikasi resmi Kemnaker RI sejak 2011.";
const canonical = "/tentang-kami/";

const aboutSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Tentang Kami", "item": "https://konsultank3.com/tentang-kami/" }
      ]
    },
    {
      "@type": "AboutPage",
      "name": "Tentang KonsultanK3.com",
      "description": description,
      "mainEntity": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  schema={aboutSchema}
  presetMessage="Halo KonsultanK3, saya ingin konsultasi layanan keselamatan kerja dan pelatihan K3."
>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <span class="text-slate-300">Tentang Kami</span>
      </nav>

      <div class="space-y-6 max-w-4xl">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          Portal Edukasi &amp; Kepatuhan Regulasi K3 Sejak 2011
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Portal Edukasi, Konsultasi &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Panduan Sertifikasi K3 Terpercaya</span>
        </h1>

        <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-3xl">
          <strong>KonsultanK3.com</strong> adalah media referensi independen dan pusat informasi keselamatan dan kesehatan kerja (K3) terdepan di Indonesia. Sejak tahun 2011, kami mendampingi praktisi HSE, akademisi, dan manajemen industri dalam memahami regulasi ketenagakerjaan, standar SNI, serta penerapan Sistem Manajemen K3.
        </p>
      </div>

      <!-- Key Metrics Strip -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pt-6 max-w-5xl border-t border-white/10">
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Eksistensi Digital</span>
          <p class="text-white font-bold text-base sm:text-lg">Sejak 2011 (15 Tahun)</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Panduan Induk</span>
          <p class="text-white font-bold text-base sm:text-lg">4 Topik Utama K3</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Artikel Referensi</span>
          <p class="text-white font-bold text-base sm:text-lg">29 Artikel &amp; Unduhan</p>
        </div>
        <div class="p-4 rounded-2xl bg-white/5 border border-white/10">
          <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-1">Standar Regulasi</span>
          <p class="text-emerald-400 font-bold text-base sm:text-lg">Kemnaker RI &amp; BNSP</p>
        </div>
      </div>

    </div>
  </header>

  <!-- Body Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-16">
    
    <!-- Vision & Mission Bento Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-600 block">Visi Portal</span>
        <h3 class="font-serif text-2xl font-bold text-slate-900 leading-tight">Mewujudkan Ekosistem Tempat Kerja Aman &amp; Zero Accident</h3>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          Menjadi kanal pengetahuan dan rujukan ilmiah keselamatan kerja terlengkap yang menjembatani regulasi pemerintah, kebutuhan industri, dan kompetensi tenaga kerja demi terciptanya tempat kerja nihil kecelakaan di seluruh nusantara.
        </p>
      </div>

      <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-600 block">Misi Utama</span>
        <h3 class="font-serif text-2xl font-bold text-slate-900 leading-tight">Diseminasi Pengetahuan &amp; Standardisasi Mutu</h3>
        <ul class="space-y-3 text-slate-600 text-sm">
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 shrink-0"></span>
            <span>Menyediakan ulasan regulasi K3, instrumen penilaian risiko, dan panduan teknis yang mudah dipahami dan diunduh cuma-cuma.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 shrink-0"></span>
            <span>Memfasilitasi pendaftaran pembinaan kompetensi personil K3 resmi berlisensi Kemnaker RI dan sertifikasi profesi BNSP.</span>
          </li>
          <li class="flex items-start gap-3">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mt-2 shrink-0"></span>
            <span>Mendampingi pelaku industri menyusun manual dan prosedur Sistem Manajemen K3 (SMK3 PP 50/2012) menuju Bendera Emas.</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Operational Overview Box -->
    <div class="p-8 sm:p-10 rounded-3xl bg-white border border-slate-200/80 shadow-sm space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-slate-500 block">Tata Kelola &amp; Layanan</span>
      <h3 class="font-serif text-2xl font-bold text-slate-900 leading-tight">Penyelenggaraan Pembinaan &amp; Konsultasi K3</h3>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
        KonsultanK3.com menyelenggarakan seluruh program pembinaan sertifikasi personel, asesmen lingkungan kerja, dan pendampingan audit sistem manajemen bersama PJK3 mitra berlisensi Kemnaker RI dan lembaga sertifikasi profesi terakreditasi BNSP.
      </p>
    </div>

    <!-- Corporate Credentials & Accreditations -->
    <div class="bg-slate-950 text-white rounded-3xl p-8 sm:p-12 space-y-8 shadow-xl border border-white/10">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-widest text-amber-400 block">Landasan Legalitas</span>
        <h3 class="font-serif text-2xl sm:text-3xl font-bold text-white">Akreditasi &amp; Lisensi Penunjukan PJK3</h3>
        <p class="text-slate-300 text-sm leading-relaxed">
          Seluruh program pembinaan kompetensi, ujian sertifikasi, dan asesmen lapangan diselenggarakan sesuai ketetapan kurikulum resmi Ditjen Binwasnaker &amp; K3 Kemnaker RI serta standar BNSP bersama PJK3 mitra berlisensi Kemnaker RI.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-4 border-t border-white/10 text-sm">
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Izin Operasional</span>
          <p class="font-bold text-white text-base">PJK3 Bidang Pembinaan K3</p>
          <p class="text-xs text-amber-400">Kemnaker RI</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Standarisasi BNSP</span>
          <p class="font-bold text-white text-base">Tempat Uji Kompetensi (TUK)</p>
          <p class="text-xs text-amber-400">LSP Terakreditasi BNSP</p>
        </div>
        <div class="space-y-1">
          <span class="text-xs uppercase tracking-wider text-slate-400 font-bold">Kontak Layanan</span>
          <p class="font-bold text-white text-base">Konsultasi via WhatsApp</p>
          <p class="text-xs text-amber-400">0895-1025-3435</p>
        </div>
      </div>
    </div>

    <!-- Footer Note Line -->
    <div class="p-6 rounded-2xl bg-slate-100 border border-slate-200 text-center text-xs text-slate-600 font-medium">
      Layanan konsultasi dan pembinaan K3 diselenggarakan bersama PJK3 mitra berlisensi Kemnaker RI
    </div>

  </main>
</BaseLayout>
