---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = "Pembinaan & Sertifikasi Calon Ahli K3 Umum Kemnaker RI";
const description = "Program pembinaan sertifikasi calon Ahli K3 Umum resmi Kemnaker RI selama 12 hari (120 JP). Modul resmi, bimbingan PKL, dan lisensi SKP nasional.";
const canonical = "/pelatihan-ahli-k3-umum/";
---

<BaseLayout title={`${title} » Konsultan K3`} description={description} canonical={canonical}>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">Ahli K3 Umum</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Sertifikasi Resmi Kemnaker RI &bull; Permenaker No. 02/MEN/1992
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pembinaan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Calon Ahli K3 Umum</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Program wajib pemerintah 120 Jam Pelajaran (12 Hari) untuk mencetak personel pengawas kepatuhan norma K3 di tempat kerja dengan lisensi dan Surat Keputusan Penunjukan (SKP) resmi dari Kementerian Ketenagakerjaan RI.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20mendaftar%20pembinaan%20Ahli%20K3%20Umum%20batch%20terdekat"
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Daftar Batch Terdekat &rarr;
            </a>
            <a
              href="#modul-kurikulum"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Silabus 120 JP
            </a>
          </div>

          <!-- Quick Fast-Track Key Info Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi</span>
              <p class="text-white font-bold text-sm">12 Hari (120 JP)</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Metode</span>
              <p class="text-white font-bold text-sm">Blended / Zoom + PKL</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen</span>
              <p class="text-white font-bold text-sm">SKP &amp; Lisensi Sah</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kelulusan</span>
              <p class="text-emerald-400 font-bold text-sm">Garansi 100%</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pembinaan Calon Ahli K3 Umum Resmi Kemnaker RI"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Mandatori Permenaker 02/1992
              </span>
              <div class="text-lg font-bold">Kualifikasi Sekretaris P2K3</div>
              <p class="text-xs text-slate-300 mt-1">Wajib dimiliki perusahaan dengan tenaga kerja &gt;100 orang atau memiliki potensi bahaya tinggi.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">Lisensi SKP Kemnaker</div>
              <div class="text-[10px] text-slate-400">Berlaku Nasional 3 Tahun</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🏆</div>
            <div>
              <div class="text-xs font-bold text-white">Garansi Pembinaan</div>
              <div class="text-[10px] text-slate-400">Pendampingan Ujian TemanK3</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Subpage Body Layout -->
  <main class="max-w-7xl mx-auto px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Rich Curriculum & Modules (8 cols) -->
      <div class="lg:col-span-8 space-y-12">
        
        <!-- 4 Bento Feature Modules -->
        <div id="modul-kurikulum" class="grid grid-cols-1 sm:grid-cols-2 gap-6 scroll-mt-24">
          <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
              01
            </div>
            <h3 class="font-serif text-2xl font-normal text-zinc-900">Perundang-undangan K3</h3>
            <p class="text-zinc-600 font-light text-sm leading-relaxed">
              Kajian mendalam UU No. 1/1970, kebijakan nasional ketenagakerjaan, kelembagaan P2K3, dan landasan hukum keselamatan operasional.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
              02
            </div>
            <h3 class="font-serif text-2xl font-normal text-zinc-900">Keahlian Bidang Teknis</h3>
            <p class="text-zinc-600 font-light text-sm leading-relaxed">
              Norma K3 mekanik, pesawat uap &amp; bejana tekan, instalasi listrik, penanggulangan kebakaran, konstruksi, dan kesehatan kerja.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
              03
            </div>
            <h3 class="font-serif text-2xl font-normal text-zinc-900">Praktik Lapangan (PKL)</h3>
            <p class="text-zinc-600 font-light text-sm leading-relaxed">
              Observasi lapangan langsung di fasilitas industri, identifikasi bahaya faktual, dan penyusunan kertas kerja laporan audit K3.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-white border border-zinc-200/80 shadow-sm space-y-4">
            <div class="w-12 h-12 rounded-2xl bg-zinc-100 flex items-center justify-center text-zinc-900 font-mono font-semibold">
              04
            </div>
            <h3 class="font-serif text-2xl font-normal text-zinc-900">Ujian &amp; Evaluasi Akhir</h3>
            <p class="text-zinc-600 font-light text-sm leading-relaxed">
              Evaluasi teori komprehensif dari Pengawas Ditjen Binwasnaker Kemnaker RI, seminar PKL, dan verifikasi berkas lisensi.
            </p>
          </div>
        </div>

        <!-- Detailed Syllabus Breakdown Accordion / Sections -->
        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-zinc-200/80 shadow-sm space-y-8">
          <div class="border-b border-zinc-200 pb-6">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 block mb-1">Materi Pembinaan</span>
            <h2 class="font-serif text-3xl font-normal text-zinc-900">Struktur Kurikulum 120 Jam Pelajaran (JP)</h2>
          </div>

          <div class="space-y-6">
            <div class="p-6 rounded-2xl bg-zinc-50 border border-zinc-200/60 space-y-3">
              <h4 class="font-serif text-xl font-normal text-zinc-900">A. Kelompok Dasar (10 JP)</h4>
              <ul class="list-disc pl-6 space-y-1.5 text-zinc-600 text-sm font-light">
                <li>Kebijakan Nasional K3 &amp; Pengawasan Ketenagakerjaan</li>
                <li>Undang-Undang No. 1 Tahun 1970 tentang Keselamatan Kerja</li>
                <li>Kelembagaan, Panitia Pembina K3 (P2K3), dan Perusahaan Jasa K3 (PJK3)</li>
              </ul>
            </div>

            <div class="p-6 rounded-2xl bg-zinc-50 border border-zinc-200/60 space-y-3">
              <h4 class="font-serif text-xl font-normal text-zinc-900">B. Kelompok Keahlian &amp; Teknis (80 JP)</h4>
              <ul class="list-disc pl-6 space-y-1.5 text-zinc-600 text-sm font-light">
                <li>Sistem Manajemen K3 (SMK3) sesuai PP No. 50 Tahun 2012 &amp; Audit SMK3</li>
                <li>Norma K3 Pesawat Uap, Bejana Tekan, &amp; Tangki Timbun</li>
                <li>Norma K3 Pesawat Angkat &amp; Angkut (PAA)</li>
                <li>Norma K3 Kelistrikan &amp; Penyalur Petir (Permenaker 12/2015 &amp; 31/2015)</li>
                <li>Norma K3 Penanggulangan Kebakaran (Kepmenaker 186/1999)</li>
                <li>Norma K3 Konstruksi Bangunan &amp; Bekerja di Ketinggian</li>
                <li>Norma Kesehatan Kerja, Ergonomi, &amp; Toksikologi Industri</li>
                <li>Metodologi Analisis Kecelakaan Kerja, JSA, dan Laporan Investigasi Insiden</li>
              </ul>
            </div>

            <div class="p-6 rounded-2xl bg-zinc-50 border border-zinc-200/60 space-y-3">
              <h4 class="font-serif text-xl font-normal text-zinc-900">C. Praktik Kerja Lapangan &amp; Evaluasi (30 JP)</h4>
              <ul class="list-disc pl-6 space-y-1.5 text-zinc-600 text-sm font-light">
                <li>Studi Kasus &amp; Praktik Observasi Lapangan di Pabrik/Fasilitas Industri</li>
                <li>Penyusunan Kertas Kerja &amp; Laporan Hasil Praktik Kerja Lapangan (PKL)</li>
                <li>Seminar &amp; Presentasi Laporan di Hadapan Pengawas Kemnaker RI</li>
                <li>Ujian Teori Evaluasi Akhir Kemnaker RI</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- Requirements & Prerequisites Card -->
        <div class="bg-white rounded-3xl p-8 sm:p-12 border border-zinc-200/80 shadow-sm space-y-6">
          <div class="border-b border-zinc-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400 block mb-1">Persyaratan Calon Peserta</span>
            <h3 class="font-serif text-2xl font-normal text-zinc-900">Kelayakan Administrasi Pendaftaran</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/60 space-y-2">
              <span class="text-xs font-mono uppercase text-zinc-500 font-bold block">Tingkat Pendidikan Minimal</span>
              <p class="text-zinc-800 text-sm leading-relaxed">Pendidikan minimal Diploma 3 (D3) atau Sarjana (S1) semua jurusan (teknik maupun non-teknik).</p>
            </div>
            <div class="p-4 rounded-xl bg-zinc-50 border border-zinc-200/60 space-y-2">
              <span class="text-xs font-mono uppercase text-zinc-500 font-bold block">Dokumen Wajib</span>
              <p class="text-zinc-800 text-sm leading-relaxed">Salinan ijazah legalisir, KTP, pas foto latar merah (2x3, 3x4, 4x6), dan surat rekomendasi instansi.</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Conversion Sidebar (4 cols) -->
      <aside class="lg:col-span-4 space-y-8 lg:sticky lg:top-32 self-start">
        
        <!-- WhatsApp Booking Card -->
        <div class="bg-zinc-900 text-white rounded-3xl p-8 space-y-6 shadow-xl">
          <div class="space-y-2">
            <span class="text-xs font-mono uppercase tracking-widest text-zinc-400">Pendaftaran Batch Resmi</span>
            <h3 class="font-serif text-2xl font-normal text-white">Amankan Kursi Pembinaan Anda</h3>
            <p class="text-xs font-mono text-zinc-400 leading-relaxed">
              Kuota dibatasi 30 peserta per batch sesuai regulasi pengawasan ketenagakerjaan RI untuk menjamin kualitas bimbingan PKL.
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-zinc-800/80 border border-zinc-700/60 space-y-2 text-xs">
            <div class="flex items-center justify-between">
              <span class="text-zinc-400">Batch Mendatang:</span>
              <span class="text-white font-mono font-bold">10 – 23 November 2026</span>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-zinc-400">Status Kuota:</span>
              <span class="text-emerald-400 font-mono font-bold">Kuota Terbatas (4 Kursi)</span>
            </div>
          </div>

          <a href="https://wa.me/6281392943146?text=Halo%20KonsultanK3,%20saya%20ingin%20mendaftar%20Pelatihan%20Ahli%20K3%20Umum%20Batch%20Terdekat" target="_blank" rel="noopener" class="w-full inline-flex items-center justify-center gap-2 p-4 rounded-full bg-white text-zinc-900 font-semibold text-xs font-mono uppercase tracking-wider hover:bg-zinc-200 transition-colors shadow-lg">
            <span>Daftar via WhatsApp Resmi</span>
            <span>&rarr;</span>
          </a>
        </div>

        <!-- Facilities Included Card -->
        <div class="bg-white rounded-3xl p-8 border border-zinc-200/80 shadow-sm space-y-4">
          <span class="text-xs font-mono uppercase tracking-widest text-zinc-500 block">Fasilitas Peserta</span>
          <ul class="space-y-2.5 text-xs text-zinc-700 font-light">
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">&check;</span>
              <span>Sertifikat Calon Ahli K3 Umum Kemnaker RI</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">&check;</span>
              <span>Surat Keputusan Penunjukan (SKP) Resmi</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">&check;</span>
              <span>Kartu Lisensi Kewenangan Ahli K3 Kemnaker</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">&check;</span>
              <span>Modul Eksklusif &amp; Kompilasi UU K3 Lengkap</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-emerald-600 font-bold">&check;</span>
              <span>Pin Kewenangan K3 &amp; Seminar Kit Eksklusif</span>
            </li>
          </ul>
        </div>

        <!-- Official Accreditation Seal -->
        <div class="p-6 rounded-3xl bg-zinc-50 border border-zinc-200/80 space-y-2">
          <span class="text-[0.65rem] font-mono uppercase tracking-wider text-zinc-500 block">Akreditasi &amp; Legalitas</span>
          <p class="text-xs text-zinc-600 font-light leading-relaxed">
            Diselenggarakan oleh <strong>PT Wahana Totalita Konsultan</strong>, Perusahaan Jasa K3 (PJK3) berlisensi resmi Kemnaker RI dengan nomor SKP aktif dan terdaftar di LPSE Nasional.
          </p>
        </div>

      </aside>

    </div>
  </main>

  
</BaseLayout>
