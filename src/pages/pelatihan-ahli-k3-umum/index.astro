---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { batches } from '../../data/batches.js';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const batch = batches.ahliK3Umum;

const title = "Pelatihan Ahli K3 Umum Kemnaker Bersertifikat";
const description = "Program pembinaan sertifikasi calon Ahli K3 Umum resmi Kemnaker RI. Pembekalan regulasi keselamatan kerja, audit SMK3, investigasi insiden, dan lisensi SKP.";
const canonical = "/pelatihan-ahli-k3-umum/";

const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Katalog Pelatihan", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Ahli K3 Umum", "item": "https://konsultank3.com/pelatihan-ahli-k3-umum/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pembinaan & Sertifikasi Calon Ahli K3 Umum Kemnaker RI",
      "description": "Program pembinaan kompetensi calon Ahli K3 Umum untuk pengawasan norma K3 dan penunjukan sekretaris P2K3 berlisensi resmi Kemnaker RI sesuai Permenaker No. 02/MEN/1992.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      }
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={courseSchema}>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Katalog Pelatihan</a>
        <span>/</span>
        <span class="text-slate-300">Ahli K3 Umum</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Left: Headline & Key Highlights -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Sertifikasi Resmi Kemnaker RI &bull; Permenaker No. 02/MEN/1992
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pembinaan &amp; Sertifikasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Calon Ahli K3 Umum</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Program strategis pemerintah untuk mencetak personel pengawas kepatuhan norma K3 di tempat kerja dengan lisensi dan Surat Keputusan Penunjukan (SKP) resmi dari Kementerian Ketenagakerjaan RI.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, saya ingin konsultasi pembinaan Calon Ahli K3 Umum Kemnaker RI")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi WhatsApp Resmi &rarr;
            </a>
            <a
              href="#jenjang-pelatihan"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Jenjang &amp; Kompetensi
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Tingkatan</span>
              <p class="text-white font-bold text-sm">Ahli K3 Umum</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Metode</span>
              <p class="text-white font-bold text-sm">Teori, PKL &amp; Ujian</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Dokumen</span>
              <p class="text-white font-bold text-sm">SKP &amp; Lisensi Sah</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kualifikasi</span>
              <p class="text-emerald-400 font-bold text-sm">Sekretaris P2K3</p>
            </div>
          </div>
        </div>

        <!-- Right: Photography Card with Floating Badges -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/training-session.jpg"
              alt="Pembinaan Calon Ahli K3 Umum Resmi Kemnaker RI"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Mandatori Permenaker 02/1992
              </span>
              <div class="text-lg font-bold">Kualifikasi Sekretaris P2K3</div>
              <p class="text-xs text-slate-300 mt-1">Wajib dimiliki perusahaan dengan tenaga kerja lebih dari 100 orang atau memiliki potensi bahaya tinggi.</p>
            </div>
          </div>

          <!-- Floating Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">Lisensi SKP Kemnaker</div>
              <div class="text-[10px] text-slate-400">Pengawasan Norma K3</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">📋</div>
            <div>
              <div class="text-xs font-bold text-white">Audit SMK3 Terstruktur</div>
              <div class="text-[10px] text-slate-400">Sesuai PP 50/2012</div>
            </div>
          </div>
        </div>

      </div>

    </div>
  </header>

  <!-- Main Subpage Body Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Rich Curriculum & Modules (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section 1: Apa itu Pembinaan Calon Ahli K3 Umum -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Pengenalan Program</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Apa itu Pembinaan Calon Ahli K3 Umum</h2>
          </div>
          <p class="text-base sm:text-lg text-slate-700 font-light leading-relaxed">
            Pembinaan Calon Ahli K3 Umum adalah program pendidikan dan pelatihan kualifikasi keahlian khusus yang diselenggarakan untuk mempersiapkan tenaga ahli profesional yang memiliki kewenangan hukum dalam mengawasi ditaatinya peraturan perundang-undangan keselamatan dan kesehatan kerja di tempat kerja. Program ini membekali peserta dengan penguasaan norma pengawasan ketenagakerjaan, identifikasi potensi bahaya industri, teknik audit internal sistem manajemen K3, serta kemampuan menyusun rekomendasi mitigasi risiko kerja bagi pimpinan manajemen perusahaan.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Tingginya angka kecelakaan kerja, penyakit akibat kerja, serta kerugian finansial akibat kerusakan aset operasional menuntut kehadiran personel yang menguasai regulasi keselamatan secara komprehensif. Personel Ahli K3 Umum bertindak sebagai tangan kanan manajemen sekaligus perpanjangan tangan pengawas ketenagakerjaan pemerintah dalam memastikan tempat kerja memenuhi standar keselamatan lingkungan, keandalan permesinan mekanik, pesawat uap, instalasi listrik, serta kesiapsiagaan tanggap darurat kebakaran.
          </p>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kewajiban penunjukan Ahli K3 Umum ditetapkan secara mandatori melalui Permenaker No. 02/MEN/1992 tentang Tata Cara Penunjukan, Kewajiban dan Wewenang Ahli Keselamatan dan Kesehatan Kerja. Peraturan ini mengamanatkan bahwa perusahaan yang mempekerjakan tenaga kerja sebanyak 100 orang atau lebih, atau perusahaan dengan potensi bahaya tinggi (high risk), wajib membentuk Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3) di mana posisi Sekretaris P2K3 wajib dijabat oleh Ahli K3 Umum yang memiliki Surat Keputusan Penunjukan (SKP) dan Kartu Lisensi resmi dari Kementerian Ketenagakerjaan RI.
          </p>
          <div class="p-6 rounded-2xl bg-amber-500/5 border border-amber-500/20 space-y-3">
            <h3 class="text-base font-bold text-amber-900">Siapa Saja yang Membutuhkan Pelatihan Ini?</h3>
            <p class="text-sm text-slate-700 font-light leading-relaxed">
              Program pembinaan Ahli K3 Umum merupakan kebutuhan wajib bagi berbagai profil profesional dan sektor usaha, antara lain:
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-sm text-slate-700 font-light">
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Calon Sekretaris P2K3 Perusahaan:</strong> Tenaga kerja yang ditunjuk manajemen untuk memimpin kelembagaan keselamatan kerja internal.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Manajer HSE &amp; Supervisor K3:</strong> Bertanggung jawab atas perancangan kebijakan K3, audit SMK3, dan kepatuhan perizinan norma kerja.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Industri Manufaktur, Tambang, Migas &amp; Kimia:</strong> Sektor dengan intensitas risiko tinggi yang membutuhkan pengawasan norma ketat.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Perusahaan Konstruksi &amp; Kontraktor Infrastruktur:</strong> Mengelola keselamatan proyek pembangunan gedung, jembatan, dan instalasi mekanikal.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Rumah Sakit, Perhotelan &amp; Fasilitas Publik:</strong> Mengamankan keselamatan pasien, staf medis, tamu, serta fasilitas sarana gedung.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-600 font-bold mt-0.5">&bull;</span>
                <span><strong>Lulusan Perguruan Tinggi (Fresh Graduate):</strong> Membangun keunggulan karir profesional di bidang Keselamatan dan Kesehatan Kerja nasional.</span>
              </li>
            </ul>
          </div>
        </section>

        <!-- Section 2: Jenjang / Jenis Pelatihan -->
        <section id="jenjang-pelatihan" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Klasifikasi &amp; Tingkatan</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Jenjang / Jenis Pelatihan</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Pembinaan Calon Ahli K3 Umum diselenggarakan secara spesifik untuk membentuk tenaga ahli kepengawasan norma keselamatan lintas sektor industri dengan rincian skema kompetensi pada tabel berikut:
          </p>

          <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm">
            <table class="w-full text-left text-xs sm:text-sm text-slate-700">
              <thead class="bg-slate-900 text-white text-xs uppercase font-semibold">
                <tr>
                  <th class="py-4 px-4 sm:px-6">Jenjang / Jenis</th>
                  <th class="py-4 px-4 sm:px-6">Peran</th>
                  <th class="py-4 px-4 sm:px-6">Tugas utama</th>
                  <th class="py-4 px-4 sm:px-6">Materi kunci</th>
                  <th class="py-4 px-4 sm:px-6">Persyaratan</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 bg-white">
                <tr class="hover:bg-slate-50 transition-colors">
                  <td class="py-4 px-4 sm:px-6 font-bold text-slate-900 font-mono">Calon Ahli K3 Umum</td>
                  <td class="py-4 px-4 sm:px-6 font-semibold text-slate-800">Sekretaris P2K3 &amp; Pengawas Norma K3</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Memimpin rapat P2K3, menyusun laporan triwulan kepatuhan K3 ke Disnaker, mengaudit implementasi SMK3, dan memimpin investigasi kecelakaan kerja</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-600 font-light">Kebijakan nasional K3, norma mekanik, pesawat uap &amp; bejana tekan, instalasi listrik &amp; petir, proteksi kebakaran, konstruksi, lingkungan kerja, audit SMK3, analisis insiden &amp; JSA, Praktik Kerja Lapangan (PKL)</td>
                  <td class="py-4 px-4 sm:px-6 text-slate-800 font-semibold">Minimal Diploma 3 (D3) atau Sarjana (S1) semua jurusan</td>
                </tr>
              </tbody>
            </table>
          </div>

          <p class="text-sm text-slate-600 font-light leading-relaxed">
            Kualifikasi Calon Ahli K3 Umum merupakan sertifikasi payung yang memberikan mandat kepengawasan menyeluruh. Pemegang SKP Ahli K3 Umum memiliki hak untuk memasuki tempat kerja guna memeriksa kesesuaian instalasi permesinan, meminta keterangan kepada pengurus mengenai pelaksanaan K3, serta mengusulkan tindakan pencegahan bahaya yang mengikat bagi manajemen perusahaan demi keselamatan seluruh pekerja.
          </p>
        </section>

        <!-- Section 3: Dasar Hukum -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Landasan Regulasi</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Dasar Hukum</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Penyelenggaraan program pembinaan Calon Ahli K3 Umum dan kewajiban penunjukan personel ahli di perusahaan bertumpu pada ketentuan peraturan perundang-undangan nasional yang berkekuatan hukum tetap, meliputi:
          </p>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">UU No. 1 Tahun 1970 tentang Keselamatan Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Undang-Undang Keselamatan Kerja merupakan landasan konstitusional perlindungan tenaga kerja di Indonesia. Pada Pasal 1 ayat (6) dan Pasal 10 diatur secara tegas ketentuan mengenai penunjukan ahli keselamatan kerja serta kewajiban pembentukan Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3) di tempat kerja guna mengembangkan kerja sama, saling pengertian, dan partisipasi efektif antara pengusaha dan pekerja.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Permenaker No. 02/MEN/1992 tentang Tata Cara Penunjukan, Kewajiban dan Wewenang Ahli Keselamatan dan Kesehatan Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peraturan ini menetapkan tata cara penunjukan resmi Ahli K3 oleh Menteri Ketenagakerjaan RI, persyaratan administrasi calon peserta, serta kewajiban dan wewenang hukum yang melekat pada pemegang lisensi. Regulasi ini menegaskan bahwa perusahaan dengan jumlah pekerja di atas 100 orang atau memiliki potensi bahaya tinggi wajib memiliki sekurang-kurangnya satu orang Ahli K3 Umum sebagai sekretaris P2K3.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">PP No. 50 Tahun 2012 tentang Penerapan Sistem Manajemen Keselamatan dan Kesehatan Kerja (SMK3)</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peraturan Pemerintah ini mewajibkan setiap perusahaan yang mempekerjakan lebih dari 100 orang atau memiliki tingkat potensi bahaya tinggi untuk menerapkan SMK3 yang terintegrasi dengan sistem manajemen perusahaan. Peraturan ini memuat pedoman penetapan kebijakan, perencanaan, pelaksanaan, pemantauan, serta audit berkala SMK3 yang harus dikawal oleh personel ahli K3 kompeten.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Permenaker No. 12 Tahun 2015 &amp; Permenaker No. 31 Tahun 2015 tentang K3 Kelistrikan dan Penyalur Petir</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Rangkaian regulasi ini memuat standar teknis pengawasan keselamatan instalasi ketenagalistrikan dan instalasi proteksi penyalur petir pada bangunan tempat kerja. Mengatur ketentuan perencanaan, pemasangan, pemeliharaan, serta pemeriksaan dan pengujian berkala terhadap panel daya, resistansi grounding pembumian, dan instalasi penangkal petir guna mencegah bahaya kebakaran dan sengatan listrik fatal.
              </p>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-amber-500"></span>
                <h3 class="text-base font-bold text-slate-900">Kepmenaker No. KEP.186/MEN/1999 tentang Unit Penanggulangan Kebakaran di Tempat Kerja</h3>
              </div>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Keputusan ini mewajibkan pengusaha membentuk unit penanggulangan kebakaran di tempat kerja sesuai klasifikasi tingkat risiko kebakaran fasilitas. Menetapkan peran penugasan personel proteksi kebakaran mulai dari petugas peran, regu pemadam, hingga koordinator unit, serta mengatur standar penyediaan alat pemadam api ringan (APAR) dan instalasi hidran gedung.
              </p>
            </div>
          </div>
        </section>

        <!-- Section 4: Silabus Pembelajaran -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Materi Kurikulum</span>
            <h2 class="font-serif text-3xl font-bold text-slate-900 tracking-tight">Silabus Pembelajaran</h2>
          </div>
          <p class="text-base text-slate-700 leading-relaxed font-light">
            Kurikulum pembinaan Ahli K3 Umum disusun secara terstruktur mengacu pada modul kurikulum resmi Direktorat Bina Pengawasan Ketenagakerjaan Kemnaker RI, mencakup kelompok dasar, kelompok keahlian teknis, serta praktik kerja lapangan:
          </p>

          <div class="space-y-5">
            <!-- Topic 1 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">01</span>
                Kebijakan Nasional K3 &amp; Kelembagaan
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Materi pokok ini mengkaji arah kebijakan nasional keselamatan kerja dan sistem pengawasan ketenagakerjaan di Indonesia berdasarkan UU No. 1 Tahun 1970. Peserta mempelajari pembentukan dan tata kelola Panitia Pembina Keselamatan dan Kesehatan Kerja (P2K3) di perusahaan serta mekanisme kemitraan bersama Perusahaan Jasa K3 (PJK3). Modul ini menekankan hak, kewajiban, dan tanggung jawab hukum pengusaha maupun tenaga kerja dalam mewujudkan nihil kecelakaan kerja.
              </p>
            </div>

            <!-- Topic 2 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">02</span>
                Sistem Manajemen K3 (SMK3) Sesuai PP No. 50 Tahun 2012 &amp; Audit SMK3
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini mendalami lima prinsip dasar penerapan SMK3 yang mencakup penetapan kebijakan, perencanaan, pelaksanaan rencana, pemantauan dan evaluasi kinerja K3, serta peninjauan dan peningkatan kinerja manajemen. Peserta dibekali pemahaman mendalam mengenai pedoman audit SMK3, interpretasi 166 kriteria audit, teknik pengumpulan bukti kepatuhan, serta penyusunan laporan audit internal. Pembahasan ini membekali peserta untuk mempersiapkan perusahaan menghadapi audit sertifikasi SMK3 eksternal.
              </p>
            </div>

            <!-- Topic 3 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">03</span>
                Norma K3 Pesawat Uap, Bejana Tekan, &amp; Tangki Timbun
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini membahas potensi bahaya ledakan dan pelepasan fluida bertekanan tinggi pada boiler industri, kompresor angin, bejana penyimpanan gas, serta tangki timbun bahan kimia. Peserta mempelajari regulasi pengawasan teknis instalasi uap, fungsi katup pengaman (safety valve), manometer tekanan, dan kaca penduga air. Materi menekankan pentingnya pemeriksaan berkala, uji hidrostatis, dan surat keterangan kelaikan operasi (suker) dari instansi pengawas ketenagakerjaan.
              </p>
            </div>

            <!-- Topic 4 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">04</span>
                Norma K3 Pesawat Angkat &amp; Angkut (PAA)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini membedah kelaikan operasional peralatan angkat dan angkut seperti overhead crane, mobile crane, forklift, dan elevator lift barang di area industri. Peserta mempelajari batas beban kerja aman (Safe Working Load / SWL), inspeksi fisik tali kawat baja (wire rope) dari keausan atau putus kawat, serta kelengkapan rem pengaman. Pembahasan juga mencakup kewajiban lisensi operator (SIO) dan sertifikat pengujian alat guna mencegah bahaya tertimpa beban jatuh atau alat terguling.
              </p>
            </div>

            <!-- Topic 5 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">05</span>
                Norma K3 Kelistrikan &amp; Penyalur Petir (Permenaker 12/2015 &amp; 31/2015)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Materi ini mengupas pengawasan keselamatan instalasi daya listrik industri dan proteksi bahaya petir sesuai Permenaker No. 12 Tahun 2015 dan Permenaker No. 31 Tahun 2015. Peserta mempelajari pencegahan bahaya arus hubung singkat, sengatan listrik, serta penerapan pembumian grounding dengan tahanan di bawah 5 Ohm. Dipelajari pula inspeksi instalasi penyalur petir elektrostatis maupun konvensional guna mengamankan struktur gedung dari sambaran petir langsung.
              </p>
            </div>

            <!-- Topic 6 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">06</span>
                Norma K3 Penanggulangan Kebakaran (Kepmenaker 186/1999)
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Topik ini mengkaji klasifikasi potensi bahaya kebakaran tempat kerja dan pembentukan unit tanggap darurat kebakaran sesuai Kepmenaker No. KEP.186/MEN/1999. Peserta mempelajari prinsip kerja sistem proteksi aktif seperti instalasi alarm deteksi asap, tabung APAR berbagai media pemadam, jaringan hidran gedung, serta sistem sprinkler otomatis. Modul ini membekali peserta dalam merancang skenario evakuasi darurat, jalur penyelamatan, dan titik kumpul yang aman.
              </p>
            </div>

            <!-- Topic 7 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">07</span>
                Norma K3 Konstruksi Bangunan &amp; Bekerja di Ketinggian
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Pembahasan materi ini menitikberatkan pada mitigasi risiko pada pekerjaan konstruksi sipil, pembongkaran, galian tanah, serta aktivitas bekerja di ketinggian lebih dari 1,8 meter. Peserta mempelajari inspeksi perancah (scaffolding), pemasangan jaring pengaman (safety net), penggunaan full body harness terhubung ke lifeline penahan jatuh, serta prosedur izin kerja risiko tinggi (Work Permit). Pengetahuan ini esensial guna mencegah fatalitas akibat insiden terjatuh dari ketinggian.
              </p>
            </div>

            <!-- Topic 8 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">08</span>
                Norma Kesehatan Kerja, Ergonomi, &amp; Toksikologi Industri
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Modul ini membedah faktor-faktor bahaya lingkungan kerja yang mempengaruhi kesehatan pekerja, mencakup faktor fisik (kebisingan, getaran, iklim kerja), faktor kimia (debu, uap pelarut, gas beracun), serta faktor biologis. Peserta dilatih menerapkan prinsip ergonomi gerakan kerja guna mencegah keluhan muskuloskeletal, memahami pemeriksaan kesehatan tenaga kerja (awal, berkala, khusus), serta mengelola fasilitas Pertolongan Pertama Pada Kecelakaan (P3K) di tempat kerja.
              </p>
            </div>

            <!-- Topic 9 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">09</span>
                Analisis Kecelakaan Kerja, JSA, &amp; Investigasi Insiden
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Kelompok materi ini memberikan metodologi praktis dalam menyusun Job Safety Analysis (JSA) untuk mengidentifikasi bahaya di setiap tahapan langkah kerja sebelum aktivitas dimulai. Peserta dibekali keahlian investigasi insiden menggunakan metode analisis akar penyebab (root cause analysis) guna menemukan tindakan tidak aman (unsafe act) dan kondisi tidak aman (unsafe condition). Hasil investigasi dituangkan ke dalam format laporan kecelakaan resmi untuk pelaporan ke instansi ketenagakerjaan dan pencegahan kejadian berulang.
              </p>
            </div>

            <!-- Topic 10 -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
                <span class="w-7 h-7 rounded-lg bg-amber-500/10 text-amber-700 font-mono text-xs flex items-center justify-center font-bold">10</span>
                Praktik Kerja Lapangan (PKL), Seminar &amp; Ujian Evaluasi
              </h3>
              <p class="text-sm text-slate-600 font-light leading-relaxed">
                Peserta melaksanakan observasi langsung ke fasilitas pabrik industri untuk melakukan audit inspeksi norma keselamatan kerja secara faktual. Hasil temuan di lapangan disusun menjadi kertas kerja laporan komprehensif yang diseminarkan di hadapan tim penguji. Rangkaian pembinaan diakhiri dengan ujian evaluasi teori tertulis yang diawasi langsung oleh pejabat pengawas Ditjen Binwasnaker Kemnaker RI untuk menentukan kelayakan penetapan Surat Keputusan Penunjukan.
              </p>
            </div>
          </div>
