---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Pelatihan K3 Laboratorium Jogja Semarang BNSP Biosafety";
const description = "Pelatihan K3 Laboratorium BNSP di Yogyakarta, Sleman, Semarang, dan Solo. Pengendalian B3 lab, lemari asam fume hood, serta ISO 17025. Cek jadwal WA.";
const canonical = "/pelatihan-k3-laboratorium-yogyakarta-semarang/";
const ogImage = "https://konsultank3.com/assets/images/pelatihan-k3-laboratorium-yogyakarta-hero.jpg";

const faqs = [
  {
    q: "Mengapa tenaga laboratorium di Yogyakarta dan Semarang perlu tersertifikasi K3 Laboratorium BNSP?",
    a: "Laboratorium pendidikan/riset di Sleman–Yogyakarta maupun laboratorium Quality Control (QC), pengujian pangan, farmasi, tekstil, dan lingkungan di Semarang, Solo, serta Batang bekerja harian dengan asam pekat, pelarut organik volatil, pemanas suhu tinggi, hingga agen biologis. Selain menjamin keselamatan analis dari luka bakar kimia maupun paparan kronis, sertifikat K3 Laboratorium BNSP mendukung kelengkapan SDM audit akreditasi SNI ISO/IEC 17025 oleh KAN serta akreditasi laboratorium kesehatan."
  },
  {
    q: "Apa perbedaan fungsi Fume Hood (Lemari Asam) dan Biosafety Cabinet (BSC) yang diajarkan dalam pelatihan?",
    a: "Fume Hood (lemari asam kimia) melindungi analis dan ruangan dengan menghisap uap kimia beracun dan korosif keluar cerobong melalui kecepatan udara muka (face velocity sekitar 0,4–0,5 m/detik), namun TIDAK melindungi sampel dari kontaminasi udara. Sebaliknya, Biosafety Cabinet (BSC kelas I/II/III) menggunakan filter HEPA untuk memproteksi pekerja, lingkungan, sekaligus sterilitas sampel mikrobiologi/patologi."
  },
  {
    q: "Berapa estimasi biaya Pelatihan K3 Laboratorium BNSP untuk area Yogyakarta, Solo, dan Jawa Tengah?",
    a: "Estimasi investasi pembinaan dan asesmen kompetensi K3 Laboratorium BNSP per peserta untuk jadwal kelas blended online berkisar Rp4.500.000 hingga Rp5.500.000, sedangkan untuk pelatihan tatap muka publik atau paket In-House di fasilitas laboratorium kampus, balai uji, atau pabrik di Yogyakarta dan Semarang berkisar Rp5.500.000 hingga Rp7.000.000."
  },
  {
    q: "Bagaimana penataan penyimpanan bahan kimia reaktif dan inkompatibel yang benar di ruang reagen?",
    a: "Bahan kimia tidak boleh disusun berdasarkan abjad (A–Z) semata karena berisiko mempertemukan oksidator kuat di samping pelarut organik mudah menyala atau asam di samping basa/sianida. Penyimpanan wajib dibagi berdasarkan kelompok sifat bahaya (Flammable Cabinet terhubung grounding, lemari asam anorganik vs organik terpisah, lemari korosif basa, dan lemari khusus bahan peroksida)."
  },
  {
    q: "Apakah pelatihan ini cocok bagi analis laboratorium universitas, politeknik, dan balai uji pemerintah di Jogja–Jateng?",
    a: "Sangat sesuai. Peserta rutin kami mencakup pranata laboratorium pendidikan (PLP), dosen/kepala laboratorium riset teknik kimia, farmasi, biologi, serta analis QC industri pangan, jamu, obat tradisional, cat, dan tekstil di koridor DIY–Jawa Tengah."
  },
  {
    q: "Apa syarat pendaftaran sertifikasi K3 Laboratorium skema BNSP?",
    a: "Peserta menyiapkan fotokopi KTP, ijazah minimal SLTA/SMK Analis Kimia/D3/S1 bidang relevan (Kimia, Biologi, Farmasi, Lingkungan, Teknik Kimia, atau Kesmas), pas foto latar merah, serta surat keterangan/portofolio pengalaman bekerja atau mengelola kegiatan di laboratorium."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pelatihan K3 Laboratorium BNSP", "item": "https://konsultank3.com/pelatihan-k3-laboratorium-bnsp/" },
        { "@type": "ListItem", "position": 3, "name": "K3 Laboratorium Yogyakarta Semarang", "item": "https://konsultank3.com/pelatihan-k3-laboratorium-yogyakarta-semarang/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan K3 Laboratorium (Biosafety & Chemical Safety) Yogyakarta, Solo & Semarang BNSP",
      "description": description,
      "courseCode": "K3-LAB-YOG-SMG",
      "educationalCredentialAwarded": "Sertifikat Pelatihan & Sertifikat Kompetensi K3 Laboratorium BNSP",
      "occupationalCategory": "Analis Laboratorium / Kepala Laboratorium / Penanggung Jawab K3 Lab",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": "4500000",
        "highPrice": "7000000",
        "offerCount": "2"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": ["Online", "Blended", "Onsite"],
        "courseWorkload": "PT28H",
        "location": {
          "@type": "Place",
          "name": "Koridor Pendidikan & Industri DIY - Jawa Tengah (Yogyakarta, Solo, Semarang)",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Yogyakarta",
            "addressRegion": "DI Yogyakarta",
            "addressCountry": "ID"
          }
        }
      }
    },
    {
      "@type": "Service",
      "name": "Layanan Pelatihan & Asesmen K3 Laboratorium DIY & Jawa Tengah",
      "serviceType": "Pembinaan Keselamatan Kerja Laboratorium Pengujian, Riset & QC Industri",
      "url": "https://konsultank3.com/pelatihan-k3-laboratorium-yogyakarta-semarang/",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com",
        "telephone": "+62-895-1025-3435"
      },
      "areaServed": [
        "Yogyakarta",
        "Sleman",
        "Bantul",
        "Semarang",
        "Ungaran",
        "Kendal",
        "Batang",
        "Solo",
        "Surakarta",
        "Karanganyar",
        "Cilacap"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={pageSchema}
  presetMessage="Halo Kak, saya mau informasi jadwal dan biaya Pelatihan K3 Laboratorium BNSP untuk instansi di Yogyakarta / Semarang / Jateng."
>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">

      <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan-k3-laboratorium-bnsp/" class="hover:text-amber-400 transition-colors">K3 Laboratorium BNSP</a>
        <span>/</span>
        <span class="text-slate-300">Yogyakarta &amp; Semarang</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/15 text-emerald-300 text-xs font-semibold border border-emerald-500/25">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse-glow"></span>
            SNI ISO/IEC 17025 &amp; Biosafety &bull; Koridor Yogyakarta &ndash; Solo &ndash; Semarang &ndash; Kendal &ndash; Cilacap
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-teal-200 to-sky-300">K3 Laboratorium Yogyakarta &amp; Semarang</span> BNSP Biosafety
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Program pembinaan sertifikasi <strong>K3 Laboratorium BNSP</strong> untuk pranata laboratorium riset kampus, balai pengujian pemerintah, lab patologi klinik, serta analis Quality Control (QC) industri farmasi, makanan, dan petrokimia di wilayah DIY dan Jawa Tengah.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, tim laboratorium kami ingin tanya jadwal & biaya Pelatihan K3 Laboratorium BNSP area Yogyakarta / Semarang.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Konsultasi Jadwal &amp; Biaya WA</span>
              <span>&rarr;</span>
            </a>
            <a
              href="/pelatihan-k3-laboratorium-bnsp/"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Silabus Induk K3 Lab &rarr;
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Sertifikasi</span>
              <p class="text-white font-bold text-sm">Kompetensi BNSP</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Standar Lab</span>
              <p class="text-white font-bold text-sm">ISO 17025 &amp; BSL</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Fokus Pengendalian</span>
              <p class="text-white font-bold text-sm">Fume Hood &amp; B3</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Jangkauan</span>
              <p class="text-emerald-300 font-bold text-sm">Jogja, Solo, Semarang</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/pelatihan-k3-laboratorium-yogyakarta-hero.jpg"
              alt="Analis laboratorium bekerja dengan lemari asam fume hood dan APD lengkap di laboratorium uji Yogyakarta Semarang"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-600 text-white mb-2">
                Dukungan Akreditasi Lab KAN &amp; Kepatuhan Riset
              </span>
              <div class="text-lg font-bold">Proteksi Reagen Reaktif, Gas &amp; Biologi</div>
              <p class="text-xs text-slate-300 mt-1">
                Inspeksi kelayakan fume hood, matriks kompatibilitas penyimpanan kimia, serta tanggap darurat tumpahan pelarut laboratorium.
              </p>
            </div>
          </div>

          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center font-bold text-lg">✓</div>
            <div>
              <div class="text-xs font-bold text-white">Sertifikat Garuda BNSP</div>
              <div class="text-[10px] text-slate-400">Terverifikasi LSP Nasional</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">🔬</div>
            <div>
              <div class="text-xs font-bold text-white">Kampus &amp; Lab QC Industri</div>
              <div class="text-[10px] text-slate-400">Jogja &bull; Solo &bull; Semarang</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <aside aria-label="Informasi Pembaruan & Jadwal" class="w-full bg-emerald-500/10 border-b border-emerald-500/20 py-3 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-800 font-medium">
      <span class="inline-flex items-center gap-1.5 font-bold text-emerald-950">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Diperbarui November 2026 &bull; Sentra Riset &amp; Manufaktur DIY – Jateng:
      </span>
      <span class="text-slate-700">Tersedia jadwal kelas blended untuk PLP kampus maupun In-House lab industri di Kendal, Ungaran, dan Batang.</span>
      <a
        href={waLink("Halo Kak, minta jadwal pelatihan K3 Laboratorium BNSP terdekat untuk tim kami di Yogyakarta / Semarang.")}
        target="_blank"
        rel="noopener"
        class="text-emerald-800 hover:text-emerald-950 font-bold underline ml-1"
      >
        Cek Jadwal via WhatsApp ({WA_DISPLAY}) &rarr;
      </a>
    </div>
  </aside>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Quick Answer + Lab Safety Matrix -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">Ringkasan Jawaban Cepat</span>
        <h2 class="text-2xl font-serif font-bold text-slate-900">Kebutuhan Kepatuhan K3 Laboratorium di Poros Joglosemar</h2>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          Koridor <strong>Yogyakarta–Solo–Semarang (Joglosemar)</strong> menghimpun ratusan laboratorium pengujian akademik dan riset terapan di Sleman–Bantul, laboratorium uji klinis &amp; pengawasan mutu obat-makanan, hingga lab QC pabrik farmasi, jamu modern, makanan-minuman, serta tekstil ekspor di Ungaran, Kendal, dan KIT Batang.
        </p>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          Insiden tumpahan asam sulfat/perklorat, pecahan alat gelas terkontaminasi, maupun kegagalan aliran hisap lemari asam (<em>fume hood</em>) sangat sering berawal dari kurangnya pemahaman klasifikasi bahaya di ruang sempit. Program regional ini memperkuat materi <a href="/pelatihan-k3-laboratorium-bnsp/" class="text-emerald-700 font-bold underline">Pelatihan K3 Laboratorium BNSP Induk</a> guna memenuhi kebutuhan teknis lab kampus dan QA/QC Jawa Tengah–DIY.
        </p>
      </div>

      <div class="lg:col-span-6 overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-slate-700">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th class="py-3.5 px-4">Aspek Pengendalian Lab</th>
              <th class="py-3.5 px-4">Standar Verifikasi Kompetensi</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">Ventilasi Lokal &amp; Biosafety</td>
              <td class="py-3 px-4">Audit fungsi Fume Hood (0,4–0,5 m/s), BSC Kelas I–II, dan kalibrasi aliran udara</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">Segregasi Reagen Kimia</td>
              <td class="py-3 px-4">Matriks kompatibilitas asam, basa, oksidator, serta penyimpanan silinder gas lab</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">Pengelolaan Limbah &amp; Spill Kit</td>
              <td class="py-3 px-4">Penetralan ceceran asam-basa, limbah merkuri/eter, serta manifest TPS B3</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">Ergonomi &amp; Kelistrikan Instrumen</td>
              <td class="py-3 px-4">Pemeriksaan alat sentrifugasi, autoklaf bertekanan, dan beban listrik HPLC/AAS</td>
            </tr>
            <tr>
              <td class="py-3 px-4 font-bold text-slate-900">Estimasi Biaya</td>
              <td class="py-3 px-4 font-semibold text-emerald-700">Blended Rp4,5–5,5 jt &bull; Offline/In-House Rp5,5–7 jt</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Regional Industrial & Campus Clusters -->
    <section class="space-y-8">
      <div class="max-w-3xl space-y-2">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">Koridor Kampus Riset &amp; Kawasan Industri Jateng – DIY</span>
        <h2 class="text-3xl font-serif font-extrabold text-slate-900">Jangkauan Pelatihan dari Yogyakarta, Solo hingga Semarang &amp; Cilacap</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Yogyakarta, Sleman &amp; Bantul</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Pembinaan pranata laboratorium pendidikan (PLP) perguruan tinggi negeri/swasta, laboratorium biomedis, serta lab pengujian lingkungan daerah.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Semarang (KIW, BSB) &amp; Ungaran</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Sertifikasi analis laboratorium QA/QC industri farmasi, obat herbal/jamu, garmen, serta laboratorium uji pangan terakreditasi KAN.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Kendal (KIK) &amp; Batang (KITB)</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Mendukung lab kendali mutu pabrik elektronik, material baterai, keramik ekspor, dan manufaktur kimia di sepanjang koridor Pantura Jawa Tengah.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Solo, Sukoharjo &amp; Karanganyar</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Laboratorium pencelupan/pewarnaan tekstil, farmasi, serta riset politeknik manufaktur di kawasan Solo Raya.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Cilacap &amp; Purwokerto</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Laboratorium pengujian hidrokarbon kilang, semen, air limbah industri, serta fasilitas pendidikan tinggi Jawa Tengah bagian selatan.
          </p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
          <h3 class="font-bold text-slate-900 text-base">Magelang &amp; Kudus (Pantura Timur)</h3>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
            Program fleksibel daring maupun In-House guna memenuhi kelengkapan sertifikasi personel QA laboratorium kertas, rokok, dan pangan.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Cross Links + Registration Box -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-5">
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 block">Program Terkait Lingkungan &amp; Kesehatan Kerja</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-extrabold text-slate-900">Padukan Sertifikasi K3 Lab dengan Pengendalian Lingkungan Kerja</h2>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Banyak instansi riset, rumah sakit, dan pabrik pengujian mutu di Jateng–DIY yang sekaligus mendaftarkan staf laboratoriumnya ke jalur pendukung berikut untuk menutup celah audit K3 &amp; lingkungan secara menyeluruh:
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs sm:text-sm">
          <a href="/pelatihan-higiene-industri-pasuruan-sidoarjo/" class="p-4 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-400 transition-colors">
            <strong class="text-emerald-800 block mb-1">Ahli Higiene Industri Muda (HIMU) BNSP &rarr;</strong>
            <span class="text-slate-600 text-xs">Kompetensi sampling uap kimia, kebisingan, debu, serta analisis pajanan pekerja di lab &amp; produksi.</span>
          </a>
          <a href="/pelatihan-k3-rumah-sakit-bandung-jakarta/" class="p-4 rounded-xl bg-slate-50 border border-slate-200 hover:border-emerald-400 transition-colors">
            <strong class="text-emerald-800 block mb-1">K3 Rumah Sakit (K3RS) Akreditasi BNSP &rarr;</strong>
