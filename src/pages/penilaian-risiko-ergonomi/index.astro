---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Penilaian Risiko Ergonomi & Workstation Design K3";
const description = "Jasa audit & penilaian risiko ergonomi Permenaker 5/2018: analisis RULA, REBA, NIOSH Lifting Equation, ROSA, dan perancangan stasiun kerja industri/kantor.";
const canonical = "/penilaian-risiko-ergonomi/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Kesehatan Kerja", "item": "https://konsultank3.com/penyakit-akibat-kerja/" },
        { "@type": "ListItem", "position": 3, "name": "Penilaian Risiko Ergonomi", "item": "https://konsultank3.com/penilaian-risiko-ergonomi/" }
      ]
    },
    {
      "@type": "Service",
      "name": "Jasa Audit & Penilaian Risiko Ergonomi Industri - RULA, REBA, NIOSH & ROSA",
      "serviceType": "Ergonomics Risk Assessment & Engineering Design",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa dasar hukum kewajiban pengukuran ergonomi di tempat kerja Indonesia?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Peraturan Menteri Ketenagakerjaan No. 5 Tahun 2018 tentang K3 Lingkungan Kerja mewajibkan pengusaha melakukan penilaian dan pengendalian potensi bahaya faktor ergonomi terhadap cara kerja, posisi kerja, postur tubuh, dan pengangkatan beban manual."
          }
        },
        {
          "@type": "Question",
          "name": "Kapan perusahaan harus menggunakan metode RULA versus REBA?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "RULA (Rapid Upper Limb Assessment) digunakan khusus untuk pekerjaan yang bertumpu pada ekstremitas atas (leher, bahu, lengan, pergelangan tangan) seperti posisi duduk, operator VDU, atau perakitan presisi. Sedangkan REBA (Rapid Entire Body Assessment) digunakan untuk pekerjaan dengan variasi postur seluruh tubuh, berdiri dinamis, atau pekerjaan fisik di area pabrik dan logistik."
          }
        },
        {
          "@type": "Question",
          "name": "Bagaimana penilaian ergonomi membantu menurunkan angka absensi karyawan?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Keluhan Musculoskeletal Disorders (MSDs) seperti low back pain dan carpal tunnel syndrome merupakan pemicu utama absensi sakit kronis. Redesain stasiun kerja berbasis antropometri terbukti menurunkan tingkat keluhan fisik hingga lebih dari 60% dan meningkatkan output produktivitas kerja."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Section -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/penyakit-akibat-kerja/" class="hover:text-amber-400 transition-colors">Kesehatan Kerja</a>
        <span>/</span>
        <span class="text-slate-300">Penilaian Risiko Ergonomi</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Kepatuhan Permenaker No. 5/2018 &bull; Pencegahan MSDs
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Penilaian Risiko Ergonomi &amp; <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Desain Stasiun Kerja</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Audit biomekanika postur kerja (RULA, REBA, NIOSH Lifting Equation, ROSA) dan rekayasa ergonomi stasiun kerja industri untuk mengeliminasi cedera otot rangka (MSDs) dan mengoptimalkan produktivitas lini operasional.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, kami ingin berdiskusi mengenai audit dan asesmen risiko ergonomi tempat kerja (Permenaker 5/2018)")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105"
            >
              Konsultasi Audit Ergonomi &rarr;
            </a>
            <a
              href="#metode-evaluasi"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat 4 Metode Evaluasi
            </a>
          </div>

          <!-- Quick Stats Bar -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Regulasi</span>
              <p class="text-white font-bold text-sm">Permenaker 5/2018</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Metodologi</span>
              <p class="text-white font-bold text-sm">RULA, REBA, NIOSH</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Sektor</span>
              <p class="text-white font-bold text-sm">Pabrik &amp; Kantor VDU</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Keluaran</span>
              <p class="text-emerald-400 font-bold text-sm">Redesain Stasiun Kerja</p>
            </div>
          </div>
        </div>

        <!-- Right Column: Card -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/hero-safety-officer.jpg"
              alt="Pengukuran Biomekanika Postur Kerja Ergonomi Lapangan"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>
            
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-500 text-slate-950 mb-2">
                Biomekanika &amp; Antropometri
              </span>
              <div class="text-lg font-bold">Sesuaikan Pekerjaan dengan Manusia</div>
              <p class="text-xs text-slate-300 mt-1">Bukan memaksa tubuh pekerja beradaptasi pada stasiun kerja yang dirancang buruk.</p>
            </div>
          </div>

          <!-- Badges -->
          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-500 text-white flex items-center justify-center font-bold text-lg">
              ✓
            </div>
            <div>
              <div class="text-xs font-bold text-white">Bebas Nyeri Otot &amp; HNP</div>
              <div class="text-[10px] text-slate-400">Pencegahan Penyakit Akibat Kerja</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">📐</div>
            <div>
              <div class="text-xs font-bold text-white">Engineering Controls</div>
              <div class="text-[10px] text-slate-400">Desain Meja, Kursi &amp; Konveyor</div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Main Content Layout -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      
      <!-- Left Column: Rich Technical Guide (8 cols) -->
      <article class="lg:col-span-8 space-y-14 text-slate-800 leading-relaxed">
        
        <!-- Section: Mengapa Ergonomi Kritis -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Dampak Medis &amp; Finansial</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Musculoskeletal Disorders (MSDs): Ancaman Tersembunyi Efisiensi Pabrik
            </h2>
          </div>

          <p class="text-slate-700 leading-relaxed">
            Di banyak industri manufaktur, perakitan komponen, logistik pergudangan, hingga operasional kantor perbankan, keluhan nyeri otot rangka (<em>Musculoskeletal Disorders - MSDs</em>) kerap dianggap sebagai "keluhan biasa" atau faktor penuaan. Faktanya, berdasarkan data Organisasi Kesehatan Dunia (WHO) dan Kementerian Ketenagakerjaan RI, MSDs seperti <strong>Low Back Pain (nyeri pinggang bawah), Carpal Tunnel Syndrome (CTS), Tendinitis, dan Herniated Nucleus Pulposus (HNP)</strong> merupakan penyebab nomor satu kompensasi klaim kesehatan dan kehilangan jam kerja efektif.
          </p>

          <p class="text-slate-700 leading-relaxed">
            Berdasarkan <strong>Permenaker No. 5 Tahun 2018 tentang Keselamatan dan Kesehatan Kerja Lingkungan Kerja</strong>, faktor ergonomi memiliki kedudukan hukum yang sama kuatnya dengan faktor fisika (kebisingan/pencahayaan) dan kimia. Perusahaan berkewajiban melakukan pengukuran risiko postur janggal, gerakan berulang (<em>repetitive motion</em>), angkat-angkut manual (<em>manual handling</em>), dan getaran mekanis.
          </p>

          <div class="p-6 rounded-2xl bg-amber-500/10 border border-amber-500/20 space-y-3">
            <div class="flex items-center gap-2 text-amber-900 font-bold text-sm">
              <span class="text-lg">⚖️</span>
              Pasal 23 &ndash; 24 Permenaker No. 5/2018
            </div>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed">
              Pengurus tempat kerja diwajibkan melakukan penyesuaian antara tata cara kerja, posisi kerja, peralatan, dan lingkungan kerja terhadap keterbatasan anatomis, fisiologis, dan psikologis tenaga kerja guna mewujudkan produktivitas optimal tanpa mengorbankan kesehatan jangka panjang.
            </p>
          </div>
        </section>

        <!-- Section: 4 Metode Penilaian Ergonomi Standar Emas -->
        <section id="metode-evaluasi" class="space-y-6 scroll-mt-24">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Metodologi Pengukuran</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              4 Metode Standar Penilaian Risiko Ergonomi yang Kami Terapkan
            </h2>
          </div>

          <p class="text-slate-700">
            Kami mengombinasikan instrumen biomekanika berskala internasional yang diakui oleh akademisi dan pengawas K3 Kemnaker RI:
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- RULA Card -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-amber-100 text-amber-800">Metode 01 &bull; Postur Tubuh Atas</span>
                <span class="text-xs text-slate-400">Skor 1 &ndash; 7</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">RULA (Rapid Upper Limb Assessment)</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Dioptimalkan untuk pekerjaan dengan pembebanan pada leher, bahu, lengan atas, lengan bawah, dan pergelangan tangan. Sangat cocok untuk operator perakitan elektronik, operator mesin presisi, teknisi jahit garmen, dan pekerjaan meja perakitan.
              </p>
              <div class="text-[11px] text-amber-700 font-semibold pt-1 border-t border-slate-100">
                Fokus Output: Rekomendasi sudut elevasi lengan &amp; elevasi meja kerja.
              </div>
            </div>

            <!-- REBA Card -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-blue-100 text-blue-800">Metode 02 &bull; Seluruh Tubuh Dinamis</span>
                <span class="text-xs text-slate-400">Skor 1 &ndash; 15</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">REBA (Rapid Entire Body Assessment)</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Mengevaluasi postur statis maupun dinamis seluruh tubuh, termasuk batang tubuh (punggung), leher, kaki, dan lengan. Ideal untuk pekerjaan gudang logistik, maintenance mesin industri, tenaga kesehatan, dan bongkar-muat kargo.
              </p>
              <div class="text-[11px] text-blue-700 font-semibold pt-1 border-t border-slate-100">
                Fokus Output: Skala prioritas tindakan perbaikan (Action Level 0 s.d 4).
              </div>
            </div>

            <!-- NIOSH Card -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-rose-100 text-rose-800">Metode 03 &bull; Angkat Beban Manual</span>
                <span class="text-xs text-slate-400">RWL &amp; Lifting Index</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">NIOSH Lifting Equation (Manual Handling)</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Formula biomekanika untuk menghitung Batas Berat yang Direkomendasikan (<em>Recommended Weight Limit - RWL</em>) berdasarkan 6 pengali: jarak horizontal, posisi vertikal awal, jarak tempuh perpindahan, sudut asimetri/putaran tubuh, frekuensi angkat, dan kualitas pegangan (coupling).
              </p>
              <div class="text-[11px] text-rose-700 font-semibold pt-1 border-t border-slate-100">
                Fokus Output: Lifting Index (LI) &gt; 1 mengindikasikan risiko cedera tulang belakang.
              </div>
            </div>

            <!-- ROSA Card -->
            <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 rounded-md text-[11px] font-bold bg-emerald-100 text-emerald-800">Metode 04 &bull; Ergonomi Perkantoran</span>
                <span class="text-xs text-slate-400">Skor 1 &ndash; 10</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900">ROSA (Rapid Office Strain Assessment)</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                Dirancang khusus untuk pekerja layar monitor (VDU/komputer) dan staf kantor. Menilai interaksi ketinggian kursi, sandaran punggung bawah (lumbar support), posisi sandaran lengan, jarak mata ke monitor, penempatan mouse, dan sudut keyboard.
              </p>
              <div class="text-[11px] text-emerald-700 font-semibold pt-1 border-t border-slate-100">
                Fokus Output: Mencegah sindrom leher kaku (text neck) dan ketegangan mata.
              </div>
            </div>
          </div>
        </section>

        <!-- Section: Tahapan Pelaksanaan Audit Ergonomi -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Standard Operating Procedure</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Alur 4 Tahap Asesmen Ergonomi di Fasilitas Anda
            </h2>
          </div>

          <div class="space-y-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                01
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 1: Survei Kuesioner Nordic Body Map (NBM)</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Menyebarkan kuesioner terstandarisasi untuk memetakan distribusi rasa sakit pada 28 titik otot pekerja. Data ini digunakan untuk menyaring stasiun kerja yang memiliki prevalensi keluhan tertinggi.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                02
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 2: Video Recording &amp; Pengukuran Geometri Stasiun Kerja</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Perekaman siklus kerja aktual dari berbagai sudut pandang (sagittal &amp; coronal plane), pengukuran dimensi fisik stasiun kerja (tinggi meja, jangkauan raihan, berat beban), dan pencatatan frekuensi gerakan berulang.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                03
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 3: Kalkulasi Skor Biomekanika &amp; Severity Ranking</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Mengolah data menggunakan perangkat lunak analisis ergonomi untuk menghasilkan skor RULA/REBA/NIOSH, menentukan level urgensi tindakan perbaikan, dan mengidentifikasi pemicu utama kelelahan otot.
                </p>
              </div>
            </div>

            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm flex gap-4 items-start">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-slate-950 font-bold flex items-center justify-center shrink-0">
                04
              </div>
              <div class="space-y-1">
                <h3 class="text-base font-bold text-slate-900">Tahap 4: Desain Rekayasa Teknik &amp; Laporan Tindak Lanjut</h3>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                  Menghasilkan rancangan teknis stasiun kerja baru berbasis persentil antropometri tenaga kerja Indonesia (persentil 5th hingga 95th), rekomendasi alat bantu mekanis, SOP postur aman, dan modul pelatihan peregangan berkala.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- Section: Deliverables -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">Paket Laporan</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Keluaran Resmi Asesmen Ergonomi untuk Perusahaan
            </h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">📊 Laporan Komprehensif Permenaker 5/2018</div>
              <p class="text-xs text-slate-600">Dokumen legal hasil audit ergonomi yang siap diserahkan kepada Pengawas Ketenagakerjaan Disnaker dan auditor eksternal SMK3.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">📐 Cetak Biru Rekayasa Stasiun Kerja</div>
              <p class="text-xs text-slate-600">Spesifikasi dimensi meja, kursi kerja, tinggi konveyor, dan tata letak alat berdasarkan tabel antropometri pekerja.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">📦 Pedoman Batas Angkat Beban (NIOSH RWL)</div>
              <p class="text-xs text-slate-600">Panduan operasional batas beban angkat aman untuk mencegah kecelakaan sakit pinggang (HNP) pada lini logistik.</p>
            </div>
            <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
              <div class="text-amber-500 font-bold text-base">🧘 Modul Workplace Stretching &amp; Microbreaks</div>
              <p class="text-xs text-slate-600">Panduan gerakan peregangan 5 menit di tempat kerja yang dapat dipandu oleh supervisor saat briefing harian.</p>
            </div>
          </div>
        </section>

        <!-- Section: FAQ -->
        <section class="space-y-6">
          <div class="border-b border-slate-200 pb-4">
            <span class="text-xs font-mono uppercase tracking-widest text-amber-600 font-semibold block mb-1">FAQ</span>
            <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-950">
              Pertanyaan yang Sering Diajukan Seputar Penilaian Risiko Ergonomi
            </h2>
          </div>

          <div class="space-y-3">
            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Berapa lama proses asesmen ergonomi berlangsung di lapangan?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Pengambilan data lapangan tipikal memakan waktu 2 hingga 4 hari kerja tergantung pada jumlah stasiun kerja yang disurvei, dilanjutkan dengan 2–3 minggu proses pengolahan data biomekanika dan penyusunan rekomendasi desain rekayasa.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apakah perbaikan ergonomi selalu membutuhkan biaya pengadaan alat yang mahal?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Tidak. Filosofi kami mengutamakan perbaikan bertahap (Low Cost, High Impact). Banyak temuan risiko tinggi dapat diturunkan drastis hanya dengan mengubah ketinggian dudukan palet, mengubah sudut kemiringan wadah baut, menambahkan footrest sederhana, atau menjadwalkan rotasi tugas kerja setiap 2 jam.
              </p>
            </details>

            <details class="group p-4 rounded-xl bg-white border border-slate-200 open:border-amber-400 transition-colors">
              <summary class="font-bold text-sm text-slate-900 cursor-pointer flex justify-between items-center">
                Apakah asesmen ergonomi ini mencakup pekerja kantoran (office ergonomics)?
                <span class="text-amber-500 font-bold group-open:rotate-180 transition-transform">&darr;</span>
              </summary>
              <p class="text-xs sm:text-sm text-slate-600 mt-3 leading-relaxed">
                Ya. Melalui instrumen ROSA (Rapid Office Strain Assessment), kami mengaudit stasiun kerja komputer kantor, termasuk kesesuaian kursi kerja ergonomis, jarak pandang layar monitor ganda, ketinggian meja, dan pencahayaan untuk mencegah ketegangan mata dan sakit leher kronis.
              </p>
            </details>
          </div>
        </section>

