---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { WA_DISPLAY, waLink } from '../../data/contact.js';

const title = "Auditor SMK3 Kemnaker RI & Jasa Perpanjangan SKP";
const description = "Pelatihan sertifikasi Auditor SMK3 Kemnaker RI & jasa perpanjangan SKP resmi. Kuasai 166 kriteria audit PP 50/2012, studi kasus industri, dan ujian lisensi.";
const canonical = "/pelatihan-auditor-smk3-kemnaker/";

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Pelatihan K3", "item": "https://konsultank3.com/pelatihan/" },
        { "@type": "ListItem", "position": 3, "name": "Auditor SMK3 Kemnaker", "item": "https://konsultank3.com/pelatihan-auditor-smk3-kemnaker/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan Sertifikasi Auditor SMK3 Kemnaker RI & Perpanjangan SKP",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "educationalCredentialAwarded": "Sertifikat & SKP Auditor SMK3 Kemnaker RI",
      "occupationalCategory": "K3 Auditor / Lead Auditor SMK3",
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "Blended / In-House / Public",
        "courseWorkload": "PT40H"
      }
    },
    {
      "@type": "Service",
      "name": "Layanan Konsultasi & Pengurusan Perpanjangan SKP Auditor SMK3",
      "serviceType": "Occupational Safety and Health Auditor Licensing Service",
      "description": "Layanan asistensi audit internal SMK3, evaluasi portofolio audit, dan pengurusan perpanjangan SKP Auditor SMK3 resmi via portal Kemnaker RI.",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "areaServed": "Indonesia"
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Apa perbedaan Auditor Internal SMK3 dan Auditor Eksternal SMK3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Auditor Internal SMK3 adalah personel internal perusahaan bersertifikat yang ditunjuk untuk memverifikasi efektivitas penerapan SMK3 secara berkala di tempat kerja. Auditor Eksternal SMK3 adalah auditor senior yang bekerja di bawah Lembaga Audit Independen resmi yang ditunjuk oleh Menteri Ketenagakerjaan untuk melaksanakan audit sertifikasi formal guna menerbitkan sertifikat emas atau perak SMK3."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa lama masa berlaku SKP Auditor SMK3 Kemnaker RI?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "SKP (Surat Keputusan Penunjukan) Auditor SMK3 Kemnaker berlaku selama 3 (tiga) tahun. Pemegang SKP wajib memperpanjang lisensinya sebelum masa berlakunya berakhir dengan menyertakan bukti portofolio audit SMK3 yang telah dilakukan selama masa penunjukan."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa tarif resmi PNBP untuk perpanjangan SKP Auditor SMK3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Berdasarkan PP No. 41 Tahun 2023 tentang Penerimaan Negara Bukan Pajak (PNBP) di lingkungan Kementerian Ketenagakerjaan, tarif resmi evaluasi dokumen sebesar Rp120.000 dan penerbitan perpanjangan SKP sebesar Rp150.000 (total PNBP murni Rp270.000), di luar biaya pembinaan, verifikasi berkas, atau jasa administrasi PJK3."
          }
        },
        {
          "@type": "Question",
          "name": "Apakah sertifikat Ahli K3 Umum wajib dimiliki sebelum ikut Auditor SMK3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Ya, kepemilikan sertifikat pembinaan dan SKP Ahli K3 Umum yang masih aktif merupakan syarat prasyarat mutlak yang diwajibkan oleh Kemnaker RI untuk dapat didaftarkan dalam program pembinaan Auditor SMK3."
          }
        },
        {
          "@type": "Question",
          "name": "Berapa kriteria audit yang dipelajari dalam pembinaan Auditor SMK3?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Peserta mempelajari 166 kriteria audit SMK3 yang tercantum dalam Lampiran II PP No. 50 Tahun 2012, meliputi 12 elemen audit mulai dari komitmen kebijakan, perencanaan, pengendalian operasi, hingga peninjauan ulang manajemen."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout title={title} description={description} canonical={canonical} schema={pageSchema}>
  <!-- Hero Header -->
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
      
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan/" class="hover:text-amber-400 transition-colors">Pelatihan K3</a>
        <span>/</span>
        <span class="text-slate-300">Auditor SMK3 Kemnaker</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left Column -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold border border-amber-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
            Sertifikasi Resmi Kemnaker RI &bull; PP No. 50 Tahun 2012
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pembinaan <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-amber-300 to-yellow-500">Auditor SMK3 Kemnaker RI</span> &amp; Perpanjangan SKP
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Tingkatkan kapabilitas kepatuhan industri dengan mencetak Auditor Internal berlisensi resmi. Kuasai metodologi audit 166 kriteria, penentuan temuan mayor/minor, serta layanan perpanjangan SKP Auditor Kemnaker sebelum masa berlaku berakhir.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo KonsultanK3, kami ingin berkonsultasi mengenai pendaftaran Pelatihan Auditor SMK3 Kemnaker / Pengurusan Perpanjangan SKP")}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/20 transition-all transform hover:-translate-y-0.5"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              Konsultasi Program &amp; SKP
            </a>
            <a
              href="#silabus"
              class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-white/5 hover:bg-white/10 text-white font-semibold text-sm border border-white/10 transition-colors"
            >
              Lihat 166 Kriteria Audit
            </a>
          </div>
        </div>

        <!-- Right Column: Quick Highlights -->
        <div class="lg:col-span-5">
          <div class="p-6 sm:p-8 rounded-3xl bg-slate-900/80 border border-white/10 backdrop-blur-sm shadow-2xl space-y-6">
            <h3 class="font-serif text-lg font-bold text-white flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-400"></span>
              Profil Program Sertifikasi
            </h3>
            
            <dl class="space-y-4 text-xs sm:text-sm">
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Sertifikasi &amp; Lisensi</dt>
                <dd class="text-white font-semibold text-right">Kemnaker RI (Sertifikat + SKP)</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Landasan Hukum</dt>
                <dd class="text-amber-300 font-semibold text-right">PP No. 50/2012 &amp; UU 1/1970</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Prasyarat Wajib</dt>
                <dd class="text-white font-semibold text-right">Ahli K3 Umum Aktif (Min. D3/S1)</dd>
              </div>
              <div class="flex justify-between pb-3 border-b border-white/10">
                <dt class="text-slate-400">Masa Berlaku SKP</dt>
                <dd class="text-white font-semibold text-right">3 Tahun (Dapat Diperpanjang)</dd>
              </div>
              <div class="flex justify-between">
                <dt class="text-slate-400">Cakupan Evaluasi</dt>
                <dd class="text-emerald-400 font-semibold text-right">166 Kriteria / 12 Elemen</dd>
              </div>
            </dl>

            <div class="pt-2">
              <div class="p-3.5 rounded-xl bg-amber-500/10 border border-amber-500/20 text-xs text-amber-200 leading-relaxed">
                <strong>Catatan Kepatuhan:</strong> Audit internal SMK3 wajib dilakukan minimal 1 kali per tahun oleh Auditor yang ditunjuk pengurus perusahaan sebagai syarat pra-audit eksternal.
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </header>

  <!-- Navigation Anchor Strip -->
  <div class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm text-xs sm:text-sm font-medium">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex overflow-x-auto gap-6 py-3 scrollbar-none text-slate-600">
      <a href="#urgensi" class="hover:text-amber-600 whitespace-nowrap">Urgensi Auditor</a>
      <a href="#kriteria-audit" class="hover:text-amber-600 whitespace-nowrap">Tingkatan 166 Kriteria</a>
      <a href="#silabus" class="hover:text-amber-600 whitespace-nowrap">Silabus &amp; Kurikulum</a>
      <a href="#perpanjangan-skp" class="hover:text-amber-600 whitespace-nowrap text-amber-700 font-bold">Layanan Perpanjangan SKP</a>
      <a href="#syarat" class="hover:text-amber-600 whitespace-nowrap">Syarat Pendaftaran</a>
      <a href="#faq" class="hover:text-amber-600 whitespace-nowrap">FAQ</a>
    </div>
  </div>

  <!-- Content Sections -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Urgensi Auditor SMK3 Internal -->
    <section id="urgensi" class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
      <div class="lg:col-span-8 space-y-6 text-slate-700 leading-relaxed text-base">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">Kewajiban Perusahaan &amp; Regulasi</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Mengapa Perusahaan Membutuhkan Auditor SMK3 Berlisensi Kemnaker?
        </h2>
        <p>
          Berdasarkan <strong>Peraturan Pemerintah No. 50 Tahun 2012</strong> Pasal 5, setiap perusahaan yang mempekerjakan minimal 100 orang pekerja atau memiliki potensi bahaya tinggi (seperti petrokimia, migas, konstruksi, pertambangan, dan manufaktur berat) <strong>wajib menerapkan Sistem Manajemen Keselamatan dan Kesehatan Kerja (SMK3)</strong>.
        </p>
        <p>
          Namun, sertifikasi emas atau perak dari Kemnaker RI tidak dapat diraih secara instan. Pada Pasal 14 ayat (1) ditegaskan bahwa pengurus perusahaan wajib melakukan <em>peninjauan ulang dan audit internal secara berkala</em> untuk menguji efektivitas sistem sebelum diaudit oleh Lembaga Audit Eksternal resmi.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2">
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-amber-500/10 text-amber-600 flex items-center justify-center font-bold text-sm">01</div>
            <h4 class="font-bold text-slate-900 text-sm">Persiapan Audit Eksternal Tanpa Temuan Mayor</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Auditor internal bertugas mendeteksi kesenjangan operasional (*gap analysis*), mencegah temuan kategori kritis/mayor yang dapat membatalkan sertifikat emas SMK3.
            </p>
          </div>
          <div class="p-5 rounded-2xl bg-slate-50 border border-slate-200 space-y-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 text-emerald-600 flex items-center justify-center font-bold text-sm">02</div>
            <h4 class="font-bold text-slate-900 text-sm">Poin Plus Kredensial Tender Korporasi</h4>
            <p class="text-xs text-slate-600 leading-relaxed">
              Memiliki auditor internal ber-SKP aktif membuktikan kepada Owner proyek migas/BUMN bahwa sistem keselamatan perusahaan dikontrol secara objektif dan sistematis.
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-4 p-6 rounded-3xl bg-slate-900 text-white space-y-5 border border-slate-800 shadow-xl">
        <h3 class="font-serif text-lg font-bold text-amber-400">Hierarki Kewenangan Auditor K3</h3>
        <ul class="space-y-4 text-xs leading-relaxed">
          <li class="pb-3 border-b border-white/10 space-y-1">
            <span class="font-bold text-white block text-sm">Auditor Internal SMK3</span>
            <span class="text-slate-300">Pegawai perusahaan yang telah lulus pelatihan pembinaan Auditor SMK3 Kemnaker dan memiliki sertifikat/SKP penunjukan. Menjalankan audit mandiri berkala di lingkungan internal.</span>
          </li>
          <li class="pb-3 border-b border-white/10 space-y-1">
            <span class="font-bold text-white block text-sm">Auditor Eksternal SMK3 (Senior)</span>
            <span class="text-slate-300">Auditor profesional yang teregistrasi di Kemnaker dan bernaung di bawah Lembaga Audit Independen resmi (PJK3 Audit) untuk melakukan sertifikasi nasional.</span>
          </li>
          <li class="space-y-1">
            <span class="font-bold text-white block text-sm">Pengawas Ketenagakerjaan K3</span>
            <span class="text-slate-300">Aparatur Sipil Negara (ASN) Pengawas Disnaker / Kemnaker yang berwenang melakukan inspeksi yuridis dan penegakan hukum ketenagakerjaan.</span>
          </li>
        </ul>
      </div>
    </section>

    <!-- Section 2: 166 Kriteria Audit PP 50/2012 -->
    <section id="kriteria-audit" class="space-y-8">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-600 block">Kerangka Teknis Evaluasi</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Struktur Tingkatan Audit SMK3: 64, 122, dan 166 Kriteria
        </h2>
        <p class="text-slate-600 text-sm leading-relaxed">
          Sesuai Lampiran II PP No. 50 Tahun 2012, pembinaan Auditor SMK3 mendalami 12 elemen wajib dengan kedalaman kriteria yang disesuaikan dengan tingkat risiko perusahaan:
        </p>
      </div>

      <!-- Table Matrix -->
      <div class="overflow-x-auto rounded-2xl border border-slate-200 shadow-sm bg-white">
        <table class="w-full text-left text-xs sm:text-sm">
          <thead class="bg-slate-900 text-white font-semibold uppercase tracking-wider text-[11px]">
            <tr>
              <th class="p-4 sm:p-5">Tingkat Penilaian Audit</th>
              <th class="p-4 sm:p-5">Jumlah Kriteria</th>
              <th class="p-4 sm:p-5">Target Profil Perusahaan</th>
              <th class="p-4 sm:p-5">Ambang Kelulusan Sertifikat</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-slate-900">Tingkat Awal (Basic)</td>
              <td class="p-4 sm:p-5"><span class="px-2.5 py-1 rounded-full bg-slate-100 font-bold text-slate-800">64 Kriteria</span></td>
              <td class="p-4 sm:p-5">Perusahaan kecil dengan tingkat potensi bahaya rendah</td>
              <td class="p-4 sm:p-5">
                <span class="text-emerald-700 font-semibold block">0–59%: Kurang</span>
                <span class="text-amber-700 font-semibold block">60–84%: Baik (Sertifikat Perak)</span>
                <span class="text-emerald-600 font-bold block">85–100%: Memuaskan (Bendera Emas)</span>
              </td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors bg-amber-50/30">
              <td class="p-4 sm:p-5 font-bold text-slate-900">Tingkat Transisi (Intermediate)</td>
              <td class="p-4 sm:p-5"><span class="px-2.5 py-1 rounded-full bg-amber-100 font-bold text-amber-800">122 Kriteria</span></td>
              <td class="p-4 sm:p-5">Perusahaan menengah dengan proses kerja berisiko sedang</td>
              <td class="p-4 sm:p-5">
                <span class="text-emerald-700 font-semibold block">0–59%: Tindakan Hukum</span>
                <span class="text-amber-700 font-semibold block">60–84%: Sertifikat Perak</span>
                <span class="text-emerald-600 font-bold block">85–100%: Bendera Emas Kemnaker</span>
              </td>
            </tr>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="p-4 sm:p-5 font-bold text-slate-900">Tingkat Lanjutan (Advanced)</td>
              <td class="p-4 sm:p-5"><span class="px-2.5 py-1 rounded-full bg-emerald-100 font-bold text-emerald-800">166 Kriteria</span></td>
              <td class="p-4 sm:p-5 font-medium text-slate-900">Perusahaan besar &gt;100 pekerja atau risiko bahaya tinggi (Migas, Petrokimia, Manufaktur Berat, Tambang)</td>
              <td class="p-4 sm:p-5 font-bold text-emerald-600">
                Wajib 85–100% untuk meraih Bendera Emas SMK3 Lanjutan
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Elemen Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-4">
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <span class="text-xs font-bold text-amber-600 uppercase">Elemen 1 s/d 4</span>
          <h4 class="font-bold text-slate-900 text-sm">Fondasi &amp; Perencanaan</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pembangunan komitmen kebijakan K3, tinjauan kontrak, pengendalian dokumen, dan pengorganisasian P2K3 di tempat kerja.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <span class="text-xs font-bold text-amber-600 uppercase">Elemen 5 s/d 8</span>
          <h4 class="font-bold text-slate-900 text-sm">Operasional Lapangan &amp; Bahaya</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pembelian barang/jasa, keamanan bekerja, standar pemeliharaan sarana/prasarana, dan kesiapsiagaan tanggap darurat industri.
          </p>
        </div>
        <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-2">
          <span class="text-xs font-bold text-amber-600 uppercase">Elemen 9 s/d 12</span>
          <h4 class="font-bold text-slate-900 text-sm">Inspeksi, Investigasi &amp; Audit</h4>
          <p class="text-xs text-slate-600 leading-relaxed">
            Pemeriksaan kesehatan, investigasi insiden, pencatatan data kecelakaan kerja, dan audit internal berkala SMK3.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: Silabus & Kurikulum Pelatihan -->
    <section id="silabus" class="p-8 sm:p-12 rounded-3xl bg-slate-900 text-white space-y-10 border border-slate-800">
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-bold uppercase tracking-wider text-amber-400 block">Kurikulum Standar Kemnaker RI</span>
        <h2 class="font-serif text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Silabus Pembelajaran Calon Auditor SMK3
        </h2>
        <p class="text-slate-300 text-sm leading-relaxed">
          Disusun berbasis kompetensi resmi untuk menghasilkan auditor yang tajam dalam melakukan observasi lapangan, teliti memeriksa dokumen bukti, dan independen dalam mengambil keputusan audit:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Module 1 -->
        <div class="p-6 rounded-2xl bg-slate-800/60 border border-white/10 space-y-3">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-amber-500/20 text-amber-400 flex items-center justify-center font-bold text-xs">M-1</span>
            <h4 class="font-bold text-white text-base">Kerangka Hukum &amp; Kebijakan SMK3 Nasional</h4>
          </div>
          <ul class="text-xs text-slate-300 space-y-2 list-disc list-inside leading-relaxed">
            <li>Kebijakan K3 Nasional dan perkembangan regulasi ketenagakerjaan.</li>
            <li>Prinsip dasar dan pemahaman mendalam PP No. 50 Tahun 2012.</li>
            <li>Tanggung jawab hukum pengurus, auditor internal, dan auditor eksternal.</li>
          </ul>
        </div>

        <!-- Module 2 -->
        <div class="p-6 rounded-2xl bg-slate-800/60 border border-white/10 space-y-3">
          <div class="flex items-center gap-3">
