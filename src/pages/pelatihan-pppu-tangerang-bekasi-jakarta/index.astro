---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { waLink } from '../../data/contact.js';

const title = "Pelatihan PPPU POIPPU Tangerang Bekasi Jakarta BNSP";
const description = "Pelatihan dan sertifikasi PPPU serta POIPPU BNSP di Tangerang, Bekasi, Jakarta, dan Cikarang. Kelola emisi boiler cerobong pabrik dan PROPER. Cek biaya.";
const canonical = "/pelatihan-pppu-tangerang-bekasi-jakarta/";
const ogImage = "https://konsultank3.com/assets/images/pelatihan-pppu-poippu-tangerang-hero.jpg";

const faqs = [
  {
    q: "Perusahaan mana di Tangerang, Bekasi, dan Jakarta yang wajib memiliki personel bersertifikat PPPU dan POIPPU?",
    a: "Setiap pabrik manufaktur, PLTD/genset berkapasitas besar, boiler batubara/gas/cangkang, smelter, pembakaran limbah, pabrik semen/keramik, maupun pengelola gedung komersial Jakarta yang memiliki cerobong emisi sumber tidak bergerak di kawasan Cikupa, Balaraja, Jatake, Jababeka, MM2100, Pulogadung, dan KBN Cakung wajib menunjuk penanggung jawab pengendalian pencemaran udara berlisensi BNSP sesuai PP No. 22/2021."
  },
  {
    q: "Apa perbedaan sertifikasi PPPU BNSP dan POIPPU / POPU BNSP?",
    a: "PPPU (Penanggung Jawab Pengendalian Pencemaran Udara) adalah level penanggung jawab manajerial/engineering yang menyusun rencana pemantauan emisi isokinetik, mengevaluasi pemenuhan Pertek Emisi, serta menyusun pelaporan SIMPEL KLHK dan PROPER. Sedangkan POIPPU (Penanggung Jawab Operasional Instalasi Pengendalian Pencemaran Udara, sering juga disebut POPU) berfokus pada pengoperasian serta pemeliharaan alat pengendali seperti bag filter, electrostatic precipitator, siklon, dan wet scrubber."
  },
  {
    q: "Berapa estimasi biaya Pelatihan PPPU dan POIPPU BNSP di Tangerang, Bekasi, dan Jakarta?",
    a: "Estimasi investasi per peserta mencakup: skema POIPPU / POPU BNSP berkisar Rp6.000.000–Rp7.500.000, sedangkan skema PPPU BNSP berkisar Rp7.000.000–Rp9.500.000 termasuk pembekalan SKKNI No. 282/2020, asistensi penyusunan portofolio dokumen emisi cerobong, serta biaya ujian asesmen asesor BNSP."
  },
  {
    q: "Apakah pelatihan ini juga melayani peserta dari Cikarang, Karawang, Depok, Bogor, dan Serang?",
    a: "Ya. Penyelenggaraan kelas wilayah Jabodetabek–Banten mencakup seluruh klaster manufaktur mulai dari Cikupa–Balaraja–Jatake Tangerang, Serang–Cilegon, Pulogadung–Cakung Jakarta, Cibitung–Cikarang–Bekasi, hingga koridor Bogor–Karawang baik melalui format Blended Learning, Tatap Muka, maupun In-House Training pabrik."
  },
  {
    q: "Apa syarat pendaftaran dan portofolio yang harus disiapkan untuk ujian PPPU dan POIPPU?",
    a: "Persyaratan administrasi mencakup KTP, pasfoto latar merah, ijazah (min. SMA/SMK berpengalaman untuk POIPPU; min. D3/S1 Teknik/Lingkungan/Kimia atau SLTA berpengalaman panjang untuk PPPU), CV, serta surat tugas perusahaan. Portofolio kerja meliputi denah titik cerobong, spesifikasi boiler/genset serta alat pengendali debu/gas, laporan uji emisi semester lab terakreditasi KAN, dan logbook perawatan filter."
  },
  {
    q: "Mengapa kepemilikan sertifikat PPPU dan POIPPU sangat memengaruhi skor PROPER dan izin operasional pabrik?",
    a: "Dalam audit pengawasan DLH DKI Jakarta, DLHK Banten, maupun DLH Jawa Barat dan evaluasi PROPER KLHK, keberadaan tenaga kompeten bersertifikat BNSP merupakan persyaratan mutlak pada aspek pengendalian pencemaran udara serta verifikasi dokumen Persetujuan Teknis (Pertek) pembuangan emisi."
  },
  {
    q: "Bagaimana bila perusahaan belum mempunyai data uji emisi lengkap untuk dijadikan portofolio uji?",
    a: "Instruktur dan tim verifikasi kami akan memandu cara merapikan dokumen operasional eksisting (seperti checklist perawatan baghouse, jadwal pembersihan scrubber, inventarisasi sumber emisi genset/boiler, maupun studi kasus perhitungan beban emisi) sehingga siap dinilai asesor."
  }
];

const pageSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Beranda", "item": "https://konsultank3.com/" },
        { "@type": "ListItem", "position": 2, "name": "Sertifikasi BNSP PPPU & POIPPU", "item": "https://konsultank3.com/pelatihan-pppu-poippu/" },
        { "@type": "ListItem", "position": 3, "name": "PPPU POIPPU Tangerang Bekasi Jakarta", "item": "https://konsultank3.com/pelatihan-pppu-tangerang-bekasi-jakarta/" }
      ]
    },
    {
      "@type": "Course",
      "name": "Pelatihan & Sertifikasi PPPU & POIPPU BNSP Tangerang, Bekasi & Jakarta",
      "description": description,
      "courseCode": "PPPU-POIPPU-JABODETABEK",
      "educationalCredentialAwarded": "Sertifikat Kompetensi BNSP PPPU / POIPPU (POPU)",
      "occupationalCategory": "Penanggung Jawab Pengendalian Pencemaran Udara / Operator Alat Pengendali Emisi",
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com"
      },
      "offers": {
        "@type": "AggregateOffer",
        "priceCurrency": "IDR",
        "lowPrice": "6000000",
        "highPrice": "9500000",
        "offerCount": "2"
      },
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": ["Onsite", "Blended"],
        "courseWorkload": "PT28H",
        "location": {
          "@type": "Place",
          "name": "Koridor Industri Tangerang, Bekasi & Jakarta",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Tangerang",
            "addressRegion": "Banten",
            "addressCountry": "ID"
          }
        }
      }
    },
    {
      "@type": "Service",
      "name": "Layanan Pelatihan & Uji Kompetensi PPPU POIPPU Jabodetabek, Tangerang, Bekasi, Jakarta dan Serang",
      "serviceType": "Sertifikasi Kompetensi Pengendalian Pencemaran Udara BNSP",
      "url": "https://konsultank3.com/pelatihan-pppu-tangerang-bekasi-jakarta/",
      "description": description,
      "provider": {
        "@type": "Organization",
        "name": "Konsultan K3 Indonesia",
        "url": "https://konsultank3.com",
        "telephone": "+62-895-1025-3435"
      },
      "areaServed": [
        "Tangerang",
        "Cikupa",
        "Balaraja",
        "Jatake",
        "Jakarta",
        "Pulogadung",
        "KBN Cakung",
        "Bekasi",
        "Cikarang",
        "MM2100",
        "Jababeka",
        "Karawang",
        "Bogor",
        "Depok",
        "Serang"
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map((item) => ({
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      }))
    }
  ]
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  schema={pageSchema}
  presetMessage="Halo Kak, saya mau info jadwal dan biaya Sertifikasi PPPU / POIPPU BNSP di Tangerang, Bekasi, atau Jakarta."
>
  <header class="w-full relative bg-slate-950 text-white pt-12 pb-20 border-b border-white/10 overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:20px_20px] opacity-30"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">

      <nav class="flex flex-wrap items-center gap-2 text-xs text-slate-400" aria-label="Breadcrumb">
        <a href="/" class="hover:text-amber-400 transition-colors">Beranda</a>
        <span>/</span>
        <a href="/pelatihan-pppu-poippu/" class="hover:text-amber-400 transition-colors">BNSP PPPU &amp; POIPPU</a>
        <span>/</span>
        <span class="text-slate-300">Tangerang, Bekasi &amp; Jakarta</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 text-cyan-300 text-xs font-semibold border border-cyan-500/20">
            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse-glow"></span>
            SKKNI No. 282/2020 &bull; Koridor Industri Tangerang &ndash; Jakarta &ndash; Bekasi
          </div>

          <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
            Pelatihan <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-300 via-emerald-300 to-teal-400">PPPU &amp; POIPPU BNSP Tangerang, Bekasi &amp; Jakarta</span>
          </h1>

          <p class="text-slate-300 font-sans text-base sm:text-lg leading-relaxed max-w-2xl">
            Program sertifikasi kompetensi pengendalian pencemaran udara dan operasi alat pengendali emisi pabrik (boiler, genset, scrubber, baghouse filter) bagi kawasan industri Jabodetabek, Cikupa–Balaraja Tangerang, KBN Cakung–Pulogadung Jakarta, serta Cikarang–Bekasi.
          </p>

          <div class="flex flex-wrap items-center gap-4 pt-2">
            <a
              href={waLink("Halo Kak, saya mau info jadwal dan biaya Sertifikasi PPPU / POIPPU BNSP di Tangerang, Bekasi, Jakarta.")}
              target="_blank"
              rel="noopener"
              class="px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm shadow-xl shadow-emerald-600/30 transition-all hover:scale-105 inline-flex items-center gap-2"
            >
              <span>Konsultasi Jadwal &amp; Biaya WA</span>
              <span>&rarr;</span>
            </a>
            <a
              href="/pelatihan-pppu-poippu/"
              class="px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/15 text-white font-semibold text-sm border border-white/15 transition-all"
            >
              Lihat Skema Induk PPPU/POIPPU &rarr;
            </a>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-white/10 text-center sm:text-left">
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Skema Resmi</span>
              <p class="text-white font-bold text-sm">PPPU &amp; POIPPU (POPU)</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Kepatuhan Emisi</span>
              <p class="text-white font-bold text-sm">Pertek, SIMPEL &amp; PROPER</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Durasi Program</span>
              <p class="text-white font-bold text-sm">3 – 4 Hari + Asesmen</p>
            </div>
            <div class="p-3 rounded-xl bg-white/5 border border-white/10">
              <span class="text-[10px] uppercase tracking-wider text-slate-400 block mb-0.5">Wilayah Industri</span>
              <p class="text-cyan-300 font-bold text-sm">Tangerang, Bekasi, DKI</p>
            </div>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="relative rounded-3xl overflow-hidden border border-white/15 shadow-2xl group">
            <img
              src="/assets/images/pelatihan-pppu-poippu-tangerang-hero.jpg"
              alt="Insinyur lingkungan melaksanakan pemantauan emisi cerobong boiler industri wilayah Tangerang Bekasi Jakarta"
              class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/25 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="inline-block px-2.5 py-1 rounded-md text-[11px] font-bold bg-cyan-500 text-slate-950 mb-2">
                Pemantauan Cerobong &amp; Baku Mutu Udara
              </span>
              <div class="text-lg font-bold">Kepatuhan Emisi Industri Jabodetabek &amp; Banten</div>
              <p class="text-xs text-slate-300 mt-1">
                Solusi sertifikasi penanggung jawab emisi bagi pabrik dan bangunan komersial berboiler serta genset kapasitas besar.
              </p>
            </div>
          </div>

          <div class="hidden sm:flex absolute -top-5 -left-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-cyan-500 text-slate-950 flex items-center justify-center font-bold text-lg">✓</div>
            <div>
              <div class="text-xs font-bold text-white">Sertifikat Garuda BNSP</div>
              <div class="text-[10px] text-slate-400">Standar SKKNI 282/2020</div>
            </div>
          </div>

          <div class="hidden sm:flex absolute -bottom-5 -right-5 p-3.5 rounded-2xl bg-slate-900/90 border border-white/15 backdrop-blur-md shadow-xl items-center gap-3">
            <div class="text-xl">💨</div>
            <div>
              <div class="text-xs font-bold text-white">Cakupan Jabodetabek</div>
              <div class="text-[10px] text-slate-400">Tangerang &bull; Bekasi &bull; Jakarta</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <aside aria-label="Informasi Pembaruan & Jadwal" class="w-full bg-cyan-500/10 border-b border-cyan-500/20 py-3 px-4 text-center">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-center gap-3 text-xs sm:text-sm text-slate-800 font-medium">
      <span class="inline-flex items-center gap-1.5 font-bold text-cyan-950">
        <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
        Diperbarui November 2026 &bull; Jabodetabek &amp; Banten:
      </span>
      <span class="text-slate-700">Melayani peserta dari Tangerang, Jakarta, Bekasi, Cikarang, Bogor, Depok, dan Serang.</span>
      <a
        href={waLink("Halo Kak, boleh minta jadwal uji PPPU / POIPPU BNSP untuk perusahaan di Jabodetabek?")}
        target="_blank"
        rel="noopener"
        class="text-cyan-800 hover:text-cyan-950 font-bold underline ml-1"
      >
        Cek Jadwal via WhatsApp &rarr;
      </a>
    </div>
  </aside>

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-20">

    <!-- Section 1: Quick Answer + Summary Table -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-6 p-8 rounded-3xl bg-white border border-slate-200 shadow-sm space-y-4">
        <span class="text-xs font-bold uppercase tracking-widest text-cyan-700 block">Ringkasan Jawaban Cepat</span>
        <h2 class="text-2xl font-serif font-bold text-slate-900">Sertifikasi Emisi Udara Jabodetabek &amp; Banten</h2>
        <p class="text-slate-700 text-sm sm:text-base leading-relaxed">
          Melalui program induk <a href="/pelatihan-pppu-poippu/" class="text-cyan-700 font-bold underline">Sertifikasi BNSP PPPU &amp; POIPPU Emisi Udara</a>, kami melayani perusahaan di <strong>Tangerang, Bekasi, Jakarta, Cikarang, Karawang, dan Serang</strong> untuk memenuhi kewajiban tenaga kompeten pengendalian pencemaran udara di cerobong boiler, genset, furnace, dan unit dust collector agar lolos pemeriksaan DLH serta penilaian PROPER.
        </p>
        <div class="p-4 rounded-2xl bg-cyan-50 border border-cyan-200 text-xs text-cyan-950 leading-relaxed">
          <strong>Pengawasan Emisi Jabodetabek:</strong> Kawasan industri di Banten, DKI Jakarta, dan Jawa Barat Barat menjadi fokus utama penegakan kualitas udara ambien dan uji emisi sumber tidak bergerak secara berkala per semester.
        </div>
      </div>

      <div class="lg:col-span-6 overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-slate-700">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th class="py-3.5 px-5">Informasi Utama</th>
              <th class="py-3.5 px-5">Detail Koridor Tangerang–Bekasi–Jakarta</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Lembaga Penerbit</td>
              <td class="py-3 px-5">BNSP RI (via LSP Sektor Lingkungan Terlisensi)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Skema Kompetensi</td>
              <td class="py-3 px-5">PPPU (Penanggung Jawab) &amp; POIPPU / POPU (Operator)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Cakupan Kota</td>
              <td class="py-3 px-5">Tangerang, Bekasi, Jakarta, Cikarang, Karawang, Serang, Bogor</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Durasi Pembinaan</td>
              <td class="py-3 px-5">3 – 4 Hari (Pembekalan SKKNI + Klinik Portofolio + Asesmen)</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Estimasi Biaya</td>
              <td class="py-3 px-5 font-semibold text-cyan-700">POIPPU Rp6–7,5 jt &bull; PPPU Rp7–9,5 jt / peserta</td>
            </tr>
            <tr>
              <td class="py-3 px-5 font-bold text-slate-900">Landasan Standar</td>
              <td class="py-3 px-5">SKKNI No. 282 Tahun 2020 &amp; PP No. 22 Tahun 2021</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Section 2: Multi-City Corridor Coverage -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-cyan-700 block mb-2">Cakupan Kawasan Jabodetabek &amp; Banten</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Klaster Pabrik &amp; Fasilitas Beremisi di Tangerang, Jakarta, dan Bekasi
        </h2>
        <div class="h-1 w-20 bg-cyan-600 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          Satu halaman program ini melayani kebutuhan sertifikasi personel pengendali udara di seluruh koridor industri barat hingga timur Jabodetabek dengan penyesuaian karakteristik emisi masing-masing sektor.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-cyan-500/10 text-cyan-700 flex items-center justify-center font-bold text-xl">🏭</div>
          <h3 class="font-bold text-slate-900 text-lg">Tangerang, Cikupa &amp; Serang</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Kawasan Cikupa Mas, Balaraja, Jatake, Manis, Pasar Kemis, hingga Cikande (Serang) dipadati industri tekstil, keramik, plastik, ban, dan peleburan logam yang mengoperasikan boiler serta baghouse dust collector di bawah pengawasan DLHK Banten.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-emerald-500/10 text-emerald-700 flex items-center justify-center font-bold text-xl">🏢</div>
          <h3 class="font-bold text-slate-900 text-lg">DKI Jakarta (Pulogadung, Cakung, CBD)</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Pabrik farmasi, otomotif, dan logam di JIEP Pulogadung, KBN Cakung–Marunda, Sunter, serta gedung pencakar langit maupun data center dengan cadangan genset berkapasitas besar di bawah pantauan DLH DKI Jakarta.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white border border-slate-200 shadow-sm space-y-3">
          <div class="w-11 h-11 rounded-xl bg-amber-500/10 text-amber-700 flex items-center justify-center font-bold text-xl">🔥</div>
          <h3 class="font-bold text-slate-900 text-lg">Bekasi, Cikarang &amp; Karawang</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            Pabrik makanan-minuman, kertas, otomotif, dan kimia di MM2100, Jababeka, EJIP, Delta Silicon, dan Narogong dengan cerobong boiler uap, incinerator, serta unit wet scrubber maupun thermal oxidizer.
          </p>
        </div>
      </div>
    </section>

    <!-- Section 3: PPPU vs POIPPU Comparison -->
    <section class="space-y-8">
      <div class="max-w-3xl">
        <span class="text-xs font-bold uppercase tracking-widest text-cyan-700 block mb-2">Pemetaan Jabatan</span>
        <h2 class="text-2xl sm:text-3xl font-serif font-bold text-slate-900 tracking-tight">
          Perbedaan Skema PPPU dan POIPPU / POPU BNSP
        </h2>
        <div class="h-1 w-20 bg-cyan-600 mt-3 mb-4 rounded-full"></div>
        <p class="text-slate-600 leading-relaxed text-base">
          Pelajari silabus rincian unit SKKNI pada halaman utama <a href="/pelatihan-pppu-poippu/" class="text-cyan-700 font-bold underline">Sertifikasi BNSP PPPU &amp; POIPPU</a>. Pastikan perusahaan Anda menetapkan peran pengawasan dan operasional secara tepat:
        </p>
      </div>

      <div class="overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-sm">
        <table class="w-full text-left text-xs sm:text-sm text-slate-700">
          <thead class="bg-slate-900 text-white uppercase text-xs">
            <tr>
              <th class="py-3.5 px-5">Aspek</th>
              <th class="py-3.5 px-5 bg-cyan-950">POIPPU / POPU (Operator)</th>
              <th class="py-3.5 px-5 bg-slate-800">PPPU (Penanggung Jawab)</th>
            </tr>
          </thead>
